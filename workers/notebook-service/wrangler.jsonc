// The LIT notebook service (step 4c of STUDY-DESK.md, "Order of work," 4).
// README.md has the setup, the deploy, the rollback, and the wipe.
//
// Two environments, and they are deliberately not alike:
//
//   env.preview   The preview the apps and the website build against. Test
//                 data only. It is the ONLY environment configured here, and
//                 the only one that turns the preview's way in on.
//   (top level)   Production's. Step 4f fills it in (its own database, its
//                 address, and no PREVIEW_* of any kind). Until then it has
//                 no bindings on purpose, so nothing can be deployed as
//                 production by leaving `--env preview` off a command; every
//                 npm script in package.json names the environment.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "litbible-notebook",
  "main": "src/index.js",
  "compatibility_date": "2026-11-18",
  // No *.workers.dev address and no per-version preview addresses: the
  // service answers on its own address or not at all.
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "logs": {
      // The platform's own line for each request holds the address that was
      // asked for, ids and all. The service writes its own line instead, with
      // the route as it is written in src/index.js and nothing from the request.
      "invocation_logs": false
    }
  },

  "env": {
    // Deploys as the Worker "litbible-notebook-preview".
    "preview": {
      "routes": [{ "pattern": "notebook-preview.litbible.net", "custom_domain": true }],
      "vars": {
        "ENVIRONMENT": "preview",
        // The preview's way in (src/preview.js). Production never sets this.
        "PREVIEW_SIGN_IN": "on",
        // Origins the website's connector may call from: the site, and `npm run dev`.
        "ALLOWED_ORIGINS": "https://litbible.net,http://localhost:4321",

        // Passkeys (src/passkey-form.js). The relying party is the site itself,
        // so one passkey works on the website and in both apps.
        "PASSKEY_RP_ID": "litbible.net",
        // Where a passkey's answer may come from. The website's origin, which
        // is also what an iOS app answers with; then the Android app, as
        // Android names it: android:apk-key-hash: and the base64url of a
        // signing certificate's SHA-256. The two here are the two fingerprints
        // public/.well-known/assetlinks.json already lists for
        // com.litbible.app, re-spelled (README, "Passkeys"). Not secrets.
        "PASSKEY_ORIGINS": "https://litbible.net,android:apk-key-hash:i0jYJmPpHB9l29QmwXak-oP4_MisDdoXizByqeH510k,android:apk-key-hash:1fwRSSnQjSYWhPzTsioZe2Wjm838nZnc6GVT8PMwlEU",
        // The preview only: the website's dev server, where a browser makes
        // the RP ID "localhost". Production never sets this, and the service
        // reads it only where ENVIRONMENT is "preview".
        "PASSKEY_LOCAL_ORIGINS": "http://localhost:4321"

        // Sign in with Apple and with Google are OFF: no client id is set
        // here, and none is guessed. They come from BDR's Apple developer
        // account and Google Cloud project (README, "Apple and Google").
        //   APPLE_CLIENT_IDS, APPLE_TEAM_ID, APPLE_KEY_ID   variables
        //   APPLE_PRIVATE_KEY                               a Wrangler secret
        //   GOOGLE_CLIENT_IDS                               a variable
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "litbible-notebook-preview",
          // The id `wrangler d1 create litbible-notebook-preview` printed
          // on 2026-11-23 (README, "One-time setup"). An id is not a secret.
          // Local development and the tests never read it.
          "database_id": "39ae93c2-7585-4442-bfa7-71d18267af69",
          "migrations_dir": "migrations"
        }
      ],
      // `wrangler deploy` refuses to deploy the preview until this secret is set.
      "secrets": { "required": ["PREVIEW_SECRET"] }
    }
  }
}
