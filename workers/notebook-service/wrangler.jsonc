// The LIT notebook service (steps 4c, 4e, and 4f of STUDY-DESK.md, "Order of
// work," 4). README.md has the setup, the deploy, the rollback, and the wipe;
// RUNBOOK.md has what to do when it breaks.
//
// Two environments, each named, and they are deliberately not alike:
//
//   env.preview      The preview the apps and the website build against. Test
//                    data only. The only environment that turns the preview's
//                    way in on.
//   env.production   Readers' notebooks. PREPARED IN STEP 4F AND NOT
//                    DEPLOYED: its database doesn't exist yet, and the id
//                    below is a placeholder that no deploy can succeed with
//                    (README, "Production"). It has no PREVIEW_* of any kind
//                    and no PASSKEY_LOCAL_ORIGINS, and test/config.test.js
//                    holds it to that.
//   (top level)      Nothing: no binding, no route, no trigger. A command
//                    that leaves `--env` off therefore reaches no database
//                    and answers at no address. Every npm script in
//                    package.json names its environment.
//
// Bindings, variables, triggers, and rate limits are not inherited by a named
// environment, so each is written out in both.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "litbible-notebook",
  "main": "src/index.js",
  "compatibility_date": "2026-11-18",
  // No *.workers.dev address and no per-version preview addresses: the
  // service answers on its own address or not at all.
  "workers_dev": false,
  "preview_urls": false,
  // NO STORED LOGS, on purpose (BVJ, 2026-11-26, Study Desk Audit 9's
  // decision 4). The service writes its own line for each request, with the
  // route as it is written in src/index.js and nothing from the request, but
  // a stored Workers Logs event carries the request's full URL beside it
  // (read from the preview's dashboard that day), and /devices/:id,
  // /approvals/:id, /ways/:id, and ?device= put an id in the URL. /privacy
  // says the lines aren't stored. `npx wrangler tail --env preview` shows them
  // live. Both environments inherit this; test/config.test.js holds it off.
  "observability": { "enabled": false },

  "env": {
    // Deploys as the Worker "litbible-notebook-preview".
    "preview": {
      "routes": [{ "pattern": "notebook-preview.litbible.net", "custom_domain": true }],
      "vars": {
        "ENVIRONMENT": "preview",
        // The preview's way in (src/preview.js). Production never sets this.
        "PREVIEW_SIGN_IN": "on",
        // Origins the website's connector may call from: the site, and `npm run dev`.
        "ALLOWED_ORIGINS": "https://litbible.net,http://localhost:4321",

        // Passkeys (src/passkey-form.js). The relying party is the site itself,
        // so one passkey works on the website and in both apps.
        "PASSKEY_RP_ID": "litbible.net",
        // Where a passkey's answer may come from. The website's origin, which
        // is also what an iOS app answers with; then the Android app, as
        // Android names it: android:apk-key-hash: and the base64url of a
        // signing certificate's SHA-256. The two here are the two fingerprints
        // public/.well-known/assetlinks.json already lists for
        // com.litbible.app, re-spelled (README, "Passkeys"). Not secrets.
        "PASSKEY_ORIGINS": "https://litbible.net,android:apk-key-hash:i0jYJmPpHB9l29QmwXak-oP4_MisDdoXizByqeH510k,android:apk-key-hash:1fwRSSnQjSYWhPzTsioZe2Wjm838nZnc6GVT8PMwlEU",
        // The preview only: the website's dev server, where a browser makes
        // the RP ID "localhost". Production never sets this, and the service
        // reads it only where ENVIRONMENT is "preview".
        "PASSKEY_LOCAL_ORIGINS": "http://localhost:4321",

        // Turnstile before a new account (src/turnstile.js; README, "Turnstile
        // before a new account"): the site key of the notebook service's own
        // widget, made by BVJ on 2026-11-25 for the hostname litbible.net
        // (the dashboard didn't take localhost). Public by design: GET
        // /sign-in hands it to the website. Its secret is the Wrangler secret
        // TURNSTILE_SECRET, never written here; the check is on only where
        // both are set.
        "TURNSTILE_SITE_KEY": "0x4AAAAAAGTndtU2opdLCqsd"

        // Sign in with Apple and with Google are OFF: no client id is set
        // here, and none is guessed. They come from BDR's Apple developer
        // account and Google Cloud project (README, "Apple and Google").
        //   APPLE_CLIENT_IDS, APPLE_TEAM_ID, APPLE_KEY_ID   variables
        //   APPLE_PRIVATE_KEY                               a Wrangler secret
        //   GOOGLE_CLIENT_IDS                               a variable
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "litbible-notebook-preview",
          // The id `wrangler d1 create litbible-notebook-preview` printed
          // on 2026-11-23 (README, "One-time setup"). An id is not a secret.
          // Local development and the tests never read it.
          "database_id": "39ae93c2-7585-4442-bfa7-71d18267af69",
          "migrations_dir": "migrations"
        }
      ],
      // Every hour, at seventeen past: the requests that have waited seven
      // days are carried out, and what ran out is swept (src/scheduled.js).
      "triggers": { "crons": ["17 * * * *"] },
      // How often one address may ask (src/limits.js). A namespace id is a
      // number of our own choosing, unique on the account; it is not a
      // resource to create and not a secret. `period` is in seconds.
      // A deployment missing any of the three answers "error" to everything.
      "ratelimits": [
        // The requests that begin a sign-in: 60 a minute from one address.
        { "name": "SIGN_IN_LIMIT", "namespace_id": "4101", "simple": { "limit": 60, "period": 60 } },
        // Every other request: 1,200 a minute from one address.
        { "name": "REQUEST_LIMIT", "namespace_id": "4102", "simple": { "limit": 1200, "period": 60 } },
        // POST /rows, counted apart from the rest: 120 a minute from one
        // address (BVJ, 2026-11-26; Study Desk Audit 9, SV9-1).
        { "name": "PUSH_LIMIT", "namespace_id": "4103", "simple": { "limit": 120, "period": 60 } }
      ],
      // `wrangler deploy` refuses to deploy the preview until these secrets are set.
      "secrets": { "required": ["PREVIEW_SECRET", "TURNSTILE_SECRET"] }
    },

    // Deploys as the Worker "litbible-notebook-production". NOT DEPLOYED, and
    // not to be until BVJ says so (README, "Production").
    "production": {
      "routes": [{ "pattern": "notebook.litbible.net", "custom_domain": true }],
      "vars": {
        "ENVIRONMENT": "production",
        // The website alone. No dev server.
        "ALLOWED_ORIGINS": "https://litbible.net",
        "PASSKEY_RP_ID": "litbible.net",
        // The same origins as the preview's, without the dev server's:
        // the root's test/link-files.test.js keeps both lists equal to the
        // certificates in public/.well-known/assetlinks.json.
        "PASSKEY_ORIGINS": "https://litbible.net,android:apk-key-hash:i0jYJmPpHB9l29QmwXak-oP4_MisDdoXizByqeH510k,android:apk-key-hash:1fwRSSnQjSYWhPzTsioZe2Wjm838nZnc6GVT8PMwlEU"

        // Never here: PREVIEW_SIGN_IN, PREVIEW_SECRET, PASSKEY_LOCAL_ORIGINS.
        // Apple and Google are off until BDR's identifiers are configured,
        // exactly as on the preview.
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "litbible-notebook",
          // A PLACEHOLDER. The database doesn't exist. BVJ makes it with
          // `npx wrangler d1 create litbible-notebook` and puts the id it
          // prints here (README, "Production," step 2). Until then no
          // migration and no deploy of production can succeed, and the
          // workflow's production job refuses to start.
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "migrations"
        }
      ],
      "triggers": { "crons": ["17 * * * *"] },
      "ratelimits": [
        { "name": "SIGN_IN_LIMIT", "namespace_id": "4111", "simple": { "limit": 60, "period": 60 } },
        { "name": "REQUEST_LIMIT", "namespace_id": "4112", "simple": { "limit": 1200, "period": 60 } },
        { "name": "PUSH_LIMIT", "namespace_id": "4113", "simple": { "limit": 120, "period": 60 } }
      ]
    }
  }
}
