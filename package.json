{
  "name": "litbible",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "dev": "astro dev",
    "build:topics": "node scripts/build-topics-index.mjs",
    "build:verses": "node scripts/build-verse-index.mjs",
    "build:api": "node scripts/build-api-json.mjs",
    "build:manifest": "node scripts/build-api-manifest.mjs",
    "build:og": "node scripts/build-og-images.mjs",
    "build:favicons": "node scripts/build-favicons.mjs",
    "fetch:podcast": "node scripts/fetch-podcast-feed.mjs",
    "build": "node scripts/fetch-podcast-feed.mjs && npm run build:topics && npm run build:verses && npm run build:manifest && npm run build:api && npm run build:og && astro build && pagefind --site dist",
    "preview": "npm run build && astro preview",
    "check": "astro check",
    "validate:chapters": "node scripts/validate-chapters.mjs",
    "check:links": "node scripts/check-links.mjs",
    "test": "node --test \"test/**/*.js\"",
    "fix:chapters": "node scripts/validate-chapters.mjs --fix",
    "draft:release-notes": "node scripts/draft-release-notes.mjs"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.18",
    "@fontsource/crimson-text": "^5.2.7",
    "@fontsource/fraunces": "^5.2.9",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/opendyslexic": "^5.2.5",
    "astro": "^6.4.8",
    "simple-icons": "^16.7.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/sitemap": "^3.7.3",
    "jsonc-parser": "^3.3.1",
    "opentype.js": "^2.0.0",
    "pagefind": "^1.0.0",
    "typescript": "^6.0.3"
  }
}
