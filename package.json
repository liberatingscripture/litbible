{
  "name": "litbible",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "dev": "astro dev",
    "build:topics": "node scripts/build-topics-index.mjs",
    "build:api": "node scripts/build-api-json.mjs",
    "build:manifest": "node scripts/build-api-manifest.mjs",
    "build": "npm run build:topics && node scripts/build-api-json.mjs && node scripts/build-api-manifest.mjs && astro build && pagefind --site dist",
    "preview": "npm run build && astro preview",
    "validate:chapters": "node scripts/validate-chapters.mjs",
    "fix:chapters": "node scripts/validate-chapters.mjs --fix",
    "draft:release-notes": "node scripts/draft-release-notes.mjs"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.18",
    "@fontsource/crimson-text": "^5.2.7",
    "@fontsource/fraunces": "^5.2.9",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/opendyslexic": "^5.2.5",
    "astro": "^5.17.1",
    "simple-icons": "^16.7.0"
  },
  "devDependencies": {
    "@astrojs/sitemap": "^3.7.1",
    "jsonc-parser": "^3.3.1",
    "pagefind": "^1.0.0"
  }
}
