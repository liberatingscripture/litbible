{
  "name": "litbible",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "dev": "astro dev",
    "build:topics": "node scripts/build-topics-index.mjs",
    "build:verses": "node scripts/build-verse-index.mjs",
    "build:api": "node scripts/build-api-json.mjs",
    "build:glossary": "node scripts/build-glossary-json.mjs",
    "build:greek-bridge": "node scripts/build-greek-bridge.mjs",
    "build:manifest": "node scripts/build-api-manifest.mjs",
    "build:og": "node scripts/build-og-images.mjs",
    "build:favicons": "node scripts/build-favicons.mjs",
    "build:bracket-font": "node scripts/build-bracket-marker-font.mjs",
    "build:text-critical-font": "node scripts/build-text-critical-font.mjs",
    "build:apps-qr": "node scripts/build-apps-qr.mjs",
    "build:alignment": "node scripts/build-alignment.mjs",
    "build:anchor-vectors": "node scripts/build-anchor-vectors.mjs",
    "build:greek": "node scripts/build-greek.mjs",
    "review:alignment": "node scripts/alignment-review/server.mjs",
    "review:words": "node scripts/alignment-words/server.mjs",
    "audit:words": "node scripts/audit-alignment-words.mjs",
    "audit:alignment": "node scripts/audit-alignment.mjs",
    "fetch:podcast": "node scripts/fetch-podcast-feed.mjs",
    "build": "node scripts/fetch-podcast-feed.mjs && npm run build:topics && npm run build:verses && npm run build:glossary && npm run build:greek-bridge && npm run build:manifest && npm run build:api && npm run build:og && astro build && pagefind --site dist",
    "preview": "npm run build && astro preview",
    "check": "astro check",
    "validate:chapters": "node scripts/validate-chapters.mjs",
    "check:links": "node scripts/check-links.mjs",
    "test": "node --test \"test/**/*.js\" \"scripts/reconcile/test/**/*.mjs\"",
    "fix:chapters": "node scripts/validate-chapters.mjs --fix",
    "import:chapter": "node scripts/import-chapter.mjs",
    "draft:release-notes": "node scripts/draft-release-notes.mjs",
    "review:reconcile": "node scripts/reconcile/review/server.mjs"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.18",
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "@fontsource-variable/noto-sans-hebrew": "^5.3.0",
    "@fontsource-variable/playpen-sans": "^5.3.0",
    "@fontsource/cardo": "^5.3.0",
    "@fontsource/crimson-text": "^5.3.0",
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/opendyslexic": "^5.3.0",
    "astro": "^7.4.0",
    "qrcode-generator": "^2.0.4",
    "simple-icons": "^16.35.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/markdown-remark": "7.3.3",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource/noto-sans-math": "^5.3.0",
    "jsonc-parser": "^3.3.1",
    "opentype.js": "^2.0.0",
    "pagefind": "^1.5.2",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3"
  }
}
