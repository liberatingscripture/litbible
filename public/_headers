/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  # CSP is deliberately SPLIT in two (F2, owner decision 2026-07-10) — revisit
  # only if the site ever gains logins/accounts (see CLAUDE.md):
  # 1) ENFORCED structural directives. These constrain attackers, never
  #    integrations — no future widget/embed ever needs them edited.
  #    frame-ancestors backs up X-Frame-Options above; form-action means our
  #    forms can only submit to endpoints we've named (update it if a form
  #    backend changes). 'self' covers the contact form, which posts to the
  #    /contact/submit Worker (F1 — replaced Formspree); sibforms is the
  #    Brevo newsletter.
  Content-Security-Policy: frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self' https://sibforms.com https://*.sibforms.com
  # 2) REPORT-ONLY resource allowlist: logs to the console, blocks nothing.
  #    Kept as documentation of every third-party origin the site uses and as
  #    free telemetry; enforcing it was rejected because a missed origin would
  #    silently break the newsletter/Turnstile/donate widgets ("future you
  #    forgets _headers exists" is likelier than the threat it stops on a
  #    static no-login site). 'unsafe-inline' covers Astro's is:inline scripts
  #    (JSON-LD data blocks are exempt). *.sibforms.com doesn't match the bare
  #    apex, hence both entries. sibforms is deliberately NOT in script-src:
  #    no page loads Brevo's main.js (SiteFooter.astro's docblock explains why),
  #    so Brevo is a fetch/POST target only — connect-src + form-action, never
  #    a script origin. cloudflareinsights is the Web Analytics RUM beacon:
  #    Cloudflare EDGE-INJECTS it, so it appears in no source file here, and it
  #    is skipped for non-browser user agents — a plain `curl` of the homepage
  #    shows no beacon and looks broken. Verify with a browser UA before
  #    concluding it is missing (a 2026-07-16 audit and a 2026-07-27 recheck
  #    both drew the wrong conclusion this way). The GiveLively payment step (Stripe/PayPal
  #    card fields) was never exercised with a console open, so its origins
  #    may be missing here — harmless in report-only.
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' 'unsafe-inline' https://challenges.cloudflare.com https://static.cloudflareinsights.com https://secure.givelively.org; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://secure.givelively.org; font-src 'self'; connect-src 'self' https://sibforms.com https://*.sibforms.com https://cloudflareinsights.com https://secure.givelively.org; frame-src https://challenges.cloudflare.com https://embed.podcasts.apple.com https://www.youtube.com https://open.spotify.com https://secure.givelively.org; media-src 'self'
  # Agent discovery (RFC 8288) — advertise the API catalog and machine-readable docs.
  Link: </.well-known/api-catalog>; rel="api-catalog"; type="application/linkset+json"
  Link: </llms-full.txt>; rel="service-doc"; type="text/plain"

# RFC 9727 / RFC 9264 — the catalog has no file extension, so set its media type.
/.well-known/api-catalog
  Content-Type: application/linkset+json
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=3600

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# CORS + JSON type for the whole API surface. Cache-Control is intentionally NOT
# set here: Cloudflare _headers *appends* (it does not override) when several
# rules match a path, so a broad `max-age` here would concatenate with the
# `no-store` below into a self-contradictory `public, max-age=3600, no-store` on
# every sync-critical file. Caching is therefore opted into per-file instead.
/api/*
  Access-Control-Allow-Origin: *
  Content-Type: application/json

# content.json is the large, stable full-NT artifact and is safe to edge-cache.
/api/content.json
  Cache-Control: public, max-age=3600

# The apps gate on version.json, then must read a manifest and data files that
# match it. If those were edge-cached they could lag a version bump — a client
# would see the new version but download stale hashes/bytes. Keep the sync-
# critical files fresh (plain no-store, no conflicting directive) so a version
# change is immediately consistent end-to-end. (These are only fetched when the
# version actually changed, so the cost is bounded.)
/api/version.json
  Cache-Control: no-store

/api/manifest.json
  Cache-Control: no-store

/api/data/*
  Cache-Control: no-store
