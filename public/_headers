/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  # CSP, currently REPORT-ONLY (F2): browsers log would-be violations to the
  # console but block nothing. Watch the deployed site (dev/preview don't apply
  # _headers), especially the newsletter form, contact Turnstile, /support
  # donate widget, and the podcast embeds; when a full pass is clean, rename to
  # Content-Security-Policy to enforce. 'unsafe-inline' covers Astro's is:inline
  # scripts (JSON-LD data blocks are exempt from script-src). *.sibforms.com
  # doesn't match the bare apex, hence both entries.
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' 'unsafe-inline' https://challenges.cloudflare.com https://sibforms.com https://*.sibforms.com https://secure.givelively.org; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://secure.givelively.org; font-src 'self'; connect-src 'self' https://formspree.io https://sibforms.com https://*.sibforms.com https://secure.givelively.org; frame-src https://challenges.cloudflare.com https://embed.podcasts.apple.com https://www.youtube.com https://open.spotify.com https://secure.givelively.org; media-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self' https://formspree.io https://sibforms.com https://*.sibforms.com; frame-ancestors 'none'
  # Agent discovery (RFC 8288) — advertise the API catalog and machine-readable docs.
  Link: </.well-known/api-catalog>; rel="api-catalog"; type="application/linkset+json"
  Link: </llms-full.txt>; rel="service-doc"; type="text/plain"

# RFC 9727 / RFC 9264 — the catalog has no file extension, so set its media type.
/.well-known/api-catalog
  Content-Type: application/linkset+json
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=3600

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# CORS + JSON type for the whole API surface. Cache-Control is intentionally NOT
# set here: Cloudflare _headers *appends* (it does not override) when several
# rules match a path, so a broad `max-age` here would concatenate with the
# `no-store` below into a self-contradictory `public, max-age=3600, no-store` on
# every sync-critical file. Caching is therefore opted into per-file instead.
/api/*
  Access-Control-Allow-Origin: *
  Content-Type: application/json

# content.json is the large, stable full-NT artifact and is safe to edge-cache.
/api/content.json
  Cache-Control: public, max-age=3600

# The apps gate on version.json, then must read a manifest and data files that
# match it. If those were edge-cached they could lag a version bump — a client
# would see the new version but download stale hashes/bytes. Keep the sync-
# critical files fresh (plain no-store, no conflicting directive) so a version
# change is immediately consistent end-to-end. (These are only fetched when the
# version actually changed, so the cost is bounded.)
/api/version.json
  Cache-Control: no-store

/api/manifest.json
  Cache-Control: no-store

/api/data/*
  Cache-Control: no-store
