---
import SearchBar from "./SearchBar.astro";

// scriptureControls: "study" on a chapter page (verse numbers and footnote
// letters), "read" in Reading View (numbers only: it prints no footnote
// letters, and its numbers setting hides the chapter headings too).
// headerSearch: a search icon beside "Aa" that opens a search strip under
// the header, on pages with no search box of their own (see Layout's
// pageSearch). Without JS the icon is a plain link to /search.
const { class: className = "", scriptureControls, headerSearch = false } = Astro.props;

// Text size steps. The visible letters are the usual abbreviations; the
// radios carry the words for screen readers.
const SIZE_OPTIONS = [
  { value: "sm", short: "S", label: "Small" },
  { value: "md", short: "M", label: "Medium" },
  { value: "lg", short: "L", label: "Large" },
  { value: "xl", short: "XL", label: "Extra large" },
];
---

<header class={`site-header ${className}`.trim()}>
  <div class="site-header__inner">
    <a
      href="/"
      class="site-header__brand"
      aria-label="The Liberation and Inclusion Translation home"
    >
      <img
        src="/images/lit-logo-2026-ring.svg"
        alt=""
        class="site-header__logo"
        width="48"
        height="48"
        loading="eager"
        decoding="async"
      />
      <span class="site-header__title">
        <span class="title-long">
          <span class="title-prefix">The Liberation &amp; Inclusion</span><span
            class="title-truncatable">Translation</span
          >
        </span>
        <span class="title-alt">LIT Bible</span>
        <span class="sr-only">The Liberation and Inclusion Translation</span>
      </span>
    </a>

    <!-- Desktop nav -->
    <nav class="site-nav" aria-label="Primary">
      <ul class="site-nav__list">
        <li><a href="/about">About</a></li>
        <li><a href="/translation-commitments">Commitments</a></li>
        <li><a href="/glossary">Glossary</a></li>
        <li><a href="/found-in-translation-podcast">Podcast</a></li>
        <li><a href="/articles">Articles</a></li>

        <li class="site-nav__cta-item">
          <a href="/read" class="site-header__cta"><span>Read Now</span></a>
          <!-- Desktop: search and Aa sit below READ NOW -->
          <div class="site-header__nav-tools">
            {headerSearch && (
              <a href="/search" class="site-header__search site-header__search--nav" data-search-toggle aria-label="Search">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor"
                     stroke-width="2" stroke-linecap="round" aria-hidden="true" focusable="false">
                  <circle cx="10.5" cy="10.5" r="6.5" />
                  <path d="M15.5 15.5 21 21" />
                </svg>
              </a>
            )}
            <button
              class="site-header__font-toggle site-header__font-toggle--nav"
              type="button"
              aria-expanded="false"
              aria-controls="fontTray"
              data-font-toggle
            >
              <span aria-hidden="true">Aa</span>
              <span class="sr-only">Display settings</span>
            </button>
          </div>
        </li>
      </ul>
    </nav>

    <div class="site-header__actions">
      {headerSearch && (
        <a href="/search" class="site-header__search site-header__search--actions" data-search-toggle aria-label="Search">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor"
               stroke-width="2" stroke-linecap="round" aria-hidden="true" focusable="false">
            <circle cx="10.5" cy="10.5" r="6.5" />
            <path d="M15.5 15.5 21 21" />
          </svg>
        </a>
      )}
      <button
        class="site-header__font-toggle site-header__font-toggle--actions"
        type="button"
        aria-expanded="false"
        aria-controls="fontTray"
        data-font-toggle
      >
        <span aria-hidden="true">Aa</span>
        <span class="sr-only">Display settings</span>
      </button>
      <button
        class="site-header__menu-toggle"
        type="button"
        aria-label="Open menu"
        aria-controls="mobileMenu"
        aria-expanded="false"
        aria-haspopup="dialog"
      >
        <span class="menu-icon" aria-hidden="true"></span>
        <span class="sr-only">Menu</span>
      </button>
    </div>
  </div>

  {headerSearch && (
    <div class="site-header__search-strip" id="headerSearch" hidden>
      <div class="site-header__search-inner">
        <SearchBar placeholder="Search the LIT Bible" />
        <button type="button" class="site-header__search-close" aria-label="Close search">
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path d="M1 1l12 12M13 1L1 13" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
          </svg>
        </button>
      </div>
    </div>
  )}

  <!-- No-JS navigation fallback. Under 1100px the real nav collapses to the
       JS-only overlay, whose toggle does nothing without JS. Render a plain
       nav row (only shown < 1101px, where .site-nav is hidden) and hide the
       JS-only toggles. Mirrors SiteFooter's noscript pattern: <style is:inline>
       with global selectors, since the styled elements are Astro-scoped.
       Keep this link list in sync with the desktop nav above. -->
  <noscript>
    <style is:inline>
      /* JS-only controls do nothing without JS — hide both toggles at every
         width. !important beats the scoped display rules on these buttons. */
      .site-header__menu-toggle,
      .site-header__font-toggle { display: none !important; }
      /* Fallback nav: only under 1101px, where the real .site-nav is hidden.
         On desktop the real nav works without JS, so keep the fallback out. */
      .site-header__noscript-nav {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.15rem 0.4rem;
        padding: 0.4rem var(--gutter) 0.7rem;
        border-top: 1px solid var(--border);
      }
      .site-header__noscript-nav a {
        font-family: Inter, sans-serif;
        font-size: 0.9rem;
        font-weight: 500;
        color: var(--text);
        text-decoration: none;
        padding: 0.3rem 0.5rem;
        border-radius: 8px;
      }
      @media (min-width: 1101px) {
        .site-header__noscript-nav { display: none; }
      }
    </style>
    <nav class="site-header__noscript-nav" aria-label="Primary">
      <a href="/about">About</a>
      <a href="/translation-commitments">Commitments</a>
      <a href="/glossary">Glossary</a>
      <a href="/found-in-translation-podcast">Podcast</a>
      <a href="/articles">Articles</a>
      <a href="/read">Read Now</a>
    </nav>
  </noscript>

  <!-- Shared tray — position: fixed, placed by JS beside whichever button opened it
       (the two header buttons, or Reading View's toolbar Aa) -->

  <div class="font-tray" id="fontTray" hidden role="dialog" aria-labelledby="fontTrayHeading">
    <div class="font-tray__header">
      <p class="font-tray__heading" id="fontTrayHeading">Display</p>
      <button type="button" class="font-tray__close" aria-label="Close display settings">
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
          <path d="M1 1l12 12M13 1L1 13" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
        </svg>
      </button>
    </div>
    {/* Each option is named by its font and rendered in it, so the list
        previews itself. "Default" has no single font name to give: it means
        the site's normal typography (Inter, Crimson Text, Fraunces). */}
    <fieldset class="font-tray__row">
      <legend class="font-tray__legend">Font</legend>
      <div class="font-tray__fonts">
        <label class="font-tray__font-option">
          <input type="radio" class="font-tray__font-input" name="lit-font" value="default" data-font-radio />
          <span class="font-tray__font-label font-tray__font-label--default">Default</span>
        </label>
        <label class="font-tray__font-option">
          <input type="radio" class="font-tray__font-input" name="lit-font" value="atkinson" data-font-radio />
          <span class="font-tray__font-label font-tray__font-label--atkinson">Atkinson Hyperlegible</span>
        </label>
        <label class="font-tray__font-option">
          <input type="radio" class="font-tray__font-input" name="lit-font" value="dyslexic" data-font-radio />
          <span class="font-tray__font-label font-tray__font-label--dyslexic">OpenDyslexic</span>
        </label>
      </div>
    </fieldset>

    <fieldset class="font-tray__row">
      <legend class="font-tray__legend">Theme</legend>
      <div class="font-tray__seg">
        <label class="font-tray__seg-option">
          <input type="radio" class="font-tray__seg-input" name="lit-theme" value="system" data-theme-radio />
          <span class="font-tray__seg-text">System</span>
        </label>
        <label class="font-tray__seg-option">
          <input type="radio" class="font-tray__seg-input" name="lit-theme" value="light" data-theme-radio />
          <span class="font-tray__seg-text">Light</span>
        </label>
        <label class="font-tray__seg-option">
          <input type="radio" class="font-tray__seg-input" name="lit-theme" value="dark" data-theme-radio />
          <span class="font-tray__seg-text">Dark</span>
        </label>
      </div>
    </fieldset>

    {/* Text size and line spacing apply to the reading surfaces (scripture in
        both views, footnotes, intros, article bodies) through --reading-scale
        and --reading-leading-extra in global.css; the rest of the site is
        left to browser zoom. */}
    <fieldset class="font-tray__row">
      <legend class="font-tray__legend">Text size</legend>
      <div class="font-tray__seg">
        {SIZE_OPTIONS.map((option) => (
          <label class="font-tray__seg-option">
            <input
              type="radio"
              class="font-tray__seg-input"
              name="lit-size"
              value={option.value}
              aria-label={option.label}
              data-size-radio
            />
            <span class="font-tray__seg-text" aria-hidden="true">{option.short}</span>
          </label>
        ))}
      </div>
    </fieldset>

    <fieldset class="font-tray__row">
      <legend class="font-tray__legend">Line spacing</legend>
      <div class="font-tray__seg">
        <label class="font-tray__seg-option">
          <input type="radio" class="font-tray__seg-input" name="lit-leading" value="normal" data-leading-radio />
          <span class="font-tray__seg-text">Normal</span>
        </label>
        <label class="font-tray__seg-option">
          <input type="radio" class="font-tray__seg-input" name="lit-leading" value="roomy" data-leading-radio />
          <span class="font-tray__seg-text">Roomy</span>
        </label>
      </div>
    </fieldset>

    {
      scriptureControls ? (
        <fieldset class="font-tray__row">
          <legend class="font-tray__legend">Show</legend>
          <div class="font-tray__checks">
            <label class="font-tray__check">
              <input type="checkbox" class="font-tray__check-input" data-vn-check />
              <span class="font-tray__check-label">
                {scriptureControls === "read" ? "Verse and chapter numbers" : "Verse numbers"}
              </span>
            </label>
            {scriptureControls === "study" ? (
              <label class="font-tray__check">
                <input type="checkbox" class="font-tray__check-input" data-fn-check />
                <span class="font-tray__check-label">Footnote letters</span>
              </label>
            ) : null}
            {scriptureControls === "study" ? (
              <label class="font-tray__check">
                <input type="checkbox" class="font-tray__check-input" data-terms-check />
                <span class="font-tray__check-label">Key terms</span>
              </label>
            ) : null}
          </div>
        </fieldset>
      ) : null
    }

  </div>

  <!-- Mobile overlay menu -->
  <div class="menu-overlay" id="mobileMenu" aria-hidden="true">
    <div
      class="menu-overlay__panel"
      role="dialog"
      aria-modal="true"
      aria-label="Site menu"
      tabindex="-1"
    >
      <nav class="menu-overlay__nav" aria-label="Primary (mobile)">
        {/* Below 360px the header has no room for its search icon, so search
            moves in here (global.css shows it only there). */}
        {headerSearch && (
          <a href="/search" class="menu-overlay__search" data-search-toggle>Search</a>
        )}
        <a href="/about">About</a>
        <a href="/translation-commitments">Commitments</a>
        <a href="/glossary">Glossary</a>
        <a href="/found-in-translation-podcast">Podcast</a>
        <a href="/articles">Articles</a>
        <a href="/support">Support</a>

        {/* Filled and shown by last-read.js for a returning reader */}
        <a href="/read/" class="menu-overlay__continue" data-continue-menu hidden>
          Continue: <span data-continue-label></span>
        </a>
        <a href="/read" class="menu-overlay__cta">Read Now</a>
      </nav>
    </div>
  </div>

  <script>
    import "../scripts/continue-reading.js";
    import "../scripts/header-search.js";
  </script>

  <script>
    // @ts-nocheck
    (() => {
      const toggle = document.querySelector(".site-header__menu-toggle");
      const overlay = document.getElementById("mobileMenu");
      const panel = overlay?.querySelector(".menu-overlay__panel");

      if (!toggle || !overlay || !panel) return;

      let lastActive = null;

      // Background regions to remove from the tab order and a11y tree while
      // the dialog is open. Deliberately excludes .site-header__inner (the
      // menu toggle that closes the dialog lives inside it, and there's no
      // in-panel close button) — the existing Tab-cycle handler below keeps
      // keyboard focus off the rest of the still-live header instead. inert
      // covers everything outside the header; the manual trap covers the
      // header itself. The AppsLaunchPopover <dialog> and the font tray
      // (hidden until opened) need no handling — both are already out of the
      // tab order/a11y tree when closed.
      const bgRegions = [
        document.querySelector(".skip-link"),
        document.getElementById("main-content"),
        document.querySelector(".site-footer"),
        document.querySelector(".footer-license-band"),
      ].filter(Boolean);

      const setOpenState = (open) => {
        overlay.classList.toggle("is-open", open);
        overlay.setAttribute("aria-hidden", open ? "false" : "true");

        toggle.setAttribute("aria-expanded", open ? "true" : "false");
        toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");

        for (const el of bgRegions) el.inert = open;

        // Defer scroll-lock to the next frame so the paint of the visual
        // open/close state isn't blocked by a full layout recalculation
        // (overflow:hidden on <body> triggers relayout of the entire page).
        requestAnimationFrame(() => {
          document.documentElement.classList.toggle("menu-open", open);
        });
      };

      const openMenu = () => {
        lastActive = document.activeElement;
        setOpenState(true);
        // Defer focus so the opening paint commits first; focus() forces
        // layout and would otherwise stack two sync layouts into this tick.
        requestAnimationFrame(() => panel.focus({ preventScroll: true }));
      };

      const closeMenu = () => {
        setOpenState(false);
        (lastActive?.focus ? lastActive : toggle).focus?.({
          preventScroll: true,
        });
      };

      const isOpen = () => overlay.classList.contains("is-open");

      toggle.addEventListener("click", (e) => {
        e.preventDefault();
        isOpen() ? closeMenu() : openMenu();
      });

      overlay.addEventListener("click", (e) => {
        if (e.target === overlay) closeMenu();
      });

      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && isOpen()) closeMenu();
      });

      overlay.querySelectorAll("a").forEach((a) => {
        a.addEventListener("click", () => {
          // Defer DOM mutations so the browser can paint the click feedback first.
          // For navigation links the page unloads before rAF fires — no visible effect.
          requestAnimationFrame(closeMenu);
        });
      });

      document.addEventListener("keydown", (e) => {
        if (e.key !== "Tab" || !isOpen()) return;

        const focusables = panel.querySelectorAll(
          'button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])',
        );
        if (!focusables.length) return;

        const first = focusables[0];
        const last = focusables[focusables.length - 1];

        if (e.shiftKey && document.activeElement === first) {
          e.preventDefault();
          last.focus();
        } else if (!e.shiftKey && document.activeElement === last) {
          e.preventDefault();
          first.focus();
        }
      });
    })();
  </script>

  <script>
    // @ts-nocheck
    // Deferred to idle: this initializer does a synchronous document.body.appendChild
    // (forces reflow) and runs in the post-load script burst that inflates INP input
    // delay. Idle keeps it off the load-time long task; the "Aa" button still works
    // (idle fires within tens of ms). Timeout guarantees init on a busy thread.
    const initFontTray = () => {
      const tray = document.getElementById('fontTray');
      const closeBtn = tray?.querySelector('.font-tray__close');
      const toggleBtns = Array.from(document.querySelectorAll('[data-font-toggle]'));

      if (!tray || !closeBtn || !toggleBtns.length) return;

      const fontRadios = Array.from(tray.querySelectorAll('[data-font-radio]'));
      const themeRadios = Array.from(tray.querySelectorAll('[data-theme-radio]'));
      const sizeRadios = Array.from(tray.querySelectorAll('[data-size-radio]'));
      const leadingRadios = Array.from(tray.querySelectorAll('[data-leading-radio]'));
      const vnCheck = tray.querySelector('[data-vn-check]');
      const fnCheck = tray.querySelector('[data-fn-check]');
      const termsCheck = tray.querySelector('[data-terms-check]');

      // Move the tray out of the header's stacking context (.site-header has
      // z-index:10) so its own z-index competes at the top level — otherwise
      // it renders behind page elements like the ScriptureMenu on study pages.
      // It's position:fixed and JS-positioned, so it doesn't need the header
      // as a positioning ancestor.
      document.body.appendChild(tray);

      let activeBtn = null;

      const currentFont = () => document.documentElement.getAttribute('data-font') || 'default';

      const syncFont = () => {
        const active = currentFont();
        for (const radio of fontRadios) radio.checked = radio.value === active;
      };

      const currentTheme = () => document.documentElement.getAttribute('data-theme') || 'system';

      const syncTheme = () => {
        const active = currentTheme();
        for (const radio of themeRadios) radio.checked = radio.value === active;
      };

      // Text size, line spacing and the two scripture settings. Each is an
      // attribute on <html> (absent = the default) mirrored to one storage
      // key, exactly like the font above; Layout.astro stamps them before
      // first paint. `legacy` is the Reading View key the setting replaced,
      // which the pre-paint script still falls back to, so it is deleted on
      // every change or it could resurrect an older choice.
      const SETTINGS = {
        size: { attr: 'data-size', key: 'lit-size', legacy: 'lit_rm_fontSize', fallback: 'md' },
        leading: { attr: 'data-leading', key: 'lit-leading', legacy: 'lit_rm_lineHeight', fallback: 'normal' },
        vn: { attr: 'data-vn', key: 'lit-verse-numbers', legacy: 'lit_rm_markers', fallback: 'on' },
        fn: { attr: 'data-fn', key: 'lit-fn-letters', legacy: null, fallback: 'on' },
        terms: { attr: 'data-terms', key: 'lit-terms', legacy: null, fallback: 'on' },
      };

      const currentSetting = (name) =>
        document.documentElement.getAttribute(SETTINGS[name].attr) || SETTINGS[name].fallback;

      const syncReading = () => {
        const size = currentSetting('size');
        for (const radio of sizeRadios) radio.checked = radio.value === size;
        const leading = currentSetting('leading');
        for (const radio of leadingRadios) radio.checked = radio.value === leading;
        if (vnCheck) vnCheck.checked = currentSetting('vn') === 'on';
        if (fnCheck) fnCheck.checked = currentSetting('fn') === 'on';
        if (termsCheck) termsCheck.checked = currentSetting('terms') === 'on';
      };

      // Changing text size, spacing or numbers reflows the page, which would
      // carry a reader's place away (in Reading View, a whole book's worth).
      // Pin the line of text at the reading line (30% down, just inside the
      // text column) and scroll it back to where it was. A paragraph's top
      // is not enough: a long paragraph grows below its top, so the line
      // being read still drifts. The tray is taken out of hit-testing while
      // measuring, since it can sit over the text on a phone, and the one
      // corrective scroll is let through without closing it.
      let holdingPlace = false;
      // In order of preference (a selector list would return whichever comes
      // first in the document, which is always <main>).
      const READING_SURFACES = ['.chapter-paragraphs', '.intro', '.rm-text', '.article__body', 'main'];
      const lineAt = () => {
        const surface = READING_SURFACES.map((s) => document.querySelector(s)).find(Boolean);
        if (!surface) return null;
        const x = surface.getBoundingClientRect().left + 24;
        const y = window.innerHeight * 0.3;
        tray.style.pointerEvents = 'none';
        let node = null;
        let offset = 0;
        try {
          if (document.caretPositionFromPoint) {
            const pos = document.caretPositionFromPoint(x, y);
            if (pos) ({ offsetNode: node, offset } = pos);
          } else if (document.caretRangeFromPoint) {
            const range = document.caretRangeFromPoint(x, y);
            if (range) ({ startContainer: node, startOffset: offset } = range);
          }
        } finally {
          tray.style.pointerEvents = '';
        }
        if (node?.nodeType !== Node.TEXT_NODE || !node.length) return null;
        const range = document.createRange();
        const start = Math.min(offset, node.length - 1);
        range.setStart(node, start);
        range.setEnd(node, start + 1);
        return range;
      };
      const keepReadingPlace = (change) => {
        const line = lineAt();
        const before = line?.getClientRects()[0]?.top;
        change();
        const after = line?.getClientRects()[0]?.top;
        if (before === undefined || after === undefined) return;
        const delta = after - before;
        if (Math.abs(delta) < 1) return;
        holdingPlace = true;
        window.scrollBy({ top: delta, behavior: 'instant' });
        requestAnimationFrame(() => requestAnimationFrame(() => { holdingPlace = false; }));
      };

      const applySetting = (name, value) => {
        const { attr, key, legacy, fallback } = SETTINGS[name];
        const root = document.documentElement;
        keepReadingPlace(() => {
          if (value === fallback) root.removeAttribute(attr);
          else root.setAttribute(attr, value);
        });
        try {
          value === fallback ? localStorage.removeItem(key) : localStorage.setItem(key, value);
          if (legacy) localStorage.removeItem(legacy);
        } catch (_) {}
      };

      // Below the button, or above it when there isn't room below (Reading
      // View's Aa sits in a bottom sheet on phones and tablets). Aligned to
      // the button's right edge, or its left when that would run off the
      // left of the screen (Reading View's Aa is at the toolbar's left end).
      const positionTray = (btn) => {
        const rect = btn.getBoundingClientRect();
        const margin = 8;
        tray.style.maxHeight = 'none';
        const width = tray.offsetWidth;
        const height = tray.offsetHeight;
        const below = window.innerHeight - rect.bottom - margin * 2;
        const above = rect.top - margin * 2;
        const openAbove = height > below && above > below;
        const room = openAbove ? above : below;
        tray.style.maxHeight = `${Math.max(160, room)}px`;
        tray.style.top = openAbove
          ? `${Math.max(margin, rect.top - margin - Math.min(height, room))}px`
          : `${rect.bottom + margin}px`;
        let left = rect.right - width;
        if (left < margin) left = Math.min(rect.left, window.innerWidth - width - margin);
        tray.style.left = `${Math.max(margin, left)}px`;
        tray.style.right = 'auto';
      };

      const closeTray = (returnFocus = true) => {
        tray.hidden = true;
        for (const btn of toggleBtns) btn.setAttribute('aria-expanded', 'false');
        if (returnFocus && activeBtn) activeBtn.focus({ preventScroll: true });
        activeBtn = null;
      };

      const openTray = (btn) => {
        activeBtn = btn;
        syncFont();
        syncTheme();
        syncReading();
        // Shown before it is placed, so it can be measured; both happen in
        // this task, before any paint.
        tray.hidden = false;
        positionTray(btn);
        btn.setAttribute('aria-expanded', 'true');
        requestAnimationFrame(() => closeBtn.focus({ preventScroll: true }));
      };

      for (const btn of toggleBtns) {
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          !tray.hidden && activeBtn === btn ? closeTray() : openTray(btn);
        });
      }

      closeBtn.addEventListener('click', () => closeTray());
      tray.addEventListener('click', (e) => e.stopPropagation());

      document.addEventListener('click', () => { if (!tray.hidden) closeTray(false); });

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !tray.hidden) closeTray();
      });

      window.addEventListener('resize', () => {
        if (!tray.hidden && activeBtn) positionTray(activeBtn);
      });

      // Header isn't sticky — close on scroll so the fixed tray can't detach from its button
      window.addEventListener('scroll', () => {
        if (!tray.hidden && !holdingPlace) closeTray(false);
      }, { passive: true });

      for (const radio of fontRadios) {
        radio.addEventListener('change', () => {
          if (!radio.checked) return;
          const v = radio.value; // 'default' | 'dyslexic' | 'atkinson'
          const root = document.documentElement;
          if (v === 'default') {
            root.removeAttribute('data-font');
          } else {
            root.setAttribute('data-font', v);
          }
          // The header title measures itself against the active font
          window.dispatchEvent(new Event('resize'));
          try {
            v === 'default'
              ? localStorage.removeItem('lit-font')
              : localStorage.setItem('lit-font', v);
            // Retire the pre-three-way key so its fallback can't later
            // resurrect OpenDyslexic over a newer choice
            localStorage.removeItem('dyslexic-font');
          } catch (_) {}
        });
      }

      for (const radio of themeRadios) {
        radio.addEventListener('change', () => {
          if (!radio.checked) return;
          const v = radio.value; // 'system' | 'light' | 'dark'
          const root = document.documentElement;
          if (v === 'light' || v === 'dark') {
            root.setAttribute('data-theme', v);
            root.style.colorScheme = v;
          } else {
            root.removeAttribute('data-theme');
            root.style.colorScheme = '';
          }
          try {
            v === 'system'
              ? localStorage.removeItem('lit-theme')
              : localStorage.setItem('lit-theme', v);
          } catch (_) {}
        });
      }

      for (const radio of sizeRadios) {
        radio.addEventListener('change', () => {
          if (radio.checked) applySetting('size', radio.value); // 'sm' | 'md' | 'lg' | 'xl'
        });
      }

      for (const radio of leadingRadios) {
        radio.addEventListener('change', () => {
          if (radio.checked) applySetting('leading', radio.value); // 'normal' | 'roomy'
        });
      }

      vnCheck?.addEventListener('change', () => applySetting('vn', vnCheck.checked ? 'on' : 'off'));
      fnCheck?.addEventListener('change', () => applySetting('fn', fnCheck.checked ? 'on' : 'off'));
      termsCheck?.addEventListener('change', () => applySetting('terms', termsCheck.checked ? 'on' : 'off'));

      syncFont();
      syncTheme();
      syncReading();
    };
    if ("requestIdleCallback" in window) {
      requestIdleCallback(initFontTray, { timeout: 2000 });
    } else {
      setTimeout(initFontTray, 1);
    }
  </script>

  <script>
    // Title truncation observer
    // Desktop (nav visible): allow ellipsis on "Translation" only.
    // When "Translation" is fully hidden, switch to "LIT Bible."
    // Mobile (nav hidden): no truncation — if full title overflows, jump to "LIT Bible."
    // Deferred to idle: the initial check() and the ResizeObserver's first callback do
    // forced synchronous layout (getComputedStyle / offsetWidth / scrollWidth), which
    // belongs off the load-time long task that inflates INP input delay. The header
    // min-height is reserved in critical CSS, so a late title swap can't shift layout.
    const initTitleFit = () => {
      const titleEl = document.querySelector<HTMLElement>(
        ".site-header__title",
      );
      const longEl = titleEl?.querySelector<HTMLElement>(".title-long");
      const truncEl = titleEl?.querySelector<HTMLElement>(".title-truncatable");
      const altEl = titleEl?.querySelector<HTMLElement>(".title-alt");

      if (!titleEl || !longEl || !truncEl || !altEl) return;

      const check = () => {
        // OpenDyslexic is wider — always use the short title to avoid overflow.
        // Atkinson's metrics are near Inter's, so it measures normally.
        if (document.documentElement.getAttribute("data-font") === "dyslexic") {
          longEl.style.display = "none";
          altEl.style.display = "inline";
          return;
        }

        // Reset to long title so we can measure
        longEl.style.display = "flex";
        altEl.style.display = "none";

        const nav = document.querySelector<HTMLElement>(".site-nav");
        const navVisible = nav && getComputedStyle(nav).display !== "none";

        if (navVisible) {
          // Desktop: never let "Translation" trail off in an ellipsis. Swap
          // to the short title as soon as the word can't show in full, not
          // once it is fully clipped, which left "The Liberation & Inclusion
          // Transla…" on a 1366px laptop.
          if (truncEl.scrollWidth > truncEl.clientWidth + 1) {
            longEl.style.display = "none";
            altEl.style.display = "inline";
          }
        } else {
          // Mobile: no truncation allowed.
          // If the full title overflows the container, swap to alt.
          const titleWidth = titleEl.scrollWidth;
          const availWidth = titleEl.clientWidth;
          if (titleWidth > availWidth + 2) {
            longEl.style.display = "none";
            altEl.style.display = "inline";
          }
        }
      };

      // Use ResizeObserver on the header row — its width always tracks the viewport,
      // unlike titleEl which stays the same size when showing short "LIT Bible" text.
      const headerInner = document.querySelector<HTMLElement>(
        ".site-header__inner",
      );
      if (!headerInner) return;

      // check() is a forced synchronous layout (it writes display, then reads
      // offsetWidth/scrollWidth/getComputedStyle), so it must not run on every
      // resize event: on mobile, showing and hiding the address bar fires resize
      // repeatedly throughout a scroll, and each one would relayout the whole
      // document. The answer can only change when the header's width changes or
      // when the reader's font does, so re-measure only then. data-font is in
      // the guard because the Display tray announces a font change by
      // broadcasting a synthetic resize, which leaves the width untouched.
      let lastWidth = -1;
      let lastFont = "";
      const checkIfChanged = () => {
        const width = headerInner.clientWidth;
        const font = document.documentElement.getAttribute("data-font") ?? "";
        if (width === lastWidth && font === lastFont) return;
        lastWidth = width;
        lastFont = font;
        check();
      };

      const ro = new ResizeObserver(() => {
        requestAnimationFrame(checkIfChanged);
      });
      ro.observe(headerInner);

      // Also recheck on window resize as a fallback
      window.addEventListener("resize", () => requestAnimationFrame(checkIfChanged), {
        passive: true,
      });

      // Initial check (also seeds the guard, so the ResizeObserver's own first
      // callback doesn't immediately measure the same thing again)
      checkIfChanged();

      // The webfont swap changes the title's width without changing the
      // header's, so the guard above would never re-measure after it.
      document.fonts?.ready.then(() => {
        lastWidth = -1;
        checkIfChanged();
      });
    };
    if ("requestIdleCallback" in window) {
      requestIdleCallback(initTitleFit, { timeout: 2000 });
    } else {
      setTimeout(initTitleFit, 1);
    }
  </script>

</header>
