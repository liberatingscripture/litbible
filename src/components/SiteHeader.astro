---
import SearchBar from "./SearchBar.astro";
import Icon from "./Icon.astro";
import MenuSheet from "./MenuSheet.astro";
import { PLACES, STUDY_HREF, normalizePath, placeOf } from "../lib/places.mjs";
import { NEWS, WHATS_NEW_HREF } from "../lib/news.mjs";

// The header (SITE-FEATHERBOA.md, "Four places: the header"): "LIT Bible"
// always, then the four places, Read, Study, Learn, and About, with the one
// the page is in underlined in the mark's green, and at the right end the
// magnifier, Aa, and the account. The places and their rows are
// src/lib/places.mjs, which the line under the header (PlaceLine.astro) and
// the footer read too.
//
// - Read opens the passage picker's panel (passage-picker.js; FP-15), and
//   is a link to /read, the picker at full size, without JavaScript. Learn,
//   Study, and About are <details> menus, so they open without JavaScript;
//   header-menus.js adds the keys, one open at a time, and closing on a
//   press elsewhere.
// - Study shows only on a computer with the Study preview on (html[data-desk],
//   stamped before paint, at 1100px and up; header.css), so nothing moves.
// - The full header holds from 700px (900px in OpenDyslexic). Below that
//   the row is the brand, the magnifier, Aa, and "Menu," which opens the
//   menu sheet (MenuSheet.astro, drawn after the header) from the window's
//   foot, as it does in Study's own header at every width.
// - On a phone's reading page (a chapter or an introduction, under 700px)
//   the row is the phone's top bar (SITE-FEATHERBOA.md, "The phone"; PH-01):
//   the emblem, named "Home," the chapter's name as the picker, and Aa.
//   "LIT Bible" leaves it, and "Menu" is the bar's at the thumb
//   (PhoneBar.astro); phone-bars.js opens the search field in the row's
//   place and hides it with the bar on a scroll down.
// - News marks (src/lib/news.mjs) are drawn hidden, only for the entries the
//   list holds; header-menus.js shows the ones a reader hasn't seen, on the
//   places here, in the menu sheet, and as a dot on "Menu."
//
// search: "strip" (the magnifier opens a search strip under the header),
// "page" (the page has its own search box, which the magnifier takes the
// reader to), or "none" (the Read page, whose search is its place line's or
// its toolbar's, and Study's own header). Without JavaScript the magnifier
// is a link to /search.
// deskTitle: Study's own header (/desk, BVJ 2026-10-21), at every width: the
// emblem and "LIT Bible" as the home link, the page's title centered, and
// then the menu button. desk-page.js turns the title into a menu and moves
// Aa into it (E15), so Aa is in the markup but leaves the bar once Study is
// up. No places and no search.
// deskHref: where Study's "Scripture" goes. A chapter or an introduction
// passes its place line's "Study John 3" address (?place=), so the two
// never disagree.
// scriptureControls: "study" on a chapter page (verse numbers and footnote
// letters), "read" in Read View (numbers only: it prints no footnote
// letters, and its numbers setting hides the chapter headings too).
// picker: the chapter's name on a chapter or an introduction ("John 3,"
// "John · Intro"), which makes the row the phone's top bar under 700px.
// It opens the passage picker's sheet at the chapter's grid
// (passage-picker.js), and is a link to /read without JavaScript.
const { class: className = "", scriptureControls, search = "strip", deskTitle, picker, deskHref = STUDY_HREF } = Astro.props;

type Place = (typeof PLACES)[number];
type Row = Place["rows"][number];

const path = normalizePath(Astro.url.pathname);
const where = placeOf(path);
const hrefOf = (row: Row) => (row.key === "scripture" ? deskHref : row.href);
// aria-current: "page" on the link to this page, "true" on the place it is
// in and on a row it is inside (an article, under Articles).
const currentOf = (row: Row) =>
  where.row === row.key && !row.also && PLACES.find((p) => p.key === where.place)?.rows.includes(row)
    ? where.current
    : undefined;
const placeCurrent = (place: Place) =>
  where.place !== place.key ? undefined : !place.menu && normalizePath(place.href) === path ? "page" : "true";

// The news the list holds, by place and by row: the marks are drawn hidden
// for these alone, so an empty list draws nothing.
const newsPlaces = new Set(NEWS.map((entry) => entry.place));
const newsRows = new Set(NEWS.map((entry) => `${entry.place}:${entry.row}`));

// Text size steps. The visible letters are the usual abbreviations; the
// radios carry the words for screen readers.
const SIZE_OPTIONS = [
  { value: "sm", short: "S", label: "Small" },
  { value: "md", short: "M", label: "Medium" },
  { value: "lg", short: "L", label: "Large" },
  { value: "xl", short: "XL", label: "Extra large" },
];
---

<header class={`site-header ${deskTitle ? "site-header--desk" : ""} ${picker ? "site-header--reading" : ""} ${className}`.replace(/\s+/g, " ").trim()}>
  <div class="site-header__inner">
    {/* "LIT Bible" always (HD-10); the full name is in every page's tab title (HD-11).
        On a phone's reading page the name leaves the row and the emblem alone
        is the way home, named "Home" (PH-01). */}
    <a href="/" class="site-header__brand">
      <img
        src="/images/lit-logo-2026-ring.svg"
        alt=""
        class="site-header__logo"
        width="48"
        height="48"
        loading="eager"
        decoding="async"
      />
      <span class="site-header__title">LIT Bible<span class="sr-only">, the Liberation and Inclusion Translation, home</span></span>
      {picker && <span class="sr-only site-header__home">Home</span>}
    </a>

    {/* The chapter's name as the picker (PH-01), and the search field's place
        when the bar's Search opens it there (PH-09; phone-bars.js moves the
        page's SearchBar in and out). Both only on a phone's reading page. */}
    {picker && (
      <a class="kit-btn kit-btn--plain site-header__picker" href="/read/" data-picker-open="chapters">
        <span class="sr-only">Choose passage. Current:&nbsp;</span>
        <span class="site-header__picker-label">{picker}</span>
        <Icon name="down" />
      </a>
    )}
    {picker && (
      <div class="site-header__find" id="phoneFind" data-phone-find hidden>
        <button type="button" class="kit-icon site-header__find-close" aria-label="Close search" data-phone-find-close>
          <Icon name="close" />
        </button>
      </div>
    )}

    {deskTitle && <h1 class="site-header__page-title">{deskTitle}</h1>}

    {!deskTitle && (
      <nav class="site-nav" aria-label="Primary">
        <ul class="site-nav__list">
          {PLACES.map((place) =>
            !place.menu ? (
              <li class={`site-nav__item site-nav__item--${place.key}`}>
                <a class="kit-tab site-nav__place" href={place.href} aria-current={placeCurrent(place)} data-picker-open={place.key === "read" ? "books" : undefined}>{place.label}</a>
              </li>
            ) : (
              <li class={`site-nav__item site-nav__item--${place.key}`}>
                <details class="site-nav__group" name="site-nav" data-nav-group={place.key}>
                  <summary class="kit-tab site-nav__place" aria-current={placeCurrent(place)}>
                    {place.label}<Icon name="down" />
                    {newsPlaces.has(place.key) && (
                      <span class="site-nav__dot" data-news-dot={place.key} hidden><span class="sr-only">, new</span></span>
                    )}
                  </summary>
                  <ul class="site-nav__menu">
                    {place.rows.map((row) => (
                      <>
                        {row.separate && <li class="site-nav__menu-sep" role="separator"></li>}
                        <li>
                          <a class="kit-row" href={hrefOf(row)} aria-current={currentOf(row)}>
                            {row.label}
                            {newsRows.has(`${place.key}:${row.key}`) && (
                              <span class="site-nav__new" data-news-row={`${place.key}:${row.key}`} hidden><span class="sr-only">, </span>New</span>
                            )}
                          </a>
                        </li>
                      </>
                    ))}
                    {newsPlaces.has(place.key) && (
                      <>
                        <li class="site-nav__menu-sep" role="separator" data-news-more={place.key} hidden></li>
                        <li data-news-more={place.key} hidden>
                          <a class="kit-row" href={WHATS_NEW_HREF}>See what’s new →</a>
                        </li>
                      </>
                    )}
                  </ul>
                </details>
              </li>
            ),
          )}
        </ul>
      </nav>
    )}

    <div class="site-header__actions">
      {deskTitle && <div class="site-header__desk-tools" data-desk-header-tools></div>}
      {search === "strip" && (
        <a href="/search" class="kit-icon site-header__search" data-search-toggle aria-label="Search">
          <Icon name="search" />
        </a>
      )}
      {search === "page" && (
        <a href="/search" class="kit-icon site-header__search" data-search-here aria-label="Search">
          <Icon name="search" />
        </a>
      )}
      <button
        class="kit-btn kit-btn--plain site-header__font-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="fontTray"
        data-font-toggle
      >
        <span aria-hidden="true">Aa</span>
        <span class="sr-only">Display</span>
      </button>
      {/* The account (step 4h; BVJ, 2026-11-24; AC-23): “Sign in,” and once this browser's
          notebook is linked to an account, “Account” with a menu. In the markup for everyone
          and shown only with data-desk and data-account (header.css), both stamped before
          paint, so the row never moves. It is drawn hidden until desk/account/header-entry.js
          has read which of the two this browser gets. */}
      <span class="site-header__account" data-account-entry>
        <a class="kit-btn kit-btn--plain site-header__account-link" href="/account/" data-account-signin>Sign in</a>
        <button
          type="button"
          class="kit-btn kit-btn--plain site-header__account-btn"
          aria-expanded="false"
          aria-controls="accountMenu"
          data-account-button
          hidden
        >Account<Icon name="down" /></button>
        <div class="site-nav__menu site-header__account-menu" id="accountMenu" data-account-menu hidden>
          <div data-desk-sync-slot hidden></div>
          <a class="kit-row" href="/account/">Account and devices</a>
          <a class="kit-row" href="/account/#sign-out">Sign out</a>
        </div>
      </span>
      {/* Opens the menu sheet (header-menus.js). Its icon isn't one that
          stands alone, so it keeps its word; under 400px (430px in
          OpenDyslexic) the word alone, for the room "LIT Bible" needs
          (header.css). */}
      <button
        class="kit-btn kit-btn--plain site-header__menu-toggle"
        type="button"
        aria-controls="menuSheet"
        aria-expanded="false"
        aria-haspopup="dialog"
        data-menu-toggle
      >
        <Icon name="menu" />Menu
        {newsPlaces.size > 0 && (
          <span class="site-nav__dot" data-news-menu hidden><span class="sr-only">, new</span></span>
        )}
      </button>
    </div>
  </div>

  {search === "strip" && (
    <div class="site-header__search-strip" id="headerSearch" hidden>
      <div class="site-header__search-inner">
        <SearchBar placeholder="Search the LIT Bible" />
        <button type="button" class="kit-icon site-header__search-close" aria-label="Close search">
          <Icon name="close" />
        </button>
      </div>
    </div>
  )}

  {/* Without JavaScript: the places and their menus work as they are (links
       and <details>), but Aa and the menu button do nothing, so they go, and
       below the full header's width a row of two links stands in: Read, and
       Menu, which goes to the footer's links, as the phone's bar does
       ("The phone," "Without JavaScript"). A phone's reading page needs
       neither: its picker goes to /read and its bar has Menu. A <style
       is:inline> with global selectors, as the footer's noscript note is. */}
  <noscript>
    <style is:inline>
      .site-header__menu-toggle,
      .site-header__font-toggle { display: none !important; }
      .site-header__noscript-nav {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: var(--space-1);
        padding: var(--space-1) var(--space-3) var(--space-2);
        border-top: 1px solid var(--color-hairline);
      }
      @media (min-width: 700px) {
        .site-header__noscript-nav { display: none; }
      }
      /* Study's own header has no places at any width. */
      .site-header--desk .site-header__noscript-nav { display: flex; }
      .site-header--reading .site-header__noscript-nav { display: none; }
    </style>
    <nav class="site-header__noscript-nav" aria-label="Primary">
      <a class="kit-btn kit-btn--plain" href="/read">Read</a>
      <a class="kit-btn kit-btn--plain" href="#footer-nav">Menu</a>
    </nav>
  </noscript>

  {/* Shared tray — position: fixed, placed by JS beside whichever button opened it
       (the header's Aa, or Read View's toolbar Aa) */}

  <div class="font-tray" id="fontTray" hidden role="dialog" aria-labelledby="fontTrayHeading">
    <div class="font-tray__header">
      <p class="font-tray__heading" id="fontTrayHeading">Display</p>
      <button type="button" class="font-tray__close" aria-label="Close display settings">
        <Icon name="close" />
      </button>
    </div>
    {/* Each option is named by its font and rendered in it, so the list
        previews itself. "Default" has no single font name to give: it means
        the site's normal typography (Source Sans 3, Fraunces, and Atkinson
        Hyperlegible Next for controls). */}
    <fieldset class="font-tray__row">
      <legend class="font-tray__legend">Font</legend>
      <div class="font-tray__fonts">
        <label class="font-tray__font-option">
          <input type="radio" class="font-tray__font-input" name="lit-font" value="default" data-font-radio />
          <span class="font-tray__font-label font-tray__font-label--default">Default</span>
        </label>
        <label class="font-tray__font-option">
          <input type="radio" class="font-tray__font-input" name="lit-font" value="atkinson" data-font-radio />
          <span class="font-tray__font-label font-tray__font-label--atkinson">Atkinson Hyperlegible</span>
        </label>
        <label class="font-tray__font-option">
          <input type="radio" class="font-tray__font-input" name="lit-font" value="dyslexic" data-font-radio />
          <span class="font-tray__font-label font-tray__font-label--dyslexic">OpenDyslexic</span>
        </label>
      </div>
    </fieldset>

    <fieldset class="font-tray__row">
      <legend class="font-tray__legend">Theme</legend>
      <div class="font-tray__seg">
        <label class="font-tray__seg-option">
          <input type="radio" class="font-tray__seg-input" name="lit-theme" value="system" data-theme-radio />
          <span class="font-tray__seg-text">System</span>
        </label>
        <label class="font-tray__seg-option">
          <input type="radio" class="font-tray__seg-input" name="lit-theme" value="light" data-theme-radio />
          <span class="font-tray__seg-text">Light</span>
        </label>
        <label class="font-tray__seg-option">
          <input type="radio" class="font-tray__seg-input" name="lit-theme" value="dark" data-theme-radio />
          <span class="font-tray__seg-text">Dark</span>
        </label>
      </div>
    </fieldset>

    {/* Text size and line spacing reach every page of running text through
        --reading-scale and --reading-leading-extra in global.css, page titles
        through --heading-scale, and a few controls through the gentler
        --control-scale. What follows which, and what is left to browser
        zoom, is in src/styles/CLAUDE.md (the Display tray's rule 1). */}
    <fieldset class="font-tray__row">
      <legend class="font-tray__legend">Text size</legend>
      <div class="font-tray__seg">
        {SIZE_OPTIONS.map((option) => (
          <label class="font-tray__seg-option">
            <input
              type="radio"
              class="font-tray__seg-input"
              name="lit-size"
              value={option.value}
              aria-label={option.label}
              data-size-radio
            />
            <span class="font-tray__seg-text" aria-hidden="true">{option.short}</span>
          </label>
        ))}
      </div>
    </fieldset>

    <fieldset class="font-tray__row">
      <legend class="font-tray__legend">Line spacing</legend>
      <div class="font-tray__seg">
        <label class="font-tray__seg-option">
          <input type="radio" class="font-tray__seg-input" name="lit-leading" value="normal" data-leading-radio />
          <span class="font-tray__seg-text">Normal</span>
        </label>
        <label class="font-tray__seg-option">
          <input type="radio" class="font-tray__seg-input" name="lit-leading" value="roomy" data-leading-radio />
          <span class="font-tray__seg-text">Roomy</span>
        </label>
      </div>
    </fieldset>

    {
      scriptureControls ? (
        <fieldset class="font-tray__row">
          <legend class="font-tray__legend">Show</legend>
          <div class="font-tray__checks">
            <label class="font-tray__check">
              <input type="checkbox" class="font-tray__check-input" data-vn-check data-vn-view={scriptureControls} />
              <span class="font-tray__check-label">
                {scriptureControls === "read" ? "Verse and chapter numbers" : "Verse numbers"}
              </span>
            </label>
            {scriptureControls === "study" ? (
              <label class="font-tray__check">
                <input type="checkbox" class="font-tray__check-input" data-fn-check />
                <span class="font-tray__check-label">Footnote letters</span>
              </label>
            ) : null}
            {scriptureControls === "study" ? (
              <label class="font-tray__check">
                <input type="checkbox" class="font-tray__check-input" data-terms-check />
                <span class="font-tray__check-label">Key terms</span>
              </label>
            ) : null}
          </div>
        </fieldset>
      ) : null
    }

    {/* Keyboard shortcuts (audit U4), handled by keyboard-shortcuts.js. The
        switch is required for single-key shortcuts (WCAG 2.1.4). Hidden on a
        small touch screen, where there is no keyboard to speak of. */}
    <fieldset class="font-tray__row font-tray__row--keys">
      <legend class="font-tray__legend">Keyboard</legend>
      <div class="font-tray__checks">
        <label class="font-tray__check">
          <input type="checkbox" class="font-tray__check-input" data-keys-check aria-describedby="fontTrayKeys" />
          <span class="font-tray__check-label">Keyboard shortcuts</span>
        </label>
      </div>
      <ul class="font-tray__keys" id="fontTrayKeys">
        <li><kbd>/</kbd> Search</li>
        <li><kbd>g</kbd> Choose passage</li>
        <li><kbd>←</kbd> <kbd>→</kbd> Previous or next chapter</li>
      </ul>
    </fieldset>
  </div>

  <script>
    import "../scripts/header-search.js";
    import "../scripts/keyboard-shortcuts.js";
    import "../scripts/desk-gate.js";
    import "../scripts/header-menus.js";
    import "../scripts/print-radios.js";
  </script>

  <script>
    // @ts-nocheck
    import { isHoldingPlace, keepReadingPlace } from "../scripts/keep-reading-place.js";
    // Deferred to idle: this initializer does a synchronous document.body.appendChild
    // (forces reflow) and runs in the post-load script burst that inflates INP input
    // delay. Idle keeps it off the load-time long task; the "Aa" button still works
    // (idle fires within tens of ms). Timeout guarantees init on a busy thread.
    const initFontTray = () => {
      const tray = document.getElementById('fontTray');
      const closeBtn = tray?.querySelector('.font-tray__close');
      const toggleBtns = Array.from(document.querySelectorAll('[data-font-toggle]'));

      if (!tray || !closeBtn || !toggleBtns.length) return;

      const fontRadios = Array.from(tray.querySelectorAll('[data-font-radio]'));
      const themeRadios = Array.from(tray.querySelectorAll('[data-theme-radio]'));
      const sizeRadios = Array.from(tray.querySelectorAll('[data-size-radio]'));
      const leadingRadios = Array.from(tray.querySelectorAll('[data-leading-radio]'));
      const vnCheck = tray.querySelector('[data-vn-check]');
      const fnCheck = tray.querySelector('[data-fn-check]');
      const termsCheck = tray.querySelector('[data-terms-check]');
      const keysCheck = tray.querySelector('[data-keys-check]');

      // Move the tray out of the header's stacking context (.site-header has
      // z-index:10) so its own z-index competes at the top level — otherwise
      // it renders behind page elements like the ScriptureMenu on study pages.
      // It's position:fixed and JS-positioned, so it doesn't need the header
      // as a positioning ancestor.
      document.body.appendChild(tray);

      let activeBtn = null;

      const currentFont = () => document.documentElement.getAttribute('data-font') || 'default';

      const syncFont = () => {
        const active = currentFont();
        for (const radio of fontRadios) radio.checked = radio.value === active;
      };

      const currentTheme = () => document.documentElement.getAttribute('data-theme') || 'system';

      const syncTheme = () => {
        const active = currentTheme();
        for (const radio of themeRadios) radio.checked = radio.value === active;
      };

      // Text size, line spacing and the two scripture settings. Each is an
      // attribute on <html> (absent = the default) mirrored to one storage
      // key, exactly like the font above; Layout.astro stamps them before
      // first paint. `legacy` is the Read View key the setting replaced,
      // which the pre-paint script still falls back to, so it is deleted on
      // every change or it could resurrect an older choice.
      // Verse numbers are one setting per view. In Chapter View a number is
      // the verse menu's button, so a shared switch meant that hiding numbers
      // in Read View took the menu away on a touch screen. Read View's
      // setting follows Chapter View's until the reader sets it, so it is
      // stored as set (`keep`), 'on' included: removing it would hand it back
      // to Chapter View's. Its legacy key was Read View's own before the tray.
      const readView = vnCheck?.getAttribute('data-vn-view') === 'read';
      const SETTINGS = {
        size: { attr: 'data-size', key: 'lit-size', legacy: 'lit_rm_fontSize', fallback: 'md' },
        leading: { attr: 'data-leading', key: 'lit-leading', legacy: 'lit_rm_lineHeight', fallback: 'normal' },
        vn: readView
          ? { attr: 'data-vn', key: 'lit-read-numbers', legacy: 'lit_rm_markers', fallback: 'on', keep: true }
          : { attr: 'data-vn', key: 'lit-verse-numbers', legacy: null, fallback: 'on' },
        fn: { attr: 'data-fn', key: 'lit-fn-letters', legacy: null, fallback: 'on' },
        terms: { attr: 'data-terms', key: 'lit-terms', legacy: null, fallback: 'on' },
      };

      const currentSetting = (name) =>
        document.documentElement.getAttribute(SETTINGS[name].attr) || SETTINGS[name].fallback;

      const syncReading = () => {
        const size = currentSetting('size');
        for (const radio of sizeRadios) radio.checked = radio.value === size;
        const leading = currentSetting('leading');
        for (const radio of leadingRadios) radio.checked = radio.value === leading;
        if (vnCheck) vnCheck.checked = currentSetting('vn') === 'on';
        if (fnCheck) fnCheck.checked = currentSetting('fn') === 'on';
        if (termsCheck) termsCheck.checked = currentSetting('terms') === 'on';
        // Keyboard shortcuts change nothing on the page, so they have no
        // attribute on <html>: keyboard-shortcuts.js reads the key itself.
        if (keysCheck) {
          let on = true;
          try { on = localStorage.getItem('lit-shortcuts') !== 'off'; } catch (_) {}
          keysCheck.checked = on;
        }
      };

      // Changing text size, spacing or numbers reflows the page, which would
      // carry a reader's place away; keepReadingPlace pins it (see
      // keep-reading-place.js). The tray is taken out of hit-testing while it
      // measures, since it can sit over the text on a phone, and the one
      // corrective scroll is let through without closing it (isHoldingPlace).
      const applySetting = (name, value) => {
        const { attr, key, legacy, fallback, keep } = SETTINGS[name];
        const root = document.documentElement;
        keepReadingPlace(() => {
          if (value === fallback) root.removeAttribute(attr);
          else root.setAttribute(attr, value);
        }, { overlay: tray });
        try {
          value === fallback && !keep ? localStorage.removeItem(key) : localStorage.setItem(key, value);
          if (legacy) localStorage.removeItem(legacy);
        } catch (_) {}
      };

      // Below the button, or above it when there isn't room below (Read
      // View's Aa sits in a bottom sheet on phones and tablets). Aligned to
      // the button's right edge, or its left when that would run off the
      // left of the screen (Read View's Aa is at the toolbar's left end).
      // A toggle can name another element to hang the tray from
      // (data-tray-anchor="<selector>"): the Study Desk moves its Aa into the
      // page title's menu, which closes as the tray opens, so the tray hangs
      // from the title and focus returns to it.
      const anchorOf = (btn) => (btn.dataset.trayAnchor && document.querySelector(btn.dataset.trayAnchor)) || btn;

      const positionTray = (btn) => {
        const rect = anchorOf(btn).getBoundingClientRect();
        const margin = 8;
        tray.style.maxHeight = 'none';
        const width = tray.offsetWidth;
        const height = tray.offsetHeight;
        const below = window.innerHeight - rect.bottom - margin * 2;
        const above = rect.top - margin * 2;
        const openAbove = height > below && above > below;
        const room = openAbove ? above : below;
        tray.style.maxHeight = `${Math.max(160, room)}px`;
        tray.style.top = openAbove
          ? `${Math.max(margin, rect.top - margin - Math.min(height, room))}px`
          : `${rect.bottom + margin}px`;
        let left = rect.right - width;
        if (left < margin) left = Math.min(rect.left, window.innerWidth - width - margin);
        tray.style.left = `${Math.max(margin, left)}px`;
        tray.style.right = 'auto';
      };

      const closeTray = (returnFocus = true) => {
        tray.hidden = true;
        for (const btn of toggleBtns) btn.setAttribute('aria-expanded', 'false');
        if (returnFocus && activeBtn) anchorOf(activeBtn).focus({ preventScroll: true });
        activeBtn = null;
      };

      const openTray = (btn) => {
        activeBtn = btn;
        syncFont();
        syncTheme();
        syncReading();
        // Shown before it is placed, so it can be measured; both happen in
        // this task, before any paint.
        tray.hidden = false;
        positionTray(btn);
        btn.setAttribute('aria-expanded', 'true');
        requestAnimationFrame(() => closeBtn.focus({ preventScroll: true }));
      };

      for (const btn of toggleBtns) {
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          !tray.hidden && activeBtn === btn ? closeTray() : openTray(btn);
        });
      }

      closeBtn.addEventListener('click', () => closeTray());
      tray.addEventListener('click', (e) => e.stopPropagation());

      document.addEventListener('click', () => { if (!tray.hidden) closeTray(false); });

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !tray.hidden) closeTray();
      });

      window.addEventListener('resize', () => {
        if (!tray.hidden && activeBtn) positionTray(activeBtn);
      });

      // Header isn't sticky — close on scroll so the fixed tray can't detach from its button
      window.addEventListener('scroll', () => {
        if (!tray.hidden && !isHoldingPlace()) closeTray(false);
      }, { passive: true });

      for (const radio of fontRadios) {
        radio.addEventListener('change', () => {
          if (!radio.checked) return;
          const v = radio.value; // 'default' | 'dyslexic' | 'atkinson'
          const root = document.documentElement;
          if (v === 'default') {
            root.removeAttribute('data-font');
          } else {
            root.setAttribute('data-font', v);
          }
          // What was measured in the old face (the margin's notes, a floating
          // window) is measured again
          window.dispatchEvent(new Event('resize'));
          try {
            v === 'default'
              ? localStorage.removeItem('lit-font')
              : localStorage.setItem('lit-font', v);
            // Retire the pre-three-way key so its fallback can't later
            // resurrect OpenDyslexic over a newer choice
            localStorage.removeItem('dyslexic-font');
          } catch (_) {}
        });
      }

      for (const radio of themeRadios) {
        radio.addEventListener('change', () => {
          if (!radio.checked) return;
          const v = radio.value; // 'system' | 'light' | 'dark'
          const root = document.documentElement;
          if (v === 'light' || v === 'dark') {
            root.setAttribute('data-theme', v);
            root.style.colorScheme = v;
          } else {
            root.removeAttribute('data-theme');
            root.style.colorScheme = '';
          }
          try {
            v === 'system'
              ? localStorage.removeItem('lit-theme')
              : localStorage.setItem('lit-theme', v);
          } catch (_) {}
        });
      }

      for (const radio of sizeRadios) {
        radio.addEventListener('change', () => {
          if (radio.checked) applySetting('size', radio.value); // 'sm' | 'md' | 'lg' | 'xl'
        });
      }

      for (const radio of leadingRadios) {
        radio.addEventListener('change', () => {
          if (radio.checked) applySetting('leading', radio.value); // 'normal' | 'roomy'
        });
      }

      vnCheck?.addEventListener('change', () => applySetting('vn', vnCheck.checked ? 'on' : 'off'));
      fnCheck?.addEventListener('change', () => applySetting('fn', fnCheck.checked ? 'on' : 'off'));
      termsCheck?.addEventListener('change', () => applySetting('terms', termsCheck.checked ? 'on' : 'off'));
      keysCheck?.addEventListener('change', () => {
        try {
          keysCheck.checked
            ? localStorage.removeItem('lit-shortcuts')
            : localStorage.setItem('lit-shortcuts', 'off');
        } catch (_) {}
        document.dispatchEvent(new CustomEvent('lit:shortcuts-changed'));
      });

      syncFont();
      syncTheme();
      syncReading();
    };
    if ("requestIdleCallback" in window) {
      requestIdleCallback(initFontTray, { timeout: 2000 });
    } else {
      setTimeout(initFontTray, 1);
    }
  </script>

</header>

{/* The menu sheet (PH-11 to PH-15): every menu button opens it, the header's
    here and a phone's bar on a reading page. */}
<MenuSheet search={search} deskHref={deskHref} account={!deskTitle} />
