---
import PlatformIcon from './PlatformIcon.astro';
import { band, inline, type Section } from './render';

interface Props {
  section: Section<'hero'>;
}
const { section } = Astro.props;
const { back, front } = section.phones;
---

<section class:list={['hero', band(section.background)]}>
  <div class="hero__inner container">
    <div class="hero__copy">
      <h1 class="hero__title" set:html={inline(section.title)}></h1>
      <p class="hero__sub" set:html={inline(section.subtitle)}></p>
      <div class="hero__ctas">
        {section.buttons.map((b, i) => (
          <a href={b.href} class={i === 0 ? 'btn btn-primary' : 'btn btn-secondary'} target="_blank" rel="external noopener noreferrer"><PlatformIcon platform={b.platform} />{b.label}</a>
        ))}
      </div>
    </div>
    <div class="hero__image">
      <div class="hero__phones">
        <img
          src={back.src}
          alt={back.alt}
          class="hero__phone hero__phone--back"
          width={back.width}
          height={back.height}
          decoding="async"
        />
        <img
          src={front.src}
          alt={front.alt}
          class="hero__phone hero__phone--front"
          width={front.width}
          height={front.height}
          fetchpriority="high"
          decoding="async"
        />
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-top: var(--space-6);
    padding-bottom: var(--space-6);
  }
  @media (max-width: 640px) {
    .hero {
      padding-top: var(--space-5);
      padding-bottom: var(--space-5);
    }
  }
  .hero__inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-9);
    align-items: center;
  }
  @media (min-width: 900px) {
    .hero__inner {
      grid-template-columns: 1.2fr 1fr;
      gap: var(--space-8);
    }
  }
  .hero__title {
    font-size: var(--text-5xl);
    line-height: 1.05;
    letter-spacing: -0.03em;
    max-width: 16ch;
  }
  .hero__sub {
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    line-height: var(--leading-snug);
    color: var(--text-soft);
    max-width: 36ch;
    margin-top: var(--space-5);
  }
  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-7);
  }
  .hero__beta {
    font-size: var(--text-sm);
    color: var(--text-faint);
    margin-top: var(--space-4);
  }
  .hero__image {
    display: flex;
    justify-content: center;
  }
  @media (min-width: 900px) {
    .hero__image {
      justify-content: flex-end;
    }
  }
  /* Two phones, slightly overlapped: the back one behind, the front one in
     front. Front-facing platform parity at the very top of the page. */
  .hero__phones {
    display: flex;
    align-items: flex-end;
    justify-content: center;
    width: 100%;
    max-width: 420px;
  }
  .hero__phone {
    width: 56%;
    height: auto;
    display: block;
  }
  .hero__phone--back {
    z-index: 1;
  }
  .hero__phone--front {
    margin-left: -13%;
    z-index: 2;
  }
</style>
