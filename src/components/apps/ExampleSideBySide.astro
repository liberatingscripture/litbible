---
/**
 * Side-by-side translation comparison.
 * Used by both FirstTaste (one hero example) and MoreExamples (3 deeper).
 *
 * Accepts an example collection entry. Renders the reference at top,
 * then two columns: LIT (left) and the chosen traditional rendering (right).
 */

import type { CollectionEntry } from 'astro:content';

/** Minimal inline markdown: paragraphs and *italic* only.
 *  Avoids pulling in a full markdown lib for a use case this small. */
function lite(md: string): string {
  return md
    .replace(/\*([^*]+)\*/g, '<em>$1</em>')
    .replace(/\n\n+/g, '</p><p>')
    .replace(/^/, '<p>')
    .replace(/$/, '</p>');
}

interface Props {
  entry: CollectionEntry<'examples'>;
  variant?: 'hero' | 'deeper';
}

const { entry, variant = 'deeper' } = Astro.props;
const { reference, comparison, litText, traditionalText, note } = entry.data;
---

<article class={`example example--${variant}`} aria-labelledby={`ex-${entry.id}`}>
  <header class="example__head">
    <h3 id={`ex-${entry.id}`} class="example__reference">{reference}</h3>
    <span class="example__compare" aria-hidden="true">LIT  ·  {comparison}</span>
  </header>

  <div class="example__columns">
    <div class="example__col example__col--lit">
      <span class="example__label">LIT</span>
      <div class="example__text example__text--lit" set:html={lite(litText.trim())}></div>
    </div>
    <div class="example__col example__col--trad">
      <span class="example__label">{comparison}</span>
      <div class="example__text example__text--trad" set:html={lite(traditionalText.trim())}></div>
    </div>
  </div>

  {note && <p class="example__note">{note}</p>}
</article>

<style>
  .example {
    padding-block: var(--space-7);
    border-top: 1px solid var(--rule-soft);
  }
  .example:first-of-type {
    border-top: none;
    padding-top: 0;
  }
  .example__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-bottom: var(--space-5);
  }
  .example__reference {
    font-family: var(--font-serif);
    font-size: var(--text-2xl);
    font-weight: 500;
    letter-spacing: var(--tracking-tight);
    color: var(--text);
  }
  .example__compare {
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-caps);
    color: var(--text-faint);
    font-weight: 500;
  }
  .example__columns {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }
  @media (min-width: 720px) {
    .example__columns {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-7);
    }
  }
  .example__col {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .example__label {
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-caps);
    font-weight: 600;
    color: var(--text-faint);
  }
  .example__col--lit .example__label {
    color: var(--accent);
  }
  .example__text {
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    line-height: var(--leading-loose);
    color: var(--text);
  }
  .example__text :global(p + p) {
    margin-top: var(--space-3);
  }
  .example__text :global(em) {
    font-style: italic;
  }
  .example__text--trad {
    color: var(--text-soft);
  }
  .example__note {
    margin-top: var(--space-5);
    font-size: var(--text-sm);
    color: var(--text-faint);
    font-style: italic;
  }
</style>
