---
/**
 * §5 — Closing CTA. The end-of-scroll "get the app" band: after the value
 * props, invite the download. Echoes the hero's two store buttons.
 *
 * Both apps are live: iOS on the App Store, Android on Google Play.
 */
import PlatformIcon from './PlatformIcon.astro';

const iosUrl = 'https://apps.apple.com/app/id6772577879';
const androidUrl =
  'https://play.google.com/store/apps/details?id=com.litbible.app&pcampaignid=web_share';
---

<section id="join" class="get-app">
  <div class="container get-app__inner">
    <h2 class="get-app__title">Take it with you.</h2>
    <p class="get-app__lede">
      The complete Liberation &amp; Inclusion Translation, free on iPhone and
      Android.
    </p>
    <div class="get-app__ctas">
      <a href={iosUrl} class="btn btn-primary" rel="external">
        <PlatformIcon platform="ios" />Download on the App Store
      </a>
      <a href={androidUrl} class="btn btn-secondary" rel="external">
        <PlatformIcon platform="android" />Get it on Google Play
      </a>
    </div>
  </div>
</section>

<style>
  .get-app {
    padding-block: var(--space-8);
  }
  @media (max-width: 640px) {
    .get-app {
      padding-block: var(--space-6);
    }
  }
  .get-app__inner {
    max-width: var(--measure-prose);
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .get-app__title {
    font-family: var(--font-serif);
    font-size: var(--text-4xl);
    letter-spacing: -0.025em;
    line-height: var(--leading-tight);
  }
  .get-app__lede {
    margin-top: var(--space-4);
    max-width: 44ch;
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    line-height: var(--leading-snug);
    color: var(--text-soft);
  }
  .get-app__ctas {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }
</style>
