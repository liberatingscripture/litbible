---
/**
 * §5 — Closing CTA. The end-of-scroll "get the app" band: after the value
 * props, invite the download. Echoes the hero's two store buttons.
 *
 * Both apps are live: iOS on the App Store, Android on Google Play.
 */
import PlatformIcon from './PlatformIcon.astro';
import AppIcons from './AppIcons.astro';
import { band, inline, type Section } from './render';

interface Props {
  section: Section<'get-app'>;
}
const { section } = Astro.props;
---

<section id="join" class:list={['get-app', band(section.background)]}>
  <div class="container get-app__inner">
    <h2 class="get-app__title" set:html={inline(section.title)}></h2>
    <AppIcons size={68} class="get-app__icons" />
    <p class="get-app__lede" set:html={inline(section.text)}></p>
    <div class="get-app__ctas">
      {section.buttons.map((b, i) => (
        <a href={b.href} class={i === 0 ? 'btn btn-primary' : 'btn btn-secondary'} target="_blank" rel="external noopener noreferrer"><PlatformIcon platform={b.platform} />{b.label}</a>
      ))}
    </div>
  </div>
</section>

<style>
  .get-app {
    padding-block: var(--space-8);
  }
  @media (max-width: 640px) {
    .get-app {
      padding-block: var(--space-6);
    }
  }
  .get-app__inner {
    max-width: var(--measure-prose);
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .get-app__title {
    font-family: var(--font-serif);
    font-size: var(--text-4xl);
    letter-spacing: -0.025em;
    line-height: var(--leading-tight);
  }
  .get-app__icons {
    margin-top: var(--space-4);
  }
  .get-app__lede {
    margin-top: var(--space-4);
    max-width: 44ch;
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    line-height: var(--leading-snug);
    color: var(--text-soft);
  }
  .get-app__ctas {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }
</style>
