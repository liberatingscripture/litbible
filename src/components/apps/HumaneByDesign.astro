---
/**
 * Humane by design — the translation's convictions, embodied in the app.
 * Privacy, no account, offline, accessibility. Framed as conviction, not
 * spec sheet. Every claim here is true; receipts live at /privacy.
 */
import { band, inline, leavesSite, type Section } from './render';

interface Props {
  section: Section<'humane'>;
}
const { section } = Astro.props;
const away = section.link ? leavesSite(section.link.href) : false;
---

<section class:list={['humane', band(section.background)]}>
  <div class="container humane__inner">
    <header class="humane__head">
      <span class="humane__eyebrow" set:html={inline(section.eyebrow)}></span>
      <h2 class="humane__title" set:html={inline(section.title)}></h2>
      {section.negations.length > 0 && (
        <p class="humane__negations" aria-hidden="true">
          {section.negations.map((n) => <span set:html={inline(n)}></span>)}
        </p>
      )}
    </header>

    <div class="humane__body">
      {section.paragraphs.map((p) => <p set:html={inline(p)}></p>)}
      {section.link && (
        <p class="humane__more">
          <a href={section.link.href} target={away ? '_blank' : undefined} rel={away ? 'noopener noreferrer' : undefined}>{section.link.label}</a>
        </p>
      )}
    </div>
  </div>
</section>

<style>
  .humane {
    padding-block: var(--space-6);
  }
  @media (max-width: 640px) {
    .humane {
      padding-block: var(--space-5);
    }
  }
  .humane__inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }
  @media (min-width: 820px) {
    .humane__inner {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-9);
      align-items: start;
    }
  }

  .humane__eyebrow {
    display: inline-block;
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-caps);
    color: var(--accent);
    font-weight: 600;
    margin-bottom: var(--space-3);
  }
  .humane__title {
    font-family: var(--font-serif);
    font-size: var(--text-3xl);
    letter-spacing: -0.025em;
    line-height: var(--leading-tight);
  }
  .humane__negations {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    margin-top: var(--space-5);
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    color: var(--accent);
  }

  .humane__body {
    max-width: 46ch;
    font-size: var(--text-lg);
    line-height: var(--leading-loose);
    color: var(--text);
  }
  .humane__body p + p {
    margin-top: var(--space-5);
  }
  .humane__more {
    font-size: var(--text-base);
  }
  .humane__more a {
    color: var(--accent);
  }
</style>
