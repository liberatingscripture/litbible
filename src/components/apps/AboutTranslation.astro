---
/**
 * A short pitch for the translation itself — credential, not seminar.
 * The full case lives at litbible.net/translation-commitments.
 */
import { band, inline, leavesSite, type Section } from './render';

interface Props {
  section: Section<'about'>;
}
const { section } = Astro.props;
const away = section.link ? leavesSite(section.link.href) : false;
---

<section class:list={['about', band(section.background)]}>
  <div class="container about__inner">
    <h2 class="about__title" set:html={inline(section.title)}></h2>
    <p class="about__lede" set:html={inline(section.text)}></p>
    {section.link && (
      <p class="about__more">
        <a href={section.link.href} target={away ? '_blank' : undefined} rel={away ? 'noopener noreferrer' : undefined}>{section.link.label}</a>
      </p>
    )}
  </div>
</section>

<style>
  .about {
    padding-block: var(--space-6);
  }
  @media (max-width: 640px) {
    .about {
      padding-block: var(--space-5);
    }
  }
  .about__inner {
    max-width: var(--measure-prose);
  }
  .about__title {
    font-size: var(--text-3xl);
    letter-spacing: -0.025em;
    margin-bottom: var(--space-5);
  }
  .about__lede {
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    line-height: var(--leading-snug);
    color: var(--text-soft);
  }
  .about__more {
    margin-top: var(--space-6);
    font-size: var(--text-base);
  }
  .about__more a {
    color: var(--accent);
  }
</style>
