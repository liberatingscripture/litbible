---
// The source-text notice: the LIT is an adaptation of the SBL Greek New
// Testament, whose CC BY 4.0 license asks for this attribution. It closes
// every page that prints the translation: Study View chapters and intros
// (ScriptureLayout) and Reading View (read/[book].astro). One sentence
// carries the whole attribution and the rest of the credit waits in a
// disclosure (FIXLIST V5); the wording is SblgntCredits.astro's, shared
// with /read. print.css keeps it on paper, in small type, disclosure open.
import SblgntCredits from "./SblgntCredits.astro";
---

<section
  class="scripture-disclaimer"
  aria-label="Source text and licensing notice"
  data-pagefind-ignore
>
  <div class="scripture-disclaimer__inner">
    <SblgntCredits part="line" />
    <details class="scripture-disclaimer__more">
      <summary>Source text and license</summary>
      <SblgntCredits part="rest" />
    </details>
  </div>
</section>

<style>
  .scripture-disclaimer {
    background: var(--surface-raised);
    padding: 30px 16px 56px;
  }

  .scripture-disclaimer__inner {
    margin: 0 auto;

    /* match the footer/tools “wide” container */
    width: min(1100px, calc(100% - 32px));
    max-width: none;

    font-size: 0.95rem;
    line-height: 1.65;
    color: rgba(var(--ink-rgb), 0.85);
  }

  /* The paragraphs are SblgntCredits', so they need :global to be reached. */
  .scripture-disclaimer__inner :global(p) {
    margin: 0 0 14px;
  }

  .scripture-disclaimer__inner :global(a) {
    word-break: break-word;
  }

  .scripture-disclaimer__more summary {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    cursor: pointer;
    list-style: none;
    font-weight: 500;
    color: var(--green-text);
  }

  .scripture-disclaimer__more summary::-webkit-details-marker {
    display: none;
  }

  .scripture-disclaimer__more summary::before {
    content: "";
    width: 0.45em;
    height: 0.45em;
    border-right: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    transform: rotate(-45deg);
    transition: transform 0.15s ease;
  }

  .scripture-disclaimer__more[open] summary::before {
    transform: rotate(45deg);
  }

  .scripture-disclaimer__more summary:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .scripture-disclaimer__more[open] summary {
    margin-bottom: 6px;
  }

  @media (prefers-reduced-motion: reduce) {
    .scripture-disclaimer__more summary::before {
      transition: none;
    }
  }
</style>
