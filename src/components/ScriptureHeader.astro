---
// The title of a chapter or a book's introduction, the page's h1. Previous
// and Next are the place line's ‹ › (PlaceLine.astro; CO-11), the phone
// bar's, and the large links at the foot.
import { bookKeyToLabel } from "../data/books.js";

/**
 * Props are OPTIONAL so <ScriptureHeader /> is valid anywhere.
 * If you pass props, they win. If not, we infer from the URL path.
 */
export type Props = {
  kind?: "intro" | "chapter";
  bookKey?: string;
  chapter?: number;
};

const props = Astro.props as Props;

function normalizeBookKey(key: string) {
  return String(key ?? "")
    .trim()
    .toLowerCase()
    .replace(/\s+/g, "");
}

function inferFromPath(pathname: string): {
  kind?: "intro" | "chapter";
  bookKey?: string;
  chapter?: number;
} {
  // Expected:
  // /luke-intro
  // /luke-1
  // /1john-4
  const m = pathname.match(/^\/([0-9]*[a-z]+)(?:-(intro|\d+))?\/?$/i);
  if (!m) return {};

  const bookKey = normalizeBookKey(m[1]);
  const suffix = m[2]?.toLowerCase();

  if (!suffix || suffix === "intro") {
    return { kind: "intro", bookKey };
  }

  const chapter = Number.parseInt(suffix, 10);
  if (Number.isFinite(chapter)) return { kind: "chapter", bookKey, chapter };

  return { kind: "intro", bookKey };
}

const inferred = inferFromPath(Astro.url?.pathname ?? "");

// Explicit props override inferred values (and we normalize either way)
const bookKey = normalizeBookKey(props.bookKey ?? inferred.bookKey ?? "");

const kind: "intro" | "chapter" =
  props.kind ?? inferred.kind ?? (props.chapter != null ? "chapter" : "intro");

let chapter: number | undefined = undefined;

if (kind === "chapter") {
  const raw = props.chapter ?? inferred.chapter ?? 1;
  const parsed = Number.parseInt(String(raw), 10);
  chapter = Number.isFinite(parsed) ? parsed : 1;
}

const bookName = bookKey ? bookKeyToLabel(bookKey) : "";

const headingText = !bookKey
  ? "Scripture"
  : kind === "intro"
    ? `${bookName} — Introduction`
    : `${bookName} ${chapter ?? 1}`;
---

<header class="scripture-header">
  <h1 id="chapter-title" class="chapter-title" data-pagefind-meta="title">
    {headingText}
  </h1>
</header>

<style>
  .scripture-header {
    position: relative;
    text-align: center;
    margin: 6px 0 10px;
  }

  .chapter-title {
    /* Follows the Display tray's text size through --reading-scale (see src/styles/CLAUDE.md). */
    font-size: calc(28px * var(--heading-scale, 1));
    line-height: 1.25;
    margin: 0;
    padding: 8px 0;
    text-align: center;
  }

  @media (min-width: 641px) {
    .scripture-header {
      margin: 6px 0 18px;
    }

    .chapter-title {
      font-size: calc(32px * var(--heading-scale, 1));
      line-height: 1.8;
    }
  }

  /* On a phone the top bar names the chapter (SITE-FEATHERBOA.md, "The
     phone"; PH-06), so the title stays the page's heading for screen
     readers, the verse menu's reference, and search, drawn for none of
     them. Screen only: a printed page is narrower than 700px too, and keeps
     its title. */
  @media screen and (max-width: 699px) {
    .scripture-header {
      margin: 0;
    }

    .chapter-title {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
    }
  }
</style>
