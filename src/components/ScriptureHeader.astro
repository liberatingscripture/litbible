---
// The title of a chapter or a book's introduction, the page's h1. Previous
// and Next are the place line's ‹ › (PlaceLine.astro; CO-11), the phone
// bar's, and the large links at the foot.
//
// A published chapter reads on into the next (SITE-FEATHERBOA.md, "A whole
// book"), so its title is set as every chapter's heading is between
// chapters ("Between chapters": Fraunces at the Subhead size, at the
// column's start), with "Go deeper" at its right end, naming its chapter by
// where it sits and adding no height (WB-23, WB-46). The heading row's look
// is reading-page.css's, shared with the headings src/scripts/read-on.js
// draws for the chapters it loads.
import { bookKeyToLabel } from "../data/books.js";

/**
 * Props are OPTIONAL so <ScriptureHeader /> is valid anywhere.
 * If you pass props, they win. If not, we infer from the URL path.
 */
export type Props = {
  kind?: "intro" | "chapter";
  bookKey?: string;
  chapter?: number;
  /** A published chapter: the heading row of the reading page. */
  readsOn?: boolean;
  /** The chapter has Go deeper rows, so its heading carries the button. */
  goDeeper?: boolean;
};

const props = Astro.props as Props;

function normalizeBookKey(key: string) {
  return String(key ?? "")
    .trim()
    .toLowerCase()
    .replace(/\s+/g, "");
}

function inferFromPath(pathname: string): {
  kind?: "intro" | "chapter";
  bookKey?: string;
  chapter?: number;
} {
  // Expected:
  // /luke-intro
  // /luke-1
  // /1john-4
  const m = pathname.match(/^\/([0-9]*[a-z]+)(?:-(intro|\d+))?\/?$/i);
  if (!m) return {};

  const bookKey = normalizeBookKey(m[1]);
  const suffix = m[2]?.toLowerCase();

  if (!suffix || suffix === "intro") {
    return { kind: "intro", bookKey };
  }

  const chapter = Number.parseInt(suffix, 10);
  if (Number.isFinite(chapter)) return { kind: "chapter", bookKey, chapter };

  return { kind: "intro", bookKey };
}

const inferred = inferFromPath(Astro.url?.pathname ?? "");

// Explicit props override inferred values (and we normalize either way)
const bookKey = normalizeBookKey(props.bookKey ?? inferred.bookKey ?? "");

const kind: "intro" | "chapter" =
  props.kind ?? inferred.kind ?? (props.chapter != null ? "chapter" : "intro");

let chapter: number | undefined = undefined;

if (kind === "chapter") {
  const raw = props.chapter ?? inferred.chapter ?? 1;
  const parsed = Number.parseInt(String(raw), 10);
  chapter = Number.isFinite(parsed) ? parsed : 1;
}

const bookName = bookKey ? bookKeyToLabel(bookKey) : "";

const headingText = !bookKey
  ? "Scripture"
  : kind === "intro"
    ? `${bookName} — Introduction`
    : `${bookName} ${chapter ?? 1}`;
---

<header class:list={["scripture-header", { "scripture-header--reads-on": props.readsOn }]}>
  {props.readsOn ? (
    <div class="chapter-head">
      <h1 id="chapter-title" class="chapter-title chapter-head__title" data-pagefind-meta="title">
        {headingText}
      </h1>
      {props.goDeeper && (
        <span class="chapter-head__go">
          {/* Without JavaScript, or without the Notebook, the chapter's Go
              deeper section; with the Study preview, src/scripts/read-on.js
              asks the Notebook for This verse's "This chapter" instead. */}
          <a class="kit-btn kit-btn--plain" href="#go-deeper-title" data-go-deeper data-book={bookKey} data-chapter={chapter}>Go deeper</a>
        </span>
      )}
    </div>
  ) : (
    <h1 id="chapter-title" class="chapter-title" data-pagefind-meta="title">
      {headingText}
    </h1>
  )}
</header>

<style>
  .scripture-header {
    position: relative;
    text-align: center;
    margin: 6px 0 10px;
  }

  .chapter-title {
    /* Follows the Display tray's text size through --reading-scale (see src/styles/CLAUDE.md). */
    font-size: calc(28px * var(--heading-scale, 1));
    line-height: 1.25;
    margin: 0;
    padding: 8px 0;
    text-align: center;
  }

  /* The reading page's title is a chapter heading (reading-page.css draws the
     row); these undo the centered page title, at every width (the phone's
     rules, below, hide it). */
  .scripture-header--reads-on {
    text-align: start;
    margin: var(--space-2) 0 var(--space-3);
  }

  .scripture-header--reads-on .chapter-title {
    font-size: calc(var(--size-subhead) * var(--reading-scale, 1));
    font-weight: 500;
    line-height: 1.2;
    padding: 0;
    text-align: start;
  }

  /* Once a chapter has loaded above it (read-on.js), the title is a heading
     between chapters, set as the others are (reading-page.css), at every
     width; read-on.js holds the reader's line through the change. */
  :global(html[data-read-on-above]) .scripture-header--reads-on {
    margin: var(--space-6) 0 var(--space-3);
  }

  @media (min-width: 641px) {
    .scripture-header:not(.scripture-header--reads-on) {
      margin: 6px 0 18px;
    }

    .scripture-header:not(.scripture-header--reads-on) .chapter-title {
      font-size: calc(32px * var(--heading-scale, 1));
      line-height: 1.8;
    }
  }

  /* On a phone the top bar names the chapter (SITE-FEATHERBOA.md, "The
     phone"; PH-06), so the title stays the page's heading for screen
     readers, the verse menu's reference, and search, drawn for none of
     them. Screen only: a printed page is narrower than 700px too, and keeps
     its title. */
  @media screen and (max-width: 699px) {
    .scripture-header {
      margin: 0;
    }

    .chapter-title {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
    }

    /* Go deeper goes with the title row it sits in; the chapter's Go deeper
       section stays in the flow on a phone until Phase 5's sheet. */
    .chapter-head__go {
      display: none;
    }

    /* Once a chapter has loaded above (read-on.js), this title is a heading
       between chapters, drawn like the others. */
    :global(html[data-read-on-above]) .chapter-title {
      position: static;
      width: auto;
      height: auto;
      overflow: visible;
      clip: auto;
      white-space: normal;
    }

    :global(html[data-read-on-above]) .chapter-head__go {
      display: flex;
    }
  }

</style>
