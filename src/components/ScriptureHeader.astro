---
import { bookKeyToLabel } from "../data/books.js";
import { navFor } from "../lib/chapter-nav-data.mjs";

/**
 * Props are OPTIONAL so <ScriptureHeader /> is valid anywhere.
 * If you pass props, they win. If not, we infer from the URL path.
 */
export type Props = {
  kind?: "intro" | "chapter";
  bookKey?: string;
  chapter?: number;
  /** A published chapter with text: the Read aloud icon after the title. */
  readAloud?: boolean;
};

const props = Astro.props as Props;

function normalizeBookKey(key: string) {
  return String(key ?? "")
    .trim()
    .toLowerCase()
    .replace(/\s+/g, "");
}

function inferFromPath(pathname: string): {
  kind?: "intro" | "chapter";
  bookKey?: string;
  chapter?: number;
} {
  // Expected:
  // /luke-intro
  // /luke-1
  // /1john-4
  const m = pathname.match(/^\/([0-9]*[a-z]+)(?:-(intro|\d+))?\/?$/i);
  if (!m) return {};

  const bookKey = normalizeBookKey(m[1]);
  const suffix = m[2]?.toLowerCase();

  if (!suffix || suffix === "intro") {
    return { kind: "intro", bookKey };
  }

  const chapter = Number.parseInt(suffix, 10);
  if (Number.isFinite(chapter)) return { kind: "chapter", bookKey, chapter };

  return { kind: "intro", bookKey };
}

const inferred = inferFromPath(Astro.url?.pathname ?? "");

// Explicit props override inferred values (and we normalize either way)
const bookKey = normalizeBookKey(props.bookKey ?? inferred.bookKey ?? "");

const kind: "intro" | "chapter" =
  props.kind ?? inferred.kind ?? (props.chapter != null ? "chapter" : "intro");

let chapter: number | undefined = undefined;

if (kind === "chapter") {
  const raw = props.chapter ?? inferred.chapter ?? 1;
  const parsed = Number.parseInt(String(raw), 10);
  chapter = Number.isFinite(parsed) ? parsed : 1;
}

const bookName = bookKey ? bookKeyToLabel(bookKey) : "";

// Previous/Next come from the one shared rule, which steps over draft pages
// (src/lib/chapter-nav.mjs), so these buttons, the bottom-of-page ones and a
// draft page's links always agree.
const nav = bookKey ? navFor(bookKey, kind === "intro" ? "intro" : (chapter ?? 1)) : null;
const prevHref = nav?.prev?.href ?? null;
const nextHref = nav?.next?.href ?? null;
// Where each button goes, for its accessible name ("Previous: John 2"), so a
// screen reader hears the destination the bottom-of-page links already name.
const prevLabel = nav?.prev?.label ?? "";
const nextLabel = nav?.next?.label ?? "";

const headingText = !bookKey
  ? "Scripture"
  : kind === "intro"
    ? `${bookName} — Introduction`
    : `${bookName} ${chapter ?? 1}`;
---

<header class="scripture-header">
  {/* The title sits in the middle of three columns, so an icon after it
      leaves it centred. The icon is outside the h1, which keeps the
      heading's name "Romans 8". */}
  <div class="chapter-title-row">
    <h1 id="chapter-title" class="chapter-title" data-pagefind-meta="title">
      {headingText}
    </h1>
    {props.readAloud && kind === "chapter" ? (
      <button
        type="button"
        class="read-aloud-start read-aloud-start--title"
        data-read-aloud-start
        aria-label={`Read ${headingText} aloud`}
        title="Read aloud"
      >
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor"
             stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
             aria-hidden="true" focusable="false">
          <path d="M11 5 6 9H3v6h3l5 4z" fill="currentColor" />
          <path d="M15.5 8.5a5 5 0 0 1 0 7" />
          <path d="M18.5 5.5a9 9 0 0 1 0 13" />
        </svg>
      </button>
    ) : null}
  </div>

  <nav class="chapter-nav" aria-label="Chapter navigation">
    {
      prevHref ? (
        <a class="nav-button" href={prevHref} rel="prev" aria-label={`Previous: ${prevLabel}`}>
          <span class="nav-button__full">◀ Previous</span>
          <span class="nav-button__short" aria-hidden="true">‹</span>
        </a>
      ) : (
        <span class="nav-button nav-button--disabled" aria-disabled="true">
          <span class="nav-button__full">◀ Previous</span>
          <span class="nav-button__short" aria-hidden="true">‹</span>
        </span>
      )
    }

    {
      nextHref ? (
        <a class="nav-button" href={nextHref} rel="next" aria-label={`Next: ${nextLabel}`}>
          <span class="nav-button__full">Next ▶</span>
          <span class="nav-button__short" aria-hidden="true">›</span>
        </a>
      ) : (
        <span class="nav-button nav-button--disabled" aria-disabled="true">
          <span class="nav-button__full">Next ▶</span>
          <span class="nav-button__short" aria-hidden="true">›</span>
        </span>
      )
    }
  </nav>
</header>

<style>
  .scripture-header {
    text-align: center;
    margin: 20px 0 18px;
  }

  .chapter-title-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    margin: 0 0 14px;
  }

  .chapter-title {
    grid-column: 2;
    font-size: 32px;
    line-height: 1.8;
    margin: 0;
    text-align: center;
  }

  .read-aloud-start--title {
    grid-column: 3;
    justify-self: start;
    margin-left: 6px;
  }

  .chapter-nav {
    display: flex;
    justify-content: center;
    gap: 10px;
    flex-wrap: wrap;
  }

  .nav-button {
    padding: 10px 20px;
    font-size: 16px;
    border-radius: 10px;
    border: 0;
    background-color: var(--green-deep, #0f6b33);
    color: #fff;
    cursor: pointer;
    box-shadow: 0 8px 16px rgba(0, 0, 0, 0.2);
    margin: 5px;
    transition:
      background-color 0.2s ease,
      transform 0.2s ease;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .nav-button:hover:not(.nav-button--disabled) {
    background-color: var(--ink);
    transform: translateY(-1px);
  }

  .nav-button--disabled {
    opacity: 0.5;
    cursor: not-allowed;
    pointer-events: none;
  }

  .nav-button__short {
    display: none;
  }

  /* Phones (audit F3): the top Previous/Next become 44px ‹ › either side of
     the title, so the chapter starts sooner. The bottom buttons stay big.
     Each keeps its accessible name ("Previous: Romans 7"). */
  @media (max-width: 640px) {
    .scripture-header {
      position: relative;
      margin: 6px 0 10px;
    }

    .chapter-title-row {
      margin: 0;
      padding: 0 52px;
    }

    .chapter-title {
      font-size: 28px;
      line-height: 1.25;
      padding: 8px 0;
    }

    /* Room for the icon on the right only. A short title stays centred
       between the ‹ › buttons; the longest ("2 Thessalonians 3", 203px of
       the 254px between them) moves a little left rather than wrapping. */
    :global(html.can-speak[data-ra="title"]) .chapter-title-row {
      grid-template-columns: minmax(0, 1fr) auto minmax(34px, 1fr);
    }

    .read-aloud-start--title {
      width: 32px;
      height: 32px;
      margin-left: 2px;
    }

    .chapter-nav {
      position: absolute;
      inset: 0;
      justify-content: space-between;
      align-items: center;
      gap: 0;
      pointer-events: none;
    }

    .nav-button {
      pointer-events: auto;
      width: 44px;
      height: 44px;
      padding: 0;
      margin: 0;
      border-radius: 999px;
      font-size: 26px;
      line-height: 1;
      box-shadow: 0 3px 8px rgba(0, 0, 0, 0.18);
    }

    .nav-button--disabled {
      visibility: hidden;
    }

    .nav-button__full {
      display: none;
    }

    .nav-button__short {
      display: inline;
      margin-top: -3px;
    }
  }
</style>
