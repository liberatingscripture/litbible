---
// SearchBar.astro
const {
  placeholder = "Search",
  fullSearchHref = "/search",
  defaultType = "",
} = Astro.props;
---

<div
  class="searchbar"
  data-searchbar
  data-open="false"
  data-default-type={defaultType}
>
  <label class="sr-only" for="site-search-input">Search</label>

  <!-- wrap input + button in a form so mobile can submit -->
  <form class="searchbar__form" data-searchbar-form role="search">
    <!-- Input wrap lets us overlay “ghost” autocomplete INSIDE the input -->
    <div class="searchbar__input-wrap">
      <input
        id="site-search-input"
        class="searchbar__input"
        type="search"
        placeholder={placeholder}
        autocomplete="off"
        spellcheck="false"
      />

      <!-- One-option predictive “ghost” topic suggestion -->
      <div class="searchbar__ghost" data-ghost hidden aria-hidden="true">
        <span class="searchbar__ghost-typed" data-ghost-typed></span><span
          class="searchbar__ghost-rest"
          data-ghost-rest></span>
      </div>
    </div>

    <!-- Mobile/tablet submit button -->
    <button class="searchbar__submit" type="submit" aria-label="Search">
      <svg
        class="btn-icon"
        viewBox="0 0 24 24"
        aria-hidden="true"
        focusable="false"
      >
        <path d="M3 20.5v-7.2L19.8 12 3 10.7V3.5L22 12 3 20.5Z"></path>
      </svg>
    </button>
  </form>

  <div class="searchbar__panel" role="dialog" aria-label="Search results tray">
    <div class="searchbar__panel-inner">
      <div class="searchbar__controls" aria-label="Search filters">
        <div class="searchbar__chips">
          <button type="button" class="chip chip--active" data-type=""
            >All</button
          >
          <button type="button" class="chip" data-type="article"
            >Articles</button
          >
          <button type="button" class="chip" data-type="scripture"
            >Scripture</button
          >
        </div>

        <div class="searchbar__filters">
          <label class="sr-only" for="searchbar-book">Filter by book</label>
          <select id="searchbar-book" class="searchbar__book">
            <option value="">All books</option>
          </select>

          <label class="sr-only" for="searchbar-mode">Filter results type</label
          >
          <select id="searchbar-mode" class="searchbar__mode">
            <option value="all">All results</option>
            <option value="subject">Subject matches</option>
            <option value="keyword">Keyword matches</option>
            <option value="glossary">Glossary matches</option>
            <option value="ref">Chapter &amp; verse jump</option>
          </select>
        </div>
      </div>

      <div class="searchbar__status" aria-live="polite"></div>
      <div class="searchbar__jump" data-jump hidden></div>
      <div class="searchbar__groups" data-groups></div>

      <div class="searchbar__footer">
        <a class="searchbar__full" href={fullSearchHref}>Go to full search</a>
        <button type="button" class="searchbar__close" aria-label="Close tray">
          Esc
        </button>
      </div>
    </div>
  </div>

  <script is:inline>
    (async () => {
      const root = document.currentScript?.closest("[data-searchbar]");
      if (!root) return;

      // Prevent double-init if Astro renders twice
      if (root.dataset.enhanced === "true") return;
      root.dataset.enhanced = "true";

      const form = root.querySelector("[data-searchbar-form]");
      const input = root.querySelector(".searchbar__input");
      const status = root.querySelector(".searchbar__status");
      const groupsEl = root.querySelector("[data-groups]");
      const bookSelect = root.querySelector(".searchbar__book");
      const modeSelect = root.querySelector(".searchbar__mode");
      const chips = Array.from(root.querySelectorAll(".chip"));
      const closeBtn = root.querySelector(".searchbar__close");
      const fullLink = root.querySelector(".searchbar__full");
      const jumpRow = root.querySelector("[data-jump]");

      // Ghost autocomplete elements
      const ghost = root.querySelector("[data-ghost]");
      const ghostTyped = root.querySelector("[data-ghost-typed]");
      const ghostRest = root.querySelector("[data-ghost-rest]");

      if (
        !form ||
        !input ||
        !status ||
        !groupsEl ||
        !bookSelect ||
        !modeSelect ||
        !closeBtn ||
        !jumpRow
      )
        return;

      const MIN_QUERY_LEN = 3; // keep your gate; 3–4 char queries are now exact-only

      // Canonical NT order matching your ReadMenu keys
      const BOOK_ORDER = [
        "matthew",
        "mark",
        "luke",
        "john",
        "acts",
        "romans",
        "1corinthians",
        "2corinthians",
        "galatians",
        "ephesians",
        "philippians",
        "colossians",
        "1thessalonians",
        "2thessalonians",
        "1timothy",
        "2timothy",
        "titus",
        "philemon",
        "hebrews",
        "james",
        "1peter",
        "2peter",
        "1john",
        "2john",
        "3john",
        "jude",
        "revelation",
      ];
      const BOOK_RANK = new Map(BOOK_ORDER.map((k, i) => [k, i]));

      let pagefind = null;

      const initialType = root.dataset.defaultType || "";
      let activeType = initialType;
      let activeBook = "";
      let activeMode = "all"; // all | subject | keyword | glossary | ref

      // -----------------------------
      // One-option topic autocomplete
      // -----------------------------
      let topicsLoaded = false;
      let topicsList = []; // [{ label, norm, count }]

      function normPhrase(s) {
        return String(s || "")
          .toLowerCase()
          .trim()
          .replace(/\u00a0/g, " ")
          .replace(/\s+/g, " ");
      }

      function clearGhost() {
        if (!ghost || !ghostTyped || !ghostRest) return;
        ghost.hidden = true;
        ghostTyped.textContent = "";
        ghostRest.textContent = "";
      }

      function caretIsAtEnd() {
        try {
          const end = input.value.length;
          return input.selectionStart === end && input.selectionEnd === end;
        } catch {
          return true;
        }
      }

      function bestTopicSuggestion(qRaw) {
        const qNorm = normPhrase(qRaw);
        if (!qNorm || qNorm.length < 2) return null; // small guard = fewer distractions

        // prefix-only
        const matches = [];
        for (const t of topicsList) {
          if (!t?.norm) continue;
          if (t.norm.startsWith(qNorm)) matches.push(t);
        }
        if (!matches.length) return null;

        // shortest matching first (your preference), then count desc, then alpha
        matches.sort((a, b) => {
          const la = a.norm.length;
          const lb = b.norm.length;
          if (la !== lb) return la - lb;

          const ac = Number(a.count || 0);
          const bc = Number(b.count || 0);
          if (bc !== ac) return bc - ac;

          return String(a.label || "").localeCompare(String(b.label || ""));
        });

        return matches[0] || null;
      }

      function renderGhost(qRaw) {
        if (!ghost || !ghostTyped || !ghostRest) return;

        // Only show ghost when user is editing at the end (prevents mid-string weirdness)
        if (document.activeElement === input && !caretIsAtEnd()) {
          clearGhost();
          return;
        }

        const q = String(qRaw || "");
        const picked = bestTopicSuggestion(q);
        const qNorm = normPhrase(q);
        if (!picked || picked.norm === qNorm) {
          clearGhost();
          return;
        }

        // The “rest” has to be aligned with the *original* typed string length.
        // We treat the typed string as authoritative display (even if spacing/case differs).
        const fullLabel = String(picked.label || "");
        const typedLen = q.length;

        ghost.hidden = false;
        ghostTyped.textContent = q;

        // If typedLen exceeds label length (shouldn’t happen, but safety)
        ghostRest.textContent =
          typedLen < fullLabel.length ? fullLabel.slice(typedLen) : "";
      }

      function acceptGhostIfAny() {
        if (!ghost || ghost.hidden) return false;

        const q = input.value;
        const picked = bestTopicSuggestion(q);
        if (!picked) return false;

        // Only accept if current query is a true prefix of the label (ignoring case/extra spaces)
        const qNorm = normPhrase(q);
        if (!picked.norm.startsWith(qNorm)) return false;

        // Replace with canonical label
        input.value = String(picked.label || "").trim();
        clearGhost();
        return true;
      }

      async function loadTopicsOnce() {
        if (topicsLoaded) return;
        topicsLoaded = true;

        // build-topics-index.mjs writes: /public/topics-index.json
        // so it is served from site root as: /topics-index.json
        try {
          const res = await fetch("/topics-index.json", {
            cache: "force-cache",
          });
          if (!res.ok) throw new Error("topics-index.json missing");

          const data = await res.json();

          // { generatedAt: "...", topics: { "<slug>": [ { topicLabel, url, ...}, ... ] } }
          const map =
            data?.topics && typeof data.topics === "object" ? data.topics : {};
          const byNorm = new Map();

          for (const key of Object.keys(map)) {
            const entries = Array.isArray(map[key]) ? map[key] : [];
            if (!entries.length) continue;

            const rawLabel =
              String(entries[0]?.topicLabel || "").trim() || String(key);

            const n = normPhrase(rawLabel);
            if (!n) continue;

            const count = entries.length;

            const prev = byNorm.get(n);
            if (!prev) {
              byNorm.set(n, { label: rawLabel, norm: n, count });
            } else {
              const prevLabel = String(prev.label || "");
              const nextLabel = rawLabel;

              const canonical =
                nextLabel.length < prevLabel.length ? nextLabel : prevLabel;

              byNorm.set(n, {
                label: canonical,
                norm: n,
                count: Math.max(Number(prev.count || 0), count),
              });
            }
          }

          topicsList = Array.from(byNorm.values());
        } catch {
          topicsList = [];
        }
      }

      function openPanel() {
        root.dataset.open = "true";
      }

      function closePanel() {
        root.dataset.open = "false";
        clearGhost();
      }

      function setActiveChip(type) {
        activeType = type;
        chips.forEach((c) =>
          c.classList.toggle("chip--active", (c.dataset.type || "") === type),
        );
      }

      function slugifyBookName(name) {
        return String(name)
          .toLowerCase()
          .replace(/[^0-9a-z]/g, "");
      }

      function bookKeyToLabel(key) {
        const m = String(key).match(/^(\d+)?([a-z]+)$/i);
        if (!m) return String(key);
        const num = m[1] ? m[1] + " " : "";
        const word = m[2];
        return num + word.charAt(0).toUpperCase() + word.slice(1);
      }

      // Populate book dropdown from ReadMenu if present
      const booksDataEl = document.querySelector("[data-books]");
      if (booksDataEl) {
        try {
          const books = JSON.parse(
            booksDataEl.getAttribute("data-books") || "{}",
          );
          Object.keys(books).forEach((key) => {
            const opt = document.createElement("option");
            opt.value = key;
            opt.textContent = bookKeyToLabel(key);
            bookSelect.appendChild(opt);
          });
        } catch {
          // ignore
        }
      }

      function parseReference(raw) {
        const s = String(raw || "")
          .trim()
          .toLowerCase();
        if (!s) return null;

        const cleaned = s
          .replace(/[.,;()]/g, " ")
          .replace(/\s+/g, " ")
          .trim();

        const m = cleaned.match(/^(.+?)\s+(\d+)(?::(\d+))?$/);
        if (!m) return null;

        const bookPart = m[1];
        const chapter = Number(m[2]);
        const verse = m[3] ? Number(m[3]) : null;

        const bookKey = slugifyBookName(bookPart);
        if (!BOOK_RANK.has(bookKey)) return null;
        if (!Number.isFinite(chapter) || chapter <= 0) return null;
        if (verse !== null && (!Number.isFinite(verse) || verse <= 0))
          return null;

        return { bookKey, chapter, verse };
      }

      // Normalize curly quotes so users can paste from “fancy” sources
      function normalizeQuotes(s) {
        return String(s || "")
          .replace(/[“”]/g, '"')
          .replace(/[‘’]/g, "'");
      }

      function isExplicitlyQuoted(q) {
        const s = String(q || "").trim();
        if (s.length < 2) return false;
        return s.startsWith('"') && s.endsWith('"');
      }

      // Whole-word boundary check for exact-only single-token searches (sin != since)
      function isWordChar(ch) {
        if (!ch) return false;
        return /[\p{L}\p{N}_]/u.test(ch);
      }

      function excerptHasWholeWordMarkedTerm(excerptHtml, term) {
        if (!excerptHtml || !term) return false;

        const s = String(excerptHtml)
          .replace(/<mark>/gi, "\u0001")
          .replace(/<\/mark>/gi, "\u0002")
          .replace(/<[^>]+>/g, "");

        const t = String(term).toLowerCase();

        for (let i = 0; i < s.length; i++) {
          if (s[i] !== "\u0001") continue;

          const start = i + 1;
          const end = s.indexOf("\u0002", start);
          if (end === -1) break;

          const marked = s.slice(start, end);
          if (marked.toLowerCase() === t) {
            const before = s[i - 1];
            const after = s[end + 1];
            if (!isWordChar(before) && !isWordChar(after)) return true;
          }

          i = end;
        }

        return false;
      }

      // Fallback whole-word check when Pagefind doesn't provide <mark> in excerpt
      function escapeRegExp(s) {
        return String(s).replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
      }

      function stripTags(html) {
        return String(html || "").replace(/<[^>]+>/g, "");
      }

      function textHasWholeWord(text, term) {
        if (!text || !term) return false;

        const s = String(text).toLowerCase();
        const t = escapeRegExp(String(term).toLowerCase());

        const re = new RegExp(
          `(^|[^\\p{L}\\p{N}_])${t}([^\\p{L}\\p{N}_]|$)`,
          "u",
        );
        return re.test(s);
      }

      // Case-insensitive phrase check (for non-exact, longer queries)
      function normalizePhrase(s) {
        return String(s || "")
          .toLowerCase()
          .trim()
          .replace(/\s+/g, " ");
      }

      function textHasPhrase(text, phrase) {
        if (!text || !phrase) return false;
        return normalizePhrase(text).includes(normalizePhrase(phrase));
      }

      /**
       * Query rules:
       * - If user explicitly quotes: use as-is (exact).
       * - If single token length 1–4: force exact by quoting (exact-only).
       * - If multi-word and not explicitly quoted: quote whole phrase (exact phrase).
       * - Otherwise: leave unquoted (allow Pagefind’s normal behavior).
       */
      function buildPfQuery(raw) {
        const q0 = normalizeQuotes(raw).trim();
        if (!q0)
          return { pfQuery: "", exactSingleToken: false, exactToken: "" };

        // Respect explicit quoting: don't modify
        if (isExplicitlyQuoted(q0)) {
          const inner = q0.slice(1, -1).trim();
          const single = !/\s+/.test(inner);
          return {
            pfQuery: q0,
            exactSingleToken: single,
            exactToken: single ? inner : "",
          };
        }

        const isMultiWord = /\s+/.test(q0);
        if (isMultiWord) {
          return {
            pfQuery: `"${q0}"`,
            exactSingleToken: false,
            exactToken: "",
          };
        }

        // Single token: force exact for length 1–4
        if (q0.length >= 1 && q0.length <= 4) {
          return { pfQuery: `"${q0}"`, exactSingleToken: true, exactToken: q0 };
        }

        return { pfQuery: q0, exactSingleToken: false, exactToken: "" };
      }

      function formatReferenceLabel(ref) {
        const book = bookKeyToLabel(ref.bookKey);
        if (ref.verse) return `${book} ${ref.chapter}:${ref.verse}`;
        return `${book} ${ref.chapter}`;
      }

      function makeReferenceHref(ref) {
        const base = `/${ref.bookKey}-${ref.chapter}`;
        return ref.verse ? `${base}#v${ref.verse}` : base;
      }

      function parseScripturePath(hrefOrUrl) {
        try {
          const u = new URL(hrefOrUrl, window.location.origin);
          const m = u.pathname.match(/^\/([0-9a-z]+)-(intro|\d+)$/);
          if (!m) return null;

          const bookKey = m[1];
          const chapRaw = m[2];

          return {
            bookKey,
            isIntro: chapRaw === "intro",
            chapter: chapRaw === "intro" ? 0 : Number(chapRaw),
            href: u.pathname + u.hash,
          };
        } catch {
          return null;
        }
      }

      function bibleOrderCompareHref(aHref, bHref) {
        const a = parseScripturePath(aHref);
        const b = parseScripturePath(bHref);

        if (!a && !b) return 0;
        if (!a) return 1;
        if (!b) return -1;

        const ar = BOOK_RANK.get(a.bookKey) ?? 999;
        const br = BOOK_RANK.get(b.bookKey) ?? 999;
        if (ar !== br) return ar - br;

        return a.chapter - b.chapter;
      }

      async function ensurePagefind() {
        if (pagefind) return pagefind;
        try {
          pagefind = await import("/pagefind/pagefind.js");
          return pagefind;
        } catch {
          status.textContent =
            "Search index not available yet. Run: npm run build";
          return null;
        }
      }

      function renderJump(ref) {
        if (!ref) {
          jumpRow.hidden = true;
          jumpRow.innerHTML = "";
          return;
        }

        const href = makeReferenceHref(ref);
        const label = formatReferenceLabel(ref);

        jumpRow.hidden = false;
        jumpRow.innerHTML = `
          <a class="searchbar__jump-link" href="${href}">
            Jump to <strong>${label}</strong>
            <span class="searchbar__jump-hint">↩ Enter</span>
          </a>
        `;
      }

      // ✅ Comma/semicolon-delimited subjects preserve multi-word phrases.
      // If the build accidentally gives whitespace-only, we treat the whole blob as ONE entry.
      function parseMetaList(metaValue) {
        if (!metaValue) return [];
        const raw = String(metaValue)
          .replace(/\u00A0/g, " ")
          .replace(/[|/]+/g, ",")
          .trim();

        if (!raw) return [];

        const parts = raw
          .split(/\s*[;,]\s*/g)
          .map((t) => t.trim())
          .filter(Boolean);

        return parts.length ? parts : [raw];
      }

      // ✅ Subject-zone anchor pairs: supports topics/tags/subjects
      function getSubjectRangeFromAnchors(anchors) {
        if (!Array.isArray(anchors)) return null;

        const pairs = [
          ["pf-subjects-start", "pf-subjects-end"],
          ["pf-topics-start", "pf-topics-end"],
          ["pf-tags-start", "pf-tags-end"],
        ];

        for (const [startId, endId] of pairs) {
          const start = anchors.find((a) => a?.id === startId)?.location;
          const end = anchors.find((a) => a?.id === endId)?.location;
          if (typeof start === "number" && typeof end === "number") {
            return start <= end ? { start, end } : { start: end, end: start };
          }
        }

        return null;
      }

      function getMatchLocations(d) {
        const wl = Array.isArray(d?.weighted_locations)
          ? d.weighted_locations
              .map((x) => x?.location)
              .filter((n) => typeof n === "number")
          : [];
        if (wl.length) return wl;

        const locs = Array.isArray(d?.locations)
          ? d.locations.filter((n) => typeof n === "number")
          : [];
        return locs;
      }

      function hasNonSubjectMatch(locs, subjectRange) {
        if (!subjectRange) return true;
        return (locs || []).some(
          (n) => n < subjectRange.start || n > subjectRange.end,
        );
      }

      function pickBestNonSubjectLocation(locs, subjectRange) {
        if (!Array.isArray(locs) || !locs.length) return null;
        if (!subjectRange) return locs[0];
        const nonSubject = locs.filter(
          (n) => n < subjectRange.start || n > subjectRange.end,
        );
        return nonSubject.length ? nonSubject[0] : locs[0];
      }

      // Build deep link without re-fetching r.data() again
      function hrefFromData(d, subjectRange, locs) {
        const chosenLoc = pickBestNonSubjectLocation(locs, subjectRange);

        if (
          typeof chosenLoc !== "number" ||
          !Array.isArray(d?.anchors) ||
          d.anchors.length === 0
        ) {
          return d.url;
        }

        const anchors = [...d.anchors]
          .filter((a) => {
            const id = a?.id ? String(a.id) : "";
            if (!id) return false;
            if (id.startsWith("pf-topics-")) return false;
            if (id.startsWith("pf-tags-")) return false;
            if (id.startsWith("pf-subjects-")) return false;
            return true;
          })
          .sort((a, b) => (a?.location ?? 0) - (b?.location ?? 0));

        let chosen = null;
        for (const a of anchors) {
          if (!a?.id || typeof a.location !== "number") continue;
          if (a.location <= chosenLoc) chosen = a;
          else break;
        }

        return chosen?.id ? `${d.url}#${chosen.id}` : d.url;
      }

      // ✅ Safe glossary check (never throws)
      function isGlossaryUrlSafe(url) {
        const raw = String(url || "").trim();
        if (!raw) return false;

        // Strip hash/query for cheap matching
        const base = raw.split("#")[0].split("?")[0];

        // Most Pagefind URLs are site-relative
        if (base.startsWith("/")) {
          return /\/glossary(\/|$)/i.test(base);
        }

        // Only parse if it looks absolute
        if (base.startsWith("http://") || base.startsWith("https://")) {
          try {
            const p = new URL(base).pathname.replace(/\/+$/, "");
            return /\/glossary(\/|$)/i.test(p);
          } catch {
            return false;
          }
        }

        // Fallback: segment-ish check
        return /\/glossary(\/|$)/i.test(base) || /^glossary(\/|$)/i.test(base);
      }

      function renderGroups({ glossary, subject, keyword }) {
        const glossaryCount = glossary.length;
        const subjectCount = subject.length;
        const keywordCount = keyword.length;

        if (!glossaryCount && !subjectCount && !keywordCount) {
          groupsEl.innerHTML = "";
          return;
        }

        const renderList = (items) => {
          return `
            <ol class="searchbar__results">
              ${items
                .map(
                  ({ title, href }) => `
                    <li class="searchbar__result">
                      <a class="searchbar__link" href="${href}">
                        <div class="searchbar__title">${title}</div>
                      </a>
                    </li>
                  `,
                )
                .join("")}
            </ol>
          `;
        };

        groupsEl.innerHTML = `
          ${
            glossaryCount && (activeMode === "all" || activeMode === "glossary")
              ? `
                <div class="searchbar__group">
                  <div class="searchbar__group-title">Glossary matches</div>
                  ${renderList(glossary)}
                </div>
              `
              : ""
          }
          ${
            subjectCount && (activeMode === "all" || activeMode === "subject")
              ? `
                <div class="searchbar__group">
                  <div class="searchbar__group-title">Subject matches</div>
                  ${renderList(subject)}
                </div>
              `
              : ""
          }
          ${
            keywordCount && (activeMode === "all" || activeMode === "keyword")
              ? `
                <div class="searchbar__group">
                  <div class="searchbar__group-title">Keyword matches</div>
                  ${renderList(keyword)}
                </div>
              `
              : ""
          }
        `;
      }

      async function runSearch(q) {
        // Never let a search-path error break ghost suggestions / input listeners
        try {
          const pf = await ensurePagefind();
          if (!pf) return;

          const ref = parseReference(q);

          if (activeMode === "ref") {
            clearGhost();

            if (ref) {
              status.textContent = "Press Enter to jump.";
              renderJump(ref);
            } else {
              status.textContent = "Type a reference like “Luke 4:18”.";
              renderJump(null);
            }
            groupsEl.innerHTML = "";
            return;
          }

          renderJump(ref);

          const suppressKeywordResultsForPureReference = true;

          if (
            suppressKeywordResultsForPureReference &&
            ref &&
            q.trim().match(/^[^:]+?\s+\d+(?::\d+)?$/i)
          ) {
            status.textContent = "Press Enter to jump.";
            groupsEl.innerHTML = "";
            return;
          }

          const filters = {};
          if (activeType) {
            filters.type =
              activeType === "scripture"
                ? ["scripture", "intro"]
                : [activeType];
          }
          if (activeBook) filters.book = [activeBook];

          status.textContent = "Searching…";
          groupsEl.innerHTML = "";

          const { pfQuery, exactSingleToken, exactToken } = buildPfQuery(q);

          const res = await pf.search(
            pfQuery,
            Object.keys(filters).length ? { filters } : undefined,
          );

          // Resolve ALL results to keep accurate counts.
          const qTrim = q.trim();
          const qUnquoted = qTrim.replace(/^"+|"+$/g, "").trim();
          const qPhrase = normalizePhrase(qUnquoted);
          const isSingleToken = qPhrase && !qPhrase.includes(" ");

          const resolvedAll = await Promise.all(
            res.results.map(async (r) => {
              const d = await r.data();

              const subjectRange = getSubjectRangeFromAnchors(d?.anchors);
              const locs = getMatchLocations(d);

              const topicsListLocal = [
                ...parseMetaList(d?.meta?.topics),
                ...parseMetaList(d?.meta?.tags),
              ];

              const excerptText = stripTags(d?.excerpt);

              const wholeWordOk =
                !exactSingleToken ||
                excerptHasWholeWordMarkedTerm(d?.excerpt, exactToken) ||
                textHasWholeWord(excerptText, exactToken) ||
                textHasWholeWord(d?.meta?.title, exactToken) ||
                textHasWholeWord(d?.meta?.description, exactToken) ||
                textHasWholeWord(d?.title, exactToken);

              const contentHit = !qPhrase
                ? false
                : isSingleToken
                  ? textHasWholeWord(excerptText, qPhrase) ||
                    textHasWholeWord(d?.title, qPhrase) ||
                    textHasWholeWord(d?.meta?.title, qPhrase) ||
                    textHasWholeWord(d?.meta?.description, qPhrase)
                  : textHasPhrase(excerptText, qPhrase) ||
                    textHasPhrase(d?.title, qPhrase) ||
                    textHasPhrase(d?.meta?.title, qPhrase) ||
                    textHasPhrase(d?.meta?.description, qPhrase);

              const subjectHit =
                !!qPhrase &&
                topicsListLocal.map(normalizePhrase).includes(qPhrase);

              return {
                d,
                subjectRange,
                locs,
                topicsList: topicsListLocal,
                wholeWordOk,
                subjectHit,
                contentHit,
              };
            }),
          );

          // Scripture-first ordering
          const scriptureish = [];
          const other = [];

          for (const it of resolvedAll) {
            const parsed = parseScripturePath(it.d?.url);
            if (
              parsed &&
              (it.d?.meta?.type === "scripture" || it.d?.meta?.type === "intro")
            ) {
              scriptureish.push(it);
            } else if (parsed && !it.d?.meta?.type) {
              scriptureish.push(it);
            } else {
              other.push(it);
            }
          }

          scriptureish.sort((a, b) => bibleOrderCompareHref(a.d.url, b.d.url));
          const merged = [...scriptureish, ...other];

          // Glossary bucket (exclude from other buckets to avoid duplicates)
          const glossaryMatches = merged.filter((it) =>
            isGlossaryUrlSafe(it?.d?.url),
          );
          const nonGlossary = merged.filter(
            (it) => !isGlossaryUrlSafe(it?.d?.url),
          );

          const subjectMatches = nonGlossary.filter((it) => it.subjectHit);

          const keywordMatches = nonGlossary.filter((it) => {
            // Intros are subject-indexed only (by design), so they should not appear as keyword matches.
            if (it?.d?.meta?.type === "intro") return false;

            if (!hasNonSubjectMatch(it.locs, it.subjectRange)) return false;
            if (it.subjectHit && !it.contentHit) return false;
            if (exactSingleToken) return it.wholeWordOk;
            return true;
          });

          // Only render a small number in the tray
          const glossaryItems = glossaryMatches.slice(0, 6).map((it) => ({
            title: it.d?.meta?.title ? it.d.meta.title : it.d.title || it.d.url,
            href: hrefFromData(it.d, it.subjectRange, it.locs),
          }));

          const subjectItems = subjectMatches.slice(0, 6).map((it) => ({
            title: it.d?.meta?.title ? it.d.meta.title : it.d.title || it.d.url,
            href: hrefFromData(it.d, it.subjectRange, it.locs),
          }));

          const keywordItems = keywordMatches.slice(0, 6).map((it) => ({
            title: it.d?.meta?.title ? it.d.meta.title : it.d.title || it.d.url,
            href: hrefFromData(it.d, it.subjectRange, it.locs),
          }));

          const gCount = glossaryMatches.length;
          const sCount = subjectMatches.length;
          const kCount = keywordMatches.length;

          status.textContent =
            (gCount
              ? `${gCount} glossary match${gCount === 1 ? "" : "es"} • `
              : "") +
            `${sCount} subject match${sCount === 1 ? "" : "es"} • ` +
            `${kCount} keyword match${kCount === 1 ? "" : "es"}`;

          renderGroups({
            glossary: glossaryItems,
            subject: subjectItems,
            keyword: keywordItems,
          });
        } catch (err) {
          console.error(err);
          // Don’t rethrow. Ever.
          groupsEl.innerHTML = "";
          renderJump(null);
          status.textContent = "Search failed.";
        }
      }

      function submitSearch() {
        const q = input.value.trim();
        if (!q) return;

        clearGhost();

        const ref = parseReference(q);
        if (ref) {
          if (!(activeBook && activeBook !== ref.bookKey)) {
            window.location.href = makeReferenceHref(ref);
            return;
          }
        }

        const url = new URL(
          fullLink?.getAttribute("href") || "/search",
          window.location.origin,
        );

        // Propagate query rules to full search
        const { pfQuery, exactSingleToken } = buildPfQuery(q);
        url.searchParams.set("q", exactSingleToken ? pfQuery : q);

        if (activeType) url.searchParams.set("type", activeType);
        if (activeBook) url.searchParams.set("book", activeBook);
        if (activeMode && activeMode !== "all")
          url.searchParams.set("mode", activeMode);

        window.location.href = url.pathname + url.search;
      }

      function clearForShortQuery(q) {
        groupsEl.innerHTML = "";
        renderJump(null);
        clearGhost();
        status.textContent = q
          ? `Type ${MIN_QUERY_LEN} or more letters to search.`
          : `Type ${MIN_QUERY_LEN} or more letters to search.`;
      }

      chips.forEach((chip) => {
        chip.addEventListener("click", () => {
          setActiveChip(chip.dataset.type || "");
          const q = input.value.trim();
          openPanel();

          if (activeMode !== "ref") renderGhost(q);
          else clearGhost();

          if (!q) {
            clearForShortQuery("");
            return;
          }
          if (q.length >= MIN_QUERY_LEN || parseReference(q)) runSearch(q);
          else clearForShortQuery(q);
        });
      });

      bookSelect.addEventListener("change", () => {
        activeBook = bookSelect.value || "";
        const q = input.value.trim();
        openPanel();

        if (activeMode !== "ref") renderGhost(q);
        else clearGhost();

        if (!q) {
          clearForShortQuery("");
          return;
        }
        if (q.length >= MIN_QUERY_LEN || parseReference(q)) runSearch(q);
        else clearForShortQuery(q);
      });

      modeSelect.addEventListener("change", () => {
        activeMode = modeSelect.value || "all";
        const q = input.value.trim();
        openPanel();

        if (activeMode === "ref") clearGhost();
        else renderGhost(q);

        if (!q) {
          clearForShortQuery("");
          return;
        }
        runSearch(q);
      });

      closeBtn.addEventListener("click", closePanel);

      document.addEventListener("click", (e) => {
        if (!root.contains(e.target)) closePanel();
      });

      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") closePanel();
      });

      let t = null;
      input.addEventListener("input", () => {
        const q = input.value;

        if (!q.trim()) {
          groupsEl.innerHTML = "";
          status.textContent = "";
          renderJump(null);
          clearGhost();
          return;
        }

        openPanel();

        if (activeMode !== "ref") renderGhost(q);
        else clearGhost();

        if (activeMode === "ref") {
          clearTimeout(t);
          t = setTimeout(() => runSearch(q.trim()), 120);
          return;
        }

        if (q.trim().length < MIN_QUERY_LEN) {
          clearForShortQuery(q.trim());
          return;
        }

        clearTimeout(t);
        t = setTimeout(() => runSearch(q.trim()), 120);
      });

      input.addEventListener("focus", () => {
        openPanel();
        const q = input.value;

        if (!q.trim()) {
          clearForShortQuery("");
          return;
        }

        if (activeMode !== "ref") renderGhost(q);
        else clearGhost();

        if (activeMode === "ref") {
          runSearch(q.trim());
          return;
        }

        if (q.trim().length < MIN_QUERY_LEN) {
          clearForShortQuery(q.trim());
          return;
        }

        runSearch(q.trim());
      });

      input.addEventListener("keydown", (e) => {
        // Accept ghost suggestion with Tab or ArrowRight (only at end)
        if (
          (e.key === "Tab" || e.key === "ArrowRight") &&
          !e.metaKey &&
          !e.ctrlKey &&
          !e.altKey
        ) {
          if (document.activeElement === input && caretIsAtEnd()) {
            const accepted = acceptGhostIfAny();
            if (accepted) {
              e.preventDefault();
              const q = input.value.trim();
              if (q.length >= MIN_QUERY_LEN || parseReference(q)) runSearch(q);
              return;
            }
          }
        }

        if (e.key !== "Enter") return;
        e.preventDefault();
        submitSearch();
      });

      form.addEventListener("submit", (e) => {
        e.preventDefault();
        submitSearch();
      });

      // Load topic index once (non-blocking)
      loadTopicsOnce().then(() => {
        if (activeMode !== "ref") renderGhost(input.value);
      });

      setActiveChip(initialType);
      activeMode = modeSelect.value || "all";
      closePanel();
    })();
  </script>
</div>

<!-- IMPORTANT: this CSS must be GLOBAL because search results are injected via innerHTML -->
<style is:global>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: 0;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .searchbar {
    width: 100%;
    position: relative;
  }

  /* Form row (input + button) */
  .searchbar__form {
    display: flex;
    align-items: center;
    gap: 10px;
    width: 100%;
  }

  .searchbar__input-wrap {
    position: relative;
    flex: 1 1 auto;
    min-width: 0;
  }

  .searchbar__input {
    width: 100%;
    padding: 14px 16px;
    border-radius: 12px;
    border: 1px solid rgba(29, 35, 28, 0.25);
    font-size: 1rem;
    background: rgba(255, 255, 255, 0.85);
  }

  /* One-option “ghost” autocomplete overlay inside the input */
  .searchbar__ghost {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    padding: 14px 16px;
    border-radius: 12px;
    pointer-events: none;
    user-select: none;
    overflow: hidden;

    /* match input typography */
    font-size: 1rem;
    line-height: normal;
    white-space: nowrap;
  }

  /* typed portion is invisible so the real input text shows through */
  .searchbar__ghost-typed {
    color: transparent;
  }

  /* rest appears as subtle hint */
  .searchbar__ghost-rest {
    color: rgba(29, 35, 28, 0.35);
  }

  /* Mobile/tablet submit button (hidden by default) */
  .searchbar__submit {
    display: none;
    border: none;
    border-radius: 12px;
    padding: 12px 14px;
    font-size: 0.95rem;
    font-weight: 600;
    cursor: pointer;
    white-space: nowrap;

    background: var(--green, #209d50);
    color: #fff;
    box-shadow: 0 10px 26px rgba(0, 0, 0, 0.14);

    transition:
      transform 160ms ease,
      background-color 200ms ease;
  }

  .searchbar__submit:hover {
    background: var(--ink, #1d231c);
    transform: translateY(-1px);
  }

  .searchbar__submit:active {
    transform: translateY(0);
  }

  .searchbar__submit .btn-icon {
    width: 18px;
    height: 18px;
    display: block;
    fill: currentColor;
    stroke: none;
  }

  .searchbar__submit .btn-icon path {
    fill: currentColor;
  }

  @media (max-width: 1024px) {
    .searchbar__submit {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      flex: 0 0 auto;
      width: auto;
      min-width: 0;
      padding: 12px 12px;
    }
  }

  /* Tray */
  .searchbar__panel {
    display: none;
    position: absolute;
    left: 0;
    right: 0;
    top: calc(100% + 10px);
    z-index: 999;
  }

  [data-searchbar][data-open="true"] .searchbar__panel {
    display: block;
  }

  .searchbar__panel-inner {
    background: rgba(255, 255, 255, 0.96);
    border: 1px solid rgba(29, 35, 28, 0.18);
    border-radius: 16px;
    box-shadow: 0 18px 44px rgba(0, 0, 0, 0.18);
    padding: 16px;
  }

  /* Controls wrapper */
  .searchbar__controls {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    margin-bottom: 10px;
  }

  .chip {
    border-radius: 999px;
    padding: 8px 12px;
    border: 1px solid rgba(29, 35, 28, 0.2);
    background: #fff;
    cursor: pointer;
    white-space: nowrap;
  }

  .chip--active {
    background: rgba(32, 157, 80, 0.12);
    border-color: rgba(32, 157, 80, 0.45);
  }

  /* NEW: chip strip wrapper (used on mobile) */
  .searchbar__chips {
    display: contents; /* desktop: behave like chips are direct children */
  }

  /* NEW: selects wrapper (used on mobile) */
  .searchbar__filters {
    display: contents; /* desktop: behave like selects are direct children */
  }

  .searchbar__book,
  .searchbar__mode {
    padding: 8px 10px;
    border-radius: 10px;
    border: 1px solid rgba(29, 35, 28, 0.2);
    background: #fff;
  }

  /* keep the desktop “push-right” behavior */
  .searchbar__book {
    margin-left: auto;
  }

  .searchbar__status {
    margin: 8px 0 10px;
    opacity: 0.75;
    font-size: 0.95rem;
  }

  .searchbar__jump {
    margin: 0 0 10px;
  }

  .searchbar__jump-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    text-decoration: none;
    padding: 12px 12px;
    border-radius: 14px;
    background: rgba(32, 157, 80, 0.1);
    border: 1px solid rgba(32, 157, 80, 0.35);
  }

  .searchbar__jump-hint {
    opacity: 0.7;
    font-size: 0.9rem;
    white-space: nowrap;
  }

  .searchbar__groups {
    margin-top: 6px;
  }

  .searchbar__group + .searchbar__group {
    margin-top: 12px;
  }

  .searchbar__group-title {
    font-size: 0.82rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    opacity: 0.72;
    margin: 10px 0 6px;
  }

  .searchbar__results {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .searchbar__result + .searchbar__result {
    border-top: 1px solid rgba(29, 35, 28, 0.12);
  }

  .searchbar__link {
    display: block;
    padding: 12px 0;
    text-decoration: none;
    color: inherit;
  }

  .searchbar__title {
    font-weight: 700;
    color: rgba(29, 35, 28, 0.95);
  }

  .searchbar__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 12px;
    padding-top: 10px;
    border-top: 1px solid rgba(29, 35, 28, 0.12);
  }

  .searchbar__full {
    text-decoration: underline;
  }

  .searchbar__close {
    border: 1px solid rgba(29, 35, 28, 0.2);
    background: #fff;
    border-radius: 12px;
    padding: 8px 12px;
    cursor: pointer;
  }

  /* =========================================================
     Mobile tray layout:
     - chips on ONE row (scrollable)
     - book + mode side-by-side when there's room
     - stack selects when the screen is too narrow (prevents “squish”)
     ========================================================= */
  @media (max-width: 640px) {
    .searchbar__controls {
      display: grid;
      gap: 10px;
      align-items: start;
    }

    .searchbar__chips {
      display: flex;
      gap: 10px;
      flex-wrap: nowrap;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      padding-bottom: 4px;
    }

    .searchbar__chips .chip {
      flex: 0 0 auto;
      white-space: nowrap;
    }

    .searchbar__filters {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
      align-items: center;
    }

    .searchbar__book,
    .searchbar__mode {
      width: 100%;
      min-width: 0;
      margin-left: 0;
    }
  }

  @media (max-width: 380px) {
    .searchbar__filters {
      grid-template-columns: 1fr;
    }
  }
</style>
