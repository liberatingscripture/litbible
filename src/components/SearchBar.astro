---
// SearchBar.astro
import { getCollection } from "astro:content";
import { BOOK_ORDER, bookKeyToLabel } from "../data/books.js";

const {
  placeholder = "Search",
  fullSearchHref = "/search",
  defaultMode = "",
  initialOpen = false,
} = Astro.props;

// Real term metadata for glossary search-result titles ("Hell/Hades → the
// place of the dead"). Keyed by entry id — the entry's heading anchor id on
// /glossary — and read at runtime by glossaryTermFromResult() in
// search-core.js, which falls back to parsing the anchor id when an entry
// is missing here.
const glossaryTerms = Object.fromEntries(
  (await getCollection("glossary"))
    .sort((a, b) => a.data.id.localeCompare(b.data.id))
    .map((e) => [
      e.data.id,
      { traditional: e.data.traditional, lit: e.data.lit },
    ]),
);
---

<div
  class="searchbar"
  data-searchbar
  data-open={initialOpen ? "true" : "false"}
  data-default-mode={defaultMode}
>
  <label class="sr-only" for="site-search-input">Search</label>

  <!-- wrap input + button in a form so mobile can submit -->
  <form class="searchbar__form" data-searchbar-form role="search">
    <!-- Input wrap lets us overlay “ghost” autocomplete INSIDE the input -->
    <div class="searchbar__input-wrap">
      <input
        id="site-search-input"
        class="searchbar__input"
        type="search"
        placeholder={placeholder}
        autocomplete="off"
        spellcheck="false"
      />

      <!-- One-option predictive “ghost” topic suggestion -->
      <div class="searchbar__ghost" data-ghost hidden aria-hidden="true">
        <span class="searchbar__ghost-typed" data-ghost-typed></span><span
          class="searchbar__ghost-rest"
          data-ghost-rest></span>
      </div>
    </div>

    <!-- Mobile/tablet submit button -->
    <button class="searchbar__submit" type="submit" aria-label="Search">
      <svg
        class="btn-icon"
        viewBox="0 0 24 24"
        aria-hidden="true"
        focusable="false"
      >
        <path d="M3 20.5v-7.2L19.8 12 3 10.7V3.5L22 12 3 20.5Z"></path>
      </svg>
    </button>
  </form>

  <div class="searchbar__panel" role="dialog" aria-label="Search results tray">
    <div class="searchbar__panel-inner">
      <div class="searchbar__controls" aria-label="Search filters">
        <div class="searchbar__filters">
          <div class="searchbar__filter searchbar__filter--book">
            <label class="sr-only" for="searchbar-book">Filter by book</label>
            <select id="searchbar-book" name="book" class="searchbar__book">
              <option value="">All books</option>
              {BOOK_ORDER.map((key) => (
                <option value={key}>{bookKeyToLabel(key)}</option>
              ))}
            </select>

            <button
              type="button"
              class="searchbar__tip"
              aria-label="About the book filter"
            >
              <span class="searchbar__tip-dot" aria-hidden="true">i</span>
              <span class="searchbar__tooltip" aria-hidden="true">
                Narrows scripture results to a specific book
              </span>
            </button>
          </div>

          <div class="searchbar__filter searchbar__filter--mode">
            <label class="sr-only" for="searchbar-mode"
              >Filter results type</label
            >
            <select id="searchbar-mode" name="mode" class="searchbar__mode">
              <option value="all">All results</option>
              <option value="subject">Topic matches</option>
              <option value="keyword">Keyword matches</option>
              <option value="glossary">Glossary matches</option>
              <option value="article">Article matches</option>
              <option value="intro">Book introductions</option>
            </select>

            <button
              type="button"
              class="searchbar__tip"
              aria-label="About results type (All, Topic, Keyword, Glossary, Article, Book introductions)"
            >
              <span class="searchbar__tip-dot" aria-hidden="true">i</span>
              <span class="searchbar__tooltip" aria-hidden="true">
                <strong>Topic</strong>: matches use LIT's topic index, even when
                the exact words aren't in the text. Exact matches only.<br />
                <strong>Keyword</strong>: matches words/phrases in Bible text.<br
                />
                <strong>Glossary</strong>: terms from the glossary page only,
                both LIT and traditional.<br />
                <strong>Article</strong>: matches from article pages only.<br />
                <strong>Book introductions</strong>: matches from the book intro
                pages only.
              </span>
            </button>
          </div>
        </div>
      </div>

      <div class="searchbar__active-filters" data-active-filters hidden></div>
      <div class="searchbar__status" aria-live="polite"></div>
      <div class="searchbar__jump" data-jump hidden></div>
      <div class="searchbar__groups" data-groups></div>

      <div class="searchbar__footer">
        <a class="searchbar__full" href={fullSearchHref}>Go to full search</a>
        <button type="button" class="searchbar__close" aria-label="Close tray">
          Close
        </button>
      </div>
    </div>
  </div>

  {/* Glossary term metadata for search-result titles — consumed by
      glossaryTermFromResult() in search-core.js on both search surfaces. */}
  <script
    type="application/json"
    data-glossary-terms
    set:html={JSON.stringify(glossaryTerms)}
  />

  {/* Tray behavior lives in src/scripts/searchbar.js (shared logic in
      search-core.js) so the script is bundled + cached once instead of
      shipping inline in every page's HTML. */}
  <script>
    import "../scripts/searchbar.js";
  </script>
</div>

<!-- IMPORTANT: this CSS must be GLOBAL because search results are injected via innerHTML -->
<style is:global>
  /* (UNCHANGED CSS - keep exactly what you already have) */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: 0;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .searchbar {
    width: 100%;
    position: relative;
  }

  .searchbar__form {
    display: flex;
    align-items: center;
    gap: 10px;
    width: 100%;
  }

  .searchbar__input-wrap {
    position: relative;
    flex: 1 1 auto;
    min-width: 0;
  }

  .searchbar__input {
    width: 100%;
    padding: 14px 16px;
    border-radius: 12px;
    border: 1px solid rgba(var(--ink-rgb), 0.25);
    font-size: 1rem;
    background: rgba(var(--surface-rgb), 0.94);
  }

  .searchbar__ghost {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    padding: 14px 16px;
    border-radius: 12px;
    pointer-events: none; /* ghost-typed is transparent; only ghost-rest needs events */
    user-select: none;
    overflow: hidden;
    font-size: 1rem;
    line-height: normal;
    white-space: nowrap;
  }

  .searchbar__ghost-typed {
    color: transparent;
    pointer-events: none;
  }

  .searchbar__ghost-rest {
    color: rgba(var(--ink-rgb), 0.35);
    pointer-events: auto;
    cursor: pointer;
    text-decoration: underline dotted rgba(var(--ink-rgb), 0.35);
  }

  .searchbar__ghost-rest:active {
    color: rgba(var(--ink-rgb), 0.55);
  }

  .searchbar__submit {
    display: none;
    border: none;
    border-radius: 12px;
    padding: 12px 14px;
    font-size: 0.95rem;
    font-weight: 600;
    cursor: pointer;
    white-space: nowrap;

    background: var(--green, #209d50);
    color: #fff;
    box-shadow: 0 10px 26px rgba(0, 0, 0, 0.14);

    transition:
      transform 160ms ease,
      background-color 200ms ease;
  }

  .searchbar__submit:hover {
    background: var(--ink, #1d231c);
    transform: translateY(-1px);
  }

  .searchbar__submit:active {
    transform: translateY(0);
  }

  .searchbar__submit .btn-icon {
    width: 18px;
    height: 18px;
    display: block;
    fill: currentColor;
    stroke: none;
  }

  .searchbar__submit .btn-icon path {
    fill: currentColor;
  }

  /* Visible submit button only where the tools band stacks (matches the
     scripture-tools.css tablet/mobile breakpoint) — above 900px the toolbar
     is a single desktop row and the button would crowd the search column. */
  @media (max-width: 900px) {
    .searchbar__submit {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      flex: 0 0 auto;
      width: auto;
      min-width: 0;
      padding: 12px 12px;
    }
  }

  .searchbar__panel {
    display: none;
    position: absolute;
    left: 0;
    right: 0;
    top: calc(100% + 10px);
    z-index: 999;
  }

  [data-searchbar][data-open="true"] .searchbar__panel {
    display: block;
  }

  .searchbar__panel-inner {
    background: var(--surface-raised);
    color: var(--text);
    border: 1px solid rgba(var(--ink-rgb), 0.18);
    border-radius: 16px;
    box-shadow: 0 18px 44px rgba(0, 0, 0, 0.18);
    padding: 16px;
  }

  .searchbar__controls {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    margin-bottom: 10px;
  }

  .searchbar__filters {
    display: contents;
  }

  .searchbar__filter {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
  }

  /* Preserve the old "book select pushes right" behavior */
  .searchbar__filter--book {
    margin-left: auto;
  }

  .searchbar__book,
  .searchbar__mode {
    padding: 8px 10px;
    border-radius: 10px;
    border: 1px solid rgba(var(--ink-rgb), 0.2);
    background: var(--surface-raised);
    color: var(--text);

    /* Avoid mobile overflow when paired with tooltip button */
    flex: 1 1 auto;
    min-width: 0;
  }

  .searchbar__book {
    margin-left: 0;
  }

  .searchbar__mode-help {
    width: 100%;
    margin: 2px 0 0;
    opacity: 0.72;
    font-size: 0.82rem;
  }

  .searchbar__active-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 8px 0 4px;
  }

  .searchbar__filter-pill {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 4px 10px;
    border-radius: 999px;
    border: 1px solid rgba(32, 157, 80, 0.35);
    background: rgba(32, 157, 80, 0.08);
    font-size: 0.85rem;
    cursor: pointer;
    white-space: nowrap;
    color: rgba(var(--ink-rgb), 0.9);
  }

  .searchbar__filter-pill:hover {
    background: rgba(32, 157, 80, 0.16);
    border-color: rgba(32, 157, 80, 0.5);
  }

  .searchbar__filter-pill span {
    font-size: 0.75rem;
    opacity: 0.65;
  }

  .searchbar__filter-clear-all {
    padding: 4px 10px;
    border-radius: 999px;
    border: 1px solid rgba(var(--ink-rgb), 0.18);
    background: transparent;
    font-size: 0.85rem;
    cursor: pointer;
    color: rgba(var(--ink-rgb), 0.6);
    white-space: nowrap;
  }

  .searchbar__filter-clear-all:hover {
    background: rgba(var(--ink-rgb), 0.06);
  }

  .searchbar__suggest-word {
    display: inline;
    padding: 2px 8px;
    border-radius: 999px;
    border: 1px solid rgba(32, 157, 80, 0.35);
    background: rgba(32, 157, 80, 0.08);
    cursor: pointer;
    font-size: inherit;
    color: inherit;
    font-weight: 600;
  }

  .searchbar__suggest-word:hover {
    background: rgba(32, 157, 80, 0.18);
    border-color: rgba(32, 157, 80, 0.5);
  }

  .searchbar__status {
    margin: 8px 0 10px;
    opacity: 0.75;
    font-size: 0.95rem;
  }

  .searchbar__tip {
    position: relative;

    /* JS sets these so tooltips never run off-screen */
    --tip-x: 12px;
    --tip-y: 12px;

    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: 999px;
    border: 1px solid rgba(var(--ink-rgb), 0.22);
    background: var(--surface-raised);
    color: var(--text);
    cursor: pointer;
    padding: 0;
    flex: 0 0 auto;
  }

  .searchbar__tip:focus-visible {
    outline: 2px solid rgba(32, 157, 80, 0.6);
    outline-offset: 2px;
  }

  .searchbar__tip-dot {
    font-size: 0.95rem;
    font-weight: 800;
    line-height: 1;
    color: var(--text);
    opacity: 0.85;
  }

  /* Viewport-clamped tooltips (direction independent) */
  .searchbar__tooltip {
    position: fixed;
    z-index: 1000;
    left: var(--tip-x);
    top: var(--tip-y);

    width: max-content;
    max-width: min(380px, calc(100vw - 24px));

    padding: 12px 14px;
    border-radius: 12px;
    border: 1px solid rgba(var(--ink-rgb), 0.18);
    background: var(--surface-raised);
    box-shadow: 0 18px 44px rgba(0, 0, 0, 0.18);

    font-size: 0.95rem;
    line-height: 1.5;

    white-space: normal;
    overflow-wrap: anywhere;

    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    text-align: left;

    transform: translateY(8px);
    transition:
      opacity 140ms ease,
      visibility 140ms ease,
      transform 140ms ease;
    transition-delay: 120ms;
  }

  /* Visible when JS toggles the data attr */
  .searchbar__tip[data-tip-open="true"] .searchbar__tooltip {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
    transition-delay: 0ms;
  }

  .searchbar__jump {
    margin: 0 0 10px;
  }

  .searchbar__jump-links {
    display: grid;
    gap: 8px;
  }

  .searchbar__jump-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    text-decoration: none;
    padding: 12px 12px;
    border-radius: 14px;
    background: rgba(32, 157, 80, 0.1);
    border: 1px solid rgba(32, 157, 80, 0.35);
  }

  .searchbar__jump-link--read {
    background: rgba(var(--ink-rgb), 0.05);
    border-color: rgba(var(--ink-rgb), 0.28);
  }

  .searchbar__jump-hint {
    opacity: 0.7;
    font-size: 0.9rem;
    white-space: nowrap;
  }

  .searchbar__jump-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    row-gap: 8px;
    gap: 12px;
    margin-top: 10px;
    padding-top: 10px;
    border-top: 1px solid rgba(var(--ink-rgb), 0.12);
  }

  .searchbar__jump-keys {
    font-size: 0.9rem;
    opacity: 0.72;
    white-space: nowrap;
  }

  .searchbar__jump-search {
    border: 1px solid rgba(var(--ink-rgb), 0.2);
    background: var(--surface-raised);
    border-radius: 999px;
    padding: 7px 12px;
    cursor: pointer;
    font-size: 0.9rem;
    white-space: nowrap;
    margin-left: auto;
  }

  .searchbar__groups {
    margin-top: 6px;
  }

  .searchbar__group + .searchbar__group {
    margin-top: 12px;
  }

  .searchbar__group-title {
    font-size: 0.82rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    opacity: 0.72;
    margin: 10px 0 6px;
  }

  .searchbar__results {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .searchbar__result + .searchbar__result {
    border-top: 1px solid rgba(var(--ink-rgb), 0.12);
  }

  .searchbar__link {
    display: block;
    padding: 12px 0;
    text-decoration: none;
    color: inherit;
  }

  .searchbar__title {
    font-weight: 700;
    color: rgba(var(--ink-rgb), 0.95);
  }

  .searchbar__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 12px;
    padding-top: 10px;
    border-top: 1px solid rgba(var(--ink-rgb), 0.12);
  }

  .searchbar__full {
    text-decoration: underline;
  }

  .searchbar__close {
    border: 1px solid rgba(var(--ink-rgb), 0.2);
    background: var(--surface-raised);
    color: var(--text);
    border-radius: 12px;
    padding: 8px 12px;
    cursor: pointer;
  }

  @media (max-width: 640px) {
    .searchbar__controls {
      display: grid;
      gap: 10px;
      align-items: start;
    }

    .searchbar__filters {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
      align-items: center;
    }

    .searchbar__filter {
      width: 100%;
    }

    .searchbar__filter--book {
      margin-left: 0;
    }

    .searchbar__jump-search {
      margin-left: 0;
    }
  }

  @media (max-width: 380px) {
    .searchbar__filters {
      grid-template-columns: 1fr;
    }
  }
</style>
