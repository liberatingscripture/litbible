---
// SearchBar.astro
import "../styles/search.css";
import Icon from "./Icon.astro";
import { getCollection } from "astro:content";
import { BOOK_ORDER, bookKeyToLabel } from "../data/books.js";

const {
  placeholder = "Search",
  fullSearchHref = "/search",
  defaultMode = "",
  initialOpen = false,
} = Astro.props;

// Real term metadata for glossary search-result titles ("Hell/Hades → the
// place of the dead"). Keyed by entry id — the entry's heading anchor id on
// /glossary — and read at runtime by glossaryTermFromResult() in
// search-core.js, which falls back to parsing the anchor id when an entry
// is missing here.
const glossaryTerms = Object.fromEntries(
  (await getCollection("glossary"))
    .filter((e) => !e.data.draft)
    .sort((a, b) => a.data.id.localeCompare(b.data.id))
    .map((e) => [
      e.data.id,
      { traditional: e.data.traditional, lit: e.data.lit, greek: e.data.greek },
    ]),
);
---

<div
  class="searchbar"
  data-searchbar
  data-open={initialOpen ? "true" : "false"}
  data-default-mode={defaultMode}
>
  <label class="sr-only" for="site-search-input">Search</label>

  {/* wrap input + button in a form so mobile can submit */}
  <form class="searchbar__form" data-searchbar-form role="search">
    {/* Input wrap lets us overlay “ghost” autocomplete INSIDE the input, and
        holds the count at the field's right end on /search. */}
    <div class="searchbar__input-wrap">
      <input
        id="site-search-input"
        class="kit-field searchbar__input"
        type="search"
        placeholder={placeholder}
        autocomplete="off"
        spellcheck="false"
      />

      {/* One-option predictive “ghost” topic suggestion */}
      <div class="searchbar__ghost" data-ghost hidden aria-hidden="true">
        <span class="searchbar__ghost-typed" data-ghost-typed></span><span
          class="searchbar__ghost-rest"
          data-ghost-rest></span>
      </div>

      <span class="searchbar__count" data-search-count></span>
    </div>

    {/* "Build a search…": a quiet link in the field's row, shown only while the
        Greek is chosen (search.js, searchbar.js; Study preview). */}
    <button
      type="button"
      class="kit-btn kit-btn--plain searchbar__build"
      data-build-search
      aria-haspopup="dialog"
      hidden>Build a search…</button
    >

    {/* Phone submit button: the kit's tinted icon, search being one of the
        five that may stand alone. */}
    <button class="kit-icon kit-btn--tinted searchbar__submit" type="submit" aria-label="Search">
      <Icon name="search" />
    </button>
  </form>

  <div class="searchbar__panel" role="dialog" aria-label="Search results tray">
    <div class="searchbar__panel-inner">
      <div class="searchbar__controls" aria-label="Search filters">
        <div class="searchbar__filters">
          <div class="searchbar__filter searchbar__filter--book">
            <label class="sr-only" for="searchbar-book">Filter by book</label>
            <select id="searchbar-book" name="book" class="kit-field searchbar__book">
              <option value="">All books</option>
              {BOOK_ORDER.map((key) => (
                <option value={key}>{bookKeyToLabel(key)}</option>
              ))}
            </select>
          </div>

          {/* The type. In the tray it is a menu; on /search the row of tabs
              is the type and this menu stays only as the value the shared
              search code reads and writes (hidden there by search.css). */}
          <div class="searchbar__filter searchbar__filter--mode">
            <label class="sr-only" for="searchbar-mode">Filter results type</label>
            <select id="searchbar-mode" name="mode" class="kit-field searchbar__mode">
              <option value="all">All results</option>
              <option value="subject">Chapters about it</option>
              <option value="keyword">Scripture</option>
              <option value="glossary">Glossary</option>
              <option value="article">Articles</option>
              <option value="intro">Introductions</option>
            </select>
          </div>
        </div>
      </div>

      <div class="searchbar__active-filters" data-active-filters hidden></div>
      <div class="searchbar__status" aria-live="polite"></div>
      <div class="searchbar__greek-line" data-greek-line hidden></div>
      <div class="searchbar__greek-offer" data-greek-offer hidden></div>
      <div class="searchbar__jump" data-jump hidden></div>
      <div class="searchbar__groups" data-groups></div>

      <div class="searchbar__footer">
        {/* Opens /search on the same tab, with the query and the tab
            (searchbar.js writes its address). */}
        <a class="kit-btn kit-btn--plain searchbar__full" href={fullSearchHref} hidden>See all results →</a>
        {/* Study preview only: searchbar.js shows it with data-desk="on". */}
        <button
          type="button"
          class="kit-btn kit-btn--plain searchbar__commands"
          data-search-commands
          aria-haspopup="dialog"
          hidden>Notebook actions</button
        >
        <button type="button" class="kit-btn kit-btn--plain searchbar__close" aria-label="Close tray">
          Close
        </button>
      </div>
    </div>
  </div>

  {/* Glossary term metadata for search-result titles — consumed by
      glossaryTermFromResult() in search-core.js on both search surfaces. */}
  <script
    type="application/json"
    data-glossary-terms
    set:html={JSON.stringify(glossaryTerms)}
  />

  {/* Tray behavior lives in src/scripts/searchbar.js (shared logic in
      search-core.js) so the script is bundled + cached once instead of
      shipping inline in every page's HTML. */}
  <script>
    import "../scripts/searchbar.js";
  </script>
</div>
