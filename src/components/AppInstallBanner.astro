---
/**
 * Android app-install banner — a slim, dismissible bar at the top of every page
 * offering the LIT Bible app on Google Play. Android mobile browsers only:
 * hidden on iOS and desktop, and gone once dismissed (localStorage).
 *
 * iOS is handled separately by Apple's Smart App Banner (the apple-itunes-app
 * <meta> tag in Layout.astro), which can hand an already-installed app the
 * current page — something a web page can neither detect nor do. No equivalent
 * exists for Android, so this banner covers that platform.
 *
 * Ships HIDDEN and is revealed by an inline script only on Android, so everyone
 * else sees nothing and there's no layout flash. With JS off it never appears
 * (the /apps page and footer still link to the app) — pure progressive
 * enhancement. Styling uses the site's global tokens (--surface-raised, --text,
 * --green-deep, --ink-rgb), so it's theme-correct with no dark-mode rules here.
 */
---

<aside id="lit-app-banner" class="litab" data-platform="android" hidden aria-label="Get the LIT Bible app on Google Play">
  <div class="litab__inner">
    <img class="litab__icon" src="/assets/images/lit-app-icon.svg" alt="" width="44" height="44" decoding="async" />
    <div class="litab__txt">
      <strong>LIT Bible</strong>
      <span>Free. No account, no ads.</span>
    </div>
    <a class="litab__cta" href="https://play.google.com/store/apps/details?id=com.litbible.app&pcampaignid=web_share" rel="external noopener">Get app</a>
    <button class="litab__x" type="button" aria-label="Dismiss">&times;</button>
  </div>
</aside>

<script is:inline>
  (function () {
    var KEY = "lit_app_banner_dismissed";
    try { if (localStorage.getItem(KEY) === "1") return; } catch (e) {}
    if (!/Android/i.test(navigator.userAgent || "")) return;
    var b = document.getElementById("lit-app-banner");
    if (!b) return;
    b.hidden = false;
    b.querySelector(".litab__x").addEventListener("click", function () {
      b.hidden = true;
      try { localStorage.setItem(KEY, "1"); } catch (e) {}
    });
  })();
</script>

<style>
  .litab {
    background: var(--surface-raised);
    border-bottom: 1px solid rgba(var(--ink-rgb), 0.12);
    font-family: Inter, system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  }
  .litab__inner {
    display: flex;
    align-items: center;
    gap: 12px;
    max-width: 640px;
    margin: 0 auto;
    padding: 8px 14px;
  }
  .litab__icon {
    width: 44px;
    height: 44px;
    border-radius: 10px;
    flex: none;
    box-sizing: border-box;
  }
  /* The Android mark arrives on transparency and washes out on a light
     surface, so it wears the same ink tile it has on-device (matches AppIcons). */
  .litab[data-platform="android"] .litab__icon {
    background: #1b2318;
    padding: 5px;
  }
  .litab__txt {
    flex: 1;
    min-width: 0;
    line-height: 1.25;
  }
  .litab__txt strong {
    display: block;
    font-size: 14px;
    font-weight: 600;
    color: var(--text);
  }
  .litab__txt span {
    display: block;
    font-size: 12px;
    color: rgba(var(--ink-rgb), 0.66);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .litab__cta {
    flex: none;
    background: var(--green-deep);
    color: #fff;
    text-decoration: none;
    font-size: 13px;
    font-weight: 600;
    padding: 8px 16px;
    border-radius: 999px;
    white-space: nowrap;
  }
  .litab__cta:active {
    opacity: 0.9;
  }
  .litab__x {
    flex: none;
    background: none;
    border: 0;
    color: rgba(var(--ink-rgb), 0.5);
    font-size: 22px;
    line-height: 1;
    padding: 6px 8px;
    min-width: 40px;
    cursor: pointer;
  }
</style>
