---
// One of Featherboa's icons (src/lib/icons.mjs, "Controls," "Icons"), drawn
// inline so it takes the control's color. Decorative: the control's word
// names it, or the control's aria-label where the icon stands alone, which
// only the five in STANDALONE may (search, close, back, forward, and more).
import { icon } from "../lib/icons.mjs";

interface Props {
  name: string;
  size?: number;
  class?: string;
}

const { name, size = 20, class: className = "icon" } = Astro.props;
---

<Fragment set:html={icon(name, { size, className })} />
