---
import { siFacebook, siThreads, siBluesky, siInstagram } from "simple-icons";

/**
 * hideNewsletter: omit the Brevo subscribe form. Used on /unsubscribe, which
 * embeds its own Brevo form — Brevo markup requires fixed ids (sib-form,
 * error-message, success-message), so two forms on one page collide.
 */
const { hideNewsletter = false } = Astro.props;
---

<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-left">
      <nav class="footer-nav" aria-label="Footer navigation">
        <div class="footer-col">
          <h2>Learn</h2>
          <ul>
            <li><a href="/about">About</a></li>
            <li><a href="/translation-commitments">Commitments</a></li>
            <li><a href="/found-in-translation-podcast">Podcast</a></li>
            <li><a href="/apps">Apps</a></li>
          </ul>
        </div>

        <div class="footer-col">
          <h2>Connect</h2>
          <ul>
            <li><a href="/contact">Contact</a></li>
            <li><a href="/support">Support</a></li>
            <li>
              <a
                href="/liberating-scripture-collective"
                aria-label="About the Liberating Scripture Collective"
                title="Liberating Scripture Collective"
              >
                About LSC
              </a>
            </li>
            <li><a href="/privacy">Privacy</a></li>
          </ul>

          <ul class="social-links" aria-label="Social media">
            <li>
              <a
                href="https://www.facebook.com/LiberationAndInclusionTranslation"
                aria-label="Liberation and Inclusion Translation on Facebook"
                target="_blank"
                rel="noopener noreferrer"
              >
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                  <path d={siFacebook.path}></path>
                </svg>
              </a>
            </li>

            <li>
              <a
                href="https://www.threads.com/@lit.bible"
                aria-label="Liberation and Inclusion Translation on Threads"
                target="_blank"
                rel="noopener noreferrer"
              >
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                  <path d={siThreads.path}></path>
                </svg>
              </a>
            </li>

            <li>
              <a
                href="https://bsky.app/profile/litbible.net"
                aria-label="Liberation and Inclusion Translation on Bluesky"
                target="_blank"
                rel="noopener noreferrer"
              >
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                  <path d={siBluesky.path}></path>
                </svg>
              </a>
            </li>

            <li>
              <a
                href="https://instagram.com/lit.bible"
                aria-label="Liberation and Inclusion Translation on Instagram"
                target="_blank"
                rel="noopener noreferrer"
              >
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                  <path d={siInstagram.path}></path>
                </svg>
              </a>
            </li>

          </ul>
        </div>
      </nav>
    </div>

    <div class="footer-center" aria-label="Site logo">
      <img
        src="/images/lit-logo.png"
        alt="Liberation and Inclusion Translation logo"
        width="220"
        height="220"
      />
    </div>

    <div class="footer-right">
      {!hideNewsletter && (
      <section
        class="footer-newsletter"
        aria-labelledby="footer-newsletter-heading"
      >
        <h2 id="footer-newsletter-heading" class="footer-newsletter__heading">
          Stay informed
        </h2>
        <p class="footer-newsletter__desc">
          New translations, articles, and LIT Bible news direct to your inbox.
        </p>

        {/* Brevo success/error panels — visibility toggled by Brevo main.js */}
        <div
          id="error-message"
          class="footer-newsletter__message footer-newsletter__message--error"
          role="alert"
          aria-live="assertive"
          aria-atomic="true"
        >
          <svg
            viewBox="0 0 512 512"
            aria-hidden="true"
            focusable="false"
            class="footer-newsletter__message-icon"
          >
            <path
              d="M256 40c118.621 0 216 96.075 216 216 0 119.291-96.61 216-216 216-119.244 0-216-96.562-216-216 0-119.203 96.602-216 216-216m0-32C119.043 8 8 119.083 8 256c0 136.997 111.043 248 248 248s248-111.003 248-248C504 119.083 392.957 8 256 8zm-11.49 120h22.979c6.823 0 12.274 5.682 11.99 12.5l-7 168c-.268 6.428-5.556 11.5-11.99 11.5h-8.979c-6.433 0-11.722-5.073-11.99-11.5l-7-168c-.283-6.818 5.167-12.5 11.99-12.5zM256 340c-15.464 0-28 12.536-28 28s12.536 28 28 28 28-12.536 28-28-12.536-28-28-28z"
            ></path>
          </svg>
          Your subscription could not be saved. Please try again.
        </div>

        <div
          id="success-message"
          class="footer-newsletter__message footer-newsletter__message--success"
          role="status"
          aria-live="polite"
          aria-atomic="true"
        >
          <svg
            viewBox="0 0 512 512"
            aria-hidden="true"
            focusable="false"
            class="footer-newsletter__message-icon"
          >
            <path
              d="M256 8C119.033 8 8 119.033 8 256s111.033 248 248 248 248-111.033 248-248S392.967 8 256 8zm0 464c-118.664 0-216-96.055-216-216 0-118.663 96.055-216 216-216 118.664 0 216 96.055 216 216 0 118.663-96.055 216-216 216zm141.63-274.961L217.15 376.071c-4.705 4.667-12.303 4.637-16.97-.068l-85.878-86.572c-4.667-4.705-4.637-12.303.068-16.97l8.52-8.451c4.705-4.667 12.303-4.637 16.97.068l68.976 69.533 163.441-162.13c4.705-4.667 12.303-4.637 16.97.068l8.451 8.52c4.668 4.705 4.637 12.303-.068 16.97z"
            ></path>
          </svg>
          You're subscribed. Thanks for signing up!
        </div>

        <form
          id="sib-form"
          class="footer-newsletter__form"
          method="POST"
          action="https://1742a6b7.sibforms.com/serve/MUIFAKJyiPPqI2bardfqrp4wdqO-pfiy9S0T0d29zd_v8G57bZ4nS9ClYWCPu64OSzzQyw7yTR9wqyWr-vdn17UIhr2fG1OFFtGvdeEHWM-b9y94UUNmT3jjFI_8ltcZGK3w1h_iMk2Aylrk3qAQqLSPdAV51iOZf0SVzMSSVh41B1CKoomPPA_6j5j3arPgHjcdzi76_cLEFKzQKA=="
          data-type="subscription"
          novalidate
        >
          <div class="footer-newsletter__row">
            <label for="footer-email" class="sr-only">Email address</label>
            <input
              id="footer-email"
              type="email"
              name="EMAIL"
              placeholder="your@email.com"
              autocomplete="email"
              required
              data-required="true"
              class="footer-newsletter__input"
            />
            <button
              type="submit"
              class="footer-newsletter__submit"
              form="sib-form"
              disabled
            >
              Subscribe
            </button>
          </div>

          {/* Inline field error — populated by Brevo main.js */}
          <label
            class="entry__error entry__error--primary footer-newsletter__field-error"
            aria-live="polite"></label>

          {/* Turnstile — Brevo's own site key; callback required by main.js */}
          <div class="footer-newsletter__turnstile">
            <div
              class="cf-turnstile g-recaptcha"
              data-sitekey="0x4AAAAAACyvexOxVuDiY_85"
              id="sib-captcha"
              data-callback="handleCaptchaResponse"
              data-language="en"
            >
            </div>
            <label
              class="entry__error entry__error--primary footer-newsletter__field-error"
              aria-live="polite"></label>
          </div>

          {/* Brevo required hidden fields */}
          <input
            type="text"
            name="email_address_check"
            value=""
            class="footer-newsletter__honeypot"
            aria-hidden="true"
            tabindex="-1"
            autocomplete="off"
          />
          <input type="hidden" name="locale" value="en" />
        </form>
      </section>
      )}
    </div>
  </div>
</footer>

{/* License subfooter — full-width band, outside <footer> */}
<div class="footer-license-band">
  <p class="footer-license-band__text">
    The <strong>Liberation and Inclusion Translation of the Bible (LIT)</strong
    >™ © 2024 by Brandon C. Vélez&nbsp;Johnson is licensed under
    <a
      href="https://creativecommons.org/licenses/by-nc-nd/4.0/"
      rel="license noopener noreferrer"
      target="_blank"
    >
      CC BY-NC-ND 4.0
    </a>
  </p>
</div>

{/* Brevo scripts — lazy-loaded on first user interaction with the newsletter form.
    Skipped when the newsletter form is hidden (the script would otherwise grab
    another page-level Brevo form via the shared sib-form id). */}
{!hideNewsletter && <script is:inline>
  (function() {
    var loaded = false;
    var submitBtn = document.querySelector('.footer-newsletter__submit');

    function loadBrevoScripts() {
      if (loaded) return;
      loaded = true;

      // Brevo config globals
      window.REQUIRED_CODE_ERROR_MESSAGE = "Please choose a country code";
      window.LOCALE = "en";
      window.EMAIL_INVALID_MESSAGE = window.SMS_INVALID_MESSAGE =
        "The information provided is invalid. Please review the field format and try again.";
      window.REQUIRED_ERROR_MESSAGE = "This field cannot be left blank.";
      window.GENERIC_INVALID_MESSAGE =
        "The information provided is invalid. Please review the field format and try again.";
      window.translation = {
        common: {
          selectedList: "{quantity} list selected",
          selectedLists: "{quantity} lists selected",
          selectedOption: "{quantity} selected",
          selectedOptions: "{quantity} selected",
        },
      };
      var AUTOHIDE = Boolean(0);

      window.handleCaptchaResponse = function() {
        var event = new Event("captchaChange");
        document.getElementById("sib-captcha").dispatchEvent(event);
        window.grecaptcha = window.turnstile;
      };

      // Inject Brevo form JS — re-enable submit when ready
      var s1 = document.createElement("script");
      s1.src = "https://sibforms.com/forms/end-form/build/main.js";
      s1.onload = function() {
        if (submitBtn) submitBtn.disabled = false;
      };
      document.body.appendChild(s1);

      // Inject Cloudflare Turnstile
      var s2 = document.createElement("script");
      s2.src = "https://challenges.cloudflare.com/turnstile/v0/api.js";
      s2.async = true;
      document.body.appendChild(s2);
    }

    var form = document.getElementById("sib-form");
    if (!form) return;

    // Load on first pointer or keyboard interaction with the form
    function onInteraction() {
      form.removeEventListener("pointerover", onInteraction);
      form.removeEventListener("focusin", onInteraction);
      loadBrevoScripts();
    }

    form.addEventListener("pointerover", onInteraction);
    form.addEventListener("focusin", onInteraction);
  })();
</script>}
