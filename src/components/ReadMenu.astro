---
import { BOOKS as books, BOOK_ORDER, bookKeyToLabel } from "../data/books.js";
import { scanDraftChapters } from "../lib/draft-chapters.mjs";
const { currentBook = "", currentChapter = "" } = Astro.props;

const currentBookKey = currentBook
  ? String(currentBook).toLowerCase().replace(/[^0-9a-z]/g, "")
  : "";
const initialChapterCount = currentBookKey
  ? ((books as Record<string, number>)[currentBookKey] ?? 0)
  : 0;

// Draft chapters ("indexed": false) get a "(draft)" marker in the chapter
// list so readers aren't surprised by untranslated stubs. Shared derivation
// with the sitemap filter in astro.config.mjs.
const DRAFT_CHAPTERS = scanDraftChapters().draftChaptersByBook;

const initialDrafts = new Set(DRAFT_CHAPTERS[currentBookKey] ?? []);
---

<div class="read-menu-wrap">
  <form
    class="read-menu"
    data-books={JSON.stringify(books)}
    data-drafts={JSON.stringify(DRAFT_CHAPTERS)}
    data-current-book={currentBook || undefined}
    data-current-chapter={currentChapter || undefined}
    novalidate
  >
    <label for="book-select" class="sr-only">Select a New Testament book</label>
    <select id="book-select">
      <option value="">Select a Book</option>
      {BOOK_ORDER.map((key) => (
        <option value={key}>{bookKeyToLabel(key)}</option>
      ))}
    </select>

    <label for="chapter-select" class="sr-only">Select a chapter</label>
    <select id="chapter-select" disabled={!initialChapterCount}>
      <option value="">Select a Chapter</option>
      {initialChapterCount > 0 && (
        <>
          <option value="intro" selected={currentChapter === "intro"}>Introduction</option>
          {Array.from({ length: initialChapterCount }, (_, i) => i + 1).map((i) => (
            <option
              value={String(i)}
              selected={currentChapter === String(i)}
              class={initialDrafts.has(i) ? "draft-option" : undefined}
            >
              {initialDrafts.has(i) ? `Chapter ${i} (draft)` : `Chapter ${i}`}
            </option>
          ))}
        </>
      )}
    </select>

    <div class="read-menu__actions">
      <button
        id="study-button"
        type="submit"
        name="mode"
        value="study"
        aria-label="Open selected passage in study mode"
        disabled
      >
        Study
      </button>

      <button
        id="read-button"
        type="submit"
        name="mode"
        value="read"
        aria-label="Open selected passage in reading mode"
        disabled
      >
        Read
      </button>
    </div>
  </form>

  <script is:inline>
    (() => {
      const root = document.currentScript?.previousElementSibling;
      if (!(root instanceof HTMLFormElement)) return;

      const books = JSON.parse(root.getAttribute("data-books") || "{}");
      let drafts = {};
      try {
        drafts = JSON.parse(root.getAttribute("data-drafts") || "{}");
      } catch {
        drafts = {};
      }

      const bookSelect = root.querySelector("#book-select");
      const chapterSelect = root.querySelector("#chapter-select");
      const studyButton = root.querySelector("#study-button");
      const readButton = root.querySelector("#read-button");

      if (
        !(bookSelect instanceof HTMLSelectElement) ||
        !(chapterSelect instanceof HTMLSelectElement) ||
        !(studyButton instanceof HTMLButtonElement) ||
        !(readButton instanceof HTMLButtonElement)
      ) {
        return;
      }

      function slugifyBook(name) {
        return String(name)
          .toLowerCase()
          .replace(/[^0-9a-z]/g, "");
      }

      function buildStudyHref(bookKey, chapter) {
        if (!bookKey) return "";
        if (!chapter || chapter === "intro") return `/${bookKey}-intro`;
        return `/${bookKey}-${chapter}`;
      }

      function buildReadHref(bookKey, chapter) {
        if (!bookKey) return "";
        // If no chapter selected, go to the book reading view landing page.
        if (!chapter) return `/read/${bookKey}`;
        if (chapter === "intro") return buildStudyHref(bookKey, chapter);
        return `/read/${bookKey}#ch-${chapter}`;
      }

      function setButtonsDisabled(disabled) {
        studyButton.disabled = disabled;
        readButton.disabled = disabled;
      }

      function populateChapters(key, afterPopulate) {
        chapterSelect.innerHTML = '<option value="">Select a Chapter</option>';
        chapterSelect.disabled = true;

        if (books[key]) {
          const fragment = document.createDocumentFragment();
          const draftSet = new Set(drafts[key] || []);

          const intro = document.createElement("option");
          intro.value = "intro";
          intro.textContent = "Introduction";
          fragment.appendChild(intro);

          for (let i = 1; i <= books[key]; i++) {
            const opt = document.createElement("option");
            opt.value = String(i);
            if (draftSet.has(i)) {
              opt.textContent = `Chapter ${i} (draft)`;
              opt.className = "draft-option";
            } else {
              opt.textContent = `Chapter ${i}`;
            }
            fragment.appendChild(opt);
          }

          chapterSelect.appendChild(fragment);
          chapterSelect.disabled = false;
          if (afterPopulate) afterPopulate();
        }
      }

      bookSelect.addEventListener("change", () => {
        const key = slugifyBook(bookSelect.value);

        // Defer all DOM work past the next paint so the event handler returns
        // immediately (minimises INP processing time). Buttons + chapters both
        // update after the select's visual change is already rendered.
        requestAnimationFrame(() => {
          setButtonsDisabled(!key);
          setTimeout(() => populateChapters(key), 0);
        });
      });

      // No longer gate buttons on chapter selection; keep listener optional/no-op.
      chapterSelect.addEventListener("change", () => {
        // Buttons remain enabled as long as a book is selected.
        const key = slugifyBook(bookSelect.value);
        setButtonsDisabled(!key);
      });

      // Pre-select current book/chapter if provided via data attributes
      const initBook = root.getAttribute("data-current-book");
      const initChapter = root.getAttribute("data-current-chapter");
      if (initBook) {
        for (const opt of bookSelect.options) {
          if (slugifyBook(opt.value) === initBook) {
            bookSelect.value = opt.value;
            break;
          }
        }
        const key = slugifyBook(initBook);
        setButtonsDisabled(!key);
        if (chapterSelect.options.length > 1) {
          // Options already server-rendered — just set the selected value.
          if (initChapter) chapterSelect.value = initChapter;
        } else {
          // Fallback for contexts without SSR chapter options (e.g. search page ReadMenu).
          populateChapters(key, () => {
            if (initChapter) chapterSelect.value = initChapter;
          });
        }
      }

      const submitStudyFromKeyboard = (event) => {
        if (event.key !== "Enter") return;
        event.preventDefault();

        // Enter submits "study" by default, even if chapter isn't selected.
        if (!studyButton.disabled) root.requestSubmit(studyButton);
      };

      bookSelect.addEventListener("keydown", submitStudyFromKeyboard);
      chapterSelect.addEventListener("keydown", submitStudyFromKeyboard);

      root.addEventListener("submit", (event) => {
        event.preventDefault();

        const book = slugifyBook(bookSelect.value);
        const chapter = chapterSelect.value || ""; // may be empty now
        if (!book) return;

        const submitter = event.submitter;
        const mode =
          submitter instanceof HTMLButtonElement && submitter.value
            ? submitter.value
            : "study";

        const href =
          mode === "read"
            ? buildReadHref(book, chapter)
            : buildStudyHref(book, chapter);

        if (href) requestAnimationFrame(() => { window.location.href = href; });
      });
    })();
  </script>

  <style>
    .sr-only {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }

    .read-menu {
      display: flex;
      justify-content: center;
      align-items: center;
      flex-wrap: wrap;
      gap: 10px;
      margin-top: 2.2rem;
    }

    .read-menu__actions {
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
      justify-content: center;
    }

    .read-menu select,
    .read-menu button {
      padding: 10px;
      font-size: 16px;
      border-radius: 10px;
      border: none;
      background-color: var(--surface-input);
      color: var(--text);
      box-shadow: 0 8px 16px rgba(0, 0, 0, 0.2);
      transition:
        background-color 0.2s ease,
        color 0.2s ease;
    }

    .read-menu__actions button {
      min-width: 88px;
      padding: 6px 12px;
      font-size: 0.9rem;
      border-radius: 999px;
    }

    .read-menu select:hover:not(:disabled),
    .read-menu button:hover:not(:disabled) {
      background-color: var(--green);
      color: #ffffff;
    }

    .read-menu select:disabled,
    .read-menu button:disabled {
      opacity: 0.5;
      cursor: not-allowed;
    }

    /* Draft chapters are dimmed in the list; the "(draft)" text suffix is
       the reliable marker (option styling support varies by browser). */
    .read-menu select :global(option.draft-option) {
      color: rgba(var(--ink-rgb), 0.55);
    }

    .read-menu button {
      background-color: var(--cta-bg);
      color: var(--cta-text);
      cursor: pointer;
    }

    .read-menu button#study-button {
      background-color: var(--green);
      color: #ffffff;
    }

    .read-menu button#study-button:hover:not(:disabled) {
      background-color: var(--ink);
      color: #ffffff;
    }

    @media (max-width: 560px) {
      .read-menu__actions {
        justify-content: center;
      }

      .read-menu__actions button {
        flex: 0 0 auto;
      }
    }
  </style>
</div>
