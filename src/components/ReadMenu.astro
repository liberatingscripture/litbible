---
import {
  BOOKS as books,
  BOOK_ORDER,
  BOOK_ABBREVIATIONS,
  bookKeyToLabel,
} from "../data/books.js";
import { scanDraftChapters } from "../lib/draft-chapters.mjs";
const { currentBook = "", currentChapter = "" } = Astro.props;

const currentBookKey = currentBook
  ? String(currentBook).toLowerCase().replace(/[^0-9a-z]/g, "")
  : "";
const knownBook = Boolean((books as Record<string, number>)[currentBookKey]);

// Draft chapters ("indexed": false) are dimmed with a dot marker in the
// chapter grid. Shared derivation with the sitemap filter in astro.config.mjs.
const DRAFT_CHAPTERS = scanDraftChapters().draftChaptersByBook;

// The trigger label mirrors the current passage. Every pick is a full page
// navigation (static site), so the label never needs client-side syncing —
// the next server render shows the new location.
const chapterNum = /^\d+$/.test(String(currentChapter))
  ? Number(currentChapter)
  : null;
const isIntro = String(currentChapter) === "intro";
const isDraftChapter =
  knownBook &&
  chapterNum !== null &&
  (DRAFT_CHAPTERS[currentBookKey] ?? []).includes(chapterNum);

let triggerLabel = "Go to passage";
if (knownBook && isIntro) {
  triggerLabel = `${bookKeyToLabel(currentBookKey)} · Intro`;
} else if (knownBook && chapterNum !== null) {
  triggerLabel = `${bookKeyToLabel(currentBookKey)} ${chapterNum}`;
} else if (knownBook) {
  triggerLabel = bookKeyToLabel(currentBookKey);
}

// No-JS fallback: the trigger is a real link — the book's continuous Reading
// Mode page when there is a current book, the /read landing page otherwise.
// JS upgrades it in place into the popover trigger button.
const fallbackHref = knownBook ? `/read/${currentBookKey}` : "/read";
---

<div class="read-menu-wrap">
  <nav
    class="read-menu"
    aria-label="Go to passage"
    data-books={JSON.stringify(books)}
    data-abbrs={JSON.stringify(BOOK_ABBREVIATIONS)}
    data-drafts={JSON.stringify(DRAFT_CHAPTERS)}
    data-current-book={knownBook ? currentBookKey : undefined}
    data-current-chapter={knownBook ? String(currentChapter) : undefined}
  >
    <a class="read-menu__trigger" href={fallbackHref} data-rm-trigger>
      <svg
        class="read-menu__icon"
        viewBox="0 0 24 24"
        width="1em"
        height="1em"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
        focusable="false"
      >
        <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path>
        <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path>
      </svg>
      {knownBook && <span class="sr-only">Go to passage. Current:&nbsp;</span>}
      <span class="read-menu__label">{triggerLabel}</span>
      {isDraftChapter && (
        <>
          <span class="read-menu__draft-dot" aria-hidden="true"></span>
          <span class="sr-only">(draft)</span>
        </>
      )}
      <svg
        class="read-menu__chevron"
        viewBox="0 0 24 24"
        width="1em"
        height="1em"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
        focusable="false"
      >
        <path d="m6 9 6 6 6-6"></path>
      </svg>
    </a>
  </nav>

  <script is:inline>
    (() => {
      const root = document.currentScript?.previousElementSibling;
      if (!(root instanceof HTMLElement)) return;
      // No native popover support: keep the plain fallback link.
      if (!("showPopover" in HTMLElement.prototype)) return;

      let books = {};
      let abbrs = {};
      let drafts = {};
      try {
        books = JSON.parse(root.getAttribute("data-books") || "{}");
        abbrs = JSON.parse(root.getAttribute("data-abbrs") || "{}");
        drafts = JSON.parse(root.getAttribute("data-drafts") || "{}");
      } catch {
        return;
      }
      const ORDER = Object.keys(books);
      if (!ORDER.length) return;

      const curBook = root.getAttribute("data-current-book") || "";
      const curChapter = root.getAttribute("data-current-chapter") || "";

      const link = root.querySelector("[data-rm-trigger]");
      if (!(link instanceof HTMLAnchorElement)) return;

      function label(key) {
        const m = String(key).match(/^(\d+)?([a-z]+)$/);
        if (!m) return String(key);
        return (
          (m[1] ? m[1] + " " : "") +
          m[2].charAt(0).toUpperCase() +
          m[2].slice(1)
        );
      }
      const draftSetOf = (key) => new Set(drafts[key] || []);
      const isFullDraft = (key) =>
        (drafts[key] || []).length > 0 &&
        (drafts[key] || []).length === books[key];
      const anyFullDraftBook = ORDER.some(isFullDraft);

      // Upgrade the fallback link into the popover trigger button, keeping
      // its rendered content (icon, current-location label, chevron).
      const trigger = document.createElement("button");
      trigger.type = "button";
      trigger.className = link.className;
      trigger.innerHTML = link.innerHTML;
      trigger.setAttribute("aria-haspopup", "dialog");
      trigger.setAttribute("aria-expanded", "false");
      link.replaceWith(trigger);

      const panel = document.createElement("div");
      panel.className = "read-menu__panel";
      panel.id = "read-menu-panel-" + Math.random().toString(36).slice(2, 8);
      panel.setAttribute("popover", "");
      panel.setAttribute("role", "dialog");
      panel.setAttribute("aria-label", "Go to passage");
      root.appendChild(panel);

      // Declare the trigger as this popover's invoker (rather than driving
      // showPopover()/hidePopover() from a plain click listener). Clicking
      // OUTSIDE the panel still light-dismisses exactly as before — that's
      // unchanged, auto popovers do that natively either way. What this
      // adds: the spec exempts a click on a popover's own declared invoker
      // from counting as an "outside" click, so a second click on the
      // trigger now toggles the panel closed. Without this, that second
      // click was light-dismissing it and THEN our own click handler
      // (seeing it already closed) was reopening it in the same tick — so
      // clicking the trigger again while open never visibly closed it.
      trigger.setAttribute("popovertarget", panel.id);
      trigger.setAttribute("popovertargetaction", "toggle");

      function positionPanel() {
        const r = trigger.getBoundingClientRect();
        const width = Math.min(560, window.innerWidth - 24);
        panel.style.width = width + "px";
        let left = r.left + r.width / 2 - width / 2;
        left = Math.max(12, Math.min(left, window.innerWidth - width - 12));
        panel.style.left = Math.round(left) + "px";
        let top = r.bottom + 8;
        const height = panel.getBoundingClientRect().height;
        top = Math.max(12, Math.min(top, window.innerHeight - height - 12));
        panel.style.top = Math.round(top) + "px";
      }

      function legendEl(readingModeKey) {
        const foot = document.createElement("div");
        foot.className = "read-menu__foot";
        const legend = document.createElement("span");
        legend.className = "read-menu__legend";
        legend.innerHTML =
          '<span class="read-menu__draft-dot" aria-hidden="true"></span> draft — translation in progress';
        foot.appendChild(legend);
        if (readingModeKey) {
          const a = document.createElement("a");
          a.className = "read-menu__reading-link";
          a.href = "/read/" + readingModeKey;
          a.textContent = "Open " + label(readingModeKey) + " in Reading Mode →";
          foot.appendChild(a);
        }
        return foot;
      }

      // Roving tabindex: one tab stop per grid; arrows move within it.
      function wireGrid(grid, focusTarget) {
        const cells = Array.from(grid.children);
        for (const c of cells) c.tabIndex = c === focusTarget ? 0 : -1;
        grid.addEventListener("keydown", (e) => {
          const i = cells.indexOf(document.activeElement);
          if (i < 0) return;
          const cols = getComputedStyle(grid)
            .gridTemplateColumns.split(" ").length;
          let j = null;
          if (e.key === "ArrowRight") j = Math.min(i + 1, cells.length - 1);
          else if (e.key === "ArrowLeft") j = Math.max(i - 1, 0);
          else if (e.key === "ArrowDown") j = Math.min(i + cols, cells.length - 1);
          else if (e.key === "ArrowUp") j = Math.max(i - cols, 0);
          else if (e.key === "Home") j = 0;
          else if (e.key === "End") j = cells.length - 1;
          if (j === null) return;
          e.preventDefault();
          cells[i].tabIndex = -1;
          cells[j].tabIndex = 0;
          cells[j].focus();
        });
      }

      function showBooks(focusKey) {
        panel.innerHTML = "";
        const head = document.createElement("p");
        head.className = "read-menu__head";
        head.textContent = "Choose a book";
        panel.appendChild(head);

        const grid = document.createElement("div");
        grid.className = "read-menu__grid read-menu__grid--books";
        let focusTarget = null;
        for (const key of ORDER) {
          const b = document.createElement("button");
          b.type = "button";
          b.className =
            "read-menu__cell" +
            (key === curBook ? " read-menu__cell--current" : "") +
            (isFullDraft(key) ? " read-menu__cell--draft" : "");
          b.textContent = abbrs[key] || label(key);
          b.title = label(key);
          b.setAttribute(
            "aria-label",
            label(key) + (isFullDraft(key) ? " (draft)" : ""),
          );
          b.addEventListener("click", () => showChapters(key));
          grid.appendChild(b);
          if (key === (focusKey || curBook)) focusTarget = b;
        }
        panel.appendChild(grid);
        if (anyFullDraftBook) panel.appendChild(legendEl(""));

        wireGrid(grid, focusTarget || grid.firstElementChild);
        positionPanel();
        (focusTarget || grid.firstElementChild).focus();
      }

      function showChapters(key) {
        panel.innerHTML = "";
        const head = document.createElement("div");
        head.className = "read-menu__bar";
        const back = document.createElement("button");
        back.type = "button";
        back.className = "read-menu__back";
        back.innerHTML = "&#8249; Books";
        back.addEventListener("click", () => showBooks(key));
        const name = document.createElement("span");
        name.className = "read-menu__book-name";
        name.textContent = label(key);
        const spacer = document.createElement("span");
        spacer.className = "read-menu__bar-spacer";
        head.append(back, name, spacer);
        panel.appendChild(head);

        const draftSet = draftSetOf(key);
        const grid = document.createElement("div");
        grid.className = "read-menu__grid read-menu__grid--chapters";

        // Chapter cells are real links: middle-click, long-press, and
        // "open in new tab" all behave, and the popover closes on unload.
        const intro = document.createElement("a");
        intro.className =
          "read-menu__cell read-menu__cell--intro" +
          (key === curBook && curChapter === "intro"
            ? " read-menu__cell--current"
            : "");
        intro.href = "/" + key + "-intro";
        intro.textContent = "Introduction";
        grid.appendChild(intro);

        let focusTarget = intro;
        for (let i = 1; i <= books[key]; i++) {
          const a = document.createElement("a");
          a.className =
            "read-menu__cell" +
            (key === curBook && curChapter === String(i)
              ? " read-menu__cell--current"
              : "") +
            (draftSet.has(i) ? " read-menu__cell--draft" : "");
          a.href = "/" + key + "-" + i;
          a.textContent = String(i);
          if (draftSet.has(i)) {
            a.setAttribute("aria-label", "Chapter " + i + " (draft)");
          }
          grid.appendChild(a);
          if (key === curBook && curChapter === String(i)) focusTarget = a;
        }
        panel.appendChild(grid);
        panel.appendChild(legendEl(key));

        wireGrid(grid, focusTarget);
        positionPanel();
        focusTarget.focus();
      }

      // Open/close is now driven by the browser via the invoker relationship
      // above (trigger click toggles; outside click still light-dismisses).
      // We just react to the state change: populate the book grid fresh
      // each time it opens, and keep aria-expanded in sync.
      panel.addEventListener("toggle", (e) => {
        const isOpen = e.newState === "open";
        trigger.setAttribute("aria-expanded", isOpen ? "true" : "false");
        if (isOpen) showBooks("");
      });

      // Keep Tab inside the open panel (the grids expose one tab stop each,
      // so the cycle is: back button → grid → footer link).
      panel.addEventListener("keydown", (e) => {
        if (e.key !== "Tab") return;
        const focusables = Array.from(
          panel.querySelectorAll('a[href], button:not([tabindex="-1"])'),
        );
        if (!focusables.length) return;
        const tabbables = focusables.filter((el) => el.tabIndex !== -1);
        const first = tabbables[0];
        const last = tabbables[tabbables.length - 1];
        if (e.shiftKey && document.activeElement === first) {
          e.preventDefault();
          last.focus();
        } else if (!e.shiftKey && document.activeElement === last) {
          e.preventDefault();
          first.focus();
        }
      });

      window.addEventListener("resize", () => {
        if (panel.matches(":popover-open")) positionPanel();
      });
      window.addEventListener(
        "scroll",
        () => {
          if (panel.matches(":popover-open")) panel.hidePopover();
        },
        { passive: true },
      );
    })();
  </script>

  <style is:global>
    .read-menu-wrap {
      display: flex;
      justify-content: center;
    }

    .read-menu .sr-only {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }

    /* --green-text flips to a LIGHT green in dark mode (it's a text token),
       so anywhere we use it as a background needs a paired foreground that
       flips to dark ink. */
    .read-menu {
      --rm-draft-dot: #8a5a00;
      --rm-accent-bg: var(--green-text);
      --rm-accent-fg: #ffffff;
    }

    @media (prefers-color-scheme: dark) {
      .read-menu {
        --rm-draft-dot: #d9a462;
        --rm-accent-fg: #1d231c;
      }
    }

    :root[data-theme="dark"] .read-menu {
      --rm-draft-dot: #d9a462;
      --rm-accent-fg: #1d231c;
    }

    .read-menu__trigger {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      /* Pinned to the same floor as the Reading View pill (whose fixed
         "Switch to Reading View" label renders ~243px) so the toolbar's two
         ends are the same size; long labels ("2 Thessalonians 3") still grow
         past it. Keep this in sync with .reading-view-pill in ScriptureLayout. */
      min-width: 245px;
      padding: 10px 18px;
      font-size: 16px;
      font-weight: 500;
      font-family: inherit;
      border: 1px solid rgba(var(--ink-rgb), 0.11);
      border-radius: 999px;
      background-color: var(--surface-input);
      color: var(--text);
      box-shadow: 0 2px 7px rgba(0, 0, 0, 0.08);
      cursor: pointer;
      text-decoration: none;
      transition:
        background-color 0.2s ease,
        color 0.2s ease;
    }

    .read-menu__trigger:hover {
      background-color: var(--rm-accent-bg);
      color: var(--rm-accent-fg);
    }

    .read-menu__icon {
      color: var(--green-text);
      font-size: 17px;
      flex: none;
    }

    .read-menu__trigger:hover .read-menu__icon {
      color: var(--rm-accent-fg);
    }

    .read-menu__chevron {
      font-size: 14px;
      opacity: 0.55;
      flex: none;
    }

    .read-menu__draft-dot {
      display: inline-block;
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: var(--rm-draft-dot);
      flex: none;
    }

    .read-menu__panel {
      position: fixed;
      inset: auto;
      margin: 0;
      padding: 14px;
      border: 1px solid rgba(var(--ink-rgb), 0.18);
      border-radius: 12px;
      background: var(--surface-raised);
      color: var(--text);
      box-shadow: 0 18px 44px rgba(0, 0, 0, 0.18);
      width: min(560px, calc(100vw - 24px));
      max-height: calc(100vh - 24px);
      overflow-y: auto;
    }

    .read-menu__head {
      margin: 2px 2px 10px;
      font-size: 0.85rem;
      color: rgba(var(--ink-rgb), 0.65);
    }

    .read-menu__bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
      margin: 0 0 10px;
    }

    .read-menu__back {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      padding: 4px 8px;
      font-size: 0.85rem;
      font-weight: 600;
      font-family: inherit;
      border: none;
      border-radius: 6px;
      background: transparent;
      color: var(--green-text);
      cursor: pointer;
    }

    .read-menu__back:hover {
      background: rgba(var(--ink-rgb), 0.1);
    }

    .read-menu__book-name {
      font-size: 0.9rem;
      font-weight: 600;
    }

    .read-menu__bar-spacer {
      width: 52px;
    }

    .read-menu__grid {
      display: grid;
      gap: 4px;
    }

    /* auto-fill + a measured minimum: the column count adapts to the
       available width (and to wider fonts) instead of overflowing. */
    .read-menu__grid--books {
      grid-template-columns: repeat(
        auto-fill,
        minmax(var(--rm-book-min, 62px), 1fr)
      );
    }

    .read-menu__grid--chapters {
      grid-template-columns: repeat(
        auto-fill,
        minmax(var(--rm-chapter-min, 48px), 1fr)
      );
    }

    /* OpenDyslexic is much wider than Inter — raise the floors so labels
       never clip inside their tiles. */
    html.dyslexic-font .read-menu__grid--books {
      --rm-book-min: 100px;
    }

    html.dyslexic-font .read-menu__grid--chapters {
      --rm-chapter-min: 56px;
    }

    .read-menu__cell {
      position: relative;
      display: block;
      padding: 12px 2px;
      font-size: 0.85rem;
      font-family: inherit;
      text-align: center;
      white-space: nowrap;
      border: none;
      border-radius: 8px;
      /* ink-tint instead of --surface-input: in dark mode the input token
         matches --surface-raised, which would make tiles invisible */
      background-color: rgba(var(--ink-rgb), 0.06);
      color: var(--text);
      cursor: pointer;
      text-decoration: none;
    }

    /* Touch screens: taller tiles so every cell clears ~44px targets */
    @media (pointer: coarse) {
      .read-menu__cell {
        padding-top: 14px;
        padding-bottom: 14px;
      }
    }

    .read-menu__cell:hover {
      background-color: rgba(var(--ink-rgb), 0.12);
    }

    .read-menu__cell:focus-visible,
    .read-menu__trigger:focus-visible,
    .read-menu__back:focus-visible {
      outline: 2px solid var(--green-text);
      outline-offset: 1px;
    }

    .read-menu__cell--current {
      background-color: var(--rm-accent-bg);
      color: var(--rm-accent-fg);
      font-weight: 600;
    }

    .read-menu__cell--current:hover {
      background-color: var(--rm-accent-bg);
    }

    .read-menu__cell--draft {
      opacity: 0.55;
    }

    .read-menu__cell--draft::after {
      content: "";
      position: absolute;
      top: 4px;
      right: 5px;
      width: 5px;
      height: 5px;
      border-radius: 50%;
      background: var(--rm-draft-dot);
    }

    .read-menu__cell--intro {
      grid-column: 1 / -1;
    }

    .read-menu__foot {
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 10px;
      margin: 12px 2px 0;
      font-size: 0.78rem;
      color: rgba(var(--ink-rgb), 0.65);
    }

    .read-menu__legend .read-menu__draft-dot {
      width: 5px;
      height: 5px;
      margin-right: 2px;
      vertical-align: 1px;
    }

    .read-menu__reading-link {
      color: var(--green-text);
      font-weight: 600;
      text-decoration: none;
      white-space: nowrap;
    }

    .read-menu__reading-link:hover {
      text-decoration: underline;
    }
  </style>
</div>
