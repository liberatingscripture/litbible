---
// AppsLaunchPopover — announces the iOS + Android app release. Shown once per
// visitor (cookie lit_apps_launch_v1, 30-day expiry), and only from the 2nd
// pageview of a session so it never fires on a search entrance. This is the
// site's single active announcement slot: Layout renders exactly one popover
// component, and retired ones (see WelcomePopover.astro) stay in the repo
// unimported so a past announcement can be brought back by swapping the
// import in Layout.astro.
import PlatformIcon from "./apps/PlatformIcon.astro";
---

<dialog
  id="apps-launch-popover"
  class="applaunch-dialog"
  aria-labelledby="applaunch-title"
  aria-modal="true"
>
  <div class="applaunch-inner">
    <button
      type="button"
      id="applaunch-close"
      class="applaunch-close"
      aria-label="Close app announcement"
    >
      <svg
        width="20"
        height="20"
        viewBox="0 0 20 20"
        aria-hidden="true"
        focusable="false"
      >
        <line
          x1="4"
          y1="4"
          x2="16"
          y2="16"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"></line>
        <line
          x1="16"
          y1="4"
          x2="4"
          y2="16"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"></line>
      </svg>
    </button>

    <div class="applaunch-logo">
      <img
        src="/images/lit-app-icon.svg"
        alt="LIT Bible app icon"
        width="104"
        height="104"
        loading="eager"
      />
    </div>

    <p class="applaunch-eyebrow">Now available</p>

    <h2 id="applaunch-title" class="applaunch-title">
      The LIT Bible app is here
    </h2>
    <p class="applaunch-subtitle">
      Read the Liberation and Inclusion Translation on your phone. Free, with no
      account and no ads.
    </p>

    <ul class="applaunch-features" aria-label="About the LIT Bible apps">
      <li class="applaunch-feature">
        <div class="applaunch-feature-icon applaunch-feature-icon--platforms" aria-hidden="true">
          <PlatformIcon platform="ios" />
          <PlatformIcon platform="android" />
        </div>
        <div>
          <strong>On iPhone and Android</strong>
          <span
            >Now on the App Store and Google Play. Daily and Lectionary
            readings, notes and highlights, and the whole New Testament
            offline.</span
          >
        </div>
      </li>
      <li class="applaunch-feature">
        <div class="applaunch-feature-icon" aria-hidden="true">
          <svg
            width="22"
            height="22"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path>
            <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path>
          </svg>
        </div>
        <div>
          <strong>Immersive reading</strong>
          <span
            >Toggle off verse numbers, chapter numbers, and footnote markers,
            and scripture reads the way it was first written: as letters and
            stories.</span
          >
        </div>
      </li>
    </ul>

    <div class="applaunch-ctas">
      <a href="/apps" class="applaunch-cta-primary">Get the app</a>
    </div>
  </div>
</dialog>

<style>
  /* Backdrop */
  .applaunch-dialog::backdrop {
    background: rgba(0, 0, 0, 0.55);
    transition: opacity 0.25s ease;
  }

  /* Dialog container */
  .applaunch-dialog {
    position: fixed;
    inset: 0;
    margin: auto;
    padding: 0;
    border: none;
    border-radius: 12px;
    background: var(--surface-raised, #fff);
    color: var(--text, #1d231c);
    width: min(600px, calc(100vw - 2.5rem));
    max-height: 90vh;
    overflow-y: auto;
    box-shadow: 0 8px 40px rgba(0, 0, 0, 0.22);
    /* Entry animation */
    opacity: 0;
    transform: translateY(12px) scale(0.98);
    transition:
      opacity 0.15s ease,
      transform 0.15s ease;
  }

  .applaunch-dialog[open] {
    opacity: 1;
    transform: translateY(0) scale(1);
  }

  .applaunch-dialog[open].is-closing {
    opacity: 0;
    transform: translateY(12px) scale(0.98);
    pointer-events: none;
  }

  .applaunch-dialog[open].is-closing::backdrop {
    opacity: 0;
  }

  /* Inner padding */
  .applaunch-inner {
    position: relative;
    padding: clamp(1rem, 3vw, 1.5rem);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0;
  }

  /* Close button */
  .applaunch-close {
    position: absolute;
    top: 1rem;
    right: 1rem;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    padding: 0;
    border: none;
    border-radius: 50%;
    background: transparent;
    color: var(--text, #1d231c);
    cursor: pointer;
    opacity: 0.6;
    transition:
      opacity 0.15s,
      background 0.15s;
  }

  .applaunch-close:hover,
  .applaunch-close:focus-visible {
    opacity: 1;
    background: rgba(var(--ink-rgb, 29, 35, 28), 0.08);
    outline: none;
  }

  .applaunch-logo {
    margin-bottom: 0.75rem;
  }

  .applaunch-logo img {
    display: block;
    width: clamp(80px, 22vw, 96px);
    height: auto;
    /* The app mark is a bright gradient on transparency, and its lime end
       (#BDF76B) all but vanishes against the light-theme surface (#FAFAF8).
       The ink tile keeps the whole gradient legible in BOTH themes and frames
       the mark the way an app icon actually appears on a home screen. The
       colour is fixed, not tokenised, so the tile can't invert out from under
       the gradient in dark mode. */
    border-radius: 22%;
    background: #1b2318;
    padding: 9%;
    box-sizing: border-box;
  }

  /* Eyebrow */
  .applaunch-eyebrow {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--green-text, #0f6b33);
    margin: 0 0 0.4rem 0;
  }

  /* Title */
  .applaunch-title {
    font-family: "Crimson Text", "Crimson Fallback", Georgia, "Times New Roman",
      serif;
    font-size: clamp(1.5rem, 4vw, 2rem);
    font-weight: 600;
    color: var(--text-strong, #000);
    margin: 0 0 0.5rem 0;
    line-height: 1.2;
  }

  /* Subtitle */
  .applaunch-subtitle {
    font-size: 1rem;
    color: var(--text, #1d231c);
    opacity: 0.75;
    margin: 0 0 1.1rem 0;
  }

  /* Feature list */
  .applaunch-features {
    list-style: none;
    margin: 0 0 1.25rem 0;
    padding: 0;
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    text-align: left;
  }

  .applaunch-feature {
    display: flex;
    align-items: flex-start;
    gap: 0.875rem;
    background: rgba(var(--ink-rgb, 29, 35, 28), 0.04);
    border-radius: 8px;
    padding: 0.75rem 1rem;
  }

  /* Fixed-width icon column, left-aligned. The platforms row holds two marks
     and the others hold one, so without a shared column width the rows' text
     would start at different x positions. */
  .applaunch-feature-icon {
    flex-shrink: 0;
    margin-top: 2px;
    width: 38px;
    display: flex;
    align-items: center;
    color: var(--green-text, #0f6b33);
  }

  .applaunch-feature-icon--platforms {
    gap: 0.35rem;
    /* PlatformIcon sizes itself in em, so this sets the pair's optical weight
       to match the 22px stroke icons in the other rows. */
    font-size: 17px;
  }

  .applaunch-feature div:last-child {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .applaunch-feature strong {
    font-size: 0.975rem;
    font-weight: 600;
    color: var(--text-strong, #000);
  }

  .applaunch-feature span {
    font-size: 0.9rem;
    line-height: 1.45;
    color: var(--text, #1d231c);
    opacity: 0.8;
  }

  /* CTA buttons */
  .applaunch-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: center;
    width: 100%;
  }

  .applaunch-cta-primary {
    display: inline-block;
    padding: 0.65rem 1.5rem;
    border-radius: 6px;
    font-size: 0.975rem;
    font-weight: 600;
    text-decoration: none;
    transition: opacity 0.15s;
    cursor: pointer;
    /* Deep Green + white is the solid-button pairing and is theme-invariant,
       so the launch CTA reads as the same branded button in light and dark.
       The --cta-bg/--cta-text pair the retired popover used inverts in dark
       mode and lands as a neutral grey chip. */
    background: var(--green-deep, #0f6b33);
    color: #fff;
  }

  .applaunch-cta-primary:hover,
  .applaunch-cta-primary:focus-visible {
    opacity: 0.85;
    text-decoration: none;
    outline-offset: 3px;
  }
</style>

<script>
  const COOKIE_NAME = "lit_apps_launch_v1";
  const COOKIE_DAYS = 30;

  function getCookie(name: string): string | null {
    const match = document.cookie.match(
      new RegExp(
        "(?:^|; )" +
          name.replace(/([.*+?^=!:${}()|[\]/\\])/g, "\\$1") +
          "=([^;]*)",
      ),
    );
    return match ? decodeURIComponent(match[1]) : null;
  }

  function setCookie(name: string, value: string, days: number) {
    const expires = new Date(Date.now() + days * 864e5).toUTCString();
    document.cookie = `${name}=${encodeURIComponent(value)}; expires=${expires}; path=/; SameSite=Lax`;
  }

  function dismissAndSet() {
    if (dialog.classList.contains("is-closing")) return;
    setCookie(COOKIE_NAME, "1", COOKIE_DAYS);
    dialog.classList.add("is-closing");
    setTimeout(() => dialog.close(), 250);
  }

  const dialog = document.getElementById(
    "apps-launch-popover",
  ) as HTMLDialogElement;

  let pageviews = 1;
  try {
    pageviews = (parseInt(sessionStorage.getItem("lit_pv") || "0", 10) || 0) + 1;
    sessionStorage.setItem("lit_pv", String(pageviews));
  } catch (_) { /* storage unavailable → treat as first pageview */ }

  // Never on a session entrance (a modal on a search-landing page is exactly
  // what Google's intrusive-interstitial penalty targets), never on a shared
  // verse deep link, and never on /apps (the CTA's own destination) or
  // /privacy (a page people open to read terms, not to be pitched to).
  const SUPPRESSED_PATHS = /^\/(apps|privacy)\/?$/;
  const isVerseDeepLink = /^#v\d+$/.test(location.hash);
  const isSuppressedPath = SUPPRESSED_PATHS.test(location.pathname);
  const eligible = !isVerseDeepLink && !isSuppressedPath && pageviews >= 2;

  if (dialog && !getCookie(COOKIE_NAME) && eligible) {
    // Open once the main thread is idle so the page's load-time long tasks
    // (fonts, header scripts) finish first. The popover forces an immediate
    // first interaction (the close click); opening it before those tasks
    // settle is what inflated INP (input delay) on the close button. The
    // timeout guarantees it still appears promptly even on a busy thread.
    const show = () => dialog.showModal();
    if ("requestIdleCallback" in window) {
      requestIdleCallback(show, { timeout: 1500 });
    } else {
      setTimeout(show, 200);
    }
  }

  // Close on X button
  document
    .getElementById("applaunch-close")
    ?.addEventListener("click", dismissAndSet);

  // Close on backdrop click (click lands on the <dialog> element itself, not .applaunch-inner)
  dialog?.addEventListener("click", (e) => {
    if (e.target === dialog) dismissAndSet();
  });

  // Close on Escape key (native dialog behavior) — set cookie so it doesn't reappear
  dialog?.addEventListener("cancel", (e) => {
    e.preventDefault(); // prevent default close so we can set cookie first
    dismissAndSet();
  });

  // CTA links close the popover and set cookie before navigating
  dialog?.querySelectorAll(".applaunch-cta-primary").forEach((link) => {
    link.addEventListener("click", () =>
      setCookie(COOKIE_NAME, "1", COOKIE_DAYS),
    );
  });
</script>
