---
import Layout from "../layouts/Layout.astro";
import "../styles/pages/contact.css";
---

<Layout
  title="Contact | Liberation and Inclusion Translation"
  description="Contact Brandon Vélez Johnson about the Liberation and Inclusion Translation (LIT)—questions, feedback, speaking, and collaboration."
>
  <div class="contact-page">
    <section class="contact-hero" aria-labelledby="contact-title">
      <div class="contact-inner">
        <h1 id="contact-title">Contact me</h1>

        <p class="contact-lead">
          I would love to connect to answer questions, get your input on this
          work-in-progress, talk about me speaking with a group, or just to chat
          about the Bible and spirituality. Feel free to reach out!
        </p>

        <img
          class="contact-logo"
          src="/images/lit-logo.png"
          alt="Liberation and Inclusion Translation logo."
          loading="lazy"
          decoding="async"
        />

        {/* Posts to the contact-form Worker (workers/contact-form/), which
            verifies the Turnstile token server-side and delivers the message
            via Cloudflare Email Routing. A native no-JS POST works too: the
            Worker 303-redirects to /contact/thanks/. */}
        <form
          class="contact-form"
          action="/contact/submit"
          method="POST"
          data-contact-form
        >
          <input type="hidden" name="source" value="contact" />

          {/* Honeypot (spam trap) */}
          <input
            type="hidden"
            name="_gotcha"
            value=""
          />

          <div class="field">
            <label for="name">Name</label>
            <input
              id="name"
              name="name"
              type="text"
              autocomplete="name"
              required
              placeholder="Your name"
            />
          </div>

          <div class="field">
            <label for="email">Email</label>
            <input
              id="email"
              name="email"
              type="email"
              inputmode="email"
              autocomplete="email"
              required
              placeholder="you@example.com"
            />
          </div>

          <div class="field">
            <label for="message">Message</label>
            <textarea
              id="message"
              name="message"
              rows="7"
              required
              placeholder="What would you like to share?"></textarea>
          </div>

          <div class="contact-turnstile-row">
            <div class="cf-turnstile" data-sitekey="0x4AAAAAACxG-At0E7VLZgdC"></div>
            <p class="contact-status" role="status" aria-live="polite" aria-atomic="true"></p>
          </div>

          <button class="contact-button" type="submit">Send message</button>

          <p class="contact-privacy">
            This form sends your message to our email inbox and is not intended
            for sensitive personal information.
            <br />
            <br />
            We will never sell or share your information.
          </p>
        </form>
      </div>

      <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer is:inline></script>

      <script is:inline>
        (() => {
          const form = document.querySelector("form[data-contact-form]");
          if (!form) return;

          const status = form.querySelector(".contact-status");
          const button = form.querySelector('button[type="submit"]');

          form.addEventListener("submit", async (e) => {
            e.preventDefault();

            // Honeypot filled? Pretend success.
            const hp = form.querySelector('input[name="_gotcha"]');
            if (hp && hp.value) return;

            // Turnstile token missing? Block submission.
            const turnstileToken = form.querySelector('input[name="cf-turnstile-response"]');
            if (!turnstileToken || !turnstileToken.value) {
              status.textContent = "Please complete the security check before sending.";
              return;
            }

            status.className = "contact-status";
            status.textContent = "";
            button.disabled = true;

            try {
              const data = new FormData(form);
              const res = await fetch(form.action, {
                method: "POST",
                body: data,
                headers: { Accept: "application/json" },
              });

              if (res.ok) {
                form.reset();
                status.className = "contact-status is-success";
                status.textContent = "Thanks — your message has been sent.";
                if (window.turnstile) window.turnstile.reset();
              } else {
                status.className = "contact-status is-error";
                status.textContent =
                  res.status === 403
                    ? "The security check could not be verified. Please complete it again and resend."
                    : res.status === 429
                      ? "Several messages were sent in a short time. Please wait a minute and try again."
                      : "Something went wrong. Please try again in a moment.";
                // Turnstile tokens are single-use: the server consumed this
                // one, so a retry needs a fresh widget pass.
                if (window.turnstile) window.turnstile.reset();
              }
            } catch {
              status.className = "contact-status is-error";
              status.textContent =
                "Network error. Please try again in a moment.";
            } finally {
              button.disabled = false;
            }
          });
        })();
      </script>
    </section>
  </div>
</Layout>
