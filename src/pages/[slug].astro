---
import ScriptureLayout from "../layouts/ScriptureLayout.astro";
import { BOOKS as books, bookKeyToLabel } from "../data/books.js";
import { prepareStudyParagraph } from "../lib/chapter-html";
import { linkRefs } from "../lib/scripture-refs-data.mjs";
import ChapterCtas from "../components/ChapterCtas.astro";
import DraftPage from "../components/DraftPage.astro";

type Footnote = {
  id: string; // e.g. "fn-a"
  refId: string; // e.g. "fnref-a"
  label: string; // e.g. "a"
  html: string; // inner HTML for the note content
};

type ChapterData = {
  bookKey?: string;
  chapter: number;
  indexed?: boolean;

  // Optional meta (lets your JSON drive these instead of generic strings)
  type?: string;
  title?: string;
  description?: string;
  topics?: string[];

  // New mode (Luke 4 style)
  paragraphs: string[];

  // Optional (Luke 4 style)
  footnotes?: Footnote[];
};

type ChapterModule = { default: ChapterData };

const chapterModules = import.meta.glob<ChapterModule>(
  "../data/chapters/*.json",
  { eager: true },
);

function getChapter(slug: string): ChapterData | null {
  const key = `../data/chapters/${slug}.json`;
  const mod = chapterModules[key];
  return mod?.default ?? null;
}

function normalizeBookKey(key: string) {
  return String(key ?? "")
    .trim()
    .toLowerCase()
    .replace(/\s+/g, "");
}

// This route only serves chapter pages; intros live at /[book]-intro.astro.
type StaticPath = {
  params: { slug: string };
  props: { bookKey: string; chapter: number; slug: string };
};

export function getStaticPaths(): StaticPath[] {
  const paths: StaticPath[] = [];

  const bookEntries = Object.entries(books as Record<string, number>);

  for (const [bookKey, chapterCountRaw] of bookEntries) {
    const chapterCount = Number(chapterCountRaw) || 0;

    // IMPORTANT:
    // Intros are handled by /[book]-intro.astro, so DO NOT generate them here.
    // This prevents collisions like /matthew-intro between /[slug] and /[book]-intro.
    for (let ch = 1; ch <= chapterCount; ch++) {
      paths.push({
        params: { slug: `${bookKey}-${ch}` },
        props: {
          bookKey,
          chapter: ch,
          slug: `${bookKey}-${ch}`,
        },
      });
    }
  }

  return paths;
}

const props = Astro.props as StaticPath["props"];

const chapterSlug = props.slug;
const chapterData = getChapter(props.slug);

const topics = Array.isArray(chapterData?.topics) ? chapterData!.topics : [];

const normalizedBookKey = normalizeBookKey(props.bookKey);
const bookName = bookKeyToLabel(normalizedBookKey);

const chapterNumberLabel = String(props.chapter);

const title = chapterData?.title
  ? `${chapterData.title} | Liberation and Inclusion Translation`
  : `${bookName} ${chapterNumberLabel} | Liberation and Inclusion Translation`;

const description = chapterData?.description
  ? chapterData.description
  : `${bookName} ${chapterNumberLabel} in the Liberation and Inclusion Translation (LIT).`;

const paragraphsRaw = Array.isArray(chapterData?.paragraphs)
  ? chapterData!.paragraphs
  : [];

const shouldIndex = chapterData?.indexed !== false;

const seenVerseIds = new Set<string>();
const verseState = { currentVerse: null as number | null };
const paragraphs = paragraphsRaw.map((html) =>
  prepareStudyParagraph(
    html,
    normalizedBookKey,
    props.chapter,
    seenVerseIds,
    verseState,
  ),
);

// References in a note ("Romans 2:24") link at render; the JSON the apps
// read keeps its plain text. See src/lib/scripture-refs.mjs.
const footnotes = (Array.isArray(chapterData?.footnotes)
  ? chapterData!.footnotes
  : []
).map((fn) => ({ ...fn, html: linkRefs(fn.html) }));

// A draft (or a chapter with no text yet) gets the draft page instead of its
// stored placeholder; see src/components/DraftPage.astro.
const isDraftPage = !shouldIndex || paragraphs.length === 0;
---

<ScriptureLayout
  title={title}
  description={description}
  book={props.bookKey}
  chapter={props.chapter}
  type="scripture"
  topics={topics}
  robotsIndex={shouldIndex}
  ogImage={`${Astro.site ? Astro.site.origin : "https://litbible.net"}/og/${chapterSlug}.png`}
  twitterCard="summary_large_image"
>
  <Fragment slot="head">
    {/* Citation meta — helps academic crawlers and AI systems attribute the text */}
    <meta name="citation_title" content={`${bookName} ${chapterNumberLabel} — Liberation and Inclusion Translation`} />
    <meta name="citation_author" content="Vélez Johnson, Brandon C." />
    <meta name="citation_publisher" content="Liberating Scripture Collective" />
    <meta name="citation_language" content="en" />
    <meta name="citation_date" content="2024" />
    <meta name="citation_fulltext_world_readable" content="" />
    {chapterSlug && <meta name="citation_public_url" content={`https://litbible.net/${chapterSlug}/`} />}

    {/* Chapter JSON-LD */}
    {chapterSlug && (
      <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Chapter",
        "name": `${bookName} ${chapterNumberLabel}`,
        "translator": {
          "@type": "Person",
          "name": "Brandon C. Vélez Johnson",
          "url": "https://litbible.net/about"
        },
        "isPartOf": {
          "@type": "Book",
          "name": "Liberation and Inclusion Translation",
          "alternateName": "LIT Bible",
          "author": {
            "@type": "Organization",
            "name": "Liberating Scripture Collective",
            "url": "https://liberatingscripture.org"
          },
          "translator": {
            "@type": "Person",
            "name": "Brandon C. Vélez Johnson",
            "url": "https://litbible.net/about"
          },
          "inLanguage": "en",
          "url": "https://litbible.net"
        },
        "url": `https://litbible.net/${chapterSlug}/`,
        "inLanguage": "en",
        "publisher": {
          "@type": "Organization",
          "name": "Liberating Scripture Collective",
          "url": "https://liberatingscripture.org"
        }
      })} />
    )}

    {/* BreadcrumbList JSON-LD */}
    {chapterSlug && (
      <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://litbible.net/" },
          { "@type": "ListItem", "position": 2, "name": "Read", "item": "https://litbible.net/read/" },
          { "@type": "ListItem", "position": 3, "name": bookName, "item": `https://litbible.net/read/${normalizedBookKey}/` },
          { "@type": "ListItem", "position": 4, "name": `${bookName} ${chapterNumberLabel}`, "item": `https://litbible.net/${chapterSlug}/` }
        ]
      })} />
    )}
  </Fragment>
  {/* The last-read attributes arm Continue reading; drafts never set them. */}
  <article
    class="chapter"
    data-last-read-book={isDraftPage ? undefined : normalizedBookKey}
    data-last-read-chapter={isDraftPage ? undefined : props.chapter}
  >
        {/* Hidden description for Hebrew poetry blockquotes referenced by aria-describedby */}
        <div id="hbq-description" hidden>Formatted as Hebrew and Semitic poetry with indented parallel lines</div>
        {/* H1 is provided by <ScriptureHeader /> in ScriptureLayout */}

        {!isDraftPage ? (
          <>
            <div class="chapter-paragraphs">
              {paragraphs.map((html) => (
                <div class="p" set:html={html} />
              ))}
            </div>

            {/* Chapter CTAs (below scripture text, above footnotes) */}
            <ChapterCtas bookKey={normalizedBookKey} chapter={props.chapter} />

            {/* Footnotes: shown to readers, excluded from search indexing */}
            {footnotes.length ? (
              <section
                class="footnotes-wrap"
                data-pagefind-ignore
                aria-labelledby="footnotes-title"
              >
                <h2 id="footnotes-title">Footnotes</h2>

                <ol class="footnotes">
                  {footnotes.map((fn) => (
                    <li id={fn.id}>
                      <div class="fn-body">
                        <a
                          href={`#${fn.refId}`}
                          class="footnote-backlink"
                          aria-label={`Back to footnote reference ${fn.label}`}
                        >
                          {fn.label}
                        </a>
                        <span set:html={fn.html} />
                      </div>
                    </li>
                  ))}
                </ol>
              </section>
            ) : null}

            {/* Back to top (excluded from Pagefind indexing + excerpts) */}
            <div class="back-to-top" data-pagefind-ignore>
              <a class="back-to-top__link" href="#chapter-title">
                Back to top ↑
              </a>
            </div>
          </>
        ) : (
          <>
            <DraftPage bookKey={normalizedBookKey} kind="chapter" />
            <ChapterCtas bookKey={normalizedBookKey} chapter={props.chapter} showSkipped={false} />
          </>
        )}
  </article>

  <style>
    /* Paragraph mode styling */
    .chapter-paragraphs :global(p) {
      margin: 0 0 12px;
      line-height: 1.75;
    }


    /* Add space between the end of the body text and the nav buttons */
    .chapter-paragraphs {
      margin-bottom: 40px; /* tweak: 24–40px usually feels right */
    }

    /* Breathing room above anchor targets (verse ids, paragraph anchors,
       footnotes) when the browser performs native hash scrolling */
    .chapter-paragraphs :global([id]),
    .footnotes li {
      scroll-margin-top: 16px;
    }

    /* Verse numbers inside paragraphs (ONLY these) */
    .chapter-paragraphs :global(sup.vn),
    .chapter-paragraphs :global(sup[id^="v"]) {
      font-weight: 400; /* unbold */
      font-size: 0.8em;
      line-height: 1;
      margin-right: 0;
      opacity: 0.85; /* optional, subtle */
    }

    /* Footnote refs in the MAIN scripture text only */
    .chapter-paragraphs :global(.fn-ref a) {
      text-decoration: none;
      color: var(--green-text, #0f6b33);
      font-weight: 700;
    }
    .chapter-paragraphs :global(.fn-ref a:hover) {
      text-decoration: underline;
    }

    /* Chapter CTAs — prev left, next right. margin-left:auto keeps a lone
       "next" on the right without invisible spacer elements; a lone "prev"
       (Revelation 22) sits left naturally. */
    :global(.chapter-ctas) {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 14px;
      margin: 18px 0 14px;
    }

    :global(.chapter-cta--next) {
      margin-left: auto;
    }

    /* Big, consistent button size */
    :global(.chapter-cta) {
      display: inline-flex;
      align-items: center;
      justify-content: center;

      width: clamp(240px, 42%, 420px);
      min-height: 56px;

      padding: 14px 22px;
      border-radius: 14px;

      background-color: var(--green-deep, #0f6b33);
      color: var(--white, #fff);

      font-size: 16px;
      font-weight: 400;
      letter-spacing: 0; /* match ScriptureHeader buttons */
      line-height: 1.15;
      text-align: center;
      white-space: normal;

      text-decoration: none; /* no underline ever */
      user-select: none;
      box-shadow: 0 12px 26px rgba(0, 0, 0, 0.2);

      transition:
        background-color 0.2s ease,
        /* match ScriptureHeader timing */ transform 0.2s ease;
    }

    :global(.chapter-cta:hover) {
      background-color: var(--ink); /* match ScriptureHeader hover */
      transform: translateY(-1px);
      text-decoration: none;
    }

    /* Inject arrows consistently via CSS (instead of hard-coding in labels) */
    :global(.chapter-cta--prev)::before {
      content: "◀ ";
      display: inline-block;
      width: 1.2em;
      text-align: left;
    }

    :global(.chapter-cta--next)::after {
      content: " ▶";
      display: inline-block;
      width: 1.2em;
      text-align: right;
    }

    @media (max-width: 560px) {
      :global(.chapter-ctas) {
        flex-direction: column;
        align-items: stretch;
      }

      :global(.chapter-cta) {
        width: 100%;
      }
    }

    /* Footnotes section */
    .footnotes-wrap {
      margin-top: 28px;
      padding-top: 18px;
      border-top: 1px solid rgba(var(--ink-rgb), 0.14);
    }

    .footnotes-wrap h2 {
      margin: 0 0 10px;
      font-size: 1.45rem;
      line-height: 1.2;
      font-weight: 700;
    }

    /* Footnotes list: show ONLY your a/b/c labels, not 1/2/3 */
    .footnotes {
      list-style: none;
      padding-left: 0;
      margin: 0;
    }

    .footnotes li {
      margin: 0 0 10px;
    }

    .footnotes .fn-body {
      margin: 0;
      line-height: 1.6;
    }

    .footnote-backlink {
      text-decoration: none;
      color: var(--green-text, #0f6b33);
      font-weight: 800;
      margin-right: 0.4rem;
    }

    .footnote-backlink:hover {
      text-decoration: underline;
    }

    /* Back to top (more separation from footnotes; green by default, white on hover) */
    .back-to-top {
      margin-top: 34px;
      padding-top: 10px;
      display: flex;
      justify-content: center;
    }

    .back-to-top__link {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 10px 18px;
      border-radius: 999px;
      text-decoration: none;
      user-select: none;

      background: var(--green-deep, #0f6b33);
      color: var(--white, #fff);
      font-weight: 600;

      box-shadow: 0 10px 22px rgba(0, 0, 0, 0.14);

      transition:
        background-color 0.18s ease,
        color 0.18s ease,
        transform 0.18s ease;
    }

    .back-to-top__link:hover {
      background: var(--surface-raised);
      color: var(--green-deep, #0f6b33);
      transform: translateY(-1px);
    }

    /* Hidden but still indexable */
    .pf-visually-hidden {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }

    /* HBQ layout is shared from global.css for study/read parity */
  </style>

  {/* Label footnote reference links in scripture text for screen readers */}
  <script is:inline>
    (() => {
      document.querySelectorAll('.fn-ref a').forEach(function(a) {
        if (!a.hasAttribute('aria-label')) {
          a.setAttribute('aria-label', 'Footnote reference ' + (a.textContent || '').trim());
        }
      });
    })();
  </script>

  {/* Native anchor scrolling handles #vN, paragraph, and footnote hashes.
      The one case the browser can't: a verse-RANGE hash (#v16-18) matches no
      element id, so scroll to its first verse. The bundled chapter-tools
      script applies the range highlight. */}
  <script is:inline>
    (() => {
      var m = window.location.hash.match(/^#v(\d+)-\d+$/);
      if (!m) return;
      var target = document.getElementById('v' + m[1]);
      if (target) target.scrollIntoView();
    })();
  </script>

  {/* Verse menus, range highlighting, footnote popovers (progressive enhancement) */}
  <script>
    import "../scripts/chapter-tools.js";
    import "../scripts/ref-preview.js";
    import { trackStudyView } from "../scripts/last-read.js";

    const lastReadRoot = document.querySelector("article.chapter[data-last-read-book]");
    if (lastReadRoot instanceof HTMLElement) trackStudyView(lastReadRoot);
  </script>
</ScriptureLayout>










