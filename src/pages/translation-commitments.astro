---
import Layout from '../layouts/Layout.astro';
import '../styles/pages/translation-commitments.css';
// Site 2.0's look of this page, behind the data-restyle stamp.
import '../styles/v2/commitments.css';
import tcData from '../data/translation-commitments.json';

const { commitments, narrative } = tcData;

// Site 2.0: the longer text's contents column (BVJ, 2026-11-17: "add a TOC
// column like on /about for the 'How these commitments work together'
// sheet"). Its links need targets, so each headed part gets an id made from
// its heading's words, in both looks.
const partId = (heading: string) =>
  "tc-" +
  heading
    .toLowerCase()
    .replace(/[’'“”"]/g, "")
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-|-$/g, "");
const parts = narrative.sections
  .filter((section) => section.heading)
  .map((section) => ({ id: partId(section.heading as string), heading: section.heading as string }));
---

<Layout
  title="Translation Commitments | Liberation and Inclusion Translation"
  description="The guiding commitments behind the Liberation and Inclusion Translation (LIT): a trauma-informed, liberationist translation that aims for faithfulness, clarity, and belonging."
  canonical="https://litbible.net/translation-commitments/"
>
  <article class="tc-page">
    <header class="tc-hero">
      <h1 class="tc-title v2-bar">Translation Commitments</h1>
      <p class="tc-lede">
        The LIT is a historical, literary translation from the original
        languages, guided by a set of commitments about meaning, power, harm,
        and hope. They’re the constraints that keep the work honest, the
        principles that guide how I weigh clarity, accuracy, and harm.
      </p>
    </header>

    <section class="tc-grid" aria-label="Translation commitments">
      {
        commitments.map((c) => (
          <section class="tc-card" data-key={c.key}>
            <div
              class="tc-iconTile"
              aria-hidden="true"
              style={`--icon-scale:${c.scale ?? 1.16}; --icon-x:${c.x ?? 0}px; --icon-y:${c.y ?? 0}px;`}
            >
              <img
                class="tc-icon"
                src={c.icon}
                alt=""
                loading="lazy"
                decoding="async"
              />
            </div>

            <h2 class="tc-cardTitle">{c.title}</h2>
            <p class="tc-cardBody">{c.body}</p>
          </section>
        ))
      }
    </section>

    <section class="tc-narrative v2-frame" aria-labelledby="tc-how">
      <nav class="tc-toc v2-frame__toc" data-v2 data-pagefind-ignore aria-label="On this page">
        <p class="v2-label">On this page</p>
        <ul>
          {parts.map((part) => (
            <li><a href={`#${part.id}`}>{part.heading}</a></li>
          ))}
        </ul>
      </nav>

      <div class="tc-narrative__inner v2-frame__text v2-sheet v2-sheet--bleed">
        <h2 id="tc-how">{narrative.title}</h2>
        {
          narrative.sections.map((section) => (
            <>
              {section.heading && <h3 class="v2-rule" id={partId(section.heading)}>{section.heading}</h3>}
              {section.paragraphs.map((para) => (
                <p set:html={para} />
              ))}
            </>
          ))
        }
      </div>
    </section>
  </article>

  {/* The contents column's "you are here" marker; inert without the stamp. */}
  <script>
    import "../scripts/v2-frame.js";
  </script>
</Layout>
