---
import Layout from '../layouts/Layout.astro';
import '../styles/pages/translation-commitments.css';
import tcData from '../data/translation-commitments.json';

const { commitments, narrative } = tcData;
---

<Layout
  title="Translation Commitments | Liberation and Inclusion Translation"
  description="The guiding commitments behind the Liberation and Inclusion Translation (LIT): a trauma-informed, liberationist translation that aims for faithfulness, clarity, and belonging."
  canonical="https://litbible.net/translation-commitments/"
>
  <article class="tc-page">
    <header class="tc-hero">
      <h1 class="tc-title">Translation Commitments</h1>
      <p class="tc-lede">
        The LIT is a historical, literary translation from the original
        languages, guided by a set of commitments about meaning, power, harm,
        and hope. They're the constraints that keep the work honest, the
        principles that guide how I weigh clarity, accuracy, and harm.
      </p>
    </header>

    <section class="tc-grid" aria-label="Translation commitments">
      {
        commitments.map((c) => (
          <section class="tc-card" data-key={c.key}>
            <div
              class="tc-iconTile"
              aria-hidden="true"
              style={`--icon-scale:${c.scale ?? 1.16}; --icon-x:${c.x ?? 0}px; --icon-y:${c.y ?? 0}px;`}
            >
              <img
                class="tc-icon"
                src={c.icon}
                alt=""
                loading="lazy"
                decoding="async"
              />
            </div>

            <h2 class="tc-cardTitle">{c.title}</h2>
            <p class="tc-cardBody">{c.body}</p>
          </section>
        ))
      }
    </section>

    <section class="tc-narrative" aria-labelledby="tc-how">
      <div class="tc-narrative__inner">
        <h2 id="tc-how">{narrative.title}</h2>
        {
          narrative.sections.map((section) => (
            <>
              {section.heading && <h3>{section.heading}</h3>}
              {section.paragraphs.map((para) => (
                <p set:html={para} />
              ))}
            </>
          ))
        }
      </div>
    </section>
  </article>
</Layout>
