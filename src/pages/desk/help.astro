---
// Help for the Study Desk preview (STUDY-DESK.md M12, D6; Audit 3, NB3-4 and
// decision 5): one page for the whole desk, the Notebook, /desk, sheets and
// the Greek. It was /notebook/help/ (that address redirects here). A static
// page that reads without the desk: it is noindex, out of the sitemap
// (astro.config.mjs), and (as every generic page) out of Pagefind. The
// Notebook's foot, the first-time choice, the tours and /desk's command row
// link here.
//
// Its shape (E125; BVJ, 2026-11-12): eight parts in the order a reader meets
// them, each a few topics, with a contents list (`parts`, below) that sits
// beside the text on a wide window and above it on a narrow one. Three rules:
// - Every id a link may cite stays on the heading that now holds its topic
//   (the desk links #ways-to-keep; test/desk-help-page.test.js lists them).
// - A new topic gets a row in `parts`, or the contents can't reach it; the
//   same test fails for a row with no heading, and a heading with no row.
// - Nothing is folded away: no <details>, no script. Find-in-page and an
//   anchor must reach every word.
import { MAX_FOLLOWING } from "../../lib/desk-bookmarks.mjs";
import { DESK_STAGE, FEEDBACK_HREF, FEEDBACK_LABEL } from "../../lib/desk-first-use.mjs";
import { MAX_PANES } from "../../lib/desk-layout.mjs";
import { TRASH_DAYS } from "../../lib/desk-records.mjs";
import Layout from "../../layouts/Layout.astro";
import "../../styles/pages/desk-help.css";

// The contents: each part's heading (an h2) and its topics (each an h3).
const parts = [
  {
    id: "start",
    title: "Getting started",
    topics: [
      { id: "what-it-is", title: "What the Study Desk is" },
      { id: "where-things-are", title: "Where to find each part" },
      { id: "tour", title: "Take a tour" },
    ],
  },
  {
    id: "marking",
    title: "Marking what you read",
    topics: [
      { id: "making-marks", title: "Notes, highlights, and bookmarks" },
      { id: "bookmarks", title: "Bookmarks that keep your place" },
      { id: "labels", title: "Labels" },
      { id: "footnote-pins", title: "Pinned footnotes" },
      { id: "panel", title: "The Notebook panel" },
      { id: "print-part", title: "Printing with your notes" },
    ],
  },
  {
    id: "desk-page",
    title: "The Study Desk page",
    topics: [
      { id: "desk-open", title: "Opening it" },
      { id: "desk-panes", title: "The kinds of pane" },
      { id: "desk-following", title: "Panes that follow, and “Stay here”" },
      { id: "desk-arrange", title: "Adding, moving, and sizing panes" },
      { id: "desk-full", title: "When the desk is full" },
      { id: "desk-layout", title: "Layouts and Reading" },
      { id: "desk-show", title: "What the text shows" },
      { id: "desk-menus", title: "Menus, keys, and printing" },
    ],
  },
  {
    id: "sheets",
    title: "Sheets",
    topics: [
      { id: "sheet-make", title: "Making a sheet" },
      { id: "sheet-parts", title: "Adding passages and parts" },
      { id: "sheet-templates", title: "Templates" },
      { id: "sheet-blanks", title: "Fill-in-the-blank passages" },
      { id: "sheet-size", title: "Text size" },
      { id: "sheet-tabs", title: "Saving, undoing, and two tabs" },
      { id: "sheet-versions", title: "Leader and participant versions" },
      { id: "sheet-output", title: "Print, copy, save, present, share" },
      { id: "sharing", title: "Sharing what you write" },
    ],
  },
  {
    id: "greek",
    title: "The Greek",
    topics: [
      { id: "greek-text", title: "Reading the Greek" },
      { id: "greek-word", title: "A word’s details" },
      { id: "greek-search", title: "Searching the Greek" },
      { id: "greek-sources", title: "Lexicons and sources" },
    ],
  },
  {
    id: "search",
    title: "Search and commands",
    topics: [
      { id: "search-box", title: "The search box" },
      { id: "search-pane", title: "The Search pane" },
      { id: "search-sheet", title: "Search results on a sheet" },
      { id: "commands", title: "Commands" },
    ],
  },
  {
    id: "keeping",
    title: "Keeping your notebook",
    topics: [
      { id: "ways-to-keep", title: "Where your notebook is kept" },
      { id: "copies", title: "Saving and opening a copy" },
      { id: "delete-everything", title: "The trash, and deleting everything" },
    ],
  },
  {
    id: "missing",
    title: "Send feedback",
    topics: [],
  },
