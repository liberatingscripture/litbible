---
import Layout from "../layouts/Layout.astro";
import "../styles/pages/unsubscribe.css";

/**
 * This form deliberately does NOT load Brevo's `main.js`, for the same reason
 * SiteFooter.astro doesn't. That script binds to the structural markup Brevo's
 * generated snippet ships with (.sib-form, #sib-form-container, #sib-container,
 * .entry__field, .sib-form-block__button, id="EMAIL"), none of which survives
 * restyling the form. Verified live 2026-07-21: it loads, binds a submit
 * handler that calls preventDefault, and then makes no request at all — so
 * pressing Unsubscribe silently did nothing and nobody was ever removed.
 *
 * Note that also disproves the old "the unsubscribe form works without JS"
 * claim: with JS on, main.js cancelled the native POST and dropped it. We POST
 * with our own fetch instead (the sibforms endpoint supports CORS and returns a
 * readable status). Do not "restore" main.js; its failure mode is silent.
 *
 * Unlike the newsletter form, there is no Turnstile here — Brevo's
 * unsubscription form carries no captcha — so the handler is just validate,
 * POST, report.
 */
---

<Layout
  title="Unsubscribe | Liberation and Inclusion Translation"
  description="Unsubscribe from the LIT Bible newsletter."
  robotsNoindex={true}
  hideFooterNewsletter={true}
>
  <div class="unsub-page">
    <div class="unsub-page__inner">
      <h1 class="unsub-page__heading">Unsubscribe</h1>

      <p class="unsub-page__desc">
        Enter your email address below to stop receiving emails from the LIT Bible newsletter.
      </p>

      <div id="error-message" class="unsub-message unsub-message--error" role="alert" aria-live="assertive" aria-atomic="true">
        <svg viewBox="0 0 512 512" aria-hidden="true" focusable="false" class="unsub-message__icon">
          <path d="M256 40c118.621 0 216 96.075 216 216 0 119.291-96.61 216-216 216-119.244 0-216-96.562-216-216 0-119.203 96.602-216 216-216m0-32C119.043 8 8 119.083 8 256c0 136.997 111.043 248 248 248s248-111.003 248-248C504 119.083 392.957 8 256 8zm-11.49 120h22.979c6.823 0 12.274 5.682 11.99 12.5l-7 168c-.268 6.428-5.556 11.5-11.99 11.5h-8.979c-6.433 0-11.722-5.073-11.99-11.5l-7-168c-.283-6.818 5.167-12.5 11.99-12.5zM256 340c-15.464 0-28 12.536-28 28s12.536 28 28 28 28-12.536 28-28-12.536-28-28-28z" />
        </svg>
        <span class="unsub-message__text">
          Your unsubscription could not be completed. Please try again.
        </span>
      </div>

      <div id="success-message" class="unsub-message unsub-message--success" role="status" aria-live="polite" aria-atomic="true">
        <svg viewBox="0 0 512 512" aria-hidden="true" focusable="false" class="unsub-message__icon">
          <path d="M256 8C119.033 8 8 119.033 8 256s111.033 248 248 248 248-111.033 248-248S392.967 8 256 8zm0 464c-118.664 0-216-96.055-216-216 0-118.663 96.055-216 216-216 118.664 0 216 96.055 216 216 0 118.663-96.055 216-216 216zm141.63-274.961L217.15 376.071c-4.705 4.667-12.303 4.637-16.97-.068l-85.878-86.572c-4.667-4.705-4.637-12.303.068-16.97l8.52-8.451c4.705-4.667 12.303-4.637 16.97.068l68.976 69.533 163.441-162.13c4.705-4.667 12.303-4.637 16.97.068l8.451 8.52c4.668 4.705 4.637 12.303-.068 16.97z" />
        </svg>
        <span class="unsub-message__text">
          You've been unsubscribed. You won't receive any more emails from us.
        </span>
      </div>

      <form
        id="sib-form"
        class="unsub-form"
        method="POST"
        action="https://1742a6b7.sibforms.com/serve/MUIFAF8ChGsVxj_DS8a2prrDhd_aJDuSiX055q-CeXeeggu8WXuqKN4fIV53ItwK37DD9N4qyOzyvq43hj7ealaGvKTyXIE0ZvlNztN9fyk1MOjFkaf4SLwE4LWj3VPv2VAxoQJGIoyH1xsY5nUoMqPKIUYyWRTei9Bnm54eu_3MHd9xtO2uFH0HJdGSTSN3_v03ePWtOTfsTi7ikQ=="
        data-type="unsubscription"
        novalidate
      >
        <div class="unsub-form__row">
          <label for="unsub-email" class="sr-only">Email address</label>
          <input
            id="unsub-email"
            type="email"
            name="EMAIL"
            placeholder="your@email.com"
            autocomplete="email"
            required
            class="unsub-form__input"
          />
          <button type="submit" class="unsub-form__submit" form="sib-form">
            Unsubscribe
          </button>
        </div>

        <p class="unsub-form__field-error" aria-live="polite"></p>

        <input type="text" name="email_address_check" value="" class="unsub-form__honeypot" aria-hidden="true" tabindex="-1" autocomplete="off" />
        <input type="hidden" name="locale" value="en" />
      </form>
    </div>
  </div>
</Layout>

<script is:inline>
  (function () {
    var form = document.getElementById("sib-form");
    if (!form) return;

    var btn = form.querySelector(".unsub-form__submit");
    var input = form.querySelector('[name="EMAIL"]');
    var fieldError = form.querySelector(".unsub-form__field-error");
    var successEl = document.getElementById("success-message");
    var errorEl = document.getElementById("error-message");
    var errorText = errorEl && errorEl.querySelector(".unsub-message__text");

    function show(el) { if (el) el.classList.add("is-visible"); }
    function hide(el) { if (el) el.classList.remove("is-visible"); }

    function fail(message) {
      hide(successEl);
      if (errorText) errorText.textContent = message;
      show(errorEl);
      btn.disabled = false;
    }

    form.addEventListener("submit", function (e) {
      e.preventDefault();
      fieldError.textContent = "";
      hide(errorEl);

      if (!input.value || !input.checkValidity()) {
        fieldError.textContent = "Please enter a valid email address.";
        input.focus();
        return;
      }

      btn.disabled = true;

      fetch(form.action, {
        method: "POST",
        headers: { "Content-Type": "application/x-www-form-urlencoded" },
        body: new URLSearchParams({
          EMAIL: input.value,
          email_address_check: "",
          locale: "en",
        }).toString(),
      })
        .then(function (res) {
          if (res.ok) {
            form.hidden = true;
            hide(errorEl);
            show(successEl);
          } else {
            fail("Your unsubscription could not be completed. Please try again.");
          }
        })
        .catch(function () {
          fail("Couldn't reach the server. Check your connection and try again.");
        });
    });
  })();
</script>
