---
import Layout from "../layouts/Layout.astro";
import "../styles/pages/unsubscribe.css";
---

<Layout
  title="Unsubscribe — LIT Bible"
  description="Unsubscribe from the LIT Bible newsletter."
  robotsNoindex={true}
  hideFooterNewsletter={true}
>
  <div class="unsub-page">
    <div class="unsub-page__inner">
      <h1 class="unsub-page__heading">Unsubscribe</h1>

      <p class="unsub-page__desc">
        Enter your email address below to stop receiving emails from the LIT Bible newsletter.
      </p>

      <div id="error-message" class="unsub-message unsub-message--error" role="alert" aria-live="assertive" aria-atomic="true">
        <svg viewBox="0 0 512 512" aria-hidden="true" focusable="false" class="unsub-message__icon">
          <path d="M256 40c118.621 0 216 96.075 216 216 0 119.291-96.61 216-216 216-119.244 0-216-96.562-216-216 0-119.203 96.602-216 216-216m0-32C119.043 8 8 119.083 8 256c0 136.997 111.043 248 248 248s248-111.003 248-248C504 119.083 392.957 8 256 8zm-11.49 120h22.979c6.823 0 12.274 5.682 11.99 12.5l-7 168c-.268 6.428-5.556 11.5-11.99 11.5h-8.979c-6.433 0-11.722-5.073-11.99-11.5l-7-168c-.283-6.818 5.167-12.5 11.99-12.5zM256 340c-15.464 0-28 12.536-28 28s12.536 28 28 28 28-12.536 28-28-12.536-28-28-28z" />
        </svg>
        Your unsubscription could not be completed. Please try again.
      </div>

      <div id="success-message" class="unsub-message unsub-message--success" role="status" aria-live="polite" aria-atomic="true">
        <svg viewBox="0 0 512 512" aria-hidden="true" focusable="false" class="unsub-message__icon">
          <path d="M256 8C119.033 8 8 119.033 8 256s111.033 248 248 248 248-111.033 248-248S392.967 8 256 8zm0 464c-118.664 0-216-96.055-216-216 0-118.663 96.055-216 216-216 118.664 0 216 96.055 216 216 0 118.663-96.055 216-216 216zm141.63-274.961L217.15 376.071c-4.705 4.667-12.303 4.637-16.97-.068l-85.878-86.572c-4.667-4.705-4.637-12.303.068-16.97l8.52-8.451c4.705-4.667 12.303-4.637 16.97.068l68.976 69.533 163.441-162.13c4.705-4.667 12.303-4.637 16.97.068l8.451 8.52c4.668 4.705 4.637 12.303-.068 16.97z" />
        </svg>
        You've been unsubscribed. You won't receive any more emails from us.
      </div>

      <form
        id="sib-form"
        class="unsub-form"
        method="POST"
        action="https://1742a6b7.sibforms.com/serve/MUIFAF8ChGsVxj_DS8a2prrDhd_aJDuSiX055q-CeXeeggu8WXuqKN4fIV53ItwK37DD9N4qyOzyvq43hj7ealaGvKTyXIE0ZvlNztN9fyk1MOjFkaf4SLwE4LWj3VPv2VAxoQJGIoyH1xsY5nUoMqPKIUYyWRTei9Bnm54eu_3MHd9xtO2uFH0HJdGSTSN3_v03ePWtOTfsTi7ikQ=="
        data-type="unsubscription"
        novalidate
      >
        <div class="unsub-form__row">
          <label for="unsub-email" class="sr-only">Email address</label>
          <input
            id="unsub-email"
            type="email"
            name="EMAIL"
            placeholder="your@email.com"
            autocomplete="email"
            required
            data-required="true"
            class="unsub-form__input"
          />
          <button type="submit" class="unsub-form__submit" form="sib-form">
            Unsubscribe
          </button>
        </div>

        <p class="entry__error entry__error--primary unsub-form__field-error" aria-live="polite"></p>

        <input type="text" name="email_address_check" value="" class="unsub-form__honeypot" aria-hidden="true" tabindex="-1" autocomplete="off" />
        <input type="hidden" name="locale" value="en" />
      </form>
    </div>
  </div>
</Layout>

<script is:inline>
  window.REQUIRED_CODE_ERROR_MESSAGE = 'Please choose a country code';
  window.LOCALE = 'en';
  window.EMAIL_INVALID_MESSAGE = window.SMS_INVALID_MESSAGE = "The information provided is invalid. Please review the field format and try again.";
  window.REQUIRED_ERROR_MESSAGE = "This field cannot be left blank.";
  window.GENERIC_INVALID_MESSAGE = "The information provided is invalid. Please review the field format and try again.";
  window.translation = {
    common: {
      selectedList: '{quantity} list selected',
      selectedLists: '{quantity} lists selected',
      selectedOption: '{quantity} selected',
      selectedOptions: '{quantity} selected',
    }
  };
  var AUTOHIDE = Boolean(0);
</script>
<script defer src="https://sibforms.com/forms/end-form/build/main.js"></script>
