---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import "../styles/pages/glossary.css";

// Load and sort entries alphabetically by the traditional word.
// This drives both entry rendering order and menu population order.
const rawEntries = await getCollection("glossary");
const entries = await Promise.all(
  rawEntries
    .sort((a, b) => a.data.traditional.localeCompare(b.data.traditional))
    .map(async (entry) => ({
      data: entry.data,
      Content: (await entry.render()).Content,
    }))
);

// Build the menu data object at build time.
// The traditional category uses menuTraditional when provided (e.g. "Good -1-"),
// falling back to the traditional field. Both menus follow entry sort order.
const menuData = {
  traditional: Object.fromEntries(
    entries.map((e) => [
      e.data.menuTraditional ?? e.data.traditional,
      `/glossary/#${e.data.id}`,
    ])
  ),
  lit: Object.fromEntries(
    entries.map((e) => [e.data.litMenu, `/glossary/#${e.data.id}`])
  ),
};
---

<Layout
  title="Glossary | Liberation and Inclusion Translation"
  description="A trauma-informed glossary explaining how key biblical terms are translated in the Liberation and Inclusion Translation (LIT), with historical, linguistic, and theological context."
  canonical="https://litbible.net/glossary/"
  bg="white"
  type="glossary"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "DefinedTermSet",
      "name": "LIT Bible Glossary",
      "description": "A trauma-informed glossary explaining how key biblical terms are translated in the Liberation and Inclusion Translation (LIT), with historical, linguistic, and theological context.",
      "url": "https://litbible.net/glossary/",
      "publisher": {
        "@type": "Organization",
        "name": "Liberating Scripture Collective",
        "url": "https://liberatingscripture.org"
      }
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://litbible.net/" },
        { "@type": "ListItem", "position": 2, "name": "Glossary", "item": "https://litbible.net/glossary/" }
      ]
    })} />
  </Fragment>
  <div class="glossary-page">
    <!-- PAGE HEADER (white background) -->
    <section class="glossary-hero" aria-labelledby="glossary-title">
      <div class="wrap">
        <h1 id="glossary-title" class="glossary-title">Glossary</h1>

        <p data-pagefind-ignore>
          There are many words you would expect to see if you're familiar with
          the Bible that you won't see in this translation. There are also many
          that may be unfamiliar.
        </p>
        <p data-pagefind-ignore>
          Some of them have been replaced because English has evolved over the
          last few hundred years and other words better capture the intended
          meaning of the Greek than what has become tradition. Others have been
          replaced because I'm convinced the words we've gotten used to were
          more or less the wrong choice to begin with. Other words have been
          replaced not because they are wrong but because we've gotten so used
          to them that it becomes difficult to be curious enough to really dig
          into what they are saying.
        </p>
        <p data-pagefind-ignore>
          As you look through the entries below, in bold, you'll find the
          traditional word. In italics is the Greek behind it. Underlined,
          you'll see what the LIT Bible uses in its place most often (it can
          change based on context).
        </p>
        <p data-pagefind-ignore>
          Feel free to contact me{" "}
          <a class="inline-link" href="/contact">here</a>{" "}
          if you think I've missed any important ones!
        </p>

        <!-- Sticky Glossary Menu (About-TOC style wrapper) -->
        <div
          class="glossary-toc"
          data-glossary-toc
          aria-label="Glossary Selection Menu"
          data-pagefind-ignore
        >
          <div class="glossary-toc__inner">
            <div class="glossary-toc__bar">
              <p class="glossary-toc__label">Jump to an entry</p>

              <button
                class="glossary-toc__toggle"
                type="button"
                aria-expanded="false"
                aria-controls="glossary-toc-tray"
              >
                <span class="glossary-toc__icon" aria-hidden="true"></span>
                <span class="sr-only">Toggle glossary menu</span>
              </button>
            </div>

            <div class="glossary-toc__tray" id="glossary-toc-tray">
              <!-- MENU -->
              <div class="title-menu" aria-label="Glossary Selection Menu">
                <div class="read-menu-wrap">
                  <div class="read-menu glossary-menu">
                    <label class="sr-only" for="category-select">
                      Select Glossary Category
                    </label>

                    <select
                      id="category-select"
                      aria-label="Select Glossary Category"
                    >
                      <option value="">Select Glossary Category</option>
                      <option value="traditional"
                        >Traditional Translation</option
                      >
                      <option value="lit">LIT Word Choice</option>
                    </select>

                    <label class="sr-only" for="word-select"
                      >Select a Word</label
                    >

                    <select
                      id="word-select"
                      aria-label="Select a Word"
                      disabled
                    >
                      <option value="">Select a Word</option>
                    </select>

                    <button id="go-button" type="button" disabled>Go</button>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Sticky toggle JS -->
        <script type="module">
          document.addEventListener("DOMContentLoaded", () => {
            const toc = document.querySelector("[data-glossary-toc]");
            if (!toc) return;

            const btn = toc.querySelector(".glossary-toc__toggle");
            const tray = toc.querySelector(".glossary-toc__tray");
            if (!btn || !tray) return;

            let ignoreScroll = false;
            const setOpen = (open) => {
              toc.classList.toggle("is-open", open);
              btn.setAttribute("aria-expanded", open ? "true" : "false");
              // Opening the tray shifts layout and can fire a spurious scroll event;
              // ignore scroll-to-close for a brief window after opening.
              if (open) {
                ignoreScroll = true;
                setTimeout(() => { ignoreScroll = false; }, 300);
              }
            };

            const syncForViewport = () => {
              const isMobile = window.matchMedia("(max-width: 760px)").matches;
              setOpen(!isMobile);
            };

            syncForViewport();
            window.addEventListener("resize", syncForViewport);

            btn.addEventListener("click", () => {
              setOpen(!toc.classList.contains("is-open"));
            });

            // Close on tap outside (mobile only)
            document.addEventListener("pointerdown", (e) => {
              if (
                window.matchMedia("(max-width: 900px)").matches &&
                toc.classList.contains("is-open") &&
                !toc.contains(e.target)
              ) {
                setOpen(false);
              }
            });

            // Close on scroll (mobile only)
            let scrollTimer;
            window.addEventListener("scroll", () => {
              if (
                ignoreScroll ||
                !window.matchMedia("(max-width: 900px)").matches ||
                !toc.classList.contains("is-open")
              ) return;
              clearTimeout(scrollTimer);
              scrollTimer = setTimeout(() => setOpen(false), 80);
            }, { passive: true });

            // Expose setOpen so the Go button handler can close the tray
            toc._setOpen = setOpen;
          });
        </script>

        <!-- Menu data (generated at build time from glossary collection) -->
        <script
          id="glossary-menu-data"
          type="application/json"
          set:html={JSON.stringify(menuData)}
        ></script>

        <!-- Menu JS — reads from embedded JSON so new entries are automatic -->
        <script type="module">
          document.addEventListener("DOMContentLoaded", () => {
            const glossary = JSON.parse(
              document.getElementById("glossary-menu-data").textContent
            );

            const categorySelect = document.getElementById("category-select");
            const wordSelect = document.getElementById("word-select");
            const goButton = document.getElementById("go-button");

            if (!categorySelect || !wordSelect || !goButton) return;

            wordSelect.disabled = true;
            goButton.disabled = true;

            categorySelect.addEventListener("change", () => {
              const selectedCategory = categorySelect.value;

              wordSelect.innerHTML = '<option value="">Select a Word</option>';
              wordSelect.disabled = true;
              goButton.disabled = true;

              if (selectedCategory && glossary[selectedCategory]) {
                const words = glossary[selectedCategory];
                for (const word in words) {
                  const option = document.createElement("option");
                  option.value = words[word];
                  option.textContent = word;
                  wordSelect.appendChild(option);
                }
                wordSelect.disabled = false;
              }
            });

            wordSelect.addEventListener("change", () => {
              goButton.disabled = !wordSelect.value;
            });

            goButton.addEventListener("click", () => {
              const selectedWordUrl = wordSelect.value;
              if (selectedWordUrl) {
                // Close tray on mobile before navigating
                const toc = document.querySelector("[data-glossary-toc]");
                if (toc?._setOpen && window.matchMedia("(max-width: 900px)").matches) {
                  toc._setOpen(false);
                }
                window.location.href = selectedWordUrl;
              }
            });
          });
        </script>

        <!-- ENTRIES BLOCK -->
        <section
          class="glossary-entries"
          data-pagefind-body
          data-pagefind-filter="type:glossary"
        >
          <!-- Index-only surface: just enough for search -->
          <div class="sr-only">
            <span data-pagefind-meta="title">Glossary</span>
            <span data-pagefind-meta="type">glossary</span>
            <span data-pagefind-meta="description">
              Translation glossary for key terms in the LIT.
            </span>
          </div>

          <!-- Full-bleed notch block -->
          <div class="entries-top" aria-hidden="true" data-pagefind-ignore>
          </div>

          <!-- Cream panel starts here -->
          <div class="entries-panel">
            <div class="wrap entries-wrap">
              {entries.map(({ data, Content }) => {
                const litParts = data.lit.split(" / ");
                return (
                  <article
                    class="entry"
                    data-entry={data.id}
                    data-animate="underline"
                  >
                    <header class="entry-head">
                      <h2 class="entry-title" id={data.id}>
                        {/* Index-only: search tokens for this entry */}
                        <span class="sr-only">{data.srOnly}</span>

                        <span class="entries-strike">
                          <strong>{data.traditional}</strong>
                        </span>

                        <span class="sep" data-pagefind-ignore>&nbsp;–&nbsp;</span>

                        {/* Greek transliteration is NOT Pagefind-indexed */}
                        <em data-pagefind-ignore>{data.greek}</em>

                        <span class="sep" data-pagefind-ignore>&nbsp;–&nbsp;</span>

                        {/* LIT word IS Pagefind-indexed */}
                        <span class="entries-underline">
                          {litParts.length === 1
                            ? litParts[0]
                            : litParts.map((part, i) => (
                                <>
                                  {i > 0 && (
                                    <>
                                      <span class="pf-slash-space"> </span>/<span class="pf-slash-space"> </span>
                                    </>
                                  )}
                                  {part}
                                </>
                              ))}
                        </span>

                        {/* Optional parenthetical note — not indexed */}
                        {data.note && (
                          <span data-pagefind-ignore> {data.note}</span>
                        )}
                      </h2>
                    </header>

                    {/* Definition body is NOT Pagefind-indexed */}
                    <div class="entry-body" data-pagefind-ignore>
                      <Content />
                    </div>
                  </article>
                );
              })}

              <script type="module" data-pagefind-ignore>
                // --- intersection observer: adds .is-visible and triggers redraw ---
                const entries = Array.from(
                  document.querySelectorAll(".glossary-page .entry"),
                );

                const io = new IntersectionObserver(
                  (items) => {
                    for (const item of items) {
                      if (item.isIntersecting) {
                        item.target.classList.add("is-visible");
                        revealInkInEntry(item.target);
                        io.unobserve(item.target);
                      }
                    }
                  },
                  { threshold: 0.25 },
                );

                entries.forEach((e) => io.observe(e));

                // --- ink drawing helpers ---
                function mulberry32(seed) {
                  return function () {
                    let t = (seed += 0x6d2b79f5);
                    t = Math.imul(t ^ (t >>> 15), t | 1);
                    t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
                    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
                  };
                }

                function hashString(str) {
                  let h = 2166136261;
                  for (let i = 0; i < str.length; i++) {
                    h ^= str.charCodeAt(i);
                    h = Math.imul(h, 16777619);
                  }
                  return h >>> 0;
                }

                function makeScribblePath({ w, h, kind, seed }) {
                  const rand = mulberry32(seed);

                  const padX = Math.max(2, w * 0.02);
                  const x0 = padX;
                  const x1 = w - padX;

                  const yStrike = h * 0.55;
                  const yUnderline = h * 0.92;
                  const baseY = kind === "strike" ? yStrike : yUnderline;

                  const amp =
                    kind === "strike"
                      ? Math.max(1.5, h * 0.1)
                      : Math.max(1.2, h * 0.07);

                  const points = [];
                  const steps = 6;

                  for (let i = 0; i <= steps; i++) {
                    const t = i / steps;
                    const x = x0 + (x1 - x0) * t;

                    const wobble = (rand() - 0.5) * 2 * amp;
                    const drift = Math.sin(t * Math.PI * 2) * (amp * 0.35);
                    const y = baseY + wobble * 0.55 + drift;

                    points.push({ x, y });
                  }

                  let d = `M ${points[0].x.toFixed(2)} ${points[0].y.toFixed(2)}`;
                  for (let i = 1; i < points.length - 1; i++) {
                    const cx = points[i].x;
                    const cy = points[i].y;
                    const nx = (points[i].x + points[i + 1].x) / 2;
                    const ny = (points[i].y + points[i + 1].y) / 2;
                    d += ` Q ${cx.toFixed(2)} ${cy.toFixed(2)} ${nx.toFixed(2)} ${ny.toFixed(2)}`;
                  }
                  const last = points[points.length - 1];
                  d += ` T ${last.x.toFixed(2)} ${last.y.toFixed(2)}`;
                  return d;
                }

                function clearInk(titleEl) {
                  titleEl
                    .querySelectorAll(":scope > .ink-svg")
                    .forEach((n) => n.remove());
                }

                function drawInkForSpan(span, kind) {
                  const title = span.closest(".entry-title");
                  if (!title) return;

                  const titleRect = title.getBoundingClientRect();
                  const rects = Array.from(span.getClientRects()).filter(
                    (r) => r.width > 1 && r.height > 1,
                  );

                  const seedBase = hashString(
                    (span.textContent || "").trim() + "|" + kind,
                  );

                  rects.forEach((r, idx) => {
                    const left = r.left - titleRect.left;
                    const top = r.top - titleRect.top;
                    const w = r.width;
                    const h = r.height;

                    const svg = document.createElementNS(
                      "http://www.w3.org/2000/svg",
                      "svg",
                    );
                    svg.classList.add("ink-svg");
                    svg.setAttribute("aria-hidden", "true");
                    svg.setAttribute("focusable", "false");

                    svg.style.left = `${left}px`;
                    svg.style.top = `${top}px`;
                    svg.style.width = `${w}px`;
                    svg.style.height = `${h}px`;

                    svg.setAttribute("viewBox", `0 0 ${w} ${h}`);
                    svg.setAttribute("preserveAspectRatio", "none");

                    const path = document.createElementNS(
                      "http://www.w3.org/2000/svg",
                      "path",
                    );
                    const seed = seedBase + idx * 101;

                    path.setAttribute(
                      "d",
                      makeScribblePath({ w, h, kind, seed }),
                    );
                    path.setAttribute("fill", "none");
                    path.setAttribute("stroke", "var(--lit-green)");
                    path.setAttribute("stroke-linecap", "round");
                    path.setAttribute("stroke-linejoin", "round");

                    const strokeW =
                      kind === "strike"
                        ? Math.max(1.9, h * 0.105)
                        : Math.max(1.8, h * 0.095);

                    path.setAttribute("stroke-width", strokeW.toFixed(2));

                    const len = path.getTotalLength();
                    path.style.strokeDasharray = `${len}`;
                    path.style.strokeDashoffset = `${len}`;
                    path.style.transition =
                      "stroke-dashoffset 900ms cubic-bezier(0.25, 0.8, 0.25, 1)";

                    svg.appendChild(path);
                    title.appendChild(svg);
                  });
                }

                function redrawAllInk() {
                  const titles = Array.from(
                    document.querySelectorAll(".glossary-page .entry-title"),
                  );
                  titles.forEach((title) => {
                    clearInk(title);
                    title
                      .querySelectorAll(".entries-strike")
                      .forEach((s) => drawInkForSpan(s, "strike"));
                    title
                      .querySelectorAll(".entries-underline")
                      .forEach((s) => drawInkForSpan(s, "underline"));
                  });

                  // reveal immediately for already-visible entries (above fold)
                  entries.forEach((entry) => {
                    if (entry.classList.contains("is-visible"))
                      revealInkInEntry(entry);
                  });
                }

                function revealInkInEntry(entryEl) {
                  entryEl.querySelectorAll(".ink-svg path").forEach((p) => {
                    p.style.strokeDashoffset = "0";
                  });
                }

                let raf = 0;
                function scheduleRedraw() {
                  cancelAnimationFrame(raf);
                  raf = requestAnimationFrame(redrawAllInk);
                }

                window.addEventListener("DOMContentLoaded", () => {
                  redrawAllInk();
                  window.addEventListener("resize", scheduleRedraw);
                  if (document.fonts && document.fonts.ready) {
                    document.fonts.ready.then(() => scheduleRedraw());
                  }
                });
              </script>
            </div>
          </div>
        </section>
      </div>
    </section>
  </div>
</Layout>
