---
import { getCollection, render } from "astro:content";
import Layout from "../layouts/Layout.astro";
import { BOOK_ORDER, bookKeyToLabel } from "../data/books.js";
import "../styles/pages/glossary.css";

const rawEntries = await getCollection("glossary");

/**
 * Phase 1 alignment records (src/data/alignment/, built by
 * scripts/build-alignment.mjs, reviewed via scripts/alignment-review/) — where
 * each term's LIT rendering actually appears in the published text. A glossary
 * entry says what `pneuma` becomes; this says where, and how often.
 *
 * THE DISPLAY RULE, and it is a publishing decision rather than a technical
 * one: a partial count reads as a reviewed total. So a term appears only when
 * every record we would show is one we can actually vouch for, and a single
 * record we can neither vouch for nor rule out withholds the whole term.
 *
 *   ignored       `rejected` / `no-rendering`, and anything the Greek check
 *                 contradicts (`lemma: "absent"`) — a known false positive
 *                 says nothing either way about the rest of the term
 *   shown         a human confirmed it, or the scan matched a rendering
 *                 distinctive enough that a string match is effectively
 *                 certain and the Greek doesn't contradict it
 *   withholds     an unreviewed match on ordinary English ("trust", "clean"),
 *                 which may or may not be rendering the Greek at all
 *
 * That last case is why `sarx` is currently absent: it also renders as the
 * ordinary word "family", which the scan cannot tell from a vocative
 * "Family," (cf. Rom 8:12). Reviewing those records is what surfaces it.
 */
type AlignmentRecord = {
  ref: string;
  english: { text: string; n: number }[];
  term: {
    greek: string;
    traditional: string;
    glossary: string;
    form: string | null;
  } | null;
  confidence: "distinctive" | "common" | null;
  lemma?: "present" | "absent" | "unchecked";
  status?: "auto" | "confirmed" | "no-rendering" | "rejected";
};

type AlignmentFile = {
  bookKey: string;
  chapter: number;
  records: AlignmentRecord[];
};

type OccurrenceRef = { bookKey: string; chapter: number; verse: number };

type FormOccurrences = {
  label: string;
  /** Occurrences — a verse rendering the term four times counts four. */
  count: number;
  /** Distinct verses, which is what `refs` lists. Below `count` when a verse
   *  renders the term more than once (Romans 2:12 carries "Torah" 4x). */
  verses: number;
  books: number;
  refs: OccurrenceRef[];
};

const alignmentModules = import.meta.glob<{ default: AlignmentFile }>(
  "../data/alignment/*.json",
  { eager: true },
);

/** How many verse links a rendering shows before the "show more" batching
 *  kicks in — and the size of each subsequent batch. Purely a client-side
 *  reveal: every link is server-rendered, so with JS off the full list is
 *  there. */
const OCC_CAP = 30;

const BOOK_RANK = new Map(
  (BOOK_ORDER as string[]).map((key, i) => [key, i] as const),
);
const bookRank = (key: string) => BOOK_RANK.get(key) ?? Number.MAX_SAFE_INTEGER;

/** See the display rule above. Returns null for a record that says nothing. */
function verdict(record: AlignmentRecord): "show" | "withhold" | null {
  const status = record.status ?? "auto";
  if (status === "rejected" || status === "no-rendering") return null;
  if (record.lemma === "absent") return null;
  if (status === "confirmed") return "show";
  return record.confidence === "distinctive" ? "show" : "withhold";
}

const occurrencesByTerm: Record<string, FormOccurrences[]> = (() => {
  const byTerm = new Map<
    string,
    { pure: boolean; forms: Map<string, OccurrenceRef[]> }
  >();

  for (const mod of Object.values(alignmentModules)) {
    const { bookKey, chapter, records } = mod.default;
    for (const record of records ?? []) {
      const id = record.term?.glossary;
      if (!id) continue;

      const call = verdict(record);
      if (!call) continue;

      // One unvouchable record withholds the term, even though the record
      // itself contributes no count — a subtotal presented as a total is the
      // failure mode this guards against.
      let entry = byTerm.get(id);
      if (!entry) byTerm.set(id, (entry = { pure: true, forms: new Map() }));
      if (call === "withhold") {
        entry.pure = false;
        continue;
      }

      const form = record.term?.form;
      if (!form) continue;

      // Group by the glossary rendering, not the written text: "Life-breath",
      // "life-breath", and "life-breaths" are one rendering to a reader. The
      // records keep each written variant, so Romans 8:2's deliberate
      // "Torah"/"torah" pair survives in the data even though the count here
      // shows them together.
      let refs = entry.forms.get(form);
      if (!refs) entry.forms.set(form, (refs = []));
      refs.push({
        bookKey,
        chapter,
        verse: Number(record.ref.split(".").pop()),
      });
    }
  }

  const out: Record<string, FormOccurrences[]> = {};
  for (const [id, entry] of byTerm) {
    // A term whose every record was ignored (all reviewed to "no rendering",
    // say) is settled, not shown — an empty "Where it appears" block would
    // claim the opposite of what the data says.
    if (!entry.pure || !entry.forms.size) continue;
    out[id] = [...entry.forms.entries()]
      .map(([label, refs]) => {
        const sorted = refs.sort(
          (a, b) =>
            bookRank(a.bookKey) - bookRank(b.bookKey) ||
            a.chapter - b.chapter ||
            a.verse - b.verse,
        );
        // One link per verse. The records are per-OCCURRENCE, so a verse
        // rendering the term more than once produced one ref each — and a
        // reader meeting "Romans 2:12" four times in a row reads it as a bug,
        // not as the frequency claim it actually is. The count above still
        // carries that frequency.
        const seen = new Set<string>();
        const unique = sorted.filter((r) => {
          const key = `${r.bookKey}|${r.chapter}|${r.verse}`;
          if (seen.has(key)) return false;
          seen.add(key);
          return true;
        });
        return {
          label,
          count: sorted.length,
          verses: unique.length,
          books: new Set(unique.map((r) => r.bookKey)).size,
          refs: unique,
        };
      })
      .sort((a, b) => b.count - a.count);
  }
  return out;
})();

/** Every occurrence the term's renderings account for, summed from the same
 *  per-rendering counts the list shows. */
const totalOccurrences = (id: string) =>
  (occurrencesByTerm[id] ?? []).reduce((sum, form) => sum + form.count, 0);

// Two sorted views — each menu and the initial page order use their own sort key.
const byLit = [...rawEntries].sort((a, b) => a.data.litMenu.localeCompare(b.data.litMenu));
const byTraditional = [...rawEntries].sort((a, b) =>
  (a.data.menuTraditional ?? a.data.traditional).localeCompare(
    b.data.menuTraditional ?? b.data.traditional
  )
);

// Render entries in LIT order (matches the default toggle state).
const entries = await Promise.all(
  byLit.map(async (entry) => ({
    data: entry.data,
    Content: (await render(entry)).Content,
  }))
);

// Each menu dropdown is sorted by its own key.
const menuData = {
  traditional: Object.fromEntries(
    byTraditional.map((e) => [
      e.data.menuTraditional ?? e.data.traditional,
      `/glossary/#${e.data.id}`,
    ])
  ),
  lit: Object.fromEntries(
    byLit.map((e) => [e.data.litMenu, `/glossary/#${e.data.id}`])
  ),
};
---

<Layout
  title="Glossary | Liberation and Inclusion Translation"
  description="A trauma-informed glossary explaining how key biblical terms are translated in the Liberation and Inclusion Translation (LIT), with historical, linguistic, and theological context."
  canonical="https://litbible.net/glossary/"
  bg="white"
  type="glossary"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "DefinedTermSet",
      "name": "LIT Bible Glossary",
      "description": "A trauma-informed glossary explaining how key biblical terms are translated in the Liberation and Inclusion Translation (LIT), with historical, linguistic, and theological context.",
      "url": "https://litbible.net/glossary/",
      "publisher": {
        "@type": "Organization",
        "name": "Liberating Scripture Collective",
        "url": "https://liberatingscripture.org"
      }
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://litbible.net/" },
        { "@type": "ListItem", "position": 2, "name": "Glossary", "item": "https://litbible.net/glossary/" }
      ]
    })} />
  </Fragment>
  <div class="glossary-page">
    <!-- PAGE HEADER (white background) -->
    <section class="glossary-hero" aria-labelledby="glossary-title">
      <div class="wrap">
        <h1 id="glossary-title" class="glossary-title">Glossary</h1>

        <p data-pagefind-ignore>
          There are many words you would expect to see if you're familiar with
          the Bible that you won't see in this translation. There are also many
          that may be unfamiliar.
        </p>
        <p data-pagefind-ignore>
          Some of them have been replaced because English has evolved over the
          last few hundred years and other words better capture the intended
          meaning of the Greek than what has become tradition. Others have been
          replaced because I'm convinced the words we've gotten used to were
          more or less the wrong choice to begin with. Other words have been
          replaced not because they are wrong but because we've gotten so used
          to them that it becomes difficult to be curious enough to really dig
          into what they are saying.
        </p>
        <p data-pagefind-ignore>
          As you look through the entries below, in bold, you'll find the
          traditional word. In italics is the Greek behind it. Underlined,
          you'll see what the LIT Bible uses in its place most often (it can
          change based on context).
        </p>
        <p data-pagefind-ignore>
          Feel free to contact me{" "}
          <a class="inline-link" href="/contact">here</a>{" "}
          if you think I've missed any important ones!
        </p>

        <!-- Sort toggle (inline, not sticky) -->
        <div class="glossary-sort-toggle" data-pagefind-ignore>
          <span class="sort-by-label">Sort by</span>
          <div class="category-toggle" role="group" aria-label="Sort order by">
            <span class="toggle-label is-active" id="cat-lit">LIT Bible Translation</span>
            <button
              class="toggle-switch"
              id="category-toggle"
              type="button"
              role="switch"
              aria-checked="false"
              aria-labelledby="cat-lit cat-trad"
            ></button>
            <span class="toggle-label" id="cat-trad">Traditional Translation</span>
          </div>
        </div>

        <!-- Sticky jump dropdown -->
        <div class="glossary-toc" data-pagefind-ignore>
          <div class="glossary-toc__inner">
            <label class="sr-only" for="word-select">Jump to an entry</label>
            <select id="word-select" aria-label="Jump to an entry" disabled>
              <option value="">Jump to an entry</option>
            </select>
            <button
              id="back-to-top"
              type="button"
              aria-label="Back to top"
              class="back-to-top"
            >↑</button>
          </div>
        </div>

        <!-- Menu data (generated at build time from glossary collection) -->
        <script
          id="glossary-menu-data"
          type="application/json"
          set:html={JSON.stringify(menuData)}
        ></script>

        <!-- Menu JS — reads from embedded JSON so new entries are automatic -->
        <script type="module">
          document.addEventListener("DOMContentLoaded", () => {
            const glossary = JSON.parse(
              document.getElementById("glossary-menu-data").textContent
            );

            const toggle = document.getElementById("category-toggle");
            const labelLit = document.getElementById("cat-lit");
            const labelTrad = document.getElementById("cat-trad");
            const wordSelect = document.getElementById("word-select");

            if (!toggle || !wordSelect) return;

            const populateWords = (category) => {
              wordSelect.innerHTML = '<option value="">Jump to an entry</option>';
              wordSelect.disabled = true;
              if (category && glossary[category]) {
                const words = glossary[category];
                for (const word in words) {
                  const option = document.createElement("option");
                  option.value = words[word];
                  option.textContent = word;
                  wordSelect.appendChild(option);
                }
                wordSelect.disabled = false;
              }
            };

            const reorderEntries = (category) => {
              const wrap = document.querySelector(".entries-wrap");
              if (!wrap) return;
              const entryEls = Array.from(wrap.querySelectorAll(":scope > .entry"));
              const key = category === "traditional" ? "sortTraditional" : "sortLit";
              entryEls.sort((a, b) => a.dataset[key].localeCompare(b.dataset[key]));
              entryEls.forEach((e) => wrap.appendChild(e));
              window.dispatchEvent(new CustomEvent("glossary-reordered"));
            };

            const setCategory = (isTraditional) => {
              toggle.setAttribute("aria-checked", isTraditional ? "true" : "false");
              labelLit.classList.toggle("is-active", !isTraditional);
              labelTrad.classList.toggle("is-active", isTraditional);
              populateWords(isTraditional ? "traditional" : "lit");
              reorderEntries(isTraditional ? "traditional" : "lit");
            };

            setCategory(false);

            toggle.addEventListener("click", () => {
              setCategory(toggle.getAttribute("aria-checked") !== "true");
            });

            labelLit.addEventListener("click", () => setCategory(false));
            labelTrad.addEventListener("click", () => setCategory(true));

            wordSelect.addEventListener("change", () => {
              const url = wordSelect.value;
              if (!url) return;
              window.location.href = url;
            });

            const backToTop = document.getElementById("back-to-top");
            if (backToTop) {
              const toggle = document.querySelector(".glossary-sort-toggle");
              const updateVisibility = () => {
                const scrolled = toggle
                  ? window.scrollY > toggle.getBoundingClientRect().bottom + window.scrollY
                  : window.scrollY > 200;
                backToTop.classList.toggle("is-visible", scrolled);
              };
              window.addEventListener("scroll", updateVisibility, { passive: true });
              updateVisibility();
              backToTop.addEventListener("click", () => {
                window.scrollTo({ top: 0, behavior: "smooth" });
              });
            }
          });
        </script>

        <!-- ENTRIES BLOCK -->
        <!-- Layout puts data-pagefind-ignore on <body> for this page (since
             it doesn't pass the `index` prop). The data-pagefind-body below
             opts this section back INTO the Pagefind index — removing either
             attribute breaks glossary search. -->
        <section
          class="glossary-entries"
          data-pagefind-body
          data-pagefind-filter="type:glossary"
        >
          <!-- Index-only surface: just enough for search -->
          <div class="sr-only">
            <span data-pagefind-meta="title">Glossary</span>
            <span data-pagefind-meta="type">glossary</span>
            <span data-pagefind-meta="description">
              Translation glossary for key terms in the LIT.
            </span>
          </div>

          <!-- Full-bleed notch block -->
          <div class="entries-top" aria-hidden="true" data-pagefind-ignore>
          </div>

          <!-- Cream panel starts here -->
          <div class="entries-panel">
            <div class="wrap entries-wrap">
              {entries.map(({ data, Content }) => {
                const litParts = data.lit.split(" / ");
                return (
                  <article
                    class="entry"
                    data-entry={data.id}
                    data-animate="underline"
                    data-sort-lit={data.litMenu}
                    data-sort-traditional={data.menuTraditional ?? data.traditional}
                  >
                    <header class="entry-head">
                      <h2 class="entry-title" id={data.id}>
                        {/* Index-only: search tokens for this entry */}
                        <span class="sr-only">{data.srOnly}</span>

                        <span class="entries-strike">
                          <strong>{data.traditional}</strong>
                        </span>

                        <span class="sep" data-pagefind-ignore>&nbsp;–&nbsp;</span>

                        {/* Greek transliteration is NOT Pagefind-indexed */}
                        <em data-pagefind-ignore>{data.greek}</em>

                        <span class="sep" data-pagefind-ignore>&nbsp;–&nbsp;</span>

                        {/* LIT word IS Pagefind-indexed */}
                        <span class="entries-underline">
                          {litParts.length === 1
                            ? litParts[0]
                            : litParts.map((part, i) => (
                                <>
                                  {i > 0 && (
                                    <>
                                      <span class="pf-slash-space"> </span>/<span class="pf-slash-space"> </span>
                                    </>
                                  )}
                                  {part}
                                </>
                              ))}
                        </span>

                        {/* Optional parenthetical note — not indexed */}
                        {data.note && (
                          <span data-pagefind-ignore> {data.note}</span>
                        )}
                      </h2>
                    </header>

                    {/* Definition body is NOT Pagefind-indexed */}
                    <div class="entry-body" data-pagefind-ignore>
                      <Content />
                    </div>

                    {/* Where the rendering actually appears. Plain
                        <details> so the list works with JS disabled. */}
                    {occurrencesByTerm[data.id] && (
                      <div class="entry-occurrences" data-pagefind-ignore>
                        <details class="occ-group">
                          <summary class="occ-title">
                            <h3>Where it appears</h3>
                            {/* The term's total across every rendering — the
                                sum of the per-rendering counts below, so it
                                cannot disagree with them. Rendering COUNT is
                                left out: the rows are few enough to take in
                                at a glance, and the total is the number a
                                reader is actually after. */}
                            <span class="occ-title-count">{
                              totalOccurrences(data.id) === 1
                                ? "1 occurrence"
                                : `${totalOccurrences(data.id).toLocaleString("en-US")} occurrences`
                            }</span>
                          </summary>
                        {occurrencesByTerm[data.id].map((form) => (
                          <details class="occ">
                            <summary class="occ-summary">
                              <span class="occ-form">{form.label}</span>
                              {/* Each quantity is glued to its noun — see
                                  .occ-nw. Only say "across N verses" when it
                                  differs from the occurrence count, or the
                                  list length and the headline disagree with
                                  no explanation. */}
                              <span class="occ-count">
                                <span class="occ-nw">
                                  {form.count} {form.count === 1 ? "time" : "times"}
                                </span>
                                {form.verses !== form.count && (
                                  <>
                                    {" across "}
                                    <span class="occ-nw">{form.verses} verses</span>
                                  </>
                                )}
                                {" in "}
                                <span class="occ-nw">
                                  {form.books} {form.books === 1 ? "book" : "books"}
                                </span>
                              </span>
                            </summary>
                            <ul class="occ-list" data-occ-cap={form.refs.length > OCC_CAP ? String(OCC_CAP) : undefined}>
                              {form.refs.map((ref) => (
                                <li>
                                  <a href={`/${ref.bookKey}-${ref.chapter}#v${ref.verse}`}>
                                    {bookKeyToLabel(ref.bookKey)} {ref.chapter}:{ref.verse}
                                  </a>
                                </li>
                              ))}
                            </ul>
                          </details>
                        ))}
                        </details>
                      </div>
                    )}
                  </article>
                );
              })}

              <script type="module" data-pagefind-ignore>
                // --- occurrence lists: reveal long ref lists in batches ---
                // Every link is server-rendered, so this only ever HIDES. With
                // JS off the full list is already on the page, which is why the
                // button is injected here rather than authored in the markup.
                for (const list of document.querySelectorAll(".occ-list[data-occ-cap]")) {
                  const step = Number(list.dataset.occCap) || 30;
                  const items = Array.from(list.children);
                  if (items.length <= step) continue;

                  const button = document.createElement("button");
                  button.type = "button";
                  button.className = "occ-more";

                  let shown = step;
                  const render = () => {
                    items.forEach((li, i) => {
                      li.hidden = i >= shown;
                    });
                    const left = items.length - shown;
                    if (left <= 0) {
                      button.remove();
                      return;
                    }
                    button.textContent =
                      left <= step ? `Show last ${left}` : `Show ${step} more`;
                    // Count is in the accessible name too — "Show 30 more"
                    // alone doesn't say more of what, out of context.
                    button.setAttribute(
                      "aria-label",
                      `${button.textContent} of ${items.length} verses`,
                    );
                  };

                  button.addEventListener("click", () => {
                    const firstNew = items[shown];
                    shown = Math.min(shown + step, items.length);
                    render();
                    // Keep the reader's place: focus the first newly revealed
                    // link rather than letting focus die with the button.
                    if (firstNew) firstNew.querySelector("a")?.focus();
                  });

                  render();
                  list.after(button);
                }

                // --- intersection observer: adds .is-visible and triggers redraw ---
                const entries = Array.from(
                  document.querySelectorAll(".glossary-page .entry"),
                );

                const io = new IntersectionObserver(
                  (items) => {
                    for (const item of items) {
                      if (item.isIntersecting) {
                        item.target.classList.add("is-visible");
                        revealInkInEntry(item.target);
                        io.unobserve(item.target);
                      }
                    }
                  },
                  { threshold: 0.25 },
                );

                entries.forEach((e) => io.observe(e));

                // --- ink drawing helpers ---
                function mulberry32(seed) {
                  return function () {
                    let t = (seed += 0x6d2b79f5);
                    t = Math.imul(t ^ (t >>> 15), t | 1);
                    t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
                    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
                  };
                }

                function hashString(str) {
                  let h = 2166136261;
                  for (let i = 0; i < str.length; i++) {
                    h ^= str.charCodeAt(i);
                    h = Math.imul(h, 16777619);
                  }
                  return h >>> 0;
                }

                function makeScribblePath({ w, h, kind, seed }) {
                  const rand = mulberry32(seed);

                  const padX = Math.max(2, w * 0.02);
                  const x0 = padX;
                  const x1 = w - padX;

                  const yStrike = h * 0.55;
                  const yUnderline = h * 0.92;
                  const baseY = kind === "strike" ? yStrike : yUnderline;

                  const amp =
                    kind === "strike"
                      ? Math.max(1.5, h * 0.1)
                      : Math.max(1.2, h * 0.07);

                  const points = [];
                  const steps = 6;

                  for (let i = 0; i <= steps; i++) {
                    const t = i / steps;
                    const x = x0 + (x1 - x0) * t;

                    const wobble = (rand() - 0.5) * 2 * amp;
                    const drift = Math.sin(t * Math.PI * 2) * (amp * 0.35);
                    const y = baseY + wobble * 0.55 + drift;

                    points.push({ x, y });
                  }

                  let d = `M ${points[0].x.toFixed(2)} ${points[0].y.toFixed(2)}`;
                  for (let i = 1; i < points.length - 1; i++) {
                    const cx = points[i].x;
                    const cy = points[i].y;
                    const nx = (points[i].x + points[i + 1].x) / 2;
                    const ny = (points[i].y + points[i + 1].y) / 2;
                    d += ` Q ${cx.toFixed(2)} ${cy.toFixed(2)} ${nx.toFixed(2)} ${ny.toFixed(2)}`;
                  }
                  const last = points[points.length - 1];
                  d += ` T ${last.x.toFixed(2)} ${last.y.toFixed(2)}`;
                  return d;
                }

                function clearInk(titleEl) {
                  titleEl
                    .querySelectorAll(":scope > .ink-svg")
                    .forEach((n) => n.remove());
                }

                function drawInkForSpan(span, kind) {
                  const title = span.closest(".entry-title");
                  if (!title) return;

                  const titleRect = title.getBoundingClientRect();
                  const rects = Array.from(span.getClientRects()).filter(
                    (r) => r.width > 1 && r.height > 1,
                  );

                  const seedBase = hashString(
                    (span.textContent || "").trim() + "|" + kind,
                  );

                  rects.forEach((r, idx) => {
                    const left = r.left - titleRect.left;
                    const top = r.top - titleRect.top;
                    const w = r.width;
                    const h = r.height;

                    const svg = document.createElementNS(
                      "http://www.w3.org/2000/svg",
                      "svg",
                    );
                    svg.classList.add("ink-svg");
                    svg.setAttribute("aria-hidden", "true");
                    svg.setAttribute("focusable", "false");

                    svg.style.left = `${left}px`;
                    svg.style.top = `${top}px`;
                    svg.style.width = `${w}px`;
                    svg.style.height = `${h}px`;

                    svg.setAttribute("viewBox", `0 0 ${w} ${h}`);
                    svg.setAttribute("preserveAspectRatio", "none");

                    const path = document.createElementNS(
                      "http://www.w3.org/2000/svg",
                      "path",
                    );
                    const seed = seedBase + idx * 101;

                    path.setAttribute(
                      "d",
                      makeScribblePath({ w, h, kind, seed }),
                    );
                    path.setAttribute("fill", "none");
                    path.setAttribute("stroke", "var(--lit-green)");
                    path.setAttribute("stroke-linecap", "round");
                    path.setAttribute("stroke-linejoin", "round");

                    const strokeW =
                      kind === "strike"
                        ? Math.max(1.9, h * 0.105)
                        : Math.max(1.8, h * 0.095);

                    path.setAttribute("stroke-width", strokeW.toFixed(2));

                    const len = path.getTotalLength();
                    path.style.strokeDasharray = `${len}`;
                    path.style.strokeDashoffset = `${len}`;
                    path.style.transition =
                      "stroke-dashoffset 900ms cubic-bezier(0.25, 0.8, 0.25, 1)";

                    svg.appendChild(path);
                    title.appendChild(svg);
                  });
                }

                function redrawAllInk() {
                  const titles = Array.from(
                    document.querySelectorAll(".glossary-page .entry-title"),
                  );
                  titles.forEach((title) => {
                    clearInk(title);
                    title
                      .querySelectorAll(".entries-strike")
                      .forEach((s) => drawInkForSpan(s, "strike"));
                    title
                      .querySelectorAll(".entries-underline")
                      .forEach((s) => drawInkForSpan(s, "underline"));
                  });

                  // reveal immediately for already-visible entries (above fold)
                  entries.forEach((entry) => {
                    if (entry.classList.contains("is-visible"))
                      revealInkInEntry(entry);
                  });
                }

                function revealInkInEntry(entryEl) {
                  entryEl.querySelectorAll(".ink-svg path").forEach((p) => {
                    p.style.strokeDashoffset = "0";
                  });
                }

                let raf = 0;
                function scheduleRedraw() {
                  cancelAnimationFrame(raf);
                  raf = requestAnimationFrame(redrawAllInk);
                }

                window.addEventListener("DOMContentLoaded", () => {
                  redrawAllInk();
                  window.addEventListener("resize", scheduleRedraw);
                  window.addEventListener("glossary-reordered", scheduleRedraw);
                  if (document.fonts && document.fonts.ready) {
                    document.fonts.ready.then(() => scheduleRedraw());
                  }
                });
              </script>
            </div>
          </div>
        </section>
      </div>
    </section>
  </div>
</Layout>
