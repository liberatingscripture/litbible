---
import { getCollection, render } from "astro:content";
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
import { BOOK_ORDER, bookKeyToLabel } from "../data/books.js";
import { linkRefs } from "../lib/scripture-refs-data.mjs";
import { linkGlossaryCrossRefs } from "../lib/glossary-crossrefs.mjs";
import { normalizeLabel } from "../../scripts/lib/glossary-feed-core.mjs";
import { gatedOccurrences } from "../lib/alignment-gate.mjs";
import { compareGlossaryLabels, glossarySortKey } from "../lib/glossary-sort.mjs";
import { GLOSSARY_LEMMAS, lemmaWords } from "../../scripts/lib/glossary-lemmas.mjs";
import "../styles/pages/glossary.css";

// `draft: true` entries stay in the collection (build-alignment.mjs seeds off
// the files) but never reach a reader. Filtering here also keeps them out of
// Pagefind, which indexes the built page rather than the collection.
const rawEntries = (await getCollection("glossary")).filter((e) => !e.data.draft);

/**
 * Phase 1 alignment records (src/data/alignment/, built by
 * scripts/build-alignment.mjs, reviewed via scripts/alignment-review/) — where
 * each term's LIT rendering actually appears in the published text. A glossary
 * entry says what `pneuma` becomes; this says where, and how often.
 *
 * Which records and terms may be shown is the display gate in
 * src/lib/alignment-gate.mjs, a publishing decision documented there.
 */
type AlignmentRecord = {
  ref: string;
  english: { text: string; n: number }[];
  term: {
    greek: string;
    traditional: string;
    glossary: string;
    form: string | null;
  } | null;
  confidence: "distinctive" | "common" | null;
  lemma?: "present" | "absent" | "unchecked";
  status?: "auto" | "confirmed" | "no-rendering" | "rejected";
};

type AlignmentFile = {
  bookKey: string;
  chapter: number;
  records: AlignmentRecord[];
};

type OccurrenceRef = { bookKey: string; chapter: number; verse: number };

type FormOccurrences = {
  label: string;
  /** Occurrences — a verse rendering the term four times counts four. */
  count: number;
  /** Distinct verses, which is what `refs` lists. Below `count` when a verse
   *  renders the term more than once (Romans 2:12 carries "Torah" 4x). */
  verses: number;
  books: number;
  refs: OccurrenceRef[];
};

const alignmentModules = import.meta.glob<{ default: AlignmentFile }>(
  "../data/alignment/*.json",
  { eager: true },
);

/** Batch size for the "show more" reveal on a rendering's verse list — and
 *  how many it shows before batching starts.
 *
 *  Two sizes, because a wide viewport fits several refs per row and 25 barely
 *  fills the block, while on a phone each row holds two or three and 50 is a
 *  wall. The page is statically rendered, so the choice can only be made in
 *  the client; these are emitted as data attributes rather than hardcoded in
 *  the script so the threshold below and the steps stay one source of truth.
 *
 *  The threshold MUST be the narrow step: a list of 30 needs batching on a
 *  phone even though a desktop shows it whole. 900px matches the page's own
 *  primary breakpoint.
 *
 *  Purely a client-side reveal — every link is server-rendered, so with JS
 *  off the full list is already there. */
const OCC_STEP_NARROW = 25;
const OCC_STEP_WIDE = 50;
const OCC_BREAKPOINT = 900;

const BOOK_RANK = new Map(
  (BOOK_ORDER as string[]).map((key, i) => [key, i] as const),
);
const bookRank = (key: string) => BOOK_RANK.get(key) ?? Number.MAX_SAFE_INTEGER;

const occurrencesByTerm: Record<string, FormOccurrences[]> = (() => {
  const gated = gatedOccurrences(
    Object.values(alignmentModules).map((mod) => mod.default),
  );

  const out: Record<string, FormOccurrences[]> = {};
  for (const [id, forms] of gated) {
    out[id] = [...forms.entries()]
      .map(([label, occurrences]) => {
        const sorted = occurrences
          .map(({ bookKey, chapter, verse }) => ({ bookKey, chapter, verse }))
          .sort(
            (a, b) =>
              bookRank(a.bookKey) - bookRank(b.bookKey) ||
              a.chapter - b.chapter ||
              a.verse - b.verse,
          );
        // One link per verse. The records are per-OCCURRENCE, so a verse
        // rendering the term more than once produced one ref each — and a
        // reader meeting "Romans 2:12" four times in a row reads it as a bug,
        // not as the frequency claim it actually is. The count above still
        // carries that frequency.
        const seen = new Set<string>();
        const unique = sorted.filter((r) => {
          const key = `${r.bookKey}|${r.chapter}|${r.verse}`;
          if (seen.has(key)) return false;
          seen.add(key);
          return true;
        });
        return {
          label,
          count: sorted.length,
          verses: unique.length,
          books: new Set(unique.map((r) => r.bookKey)).size,
          refs: unique,
        };
      })
      .sort((a, b) => b.count - a.count);
  }
  return out;
})();

/** Every occurrence the term's renderings account for, summed from the same
 *  per-rendering counts the list shows. */
const totalOccurrences = (id: string) =>
  (occurrencesByTerm[id] ?? []).reduce((sum, form) => sum + form.count, 0);

// Two sorted views — each menu and the initial page order use their own sort key.
// A leading article is skipped ("The Adversary" files under A); the rule is
// glossary-sort.mjs, which the page's sort switch uses.
const byLit = [...rawEntries].sort((a, b) =>
  compareGlossaryLabels(a.data.litMenu, b.data.litMenu)
);
const byTraditional = [...rawEntries].sort((a, b) =>
  compareGlossaryLabels(
    a.data.menuTraditional ?? a.data.traditional,
    b.data.menuTraditional ?? b.data.traditional
  )
);

// Cross-references ("See the entry for “good [2]” below") resolve against the
// same two labels the apps' feed indexes, through the feed's own normalizer,
// so the page and iOS agree on where each phrase points.
const labelToId = new Map<string, string>();
for (const e of rawEntries) {
  for (const label of [e.data.traditional, e.data.litMenu]) {
    labelToId.set(normalizeLabel(label), e.data.id);
  }
}
const resolveCrossRef = (label: string) => labelToId.get(normalizeLabel(label)) ?? null;

// Render entries in LIT order (matches the default toggle state). Bodies go out
// as strings so scripture references and cross-references can be linked; the
// files, and the feed built from them, keep their plain text. No entry uses a
// Markdown image (the one thing render() adds), so the stored HTML is complete.
const entries = await Promise.all(
  byLit.map(async (entry) => ({
    data: entry.data,
    Content: (await render(entry)).Content,
    bodyHtml:
      entry.rendered?.html != null && !entry.rendered.metadata?.imagePaths?.length
        ? linkGlossaryCrossRefs(linkRefs(entry.rendered.html), resolveCrossRef)
        : null,
  }))
);

/**
 * The entry's Greek word, as the alignment's lemma map spells it (GL-18): the
 * lemma whose line there carries the entry's own transliteration, so "pistis"
 * shows as "πίστις". No entry gains a field, and the map is checked against the
 * text and against each entry's `greek` (test/term-words.test.js). An entry
 * the map can't match shows its transliteration alone.
 */
const greekOf = (id: string, translit: string): string | null => {
  try {
    const words = lemmaWords(id);
    const lemmas = (GLOSSARY_LEMMAS as Record<string, string[]>)[id] ?? [];
    const at = words.findIndex(([, tr]) => tr.toLowerCase() === translit.toLowerCase());
    return at >= 0 ? lemmas[at] : null;
  } catch {
    return null;
  }
};

---

<Layout
  title="Glossary | Liberation and Inclusion Translation"
  description="A trauma-informed glossary explaining how key biblical terms are translated in the Liberation and Inclusion Translation (LIT), with historical, linguistic, and theological context."
  canonical="https://litbible.net/glossary/"
  bg="white"
  type="glossary"
  deskSurface="glossary"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "DefinedTermSet",
      "name": "LIT Bible Glossary",
      "description": "A trauma-informed glossary explaining how key biblical terms are translated in the Liberation and Inclusion Translation (LIT), with historical, linguistic, and theological context.",
      "url": "https://litbible.net/glossary/",
      "publisher": {
        "@type": "Organization",
        "name": "Liberating Scripture Collective",
        "url": "https://liberatingscripture.org"
      }
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://litbible.net/" },
        { "@type": "ListItem", "position": 2, "name": "Glossary", "item": "https://litbible.net/glossary/" }
      ]
    })} />
  </Fragment>
  <div class="glossary-page">
    {/* The page's opening: BVJ's words, in the reading column. The line under
        the header ("Learn / Glossary ▾ / trust"; GlossaryLine.astro) holds the
        list of entries and the order switch. */}
    <section class="glossary-hero" aria-labelledby="glossary-title">
      <div class="gloss-col">
        <h1 id="glossary-title" class="glossary-title">Glossary</h1>

        <p data-pagefind-ignore>
          There are many words you would expect to see if you’re familiar with
          the Bible that you won’t see in this translation. There are also many
          that may be unfamiliar.
        </p>
        <p data-pagefind-ignore>
          Some of them have been replaced because English has evolved over the
          last few hundred years and other words better capture the intended
          meaning of the Greek than what has become tradition. Others have been
          replaced because I’m convinced the words we’ve gotten used to were
          more or less the wrong choice to begin with. Other words have been
          replaced not because they are wrong but because we’ve gotten so used
          to them that it becomes difficult to be curious enough to really dig
          into what they are saying.
        </p>
        <p data-pagefind-ignore>
          As you look through the entries below, in bold, you’ll find the
          traditional word. In italics is the Greek behind it. Underlined,
          you’ll see what the LIT Bible uses in its place most often (it can
          change based on context).
        </p>
        <p data-pagefind-ignore>
          Feel free to <a class="kit-inline" href="/contact">contact me here</a>{" "}
          if you think I’ve missed any important ones!
        </p>
      </div>
    </section>

    {/* ENTRIES BLOCK */}
    {/* Layout puts data-pagefind-ignore on <body> for this page (since
         it doesn't pass the `index` prop). The data-pagefind-body below
         opts this section back INTO the Pagefind index — removing either
         attribute breaks glossary search. */}
    <section
      class="glossary-entries"
      data-pagefind-body
      data-pagefind-filter="type:glossary"
    >
      {/* Index-only surface: just enough for search. aria-hidden, since
           a screen reader otherwise announces "Glossary glossary
           Translation glossary…" before the first entry. */}
      <div class="sr-only" aria-hidden="true">
        <span data-pagefind-meta="title">Glossary</span>
        <span data-pagefind-meta="type">glossary</span>
        <span data-pagefind-meta="description">
          Translation glossary for key terms in the LIT.
        </span>
      </div>

      <div class="entries-panel">
        <div class="gloss-col entries-wrap">
          {entries.map(({ data, Content, bodyHtml }) => {
            const litParts = data.lit.split(" / ");
            const greek = greekOf(data.id, data.greek);
            const forms = occurrencesByTerm[data.id];
            const total = totalOccurrences(data.id);
            return (
              <article
                class="entry"
                data-entry={data.id}
                data-sort-lit={glossarySortKey(data.litMenu)}
                data-sort-traditional={glossarySortKey(data.menuTraditional ?? data.traditional)}
              >
                <header class="entry-head">
                  {/* The pair is the headline (GL-11 to GL-17): the traditional
                      word, lighter and gray, beside the LIT's, in full weight.
                      No arrow, no strike-through. Each LIT option is its own
                      .lit-part, so a long gloss drops each onto its own line
                      on a phone. */}
                  <h2 class="entry-title" id={data.id}>
                    {/* Index-only: search tokens for this entry. Hidden
                        from screen readers too, which otherwise read them
                        ahead of the heading's own words. */}
                    <span class="sr-only" aria-hidden="true">{data.srOnly}</span>

                    <span class="pair">
                      <span class="pair__side pair__side--traditional">
                        <span class="pair__label" data-pagefind-ignore>Traditionally</span>
                        {/* .entries-strike is a hook the Study Desk's scripts
                            find the entry's word by; nothing draws it. */}
                        <span class="pair__word entries-strike"><strong>{data.traditional}</strong></span>
                      </span>
                      <span class="pair__side pair__side--lit">
                        <span class="pair__label" data-pagefind-ignore>In the LIT</span>
                        {/* The LIT word IS Pagefind-indexed */}
                        <span class="pair__word">
                          {litParts.map((part, i) => (
                            <>
                              {i > 0 && (
                                <span class="lit-sep">
                                  <span class="pf-slash-space"> </span>/<span class="pf-slash-space"> </span>
                                </span>
                              )}
                              <span class="lit-part">{part}</span>
                            </>
                          ))}
                        </span>
                        {/* Optional parenthetical note, under the word; not indexed */}
                        {data.note && <span class="pair__note" data-pagefind-ignore>{data.note}</span>}
                      </span>
                    </span>
                  </h2>

                  {/* A link to this entry, outside the heading so it stays
                      out of the heading's name. Without JS it is an ordinary
                      link; glossary-entry-links.js makes a click copy it. Its
                      words show (copy is not one of the icons that may stand
                      alone, Icon.astro), so it needs no tooltip, and its name
                      starts with them. */}
                  <a
                    class="kit-btn kit-btn--plain entry-link"
                    href={`#${data.id}`}
                    data-entry-link
                    data-term={data.traditional}
                    aria-label={`Copy link to the ${data.traditional} entry`}
                    data-pagefind-ignore
                  >
                    <Icon name="copy" class="icon entry-link__copy" /><Icon name="check" class="icon entry-link__check" />Copy link
                  </a>
                </header>

                {/* The Greek, from the alignment's lemma map, beside its
                    transliteration (GL-18): "πίστις pistis". Not indexed. */}
                <p class="entry-greek" data-pagefind-ignore>
                  {greek && <span class="entry-greek__word" lang="grc">{greek}</span>}
                  <span class="entry-greek__translit">{data.greek}</span>
                </p>

                {/* Definition body is NOT Pagefind-indexed */}
                <div class="entry-body" data-pagefind-ignore>
                  {bodyHtml != null ? <Fragment set:html={bodyHtml} /> : <Content />}
                </div>

                {/* Where the rendering actually appears (GL-20 to GL-23): in
                    the margin where there is one, under the entry where there
                    is none. Today's numbers: the total and each rendering with
                    its count. "Every place" opens the full list below; it is
                    a link to that list, which its own address shows without
                    JavaScript. */}
                {forms && (
                  <aside class="entry-occ" aria-labelledby={`occ-${data.id}`} data-pagefind-ignore>
                    <h3 class="entry-occ__title" id={`occ-${data.id}`}>Where it appears</h3>
                    {/* The term's total across every rendering: the sum of the
                        per-rendering counts below, so it cannot disagree with
                        them. */}
                    <p class="entry-occ__total">{
                      total === 1 ? "1 occurrence" : `${total.toLocaleString("en-US")} occurrences`
                    }</p>
                    <ul class="entry-occ__forms">
                      {forms.map((form) => (
                        <li>
                          <span class="occ-form">{form.label}</span>
                          <span class="occ-count">
                            <span class="occ-nw">{form.count} {form.count === 1 ? "time" : "times"}</span>
                            {" in "}
                            <span class="occ-nw">{form.books} {form.books === 1 ? "book" : "books"}</span>
                          </span>
                        </li>
                      ))}
                    </ul>
                    <a
                      class="kit-btn kit-btn--plain entry-occ__all"
                      href={`#places-${data.id}`}
                      data-occ-all
                    ><span class="entry-occ__all-label">Every place</span><Icon name="forward" /></a>
                  </aside>
                )}
                {forms && (
                  <div class="entry-places" id={`places-${data.id}`} data-pagefind-ignore>
                    <h3 class="entry-places__title">Every place</h3>
                    {forms.map((form) => (
                      <details class="occ">
                        <summary class="kit-row occ-summary">
                          <Icon name="forward" class="icon occ-summary__mark" />
                          <span class="occ-summary__text">
                            <span class="occ-form">{form.label}</span>
                            {/* Each quantity is glued to its noun (.occ-nw).
                                Only say "across N verses" when it differs
                                from the occurrence count. */}
                            <span class="occ-count">
                              <span class="occ-nw">
                                {form.count} {form.count === 1 ? "time" : "times"}
                              </span>
                              {form.verses !== form.count && (
                                <>
                                  {" across "}
                                  <span class="occ-nw">{form.verses} verses</span>
                                </>
                              )}
                              {" in "}
                              <span class="occ-nw">
                                {form.books} {form.books === 1 ? "book" : "books"}
                              </span>
                            </span>
                          </span>
                        </summary>
                        <ul
                          class="occ-list"
                          data-occ-cap={form.refs.length > OCC_STEP_NARROW ? "" : undefined}
                          data-occ-narrow={form.refs.length > OCC_STEP_NARROW ? String(OCC_STEP_NARROW) : undefined}
                          data-occ-wide={form.refs.length > OCC_STEP_NARROW ? String(OCC_STEP_WIDE) : undefined}
                          data-occ-breakpoint={form.refs.length > OCC_STEP_NARROW ? String(OCC_BREAKPOINT) : undefined}
                        >
                          {form.refs.map((ref) => (
                            <li>
                              <a class="sref" href={`/${ref.bookKey}-${ref.chapter}/#v${ref.verse}`}>
                                {bookKeyToLabel(ref.bookKey)} {ref.chapter}:{ref.verse}
                              </a>
                            </li>
                          ))}
                        </ul>
                      </details>
                    ))}
                  </div>
                )}
              </article>
            );
          })}
        </div>
      </div>
    </section>
  </div>

  {/* Back to top: shown by the line's script once the first entry has
      scrolled away; with no script it never shows (the line's list reaches
      every entry). */}
  <div class="gloss-top" data-gloss-top data-pagefind-ignore>
    <button type="button" class="kit-btn kit-btn--plain"><Icon name="up" />Back to top</button>
  </div>

  <script type="module" data-pagefind-ignore>
    // --- "Every place": open the full list under the entry ---
    // Without this the link goes to the list's own address, which shows it
    // (:target). With it, a press toggles the list in place.
    for (const link of document.querySelectorAll("[data-occ-all]")) {
      const places = document.getElementById(link.getAttribute("href").slice(1));
      const label = link.querySelector(".entry-occ__all-label");
      if (!places || !label) continue;
      link.setAttribute("role", "button");
      link.setAttribute("aria-expanded", "false");
      link.setAttribute("aria-controls", places.id);
      const toggle = () => {
        const open = places.toggleAttribute("data-open");
        link.setAttribute("aria-expanded", String(open));
        label.textContent = open ? "Hide places" : "Every place";
      };
      link.addEventListener("click", (event) => {
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
        event.preventDefault();
        toggle();
      });
      // A button answers Space as well as Enter; a link only Enter.
      link.addEventListener("keydown", (event) => {
        if (event.key !== " ") return;
        event.preventDefault();
        toggle();
      });
    }

    // --- occurrence lists: reveal long ref lists in batches ---
    // Every link is server-rendered, so this only ever HIDES. With JS off the
    // full list is already on the page, which is why the button is injected
    // here rather than authored in the markup. A batch is a wide step from
    // 900px and a narrow one under it (OCC_STEP_*, in the frontmatter).
    for (const list of document.querySelectorAll(".occ-list[data-occ-cap]")) {
      const narrow = Number(list.dataset.occNarrow) || 25;
      const wide = Number(list.dataset.occWide) || 50;
      const mq = window.matchMedia(
        `(min-width: ${Number(list.dataset.occBreakpoint) || 900}px)`,
      );
      // Read per use, not captured once: a rotate or resize then sizes the
      // NEXT batch correctly without resetting what the reader has revealed.
      const step = () => (mq.matches ? wide : narrow);

      const items = Array.from(list.children);
      if (items.length <= step()) continue;

      const button = document.createElement("button");
      button.type = "button";
      button.className = "kit-btn kit-btn--plain occ-more";

      let shown = step();
      const render = () => {
        items.forEach((li, i) => {
          li.hidden = i >= shown;
        });
        const left = items.length - shown;
        if (left <= 0) {
          button.remove();
          return;
        }
        button.textContent = left <= step() ? `Show last ${left}` : `Show ${step()} more`;
        // Count is in the accessible name too: "Show 50 more" alone doesn't
        // say more of what, out of context.
        button.setAttribute("aria-label", `${button.textContent} of ${items.length} verses`);
      };

      mq.addEventListener("change", () => {
        if (button.isConnected) render();
      });

      button.addEventListener("click", () => {
        const firstNew = items[shown];
        shown = Math.min(shown + step(), items.length);
        render();
        // Keep the reader's place: focus the first newly revealed link rather
        // than letting focus die with the button.
        if (firstNew) firstNew.querySelector("a")?.focus();
      });

      render();
      list.after(button);
    }
  </script>

  {/* Scripture reference previews, the entries' copy-link buttons, and the
      selection panel (Copy entry text, Copy entry link): progressive
      enhancement */}
  <script>
    import "../scripts/ref-preview.js";
    import "../scripts/glossary-entry-links.js";
    import "../scripts/glossary-selection.js";
  </script>
</Layout>
