---
import Layout from "../layouts/Layout.astro";
import "../styles/pages/home.css";
import "../styles/v2/home.css";
import LscMark from "../components/LscMark.astro";
import ContinueReading from "../components/ContinueReading.astro";
import ReadMenu from "../components/ReadMenu.astro";
import EmblemMark from "../components/EmblemMark.astro";
import frauncesLatin500Url from "@fontsource/fraunces/files/fraunces-latin-500-normal.woff2";
import { getCollection } from "astro:content";
import releaseNotes from "../data/release-notes.json";
import { entryIds } from "../lib/release-notes-view.mjs";
import { termLensFor } from "../lib/term-lens-data.mjs";
import { markOrigin } from "../lib/term-words.mjs";
import { htmlToPlainText, splitChapterVerses } from "../../scripts/lib/verse-text.mjs";
import luke3 from "../data/chapters/luke-3.json";

// ── Site 2.0 only (data-v2; SITE-2.0.md, "Home") ─────────────────────────
// Everything below is built from the site's own data, so it stays true when
// the translation, the glossary or the release notes change.

// "Latest change": the newest release-notes entry, its date without the year
// and the places it names (a description's label before " — "), then a link
// to /release-notes. More than two places would crowd the line, so then only
// the date shows.
const latestNote = (releaseNotes as any[])[0];
const latestId = latestNote ? entryIds(releaseNotes)[0] : "";
const latestDate = latestNote ? String(latestNote.label).replace(/,\s*\d{4}$/, "") : "";
const latestPlaces: string[] = latestNote
  ? [...new Set<string>(latestNote.changes.map((c: any) => String(c.description).split(" — ")[0].trim()))]
  : [];
const latestLine = [latestDate, ...(latestPlaces.length <= 2 ? latestPlaces : [])]
  .filter(Boolean)
  .join(" · ");

// The passage the chat lands on: the poetry block of Luke 3 that holds verse
// 6, "all humanity will see the liberation of God," as published, with its
// footnote letters and ids left off. Its key terms are the term lens's own
// marks (term-lens-data.mjs), and the one the chat names ("liberation")
// carries the lens's card, written out here.
const PASSAGE_BOOK = "luke";
const PASSAGE_CHAPTER = 3;
const PASSAGE_VERSE = 6;
const LANDING_WORD = "liberation";
const passageParas: string[] = (luke3 as any).paragraphs ?? [];
const blockAt = passageParas.findIndex(
  (p) => /^<blockquote\b/.test(p) && new RegExp(`<sup\\b[^>]*\\bid="v${PASSAGE_VERSE}"`).test(p),
);
const verseIdsIn = (html: string) => [...html.matchAll(/<sup\b[^>]*\bid="v(\d+)"/g)].map((m) => Number(m[1]));

type PassageCard = {
  id: string;
  word: string;
  traditional: string[];
  greek: string[];
  same: boolean;
  also: string;
  title: string;
};

let passageHtml = "";
let passageRef = "";
let passageCard: PassageCard | null = null;

if (blockAt >= 0) {
  const block = passageParas[blockAt];
  const before = passageParas.slice(0, blockAt).join(" ");
  const ownIds = verseIdsIn(block);
  // A block that opens mid-verse continues the last verse before it.
  const opensMidVerse = !/^<blockquote\b[^>]*>(?:<p\b[^>]*>)?(?:<span class="vglue">)?<sup\b[^>]*\bid="v\d+"/.test(block);
  const priorIds = verseIdsIn(before);
  const firstVerse = opensMidVerse ? priorIds[priorIds.length - 1] : ownIds[0];
  const lastVerse = ownIds[ownIds.length - 1];
  passageRef = `Luke ${PASSAGE_CHAPTER}:${firstVerse}${lastVerse !== firstVerse ? `–${lastVerse}` : ""}`;

  const html = block
    .replace(/<sup\b[^>]*class="fn-ref"[^>]*>[\s\S]*?<\/sup>/g, "")
    .replace(/\s+id="[^"]*"/g, "")
    .replace(/&nbsp;/g, " ");

  // The block as tags and text, each text piece knowing its verse.
  const segs: { tag: boolean; s: string; v: number }[] = [];
  let verse = firstVerse;
  let inVn = false;
  for (const s of html.split(/(<[^>]+>)/)) {
    if (!s) continue;
    if (s.startsWith("<")) {
      if (/^<sup\b[^>]*\bclass="vn"/.test(s)) inVn = true;
      else if (s === "</sup>") inVn = false;
      segs.push({ tag: true, s, v: verse });
    } else {
      if (inVn) verse = Number(s.trim()) || verse;
      segs.push({ tag: inVn, s, v: verse });
    }
  }

  const countIn = (hay: string, needle: string) => {
    let n = 0;
    for (let i = hay.indexOf(needle); i !== -1; i = hay.indexOf(needle, i + 1)) n++;
    return n;
  };

  const entries = new Map(
    (await getCollection("glossary"))
      .filter((e) => !e.data.draft)
      .map((e) => [e.data.id, e.data]),
  );
  const lens = termLensFor(PASSAGE_BOOK, PASSAGE_CHAPTER, passageParas, entries as any);
  const verses = splitChapterVerses(passageParas);
  const wraps: { seg: number; at: number; len: number; open: boolean }[] = [];
  let landing: any = null;

  for (const mark of lens.marks as any[]) {
    if (mark.v < firstVerse || mark.v > lastVerse) continue;
    const needle = String(mark.text).replace(/\s+/g, " ").toLowerCase();
    // Occurrences of this verse that fall before the block.
    let prior = 0;
    if (mark.v === firstVerse && opensMidVerse) {
      const from = before.lastIndexOf(`id="v${mark.v}"`);
      const head = htmlToPlainText(before.slice(from).replace(/^[^>]*>\d+<\/sup>/, "")).toLowerCase();
      prior = countIn(head, needle);
      if (!verses.has(mark.v)) continue;
    }
    let want = mark.k - prior;
    if (want < 0) continue;
    for (let i = 0; i < segs.length && want >= 0; i++) {
      const sg = segs[i];
      if (sg.tag || sg.v !== mark.v) continue;
      const low = sg.s.toLowerCase();
      for (let at = low.indexOf(needle); at !== -1; at = low.indexOf(needle, at + 1)) {
        if (want-- > 0) continue;
        const clash = wraps.some((w) => w.seg === i && at < w.at + w.len && w.at < at + needle.length);
        if (!clash) {
          const open = !landing && needle === LANDING_WORD;
          if (open) landing = { mark, word: sg.s.slice(at, at + needle.length) };
          wraps.push({ seg: i, at, len: needle.length, open });
        }
        break;
      }
    }
  }

  // Wrap from the end, so an earlier position in a piece never moves.
  wraps.sort((a, b) => b.seg - a.seg || b.at - a.at);
  for (const w of wraps) {
    const s = segs[w.seg].s;
    const cls = w.open ? "v2-home__term v2-home__term--open" : "v2-home__term";
    segs[w.seg].s = `${s.slice(0, w.at)}<span class="${cls}">${s.slice(w.at, w.at + w.len)}</span>${s.slice(w.at + w.len)}`;
  }
  passageHtml = segs.map((sg) => sg.s).join("");

  if (landing) {
    const term = (lens.terms as any)[landing.mark.id];
    const from = markOrigin(term, landing.mark);
    const others = (term.renderings ?? [])
      .filter((r: any) => r.form.toLowerCase() !== String(landing.mark.form).toLowerCase())
      .slice(0, 4);
    passageCard = {
      id: landing.mark.id,
      word: landing.word,
      traditional: from.traditional,
      greek: from.greek,
      same: from.traditional.length === 1 && from.traditional[0].toLowerCase() === landing.word.toLowerCase(),
      also: others.map((r: any) => `${r.form} (${r.count})`).join(", "),
      title: term.title,
    };
  }
}

// "faith or believe", as the term lens's card lists more than one word.
const listJoin = (words: string[], i: number) =>
  i === 0 ? "" : words.length === 2 ? " or " : i === words.length - 1 ? ", or " : ", ";
---

<Layout
  title="Liberation and Inclusion Translation"
  description="A trauma-informed, justice-oriented translation of the Bible from the original languages."
  canonical="https://litbible.net/"
  bg="green"
>
  <Fragment slot="head">
    <link rel="preload" href={frauncesLatin500Url} as="font" type="font/woff2" crossorigin="anonymous" />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "LIT Bible",
      "alternateName": "Liberation and Inclusion Translation",
      "url": "https://litbible.net",
      "description": "A trauma-informed, justice-oriented translation of the Bible from the original languages.",
      "publisher": {
        "@type": "Organization",
        "name": "Liberating Scripture Collective",
        "url": "https://liberatingscripture.org"
      },
      "potentialAction": {
        "@type": "SearchAction",
        "target": {
          "@type": "EntryPoint",
          "urlTemplate": "https://litbible.net/search?q={search_term_string}"
        },
        "query-input": "required name=search_term_string"
      }
    })} />
  </Fragment>
  <!-- HERO -->
  <section class="hero">
    <div class="hero-wrap container">
      <svg
        class="hero-shape"
        viewBox="0 0 1000 520"
        preserveAspectRatio="none"
        aria-hidden="true"
      >
        <path
          fill="var(--page-bg)"
          d="
            M 80 0
            L 920 0

            C 960 60, 960 160, 920 260
            C 880 360, 880 460, 920 520

            L 80 520

            C 40 460, 40 360, 80 260
            C 120 160, 120 60, 80 0
            Z
          "
        ></path>
      </svg>

      <EmblemMark class="v2-home__emblem" />

      <div class="hero-content">
        <div class="hero-inner">
          <p class="hero-lead">
            The Bible is a library of sacred literature from <span class="v2-home__hl">oppressed &amp;
            marginalized communities.</span>
          </p>

          <p class="hero-question">
            <em>
              So why do we translate it to justify more trauma,
              authoritarianism, and exclusion?
            </em>
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- TITLE + READ MENU -->
  <section
    class="title-block title-block--with-menu"
    aria-labelledby="lit-title"
  >
    <div class="title-block__inner container">
      <p class="title-small">Introducing</p>

      <h1 id="lit-title" class="title-stack">
        <span class="title-medium">The</span>
        <span class="title-large">Liberation</span>
        <span class="title-medium">and</span>
        <span class="title-large">Inclusion</span>
        <span class="title-large">Translation</span>
      </h1>

      <p class="title-small title-sub">of the Christian Scriptures</p>

      <ContinueReading class="title-continue" />

      {/* Site 2.0: the card's one row (BVJ: "Home card row: 1 row"): the
          passage picker, the search field, and the Study Desk. The picker
          waits in a template and the field is the header's own SearchBar
          (one per page; its ids are fixed), both put in place by the script
          below, with the stamp only. The Study Desk link shows only while
          the desk runs (ReadMenu's rule for .read-menu__desk), as on /read. */}
      <div class="v2-home__actions" data-v2 data-v2-home-row>
        <div class="v2-home__picker" data-v2-home-picker-slot>
          <template data-v2-home-picker><ReadMenu /></template>
        </div>
        <div class="v2-home__search" data-v2-home-search-slot></div>
        <a class="read-menu__desk v2-home__desk" href="/desk/">
          <svg class="read-menu__icon" viewBox="0 0 24 24" width="1em" height="1em" fill="none"
               stroke="currentColor" stroke-width="2" stroke-linecap="round"
               stroke-linejoin="round" aria-hidden="true" focusable="false">
            <path d="M4 21h9M8.5 21V8a4 4 0 0 1 4-4h2" />
            <path d="M14.5 4h3l2.5 6h-8z" />
            <path d="M16 13.5v2" />
          </svg>
          <span>Study Desk</span>
        </a>
      </div>

      {latestLine && (
        <p class="v2-home__latest" data-v2 data-pagefind-ignore>
          Latest change: {latestLine} · <a href="/release-notes/">Release Notes</a>
        </p>
      )}

      {/* Site 2.0, with the stamp only (Layout.astro sets it before first
          paint, so this runs before the row is drawn): the picker is made
          from its template, and the header's SearchBar moves into the row.
          The header's search buttons are hidden with the stamp (v2/home.css),
          since the page now has its own field, and "/" (the
          lit:search-open event) is answered here by focusing that field
          rather than opening the header's emptied strip. Without the stamp
          this does nothing at all. */}
      <script is:inline>
        (() => {
          if (!document.documentElement.hasAttribute("data-restyle")) return;
          const row = document.querySelector("[data-v2-home-row]");
          if (!row) return;
          const tpl = row.querySelector("template[data-v2-home-picker]");
          const pickerSlot = row.querySelector("[data-v2-home-picker-slot]");
          if (tpl && pickerSlot) pickerSlot.append(tpl.content.cloneNode(true));
          const bar = document.querySelector("#headerSearch [data-searchbar]");
          const searchSlot = row.querySelector("[data-v2-home-search-slot]");
          if (!bar || !searchSlot) return;
          searchSlot.append(bar);
          const input = bar.querySelector("input[type='search']");
          window.addEventListener(
            "lit:search-open",
            (event) => {
              event.stopImmediatePropagation();
              input?.focus({ preventScroll: true });
              input?.scrollIntoView({ block: "nearest" });
            },
            true,
          );
        })();
      </script>
    </div>
  </section>

  <!-- INTRO -->
  <section class="intro" aria-labelledby="intro-title">
    <div class="intro-inner container">
      <h2 id="intro-title" class="intro-eyebrow">Hi there. I’m Brandon.</h2>

      <p class="intro-lead">
        No, I don’t want my kids near most Bibles, either.
      </p>

      <p class="intro-lead">I don’t want it to hurt them like it hurt me.</p>

      <p class="intro-lead">
        That’s why I’ve been translating it for them since 2020.
      </p>

      <p class="intro-body">
        All from a trauma-informed, cringe-mindful, liberationist lens.
      </p>

      <p class="intro-body">One Greek word at a time.</p>
    </div>
  </section>

  <!-- CALLOUT -->
  <section class="callout" data-animate="underline">
    <div class="callout-inner container">
      <div class="callout-panel">
        <h2 class="callout-head">
          Turns out there’s some
          <span class="callout-underline">
            really
            <svg
              class="callout-underline-svg"
              viewBox="0 0 220 26"
              aria-hidden="true"
              focusable="false"
            >
              <path
                class="callout-underline-path"
                d="M6 18 C 55 6, 120 6, 214 16"></path>
            </svg>
          </span>
          good stuff in there.
        </h2>

        <a
          class="callout-cta footer-cta"
          href="/read"
          aria-label="Read the Liberation and Inclusion Translation now"
        >
          <span><span data-v1>Read Now</span><span data-v2 data-pagefind-ignore>Read now</span></span>
        </a>
      </div>
    </div>

    <div class="callout-diagonal" aria-hidden="true"></div>
  </section>

  <!-- Underline animation -->
  <script type="module">
    (() => {
      const sections = document.querySelectorAll('[data-animate="underline"]');
      if (sections.length === 0) return;

      const observer = new IntersectionObserver(
        (entries, obs) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-visible");
              obs.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.35 },
      );

      sections.forEach((s) => observer.observe(s));
    })();
  </script>

  <!-- CHAT -->
  <section class="chat-block" aria-labelledby="chat-block-title">
    <div class="chat-block__inner container">
      <h2 id="chat-block-title" class="sr-only">
        A conversation about salvation and liberation
      </h2>

      <div class="chat-thread">
        <div class="chat-bubble chat-bubble--left" data-animate="in">
          <p>Tell me more of this <em>good stuff</em>…</p>
        </div>

        <div class="chat-bubble chat-bubble--right" data-animate="in">
          <p>
            “Salvation” was one of the first words I worked through. I picture
            floating on clouds, being rescued from hell. The sinner’s prayer,
            and all that.
          </p>
        </div>

        <div class="chat-bubble chat-bubble--left" data-animate="in">
          <p>That’s not what salvation is about?</p>
        </div>

        <div class="chat-bubble chat-bubble--right" data-animate="in">
          <p>
            Well, to a lot of Christians it is. But that word traps them in the
            wrong story. Jesus freed the oppressed and cast down the mighty.
            That sounds less like salvation and more like…
          </p>
        </div>

        <div
          class="chat-bubble chat-bubble--left chat-bubble--center"
          data-animate="in"
        >
          <p>Liberation</p>
        </div>

        <div class="chat-bubble chat-bubble--right" data-animate="in">
          <p>Exactly! Did you scroll ahead or something?</p>
        </div>
      </div>

      {/* Site 2.0: the passage the chat lands on, beside it (built above). */}
      {passageHtml && (
        <div class="v2-home__sample" data-v2 data-pagefind-ignore>
          <div class="v2-home__sample-head">
            <p class="v2-label">From the LIT · {passageRef}</p>
            <a class="v2-home__arrow" href={`/${PASSAGE_BOOK}-${PASSAGE_CHAPTER}`}>Read Luke {PASSAGE_CHAPTER} →</a>
          </div>
          <div class="v2-home__passage" set:html={passageHtml} />
          {passageCard && (
            <div class="v2-home__card" role="group" aria-label={`Key term: ${passageCard.word}`}>
              <p class="v2-home__card-word">{passageCard.word}</p>
              <p class="v2-home__card-origin">
                {passageCard.traditional.length > 0 && !passageCard.same && (
                  <>Traditionally {passageCard.traditional.map((w, i) => (<>{listJoin(passageCard!.traditional, i)}<em>{w}</em></>))} · </>
                )}Greek {passageCard.greek.map((w, i) => (<>{listJoin(passageCard!.greek, i)}<em>{w}</em></>))}
              </p>
              {passageCard.also && (
                <p class="v2-home__card-also">Also rendered: {passageCard.also}</p>
              )}
              <a class="v2-home__arrow v2-home__card-jump" href={`/glossary/#${passageCard.id}`}>{passageCard.title} in the glossary →</a>
            </div>
          )}
        </div>
      )}
    </div>
  </section>

  <!-- Chat animation -->
  <script type="module">
    (() => {
      const reduceMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      ).matches;
      if (reduceMotion) return;

      const els = document.querySelectorAll('[data-animate="in"]');
      if (!("IntersectionObserver" in window) || els.length === 0) return;

      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-in");
              io.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.15 },
      );

      els.forEach((el, i) => {
        if (!(el instanceof HTMLElement)) return;
        el.style.setProperty("--stagger", `${i * 70}ms`);
        io.observe(el);
      });
    })();
  </script>

  <!-- QUESTIONS -->
  <section class="questions-block" aria-labelledby="questions-title">
    <div class="questions-block__inner container">
      <h2 id="questions-title" class="questions-block__title">
        I’ve got more questions…
      </h2>

      <div class="questions-grid">
        <!-- Card 1 -->
        <article class="question-card">
          <div class="question-card__media">
            <img
              src="/images/open-bible.webp"
              alt="A Bible open to Matthew with handwritten study notes and a reference book"
              width="600"
              height="400"
              loading="lazy"
              decoding="async"
            />
          </div>

          <h3 class="question-card__question">
            What values guide this effort?
          </h3>

          <p class="question-card__answer">
            Faithfulness to the Greek, reading with the damned, sidestepping
            religious jargon, trusting that God is always like Jesus, and more.
          </p>

          <a
            class="question-cta"
            href="/translation-commitments"
            aria-label="Read the translation commitments"
          >
            <span>More about Commitments</span>
          </a>
        </article>

        <!-- Card 2 -->
        <article class="question-card">
          <div class="question-card__media">
            <img
              src="/images/upside-down.webp"
              alt="A hand holding a glass sphere reflecting a city skyline at sunset"
              width="600"
              height="450"
              loading="lazy"
              decoding="async"
            />
          </div>

          <h3 class="question-card__question">
            Who are you, to translate the Bible?!
          </h3>

          <p class="question-card__answer">
            Let’s start with the first three words of that question…
          </p>

          <a
            class="question-cta"
            href="/about"
            aria-label="Learn about Brandon and the project background"
          >
            <span>I’m just a person</span>
          </a>
        </article>

        <!-- Card 3 -->
        <article class="question-card v2-home__q--thumb">
          <div class="question-card__media">
            <img
              src="/images/fit-cover.webp"
              alt="Found in Translation podcast cover"
              width="600"
              height="600"
              loading="lazy"
              decoding="async"
            />
          </div>

          <h3 class="question-card__question">
            What if I’m more of an auditory learner?
          </h3>

          <p class="question-card__answer">
            I cohost a podcast where we work through the LIT one chapter or big
            idea at a time. It’s called “Found in Translation.”
          </p>

          <a
            class="question-cta"
            href="/podcast"
            aria-label="Listen to the Found in Translation podcast"
          >
            <span>Listen now</span>
          </a>
        </article>

        <!-- Card 4 -->
        <article class="question-card v2-home__q--thumb">
          <div class="question-card__media question-card__media--mark">
            <LscMark
              size={600}
              title="The Liberating Scripture Collective logo: a dove taking flight"
            />
          </div>

          <h3 class="question-card__question">
            Who keeps all this going?
          </h3>

          <p class="question-card__answer">
            I started the Liberating Scripture Collective, a nonprofit, to
            sustain the LIT and grow the teaching and care around it.
          </p>

          <a
            class="question-cta"
            href="/liberating-scripture-collective"
            aria-label="Meet the Liberating Scripture Collective"
          >
            <span>Meet the Collective</span>
          </a>
        </article>

        <!-- Card 5 -->
        <article class="question-card">
          <div class="question-card__media">
            <img
              src="/images/articles/stars-and-sand.webp"
              alt="Silhouetted figures atop a glowing orange sand dune under a star-filled night sky"
              width="600"
              height="600"
              loading="lazy"
              decoding="async"
            />
          </div>

          <h3 class="question-card__question">
            Can you show your work?
          </h3>

          <p class="question-card__answer">
            I write up the thorny translation calls, the Greek, and the ideas
            behind the LIT as articles you can dig into.
          </p>

          <a
            class="question-cta"
            href="/articles"
            aria-label="Read articles about the translation"
          >
            <span>Read the articles</span>
          </a>
        </article>

        <!-- Card 6 -->
        <article class="question-card v2-home__q--thumb">
          <div class="question-card__media">
            <img
              src="/assets/images/lit-app-icon-ios.webp"
              alt="The LIT Bible app icon: a glowing multicolor mark over a book with a red bookmark"
              width="600"
              height="600"
              loading="lazy"
              decoding="async"
            />
          </div>

          <h3 class="question-card__question">
            What if I’d rather read on my phone?
          </h3>

          <p class="question-card__answer">
