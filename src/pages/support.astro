---
// src/pages/support.astro
import Layout from "../layouts/Layout.astro";
import "../styles/pages/support.css";
import LscMark from "../components/LscMark.astro";

const donateHref = "#donate";
const lscSiteHref = "https://liberatingscripture.org";
const lscContactHref = "https://liberatingscripture.org/contact";
---

<Layout
  title="Support | Liberation and Inclusion Translation"
  description="Support the Liberating Scripture Collective (LSC): help keep liberation-centered, trauma-informed scripture work free, auditable, and community-shaped."
  canonical="https://litbible.net/support/"
>
  <Fragment slot="head">
    <script
      is:inline
      defer
      src="https://secure.givelively.org/widgets/simple_donation/liberating-scripture-collective.js?show_suggested_amount_buttons=false&show_in_honor_of=false&address_required=false&has_required_custom_question=null"
    ></script>
  </Fragment>
  <div class="support">
    <!-- HERO -->
    <header class="support-hero" aria-label="Support the work">
      <div class="support-hero__grid">
        <div class="support-hero__copy">
          <p class="eyebrow">Support the work</p>

          <h1>Donate. Get involved. Help it last.</h1>

          <p class="lede">
            The LIT is freely available online, and that's not going to change.
            The Liberating Scripture Collective exists to keep it going
            long-term and to build the learning resources, teaching, and
            trauma-informed support around it that make the translation more
            than just text on a screen.
          </p>

          <p class="lede">
            If this work has helped you, or if you want it to exist for the next
            person who needs it, this is where you can join in.
          </p>

          <div class="support-actions" aria-label="Primary actions">
            <a class="button button--primary" href={donateHref}>Donate</a>
            <a class="button" href="#get-involved">Get involved</a>
            <a
              class="button button--outline button--external"
              href={lscSiteHref}
              target="_blank"
              rel="external noopener"
            >
              liberatingscripture.org
            </a>
          </div>
        </div>

        <div
          class="support-hero__media"
          aria-label="Open book shaped like a heart"
        >
          <img
            src="/images/book-heart.webp"
            alt="An open book with pages shaped into a heart"
            width="1200"
            height="800"
            loading="eager"
            decoding="async"
          />
        </div>
      </div>
    </header>

    <!-- BODY -->
    <div class="support-content">
      <!-- DONATE BAND -->
      <section id="donate" class="support-section">
        <div class="support-band" aria-label="Donate to support the work">
          <div class="support-band__brand">
            <LscMark size={120} class="support-band__logo" />

            <div class="support-band__brand-text">
              <span>Liberating Scripture<br />Collective</span>
            </div>
          </div>

          <div class="support-band__copy">
            <h2>Donate</h2>

            <p>
              Donations keep the core work open-access, help cover
              infrastructure costs, and make it possible to publish resources
              without paywalls or extraction.
            </p>

            <ul class="support-list">
              <li>
                <strong>Infrastructure:</strong> hosting, tooling, accessibility work,
                and upkeep.
              </li>
              <li>
                <strong>Publishing:</strong> layout, editing, and eventual print production
                (without locking content).
              </li>
              <li>
                <strong>Capacity:</strong> collaboration workflows, review processes,
                and sustainability.
              </li>
            </ul>

            <p class="fineprint">
              The Liberating Scripture Collective is a registered 501(c)(3)
              nonprofit organization. Donations are tax-deductible to the extent
              permitted by law.
            </p>
          </div>

          <!-- Begin Give Lively Fundraising Widget -->
          <div id="give-lively-widget" class="gl-simple-donation-widget"></div>
          <!-- End Give Lively Fundraising Widget -->
        </div>
      </section>

      <!-- GET INVOLVED -->
      <section id="get-involved" class="support-section">
        <h2>Get involved</h2>

        <p>
          “Getting involved” can mean a lot of things, and none of them require
          being an expert. The goal is to build a community of feedback,
          accountability, and shared stewardship.
        </p>

        <div class="support-cards" aria-label="Ways to get involved">
          <article class="support-card">
            <h3>Give feedback</h3>
            <p>
              Point out unclear wording, confusing structure, or places where
              the translation needs more transparency. Specific examples help
              most.
            </p>
          </article>

          <article class="support-card">
            <h3>Share with others</h3>
            <p>
              If LIT or LSC has been useful, share it with people who want an
              honest approach to scripture.
            </p>
          </article>

          <article class="support-card">
            <h3>Collaborate</h3>
            <p>
              If you have relevant experience (biblical studies, accessibility,
              design, education, community care), you can help shape resources
              and workflows.
            </p>
          </article>

          <article class="support-card">
            <h3>Partner thoughtfully</h3>
            <p>
              If you lead a community or program and want to use LIT/LSC
              material responsibly, reach out and we’ll talk about what makes
              sense.
            </p>
          </article>
        </div>

        <div
          class="support-actions support-actions--left"
          aria-label="Contact actions"
        >
          <a class="button button--primary" href="/contact">
            Get involved (contact)
          </a>

          <a
            class="button button--outline button--external"
            href={lscContactHref}
            target="_blank"
            rel="external noopener"
          >
            LSC contact
          </a>
        </div>

        <p class="fineprint">
          If you’re not sure what you have to offer, that’s normal. A short note
          describing your interest and constraints is enough to start.
        </p>
      </section>

      <!-- TRANSPARENCY -->
      <section id="transparency" class="support-section">
        <h2>Transparency and non-commercial access</h2>

        <p>
          The point is not to build a brand. The point is to build work that
          stays free, stays honest, and stays accountable to real human impact.
        </p>

        <ul class="support-list">
          <li>
            <strong>No paywalls for core work:</strong> the translation and key resources
            remain open online.
          </li>
          <li>
            <strong>Clarity over mystique:</strong> translation choices are meant
            to be explainable and auditable.
          </li>
          <li>
            <strong>Community-shaped:</strong> feedback and critique are part of the
            design, not an afterthought.
          </li>
        </ul>
      </section>

      <!-- QUICK LINKS -->
      <section id="links" class="support-section">
        <h2>Quick links</h2>

        <div
          class="support-actions support-actions--left"
          aria-label="Quick links"
        >
          <a class="button" href={donateHref}>Donate</a>
          <a class="button" href="#get-involved">Get involved</a>

          <a
            class="button button--outline button--external"
            href={lscSiteHref}
            target="_blank"
            rel="external noopener"
          >
            liberatingscripture.org
          </a>

          <a class="button button--outline" href="/contact">
            Contact (this site)
          </a>

          <a
            class="button button--outline button--external"
            href={lscContactHref}
            target="_blank"
            rel="external noopener"
          >
            Contact (LSC site)
          </a>
        </div>

        <p class="fineprint">
          The Liberating Scripture Collective is a registered 501(c)(3)
          nonprofit. Ways to collaborate will expand as the work grows.
        </p>
      </section>
    </div>
  </div>
</Layout>
