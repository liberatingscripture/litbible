---
import Layout from "../layouts/Layout.astro";
import "../styles/pages/apps.css";

/* ─────────────────────────────────────────────────────────────────────────
   LAUNCH-DAY EDITS — do these when the apps go live in the stores.
   ─────────────────────────────────────────────────────────────────────────
   ON THIS PAGE:

   1. STORE LINKS. Fill in the two URLs below, then in the markup replace the
      `.apps-store-row` "coming soon" block with the commented-out
      `<!-- LIVE STORE BADGES -->` block a few lines under it. That block
      references /images/app-store-badge.svg and /images/google-play-badge.png
      — drop the OFFICIAL badge artwork in public/images/ first (Apple:
      developer marketing resources; Google:
      https://play.google.com/intl/en_us/badges/). Do not recolor or redraw
      the badges; official artwork only.
   2. SCREENSHOTS. Replace the `.apps-phone` CSS mock in the hero with a real
      screenshot: swap the inner `.apps-phone__screen` markup for
      `<img src="/images/app-screenshot-1.png" ... />`. Repeat for any gallery
      slots you add lower down.
   3. COPY. Change the "coming soon" framing to "available now": the
      `.apps-eyebrow`, the hero `<h1>`, the hero lede, and the closing CTA
      heading/paragraph are the only spots that say "coming soon".

   ELSEWHERE — cross-promote the apps once they are live:

   4. /read PAGE. Add a short mention of the apps on src/pages/read.astro (the
      reading landing) with a link to /apps for more information.
   5. liberatingscripture.org. Add LIT Bible apps info on the org site,
      probably on the existing /lit-bible/ page, or possibly a new /apps page
      there. (Separate repo: C:\Users\bcjoh\GitHub\liberatingscripture.github.io)
   ───────────────────────────────────────────────────────────────────────── */

// Filled in at launch (see LAUNCH-DAY EDITS above).
const APP_STORE_URL = ""; // e.g. https://apps.apple.com/app/id...
const PLAY_STORE_URL = ""; // e.g. https://play.google.com/store/apps/details?id=...
---

<Layout
  title="LIT Bible Apps | Liberation and Inclusion Translation"
  description="The LIT Bible app is coming soon to iPhone and Android: the full Liberation and Inclusion Translation, plus notes, highlights, daily and Lectionary readings, and offline reading."
  canonical="https://litbible.net/apps/"
>
  <div class="apps">
    {/* HERO */}
    <header class="apps-hero" aria-labelledby="apps-title">
      <div class="apps-hero__grid">
        <div class="apps-hero__copy">
          <p class="apps-eyebrow">Coming soon to iPhone and Android</p>

          <h1 id="apps-title">The LIT Bible, in your pocket.</h1>

          <p class="apps-lede">
            We are building native iPhone and Android apps for the Liberation
            and Inclusion Translation. Everything on this website, plus notes,
            highlights, daily readings, and offline access, wrapped in an
            interface made for reading. It arrives in the app stores soon.
          </p>

          {/* Coming-soon store row. At launch, delete this block and use the
              LIVE STORE BADGES block below it (see LAUNCH-DAY EDITS). */}
          <div class="apps-store-row" role="group" aria-label="Availability">
            <span class="apps-badge apps-badge--soon">
              <span class="apps-badge__kicker">Coming soon to the</span>
              <span class="apps-badge__store">App&nbsp;Store</span>
            </span>
            <span class="apps-badge apps-badge--soon">
              <span class="apps-badge__kicker">Coming soon on</span>
              <span class="apps-badge__store">Google&nbsp;Play</span>
            </span>
          </div>

          {/*
          <!-- LIVE STORE BADGES — uncomment at launch, remove .apps-store-row above -->
          <div class="apps-store-row" role="group" aria-label="Download the app">
            <a class="apps-store-link" href={APP_STORE_URL} aria-label="Download on the App Store">
              <img src="/images/app-store-badge.svg" alt="Download on the App Store" width="180" height="60" />
            </a>
            <a class="apps-store-link" href={PLAY_STORE_URL} aria-label="Get it on Google Play">
              <img src="/images/google-play-badge.png" alt="Get it on Google Play" width="203" height="60" />
            </a>
          </div>
          */}

          <p class="apps-notify">
            Want to know the moment it lands? Join the mailing list at the
            bottom of this page and we will tell you when the apps go live.
          </p>
        </div>

        {/* Phone mock. Honest placeholder: the app's logo and name, not a
            fabricated app interface. Swap for a real screenshot at launch. */}
        <div class="apps-hero__media" aria-hidden="true">
          <div class="apps-phone">
            <div class="apps-phone__notch"></div>
            <div class="apps-phone__screen">
              <img
                class="apps-phone__logo"
                src="/images/lit-logo.png"
                alt=""
                loading="lazy"
                decoding="async"
              />
              <p class="apps-phone__wordmark">LIT Bible</p>
              <p class="apps-phone__sub">
                Liberation and Inclusion Translation
              </p>
              <span class="apps-phone__chip">Coming soon</span>
            </div>
          </div>
        </div>
      </div>
    </header>

    <div class="apps-content">
      {/* WHAT'S INSIDE */}
      <section class="apps-section" aria-labelledby="apps-features">
        <h2 id="apps-features">Everything here, and more</h2>
        <p class="apps-section__lead">
          The apps carry the whole translation you already read on this site,
          then add the tools that make it yours.
        </p>

        <div class="apps-cards" role="list">
          <article class="apps-card" role="listitem">
            <h3>Notes and highlights</h3>
            <p>
              Mark the verses that matter to you and keep your own notes right
              beside the text, saved on your device.
            </p>
          </article>

          <article class="apps-card" role="listitem">
            <h3>Daily readings</h3>
            <p>
              A steady rhythm to return to. Short daily passages help you stay
              in the text a little at a time.
            </p>
          </article>

          <article class="apps-card" role="listitem">
            <h3>Lectionary readings</h3>
            <p>
              Follow the Lectionary through the year, with each set of readings
              ready in the LIT.
            </p>
          </article>

          <article class="apps-card" role="listitem">
            <h3>Read offline</h3>
            <p>
              The full translation lives on your device, so you can keep reading
              with no signal and no data.
            </p>
          </article>

          <article class="apps-card" role="listitem">
            <h3>Always up to date</h3>
            <p>
              As the translation is revised and new chapters are published, the
              apps update themselves to match the latest text on the site.
            </p>
          </article>

          <article class="apps-card" role="listitem">
            <h3>Made for reading</h3>
            <p>
              The website works well on a phone. The apps go further, with a
              calm, native interface built around the words.
            </p>
          </article>
        </div>
      </section>

      {/* SAME TRANSLATION, SAME COMMITMENTS */}
      <section class="apps-section apps-commitments" aria-labelledby="apps-same">
        <h2 id="apps-same">Same translation, same commitments</h2>
        <p>
          The apps are free, with no accounts and no paywalls, just like the
          website. They carry the same trauma-informed, justice-oriented
          translation, the same footnotes, and the same
          <a href="/translation-commitments/">translation commitments</a>. The
          text stays open, licensed under
          <a
            href="https://creativecommons.org/licenses/by-nc-nd/4.0/"
            rel="license noopener noreferrer"
            target="_blank">CC BY-NC-ND 4.0</a
          >, wherever you read it.
        </p>
        <p class="apps-commitments__links">
          <a class="apps-textlink" href="/read/">Start reading on the web</a>
          <a class="apps-textlink" href="/about/">About the translation</a>
        </p>
      </section>

      {/* CLOSING CTA */}
      <section class="apps-section apps-cta" aria-labelledby="apps-notify-title">
        <h2 id="apps-notify-title">Be the first to know</h2>
        <p>
          The apps are almost here. Sign up for the mailing list below and we
          will let you know the day they arrive in the App Store and on Google
          Play, along with new translation work as it is published.
        </p>
      </section>
    </div>
  </div>
</Layout>
