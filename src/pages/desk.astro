---
import Layout from "../layouts/Layout.astro";
import SblgntNotice from "../components/SblgntNotice.astro";
import { scanDraftChapters } from "../lib/draft-chapters.mjs";
import "../styles/pages/desk-page.css";

/**
 * The Study Desk as a page of its own (STUDY-DESK.md, D9; phase 3c): one to
 * four panes side by side or stacked, the LIT text among them. Everything on
 * it is drawn in the browser by src/scripts/desk/desk-page.js, which
 * desk-gate.js loads only when the Study Desk preview is switched on
 * (?desk=on), on a computer. For everyone else, and with JS off, this is the
 * whole page: a short note saying the desk is part of a preview. noindex, out
 * of the sitemap (astro.config.mjs) and out of Pagefind (Layout's default).
 *
 * The page carries two things the LIT pane needs (phase 3e): the draft
 * chapters of each book, so a run of them shows as one stub without
 * fetching each, and the description a poetry block's aria-describedby
 * names, as a chapter page does.
 *
 * Its header is the desk's own (BVJ, 2026-10-21; SiteHeader's deskTitle): the
 * page's title sits there, centered, and is the menu holding Display options
 * and the rest (E15, E68). The Display tray has no "Show" group here (no
 * `scriptureControls`): the switches that mark up the LIT text are on each
 * LIT pane's own bar, one set a pane (E108; lit-show.js). Layout.astro's
 * pre-paint script still stamps Chapter View's on <html> here as on every
 * page, and a pane's text leaves them alone (global.css, data-own-marks).
 * The source-text notice follows the panes, as it follows every page that
 * prints the translation, so the page scrolls: desk-page.js grows the panes
 * as the header scrolls away, and the notice comes up after them.
 */
const draftsJson = JSON.stringify(scanDraftChapters().draftChaptersByBook);
---

<Layout
  title="Study Desk | Liberation and Inclusion Translation"
  description="The Study Desk on the LIT Bible: the text, your notes, and the Greek side by side."
  robotsNoindex={true}
  hideFooterNewsletter={true}
  deskTitle="Study Desk"
>
  <div class="desk-page">
    <div id="hbq-description" hidden>Formatted as Hebrew and Semitic poetry with indented parallel lines</div>
    <script type="application/json" id="desk-drafts" set:html={draftsJson} />
    <div data-desk-page>
      <!-- With the preview on, the page says it is loading rather than that the
           preview is off, until the desk's code replaces both (BA153). -->
      <p class="desk-page__loading">Loading the Study Desk…</p>
      <p class="desk-page__off">
        The Study Desk is a preview that isn’t switched on in this browser, so
        there is nothing to show here yet.
      </p>
    </div>
  </div>
  <div class="desk-page__notice">
    <SblgntNotice />
  </div>
</Layout>
