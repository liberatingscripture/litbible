---
import Layout from "../layouts/Layout.astro";
import "../styles/pages/found-in-translation-podcast.css";
import PodcastEpisodesFlat from "../components/PodcastEpisodesFlat.astro";

// Update these paths to match what’s in /public/images/
const heroImage = "/images/scopio-0b189831-4e0b-46c8-a758-c743663d7611.webp";
const coverImage = "/images/fit-cover.webp";
---

<Layout
  title="Found in Translation Podcast | Liberation and Inclusion Translation"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "PodcastSeries",
      "name": "Found in Translation",
      "description": "Armchair bible banter for liberation and healing with Brandon Vélez Johnson and Brandon Rhodes.",
      "url": "https://litbible.net/found-in-translation-podcast/",
      "image": "https://litbible.net/images/fit-cover.webp",
      "author": [
        { "@type": "Person", "name": "Brandon C. Vélez Johnson", "url": "https://litbible.net/about" },
        { "@type": "Person", "name": "Brandon Rhodes" }
      ],
      "publisher": {
        "@type": "Organization",
        "name": "Liberating Scripture Collective",
        "url": "https://liberatingscripture.org"
      },
      "webFeed": [
        { "@type": "DataFeed", "url": "https://podcasts.apple.com/us/podcast/found-in-translation/id1586737797" },
        { "@type": "DataFeed", "url": "https://open.spotify.com/show/6S2wWaM5oqknwncPfOEyZ6" }
      ]
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://litbible.net/" },
        { "@type": "ListItem", "position": 2, "name": "Found in Translation Podcast", "item": "https://litbible.net/found-in-translation-podcast/" }
      ]
    })} />
  </Fragment>
  <div class="fit-page">
    <!-- HERO -->
    <section class="fit-hero" aria-label="Found in Translation hero">
      <img
        class="fit-hero__bg"
        src={heroImage}
        alt=""
        width="1920"
        height="1080"
        loading="eager"
        decoding="async"
      />

      <div class="fit-hero__content">
        <h1 class="fit-hero__title">Found in Translation</h1>
        <p class="fit-hero__subtitle">
          armchair bible banter for liberation and healing
        </p>
        <p class="fit-hero__byline">
          with Brandon Vélez Johnson and Brandon Rhodes
        </p>
      </div>
    </section>

    <!-- COVER + PLATFORMS -->
    <section class="fit-platforms" aria-label="Listen on podcast platforms">
      <div class="fit-cover-wrap">
        <img
          class="fit-cover"
          src={coverImage}
          alt="Found in Translation podcast cover"
          width="600"
          height="600"
          loading="lazy"
          decoding="async"
        />
      </div>

      <div class="fit-platform-links">
        <a
          class="fit-platform fit-platform--apple"
          href="https://podcasts.apple.com/us/podcast/found-in-translation/id1586737797"
          target="_blank"
          rel="noopener"
        >
          Apple Podcasts
        </a>
        <a
          class="fit-platform fit-platform--spotify"
          href="https://open.spotify.com/show/6S2wWaM5oqknwncPfOEyZ6"
          target="_blank"
          rel="noopener"
        >
          Spotify
        </a>
        <a
          class="fit-platform fit-platform--youtube"
          href="https://www.youtube.com/@foundintranslationpodcast"
          target="_blank"
          rel="noopener"
        >
          YouTube
        </a>
      </div>
    </section>

    <!-- LATEST -->
    <section
      class="fit-section fit-section--green"
      aria-label="Latest episodes"
    >
      <h2 class="fit-h2">Latest Episodes</h2>

      <div class="fit-embed fit-embed--apple" aria-label="Apple Podcasts embed">
        <iframe
          id="embedPlayer"
          src="https://embed.podcasts.apple.com/us/podcast/found-in-translation/id1586737797?itsct=podcast_box_player&itscg=30200&ls=1&theme=auto"
          height="450"
          frameborder="0"
          sandbox="allow-forms allow-popups allow-same-origin allow-scripts allow-top-navigation-by-user-activation"
          allow="autoplay *; encrypted-media *; clipboard-write"
          loading="lazy"
          title="Found in Translation on Apple Podcasts"></iframe>
      </div>

      <div class="fit-embed-grid">
        <div class="fit-embed" aria-label="YouTube embed">
          <iframe
            width="560"
            height="315"
            src="https://www.youtube.com/embed/videoseries?si=89z4Tei3C_Hw3ZIH&list=PLZJ2_GOQPBSqHh0NYqKQGyYLDv0ajw5nG"
            title="YouTube video player"
            frameborder="0"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            referrerpolicy="strict-origin-when-cross-origin"
            allowfullscreen></iframe>
        </div>

        <div class="fit-embed" aria-label="Spotify embed">
          <iframe
            src="https://open.spotify.com/embed/show/6S2wWaM5oqknwncPfOEyZ6?utm_source=generator&theme=0"
            frameborder="0"
            allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
            loading="lazy"
            title="Found in Translation on Spotify"></iframe>
        </div>
      </div>
    </section>

    <!-- ALL EPISODES (RSS-driven) -->
    <section
      class="fit-section fit-section--cream fit-episodes"
      aria-labelledby="fit-all-episodes"
    >
      <div class="fit-episodes__inner">
        <h2 id="fit-all-episodes" class="fit-episodes__kicker">All Episodes</h2>
        <PodcastEpisodesFlat />
      </div>
    </section>
  </div>
</Layout>
