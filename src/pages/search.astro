---
// src/pages/search.astro
import SearchLayout from "../layouts/SearchLayout.astro";
import { SEARCH_CREDIT, isExternal } from "../lib/greek-credits.mjs";

const title = "Search | Liberation and Inclusion Translation";
const description = "Search the Liberation & Inclusion Translation (LIT).";
---

<SearchLayout
  title={title}
  description={description}
  bg="cream"
  type="search"
  pagefindIndex={false}
>
  {/* The field is the page; its title is for screen readers (SE-02). */}
  <h1 class="sr-only" slot="preSearch">Search</h1>

  <section class="search-page" data-pagefind-ignore>
    {/* One row of tabs with their counts, and at its right end the book menu,
         the sort, and with the Study preview Notebook actions and Select
         (search.js; SE-03 to SE-12). */}
    <div class="search-bar-row">
      <div class="kit-tabs search-tabs" id="search-tabs" role="tablist" aria-label="Kinds of results"></div>
      <div class="search-tools" id="search-tools">
        <label class="sr-only" for="search-sort">Sort results</label>
        <select id="search-sort" class="kit-field search-sort">
          <option value="relevance">Relevance</option>
          <option value="order">Bible order</option>
        </select>
      </div>
    </div>

    <p class="search-status" id="search-status" aria-live="polite"></p>

    {/* The reference answer: "Go to John 3:16," then "Study John 3:16" */}
    <div class="search-ref" id="search-ref" data-search-ref hidden></div>

    {/* Filled only with the Study preview on: matches from the reader's own
         notebook, searched in the browser (desk/notebook-search.js). */}
    <div class="group search-group" id="group-notebook" role="tabpanel" aria-labelledby="tab-notebook" tabindex="-1" hidden>
      <h2 class="group-title sr-only">Notebook</h2>
      <ol class="search-results-list" id="results-notebook"></ol>
    </div>

    <div class="group search-group" id="group-glossary" role="tabpanel" aria-labelledby="tab-glossary" tabindex="-1" hidden>
      <h2 class="group-title sr-only">Glossary</h2>
      <ol class="search-rows" id="results-glossary"></ol>
    </div>

    <div class="group search-group" id="group-subject" role="tabpanel" aria-labelledby="tab-subject" tabindex="-1" hidden>
      <h2 class="group-title sr-only">Chapters about it</h2>
      <ol class="search-rows" id="results-subject"></ol>
    </div>

    <div class="group search-group" id="group-intros" role="tabpanel" aria-labelledby="tab-intro" tabindex="-1" hidden>
      <h2 class="group-title sr-only">Introductions</h2>
      <ol class="search-rows" id="results-intros"></ol>
    </div>

    <div class="group search-group" id="group-articles" role="tabpanel" aria-labelledby="tab-article" tabindex="-1" hidden>
      <h2 class="group-title sr-only">Articles</h2>
      <ol class="search-rows" id="results-articles"></ol>
    </div>

    <div class="group search-group" id="group-keyword" role="tabpanel" aria-labelledby="tab-keyword" tabindex="-1" hidden>
      <h2 class="group-title sr-only">Scripture</h2>
      {/* The chapters line and the glossary line, over the verses */}
      <div class="search-lines" id="search-lines"></div>
      <ol class="search-rows" id="results-keyword"></ol>
    </div>

    {/* Filled only with the Study preview on, and then alone: the verses
         of a Greek word, each with its Greek and the LIT beneath. */}
    <div class="group search-group" id="group-greek" role="tabpanel" aria-labelledby="tab-greek" tabindex="-1" hidden>
      <h2 class="group-title sr-only">Greek</h2>
      <div class="greek-lemmas" id="greek-lemmas" hidden></div>
      <label class="greek-exact" id="greek-exact" hidden>
        <input type="checkbox" id="greek-exact-input" class="kit-check" />
        Exact form only
      </label>
      <ol class="search-results-list" id="results-greek"></ol>
      {/* Examples, or an error with its way out, where a Greek search has
           nothing to list (search.js). */}
      <div class="greek-help" id="greek-help" hidden></div>
      {/* Who the Greek comes from (BA46): the Greek tab's names and links. */}
      <p class="greek-credit">{SEARCH_CREDIT.map((p) =>
        typeof p === "string" ? p
        : isExternal(p.href) ? <a href={p.href} target="_blank" rel="noopener noreferrer">{p.text}</a>
        : <a href={p.href}>{p.text}</a>
      )}</p>
    </div>

    {/* Select's foot bar (Study preview): "3 chosen · Add to sheet… · Cancel" */}
    <div class="search-pickbar" id="search-pickbar" hidden></div>

    {/* The one pager, for whichever group is paging: English verses, or the
         Greek's when a Greek search is showing. */}
    <nav class="search-pager" id="pager" aria-label="Search result pages" hidden>
    </nav>
  </section>

  <script>
    import "../scripts/search.js";
  </script>
</SearchLayout>
