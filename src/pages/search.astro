---
// src/pages/search.astro
import SearchLayout from "../layouts/SearchLayout.astro";
import { BOOK_ORDER } from "../data/books.js";
import searchScript from "../scripts/search.js?url";

const title = "Search | Liberation and Inclusion Translation";
const description = "Search the Liberation & Inclusion Translation (LIT).";

// Runs at build time (Astro), safe to pass into define:vars
const baseUrl = import.meta.env.BASE_URL || "/";
---

<SearchLayout
  title={title}
  description={description}
  bg="cream"
  type="search"
  index={false}
>
  <header class="search-header" slot="preSearch">
    <h1 class="search-title">Search</h1>
    <p class="search-subtitle">
      Results update as you type. Use the filters to narrow by type and book.
    </p>
  </header>

  <section class="search-page" data-pagefind-ignore>
    <div class="search-meta">
      <!-- Sort stays in a dedicated row so it never "wraps under" the status line -->
      <div class="search-meta__top">
        <div class="sort-wrap" aria-label="Sort results">
          <span class="sort-label">Sort by:</span>
          <div class="sort-toggle">
            <button
              type="button"
              class="sort-btn"
              data-sort="relevance"
              aria-pressed="true"
              title="Sort by relevance"
            >
              Relevance
            </button>
            <button
              type="button"
              class="sort-btn"
              data-sort="order"
              aria-pressed="false"
              title="Sort by book and chapter order"
            >
              Book order
            </button>
          </div>
        </div>
      </div>

      <div class="search-meta__status">
        <div id="search-status" aria-live="polite"></div>
      </div>

      <div class="search-active-filters" id="search-active-filters" hidden>
      </div>

      <!-- Optional reference jump banner -->
      <div class="search-ref" id="search-ref" data-search-ref hidden></div>
    </div>

    <div class="group" id="group-glossary" hidden>
      <div class="group-title">Glossary matches</div>
      <ol class="results" id="results-glossary"></ol>
    </div>

    <div class="group" id="group-subject" hidden>
      <div class="group-title">Topic matches</div>
      <ol class="results" id="results-subject"></ol>
    </div>

    <div class="group" id="group-articles" hidden>
      <div class="group-title">Article matches</div>
      <ol class="results" id="results-articles"></ol>
    </div>

    <div class="group" id="group-keyword" hidden>
      <div class="group-title">Keyword matches</div>
      <ol class="results" id="results-keyword"></ol>

      <nav class="pager" id="pager" aria-label="Search result pages" hidden>
      </nav>
    </div>
  </section>

  <script is:inline define:vars={{ BASE_URL: baseUrl, BOOK_ORDER: BOOK_ORDER }}>
    window.__SEARCH_BASE_URL = BASE_URL;
    window.__SEARCH_BOOK_ORDER = BOOK_ORDER;
  </script>
  <script type="module" src={searchScript}></script>
</SearchLayout>

<style>
  .search-page {
    padding: 18px 0 42px;
  }

  :global(.search-header) {
    text-align: center;
    margin: 0 0 16px;
  }

  :global(.search-title) {
    font-size: 32px;
    margin: 0 0 8px;
  }

  :global(.search-subtitle) {
    margin: 0;
    color: rgba(29, 35, 28, 0.7);
  }

  .search-meta {
    max-width: var(--content-width, 72ch);
    margin: 0 auto 10px;
    padding: 0 16px;
    color: rgba(29, 35, 28, 0.8);
    font-size: 0.95rem;
  }

  /* Toggle row is always its own line; status lives below. No dancing. */
  .search-meta__top {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    min-height: 40px;
  }

  .search-meta__status {
    text-align: center;
    margin-top: 6px;
  }

  .search-active-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    justify-content: center;
    margin: 8px 0 4px;
  }

  .filter-pill {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 5px 12px;
    border-radius: 999px;
    border: 1px solid rgba(32, 157, 80, 0.35);
    background: rgba(32, 157, 80, 0.08);
    font-size: 0.88rem;
    cursor: pointer;
    white-space: nowrap;
    color: rgba(29, 35, 28, 0.9);
  }

  .filter-pill:hover {
    background: rgba(32, 157, 80, 0.16);
    border-color: rgba(32, 157, 80, 0.5);
  }

  .filter-pill span {
    font-size: 0.78rem;
    opacity: 0.65;
  }

  .filter-pill--clear-all {
    border-color: rgba(29, 35, 28, 0.18);
    background: transparent;
    color: rgba(29, 35, 28, 0.6);
  }

  .filter-pill--clear-all:hover {
    background: rgba(29, 35, 28, 0.06);
  }

  /* Ref banner */
  .search-ref {
    margin-top: 10px;
  }

  .search-ref__links {
    display: grid;
    gap: 8px;
  }

  .search-ref__label {
    margin: 0 0 2px;
    font-size: 0.9rem;
    color: rgba(29, 35, 28, 0.78);
  }

  .search-ref__link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    text-decoration: none;
    padding: 12px 12px;
    border-radius: 14px;
    background: rgba(32, 157, 80, 0.1);
    border: 1px solid rgba(32, 157, 80, 0.35);
    color: inherit;
  }

  .search-ref__link--read {
    background: rgba(29, 35, 28, 0.05);
    border-color: rgba(29, 35, 28, 0.28);
  }

  .search-ref__hint {
    opacity: 0.7;
    font-size: 0.9rem;
    white-space: nowrap;
  }

  .sort-wrap {
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }

  .sort-label {
    font-size: 0.9rem;
    color: rgba(29, 35, 28, 0.75);
    white-space: nowrap;
  }

  .sort-toggle {
    display: inline-flex;
    gap: 0;
    border-radius: 999px;
    overflow: hidden;
    border: 1px solid rgba(29, 35, 28, 0.18);
    background: rgba(255, 255, 255, 0.7);
    box-shadow: 0 8px 18px rgba(0, 0, 0, 0.08);
  }

  .sort-btn {
    appearance: none;
    border: none;
    background: transparent;
    padding: 8px 12px;
    font-size: 0.9rem;
    color: rgba(29, 35, 28, 0.9);
    cursor: pointer;
    white-space: nowrap;
  }

  .sort-btn.is-active {
    background: rgba(32, 157, 80, 0.16);
    color: rgba(29, 35, 28, 1);
  }

  .sort-btn:focus-visible {
    outline: 3px solid rgba(32, 157, 80, 0.55);
    outline-offset: 2px;
  }

  .group {
    max-width: var(--content-width, 72ch);
    margin: 0 auto;
    padding: 0 16px;
  }

  .group + .group {
    margin-top: 18px;
  }

  .group-title {
    font-size: 0.82rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    opacity: 0.72;
    margin: 14px 0 10px;
    text-align: left;
  }

  .search-page :global(.results) {
    margin: 0;
    padding: 0;
    list-style: none;

    display: grid;
    gap: 12px;
  }

  .search-page :global(.result) {
    margin: 0;
  }

  .search-page :global(.result-link) {
    display: block;
    text-decoration: none;
    color: #1d231c;

    border-radius: 16px;
    padding: 16px 16px;
    padding-right: 46px;

    background: rgba(255, 255, 255, 0.78);
    border: 1px solid rgba(29, 35, 28, 0.14);
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.08);

    position: relative;

    transition:
      transform 120ms ease,
      box-shadow 120ms ease,
      border-color 160ms ease,
      background-color 160ms ease;
  }

  .search-page :global(.result-title) {
    font-weight: 700;
    margin: 0 0 6px;
    line-height: 1.25;
    color: #1d231c;
  }

  .search-page :global(.result-excerpt) {
    color: rgba(29, 35, 28, 0.78);
    line-height: 1.5;
  }

  .search-page :global(.result-link::after) {
    content: "\203A"; /* › */
    position: absolute;
    right: 16px;
    top: 50%;
    transform: translateY(-50%);

    width: 28px;
    height: 28px;
    border-radius: 999px;

    display: grid;
    place-items: center;

    background: rgba(29, 35, 28, 0.08);
    color: rgba(29, 35, 28, 0.9);
    font-size: 22px;
    line-height: 1;
  }

  @media (hover: hover) and (pointer: fine) {
    .search-page :global(.result-link:hover) {
      transform: translateY(-1px);
      border-color: rgba(32, 157, 80, 0.45);
      box-shadow: 0 16px 34px rgba(0, 0, 0, 0.12);
      background: rgba(255, 255, 255, 0.92);
    }

    .search-page :global(.result-link:hover::after) {
      background: rgba(32, 157, 80, 0.18);
    }
  }

  .search-page :global(.result-link:active) {
    transform: translateY(0);
    box-shadow: 0 8px 18px rgba(0, 0, 0, 0.1);
    background: rgba(255, 255, 255, 0.95);
  }

  .search-page :global(.result-link:focus-visible) {
    outline: 3px solid rgba(32, 157, 80, 0.55);
    outline-offset: 3px;
  }

  /* Highlighting stays for keyword results only */
  .search-page :global(.result-excerpt mark) {
    background: rgba(255, 230, 0, 0.55);
    color: #1d231c;
    padding: 0 2px;
    border-radius: 3px;
  }

  /* ── Grouped occurrence results ── */
  .search-page :global(.result-group) {
    list-style: none;
    margin: 0 0 4px;
  }

  .search-page :global(.result-group__title) {
    font-weight: 700;
    font-size: 1rem;
    color: #1d231c;
    padding: 5px 16px 6px;
  }

  .search-page :global(.result-group__occurrences) {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .search-page :global(.result-occurrence) {
    list-style: none;
  }

  .search-page :global(.result-occurrence--collapsed) {
    display: none !important;
  }

  .search-page :global(.result-link--occurrence) {
    padding: 12px 16px;
    padding-right: 46px;
    border-radius: 12px;
  }

  .search-page :global(.result-link--occurrence .result-excerpt) {
    font-size: 0.92rem;
  }

  [hidden] {
    display: none !important;
  }
</style>

<style is:global>
  .result--collapsed {
    display: none !important;
  }

  .see-more-btn {
    display: inline-block;
    margin-top: 6px;
    padding: 4px 12px;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--accent, #38613a);
    background: transparent;
    border: 1.5px solid var(--accent, #38613a);
    border-radius: 6px;
    cursor: pointer;
    transition:
      background 0.15s,
      color 0.15s;
  }

  .see-more-btn:hover {
    background: var(--accent, #38613a);
    color: #fff;
  }

  /* ── Suggest-word buttons (dynamically created, needs global scope) ── */

  .suggest-word {
    display: inline-block;
    padding: 6px 14px;
    border-radius: 12px;
    border: none;
    background-color: var(--green, #209d50);
    color: var(--white, #fff);
    cursor: pointer;
    font-size: 0.88rem;
    font-weight: 600;
    line-height: 1;
    box-shadow: 0 6px 14px rgba(0, 0, 0, 0.18);

    transition:
      background-color 0.18s ease,
      transform 0.18s ease,
      box-shadow 0.18s ease;
  }

  .suggest-word:hover {
    background-color: var(--ink, #1d231c);
    transform: translateY(-1px);
    box-shadow: 0 10px 20px rgba(0, 0, 0, 0.22);
  }

  .suggest-word:active {
    transform: translateY(0);
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.15);
  }

  .search-ref .search-ref__links {
    display: grid;
    gap: 8px;
  }

  .search-ref .search-ref__label {
    margin: 0 0 2px;
    font-size: 0.9rem;
    color: rgba(29, 35, 28, 0.78);
  }

  .search-ref .search-ref__link {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    text-decoration: none;
    padding: 12px 14px;
    border-radius: 12px;
    background-color: var(--green, #209d50);
    border: none;
    color: var(--white, #fff);
    font-weight: 700;
    box-shadow: 0 8px 16px rgba(0, 0, 0, 0.2);
    transform: translateY(0);
    transition:
      transform 140ms ease,
      box-shadow 180ms ease,
      background-color 180ms ease;
  }

  .search-ref .search-ref__link--read {
    background-color: var(--surface-raised);
    color: var(--text);
    box-shadow: 0 8px 16px rgba(0, 0, 0, 0.12);
  }

  @media (hover: hover) and (pointer: fine) {
    .search-ref .search-ref__link:hover {
      transform: translateY(-1px);
      background-color: var(--ink, #1d231c);
      box-shadow: 0 12px 22px rgba(0, 0, 0, 0.22);
    }

    .search-ref .search-ref__link--read:hover {
      background-color: var(--ink, #1d231c);
      color: var(--white, #fff);
      box-shadow: 0 12px 22px rgba(0, 0, 0, 0.22);
    }
  }

  .search-ref .search-ref__link:active {
    transform: translateY(0);
    box-shadow: 0 6px 12px rgba(0, 0, 0, 0.16);
  }

  .search-ref .search-ref__link--read:active {
    box-shadow: 0 6px 12px rgba(0, 0, 0, 0.1);
  }

  .search-ref .search-ref__link:focus-visible {
    outline: 3px solid rgba(32, 157, 80, 0.55);
    outline-offset: 2px;
  }

  .search-ref .search-ref__hint {
    opacity: 0.7;
    font-size: 0.9rem;
    white-space: nowrap;
  }

  /* ── Pager (dynamically created, needs global scope) ── */

  .pager {
    display: flex;
    gap: 6px;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
    margin: 18px auto 0;
    padding: 0 16px;
  }

  .pager-btn {
    padding: 10px 16px;
    border-radius: 12px;
    border: none;
    background-color: var(--green, #209d50);
    color: var(--white, #fff);
    cursor: pointer;
    font-size: 0.9rem;
    font-weight: 600;
    line-height: 1;
    box-shadow: 0 8px 16px rgba(0, 0, 0, 0.2);
    min-width: 40px;
    text-align: center;

    transition:
      background-color 0.18s ease,
      transform 0.18s ease,
      box-shadow 0.18s ease;
  }

  .pager-btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
    transform: none;
  }

  .pager-btn--current {
    background-color: var(--ink, #1d231c);
    cursor: default;
    box-shadow: 0 8px 16px rgba(0, 0, 0, 0.25);
  }

  .pager-ellipsis {
    padding: 0 2px;
    color: rgba(29, 35, 28, 0.45);
    font-size: 1rem;
    user-select: none;
  }

  @media (hover: hover) and (pointer: fine) {
    .pager .pager-btn:hover:not(:disabled):not(.pager-btn--current) {
      background-color: var(--ink, #1d231c);
      transform: translateY(-1px);
      box-shadow: 0 12px 22px rgba(0, 0, 0, 0.22);
    }
  }

  .pager .pager-btn:active:not(:disabled):not(.pager-btn--current) {
    transform: translateY(0);
    box-shadow: 0 8px 16px rgba(0, 0, 0, 0.18);
  }
</style>
