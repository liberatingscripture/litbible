---
import ScriptureLayout from "../layouts/ScriptureLayout.astro";
import { BOOK_ORDER, bookKeyToLabel } from "../data/books.js";
import { linkRefs } from "../lib/scripture-refs-data.mjs";
import { isDraftIntro } from "../lib/chapter-nav-data.mjs";
import ChapterCtas from "../components/ChapterCtas.astro";
import DraftPage from "../components/DraftPage.astro";

// Load intro markdown files eagerly (so we can render immediately)
type IntroMod = {
  frontmatter?: Record<string, any>;
  default: any; // MD/MDX component
  compiledContent?: () => Promise<string>;
};

const introModules = import.meta.glob<IntroMod>("../data/intros/*-intro.md", {
  eager: true,
});

export function getStaticPaths() {
  return BOOK_ORDER.map((book) => ({
    params: { book },
    props: { book },
  }));
}

const { book } = Astro.props as { book: string };

const bookKey = book;
const bookName = bookKeyToLabel(bookKey);

// Match: ../data/intros/<book>-intro.md
const introKey = `../data/intros/${bookKey}-intro.md`;
const introMod = (introModules as Record<string, IntroMod>)[introKey] ?? null;
// Rendered as an HTML string rather than through the Markdown component, so
// its scripture references ("Romans 2:24") can be linked on the way out. The
// intro file itself, which the apps sync, keeps its plain text.
//
// The "Takeaways on Liberation and Inclusion" heading ends 24 of the 27
// intros, which made every intro a search hit for "liberation" and
// "inclusion". It stays on the page; Pagefind skips it.
const introHtml = introMod?.compiledContent
  ? linkRefs(await introMod.compiledContent()).replace(
      /<h2(\s[^>]*)?>(\s*Takeaways on Liberation and Inclusion\s*)<\/h2>/g,
      "<h2 data-pagefind-ignore$1>$2</h2>",
    )
  : null;

// The intros' frontmatter `topics` are not passed on for indexing: in 2026-09
// every intro carries the same five placeholders (liberation, empire,
// healing, poverty, hospitality). Indexed, they made 24 intros a hit for
// "hospitality", and would make every intro a hit for all five. Pass them to
// ScriptureLayout again once each book has its own.

const title = `${bookName} — Introduction | Liberation and Inclusion Translation`;
const description = `Introduction to ${bookName} in the Liberation and Inclusion Translation (LIT).`;

// A placeholder intro (acts, luke and revelation in 2026-09) renders the draft
// page, stays out of search engines, the sitemap and Pagefind, and is stepped
// over by Previous/Next, the same as an indexed:false chapter.
const isDraft = isDraftIntro(bookKey);
---

<ScriptureLayout
  title={title}
  description={description}
  book={bookKey}
  chapter="intro"
  type="intro"
  robotsIndex={!isDraft}
  ogImage={`${Astro.site ? Astro.site.origin : "https://litbible.net"}/og/${bookKey}-intro.png`}
  twitterCard="summary_large_image"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://litbible.net/" },
        { "@type": "ListItem", "position": 2, "name": "Read", "item": "https://litbible.net/read/" },
        { "@type": "ListItem", "position": 3, "name": bookName, "item": `https://litbible.net/read/${bookKey}/` },
        { "@type": "ListItem", "position": 4, "name": `${bookName} Introduction`, "item": `https://litbible.net/${bookKey}-intro/` }
      ]
    })} />
  </Fragment>
  <article class="chapter">
    {/* H1 is rendered by ScriptureHeader inside ScriptureLayout */}

    {
      /* Intro prose IS Pagefind-indexed (owner decision 2026-07-09,
         superseding the earlier topics-only rule, which in practice left
         intro pages with zero indexable words so Pagefind dropped them
         entirely). Hits render under the dedicated "Book introductions"
         group in both search surfaces — see bucketSearchResults in
         search-core.js — so they can't be confused with scripture results. */
    }
    {
      isDraft ? (
        <>
          <DraftPage bookKey={bookKey} kind="intro" />
          <ChapterCtas bookKey={bookKey} chapter="intro" showSkipped={false} />
        </>
      ) : (
        <>
          <section class="intro">
            <Fragment set:html={introHtml} />
          </section>
          <ChapterCtas bookKey={bookKey} chapter="intro" />
        </>
      )
    }
  </article>

  <style>
    /* Keep intro left-aligned (NOT centered). Its width and text size come
       from .scripture-main (the shared reading measure). */
    .intro :global(p) {
      margin: 0 0 12px;
      line-height: calc(1.75 + var(--reading-leading-extra, 0));
      text-align: left;
    }

    /* Lists match article page behavior */
    .intro :global(ul),
    .intro :global(ol) {
      margin: 1rem 0;
      padding-left: 1.25rem;
    }

    .intro :global(ul li + li),
    .intro :global(ol li + li) {
      margin-top: 0.5rem;
    }

    .intro :global(li > ul),
    .intro :global(li > ol) {
      margin-top: 0.5rem;
      margin-bottom: 0.25rem;
    }

    /* If your intro markdown uses headings, give them sane spacing */
    .intro :global(h2) {
      margin: 1.4rem 0 0.7rem;
      line-height: 1.2;
    }

    .intro :global(h3) {
      margin: 1.2rem 0 0.6rem;
      line-height: 1.25;
    }

    :global(.chapter-ctas) {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 14px;
      margin: 22px 0 0;
      flex-wrap: wrap;
    }

    :global(.chapter-cta) {
      display: inline-flex;
      align-items: center;
      justify-content: center;

      width: clamp(240px, 42%, 420px);
      min-height: 56px;

      padding: 14px 22px;
      border-radius: 14px;

      background-color: var(--green-deep, #0f6b33);
      color: var(--white, #fff);

      font-size: 16px;
      font-weight: 400;
      letter-spacing: 0; /* match ScriptureHeader buttons */
      line-height: 1.15;
      text-align: center;
      white-space: normal;

      text-decoration: none; /* no underline ever */
      box-shadow: 0 12px 26px rgba(0, 0, 0, 0.18);

      transition:
        background-color 0.2s ease,
        /* match ScriptureHeader timing */ transform 0.2s ease;
    }

    :global(.chapter-cta:hover) {
      background-color: var(--ink); /* match ScriptureHeader hover */
      transform: translateY(-1px);
      text-decoration: none;
    }

    /* Inject arrows consistently via CSS (instead of hard-coding in labels) */
    :global(.chapter-cta--prev)::before {
      content: "◀ ";
      display: inline-block;
      width: 1.2em;
      text-align: left;
    }

    :global(.chapter-cta--next)::after {
      content: " ▶";
      display: inline-block;
      width: 1.2em;
      text-align: right;
    }

    @media (max-width: 560px) {
      :global(.chapter-ctas) {
        flex-direction: column;
        align-items: stretch;
      }

      :global(.chapter-cta) {
        width: 100%;
      }
    }
  </style>
  {/* Scripture reference previews (progressive enhancement) */}
  <script>
    import "../scripts/ref-preview.js";
  </script>
</ScriptureLayout>
