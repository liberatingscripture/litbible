---
// src/pages/read.astro
import ReadLayout from "../layouts/ReadLayout.astro";
import "../styles/pages/read.css";

const title = "Read | Liberation and Inclusion Translation";
const description =
  "Read the Liberation and Inclusion Translation (LIT) online.";
---

<ReadLayout
  title={title}
  description={description}
  bg="cream"
  showTools={true}
  index={false}
>
  <div slot="hero" class="read-hero">
    <img
      class="read-logo"
      src="/images/lit-logo.png"
      alt="Liberation and Inclusion Translation logo"
      width="220"
      height="220"
      loading="eager"
      decoding="async"
    />

    <h1 class="read-title">Read the LIT Online</h1>

    <p class="read-lede">
      I’ve got solid drafts of most of the New Testament (all except <strong
        >Acts</strong
      > and
      <strong>Revelation</strong>), ready for your study, scrutinize, celebrate,
      and use in your faith circles. This is a living project, so check back
      over time for the latest version. Questions, comments, or insights?
      <a href="/contact">Drop me a line</a>.
    </p>
  </div>

  <section class="views-band" aria-labelledby="views-heading">
    <h2 id="views-heading" class="views-heading">Two ways to read</h2>
    <p class="views-lede">
      The LIT offers two ways to engage with the text, and you can switch
      between them at any time.
    </p>

    <div class="views-grid">
      <div class="view-card">
        <h3 class="view-card__title">Study View</h3>
        <p class="view-card__desc">
          One chapter at a time with footnotes and cross-references. Great for
          close reading and research.
        </p>
        <a href="/matthew-5" class="view-card__link">Try Study View &rarr;</a>
      </div>

      <div class="view-card">
        <h3 class="view-card__title">Reading View</h3>
        <p class="view-card__desc">
          Continuous scroll through an entire book with a distraction-free
          reader. Includes controls for font size, verse numbers, and focus mode
          — and picks up where you left off.
        </p>
        <a href="/read/matthew#ch-5" class="view-card__link"
          >Try Reading View &rarr;</a
        >
      </div>
    </div>
  </section>

  <section class="license-band" aria-labelledby="license-heading">
    <div class="license-band__inner">
      <section
        id="license"
        class="license-card"
        aria-labelledby="license-heading"
      >
        <h2 id="license-heading" class="license-card__title">
          License and reuse
        </h2>

        <p class="license-card__lede">
          <a href="https://litbible.net" class="license-card__link">
            The Liberation and Inclusion Translation of the Bible (LIT)™
          </a>
          © 2024 by{" "}
          <a href="/about" class="license-card__link">
            Brandon C. Vélez Johnson
          </a>{" "}
          is licensed under{" "}
          <a
            href="http://creativecommons.org/licenses/by-nc-nd/4.0/?ref=chooser-v1"
            class="license-card__link"
            target="_blank"
            rel="noopener"
          >
            CC BY-NC-ND 4.0
          </a>
          .
        </p>

        <p class="license-card__lede">
          You may use it within that license with the following restrictions (If
          you would like to use it outside these restrictions, please contact me
          to discuss your project):
        </p>

        <ol class="license-card__list">
          <li>
            <strong>Attribution</strong> — You must give{" "}
            <a
              href="https://creativecommons.org/licenses/by-nc-nd/4.0/?ref=chooser-v1#ref-appropriate-credit"
              class="license-card__link"
              target="_blank"
              rel="noopener"
            >
              appropriate credit
            </a>
            , provide a link to the license, and{" "}
            <a
              href="https://creativecommons.org/licenses/by-nc-nd/4.0/?ref=chooser-v1#ref-indicate-changes"
              class="license-card__link"
              target="_blank"
              rel="noopener"
            >
              indicate if changes were made
            </a>
            .
          </li>

          <li>
            <strong>NonCommercial Use Only</strong> — You may not use the material
            for{" "}
            <a
              href="https://creativecommons.org/licenses/by-nc-nd/4.0/?ref=chooser-v1#ref-commercial-purposes"
              class="license-card__link"
              target="_blank"
              rel="noopener"
            >
              commercial purposes
            </a>
            .
          </li>

          <li>
            <strong>No Derivatives</strong> — If you{" "}
            <a
              href="https://creativecommons.org/licenses/by-nc-nd/4.0/?ref=chooser-v1#ref-some-kinds-of-mods"
              class="license-card__link"
              target="_blank"
              rel="noopener"
            >
              remix, transform, or build upon
            </a>{" "}
            the material, you may not distribute the modified material.
          </li>
        </ol>
      </section>
    </div>
  </section>

  <section
    id="sblgnt-disclaimer"
    class="scripture-disclaimer"
    aria-label="Source text and licensing notice"
  >
    <div class="scripture-disclaimer__inner">
      <p>
        The Liberation &amp; Inclusion Translation (LIT) is an original English
        translation prepared from <em>The Greek New Testament: SBL Edition</em>{
          " "
        }
        (ed. Michael W. Holmes; © 2010 Society of Biblical Literature &amp; Logos
        Bible Software).
      </p>
      <p>
        The SBLGNT is licensed under the Creative Commons Attribution 4.0,
        International Licence (CC BY 4.0):{" "}
        <a
          href="https://creativecommons.org/licenses/by/4.0/"
          rel="noopener noreferrer"
          target="_blank"
        >
          https://creativecommons.org/licenses/by/4.0/
        </a>
        . This translation constitutes an adaptation of that Greek text. Used with
        permission.
      </p>
      <p>
        Greek quotations are presented in transliterated form; accentuation and
        punctuation follow LIT house style, mostly removed for accessibility to
        readers without prior knowledge of Greek.
      </p>
      <p>
        Portions of the SBL Greek text quoted here remain available under CC BY
        4.0; the NC-ND restrictions apply only to the original English
        translation and other LIT-specific content.
      </p>
      <p>
        The Society of Biblical Literature and Logos Bible Software do not
        endorse the LIT Bible.
      </p>
    </div>
  </section>
</ReadLayout>
