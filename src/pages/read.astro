---
// src/pages/read.astro
import ReadLayout from "../layouts/ReadLayout.astro";
import "../styles/pages/read.css";
import releaseNotes from "../data/release-notes.json";

const title = "Read | Liberation and Inclusion Translation";
const description =
  "Read the Liberation and Inclusion Translation (LIT) online.";

const recentNotes = releaseNotes.slice(0, 3);

const TYPE_LABEL: Record<string, string> = {
  chapter_added: "Added",
  text_updated: "Updated",
  footnote_added: "Updated",
  footnote_updated: "Updated",
  intro_updated: "Updated",
  metadata_updated: "Updated",
  glossary_added: "Added",
  glossary_updated: "Updated",
  article_added: "Added",
  article_updated: "Updated",
};
---

<ReadLayout
  title={title}
  description={description}
  bg="cream"
  showTools={true}
  pagefindIndex={false}
>
  <link slot="head" rel="preload" as="image" type="image/webp" href="/images/lit-logo.webp" fetchpriority="high" />
  <div slot="hero" class="read-hero">
    <picture>
      <source srcset="/images/lit-logo.webp" type="image/webp" />
      <img
        class="read-logo"
        src="/images/lit-logo.png"
        alt="Liberation and Inclusion Translation logo"
        width="220"
        height="220"
        loading="eager"
        decoding="async"
        fetchpriority="high"
      />
    </picture>

    <h1 class="read-title">Read the LIT Online</h1>

    <p class="read-lede">
      I've got solid drafts of most of the New Testament (all except
      <strong>Acts</strong>, <strong>Revelation</strong>, and part of <strong
        >Luke</strong
      >) ready for you to study, scrutinize, celebrate, and use in your faith
      circles. This is a living project, so check back over time for the latest
      version. Questions, comments, or insights?
      <a href="/contact" style="white-space:nowrap">Drop me a line</a>.
    </p>

    {
      recentNotes.length > 0 && (
        <div class="whats-new">
          <button
            class="whats-new__trigger"
            type="button"
            aria-expanded="false"
            aria-controls="whatsNewPanel"
          >
            <span class="whats-new__dot" aria-hidden="true" />
            What's new
            <span class="whats-new__chevron" aria-hidden="true">
              ▾
            </span>
          </button>

          <div class="whats-new__panel" id="whatsNewPanel">
            {recentNotes.map((entry) => (
              <div class="whats-new__entry">
                <time class="whats-new__date" datetime={entry.date}>
                  {entry.label}
                </time>
                <ul class="whats-new__changes">
                  {entry.changes.map((change) => (
                    <li class="whats-new__change" data-type={change.type}>
                      <span class="whats-new__badge">
                        {TYPE_LABEL[change.type] ?? "Updated"}
                      </span>
                      <span class="whats-new__change-text">
                        {change.description}
                      </span>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
            <a href="/release-notes" class="whats-new__all">
              See all release notes →
            </a>
          </div>
        </div>
      )
    }
  </div>

  <section slot="bands" class="views-band" aria-labelledby="views-heading">
    <h2 id="views-heading" class="views-heading">Ways to read the LIT</h2>
    <p class="views-lede">
      Read the LIT however suits you: two ways on the web today, with mobile apps
      on the way.
    </p>

    <div class="views-grid">
      <div class="view-card">
        <h3 class="view-card__title">Study View</h3>
        <p class="view-card__desc">
          One chapter at a time with footnotes and cross-references. Great for
          close reading and research.
        </p>
        <a href="/matthew-5" class="view-card__link">Try Study View &rarr;</a>
      </div>

      <div class="view-card">
        <h3 class="view-card__title">Reading View</h3>
        <p class="view-card__desc">
          Continuous, distraction-free scroll through a whole book that picks up
          where you left off.
        </p>
        <a href="/read/matthew#ch-5" class="view-card__link"
          >Try Reading View &rarr;</a
        >
      </div>

      <div class="view-card view-card--available">
        <h3 class="view-card__title">LIT Bible apps</h3>
        <span class="view-card__badge">Available now</span>
        <p class="view-card__desc">
          iPhone and Android apps with the whole translation offline, plus notes,
          highlights, and daily and Lectionary readings.
        </p>
        <a href="/apps" class="view-card__link">Explore the apps &rarr;</a>
      </div>
    </div>
  </section>

  <section slot="bands" class="license-band" aria-labelledby="license-heading">
    <div class="license-band__inner">
      <section
        id="license"
        class="license-card"
        aria-labelledby="license-heading"
      >
        <h2 id="license-heading" class="license-card__title">
          License and reuse
        </h2>

        <p class="license-card__lede">
          <a href="https://litbible.net" class="license-card__link">
            The Liberation and Inclusion Translation of the Bible (LIT)™
          </a>
          © 2024 by{" "}
          <a href="/about" class="license-card__link">
            Brandon C. Vélez Johnson
          </a>{" "}
          is licensed under{" "}
          <a
            href="https://creativecommons.org/licenses/by-nc-nd/4.0/?ref=chooser-v1"
            class="license-card__link"
            target="_blank"
            rel="noopener"
          >
            CC BY-NC-ND 4.0
          </a>
          .
        </p>

        <div class="license-faq">
          <details class="license-faq-item" id="license-terms">
            <summary class="license-faq-q">
              View full license terms and standing exceptions for church, study, and digital use
            </summary>
            <div class="license-faq-body">
              <p>
                You may use the LIT Bible text within its public license under the
                following core restrictions (If you would like to use it outside
                these restrictions, please{" "}
                <a href="/contact" class="license-card__link">contact me</a> to
                discuss your project):
              </p>
              <ul>
                <li>
                  <strong>Attribution</strong> — You must give appropriate credit,
                  provide a link to the license, and indicate if changes were made.
                </li>
                <li>
                  <strong>NonCommercial Use Only</strong> — You may not use the
                  material for commercial purposes.
                </li>
                <li>
                  <strong>No Derivatives</strong> — If you remix, transform, or
                  build upon the material, you may not distribute the modified
                  material.
                </li>
              </ul>

              <h3>Standing Exceptions for Ministry, Education, and Study:</h3>
              <p>
                To encourage teaching, community study, and devotion, you are
                permitted to quote portions of the LIT Bible text AND its
                accompanying footnotes within non-commercial derivative works
                (such as Bible study booklets, church bulletins, study guides, or
                classroom presentations) without explicit written permission,
                provided that:
              </p>
              <ol>
                <li>
                  The text or footnotes quoted do not amount to a complete book of
                  the Bible.
                </li>
                <li>
                  The LIT Bible material does not account for more than 50% of the
                  total content of the new work.
                </li>
                <li>
                  Footnotes are quoted accurately and kept in context with the
                  scripture verses they reference.
                </li>
                <li>
                  The work includes the following attribution notice: "Scripture
                  and footnote quotations are from the LIT Bible (litbible.net),
                  used by permission under CC BY-NC-ND 4.0."
                </li>
              </ol>

              <h3>Digital, Newsletter, &amp; Social Media Sharing:</h3>
              <p>
                You are welcome to share short excerpts, single verses, or
                individual footnotes from the LIT Bible on social media platforms,
                personal blogs, or church email newsletters without formal
                copyright blocks, provided that:
              </p>
              <ol>
                <li>
                  The post or email does not republish more than one full chapter
                  of text at a time.
                </li>
                <li>
                  The quote is accompanied by a direct link back to litbible.net
                  (or a tag to an official LIT Bible social media account) so
                  others can find the full text in context.
                </li>
              </ol>

            </div>
          </details>

          <details class="license-faq-item" id="sblgnt-disclaimer">
            <summary class="license-faq-q">
              Source text and translation credits (SBLGNT)
            </summary>
            <div class="license-faq-body sblgnt-credits">
              <p>
                The Liberation &amp; Inclusion Translation (LIT) is an original
                English translation prepared from{" "}
                <em>The Greek New Testament: SBL Edition</em>{" "}
                (ed. Michael W. Holmes; © 2010 Society of Biblical Literature
                &amp; Logos Bible Software).
              </p>
              <p>
                The SBLGNT is licensed under the Creative Commons Attribution
                4.0, International Licence (CC BY 4.0):{" "}
                <a
                  href="https://creativecommons.org/licenses/by/4.0/"
                  rel="noopener noreferrer"
                  target="_blank"
                >
                  https://creativecommons.org/licenses/by/4.0/
                </a>
                . This translation constitutes an adaptation of that Greek text.
                Used with permission.
              </p>
              <p>
                Greek quotations are presented in transliterated form;
                accentuation and punctuation follow LIT house style, mostly
                removed for accessibility to readers without prior knowledge of
                Greek.
              </p>
              <p>
                Portions of the SBL Greek text quoted here remain available
                under CC BY 4.0; the NC-ND restrictions apply only to the
                original English translation and other LIT-specific content.
              </p>
              <p>
                The Society of Biblical Literature and Logos Bible Software do
                not endorse the LIT Bible.
              </p>
            </div>
          </details>
        </div>
      </section>
    </div>
  </section>
</ReadLayout>

<script>
  // @ts-nocheck
  (() => {
    const trigger = document.querySelector(".whats-new__trigger");
    const panel = document.getElementById("whatsNewPanel");
    if (!trigger || !panel) return;

    const open = () => {
      panel.classList.add("is-open");
      trigger.setAttribute("aria-expanded", "true");
    };

    const close = () => {
      panel.classList.remove("is-open");
      trigger.setAttribute("aria-expanded", "false");
    };

    const isOpen = () => panel.classList.contains("is-open");

    trigger.addEventListener("click", () => {
      // Yield to the browser so the button's :active/:focus styles paint
      // before the panel's visibility/transform transition starts (improves INP).
      requestAnimationFrame(() => (isOpen() ? close() : open()));
    });

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && isOpen()) {
        close();
        trigger.focus({ preventScroll: true });
      }
    });

    document.addEventListener("click", (e) => {
      if (
        isOpen() &&
        !trigger.contains(e.target) &&
        !panel.contains(e.target)
      ) {
        close();
      }
    });
  })();
</script>
