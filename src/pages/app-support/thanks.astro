---
// Landing page for the contact-form Worker's native-POST success redirect
// from the app-support form (workers/contact-form/ 303s native POSTs here —
// the fallback when fetch is blocked). JS-enabled fetch submits show an
// inline status message on /app-support instead and never see this page.
import Layout from "../../layouts/Layout.astro";
import "../../styles/pages/contact.css";
---

<Layout
  title="Message sent | Liberation and Inclusion Translation"
  description="Your message to the LIT Bible app support team has been sent."
  robotsNoindex={true}
>
  <div class="contact-page">
    <section class="contact-hero" aria-labelledby="thanks-title">
      <div class="contact-inner">
        <h1 id="thanks-title">Thank you!</h1>

        <p class="contact-lead">
          Your message has been sent. We read everything that comes in and will
          get back to you as soon as we can.
        </p>

        <img
          class="contact-logo"
          src="/images/lit-logo-2026-ring.svg"
          alt="Liberation and Inclusion Translation logo."
          loading="lazy"
          decoding="async"
        />

        <a class="contact-button" href="/">Back to the homepage</a>

        <p class="contact-privacy">
          In the meantime, you're welcome to <a href="/read/">keep reading</a>
          or browse the <a href="/articles/">articles</a>.
        </p>
      </div>
    </section>
  </div>
</Layout>
