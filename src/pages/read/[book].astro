---
// /read/<book>: Read View's old address. Read View retired in Featherboa's
// Phase 4 (WB-44; STUDY-DESK.md, E8): a chapter's page now reads on through
// its book (src/scripts/read-on.js), so each book's old page forwards to the
// chapter's page and keeps its place. `#ch-10` goes to /john-10/, a verse
// anchor to its verse, a block to its block (src/lib/read-view-retirement.mjs,
// which src/scripts/read-view-redirect.js runs). Readers' bookmarks, old
// search results, and the apps link these, so they stay. Without scripts the
// page goes to the book's first chapter, since a meta refresh can't read the
// address's #fragment. noindex, and out of the sitemap (astro.config.mjs).
import { BOOKS, BOOK_ORDER, bookKeyToLabel } from "../../data/books.js";

export function getStaticPaths() {
  return BOOK_ORDER.filter(
    (bookKey) => typeof (BOOKS as Record<string, number>)[bookKey] === "number",
  ).map((bookKey) => ({
    params: { book: bookKey },
    props: { bookKey },
  }));
}

const { bookKey } = Astro.props as { bookKey: string };
const bookName = bookKeyToLabel(bookKey);
const first = `/${bookKey}-1/`;
const canonical = Astro.site ? new URL(first, Astro.site).href : first;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="robots" content="noindex" />
    <title>{bookName} | Liberation and Inclusion Translation</title>
    <link rel="canonical" href={canonical} />
    <noscript><meta http-equiv="refresh" content={`0; url=${first}`} /></noscript>
    <script>
      import "../../scripts/read-view-redirect.js";
    </script>
  </head>
  <body>
    <main>
      <p>This page has moved to the book’s chapters.</p>
      <p><a href={first}>Go to {bookName} 1</a></p>
    </main>
  </body>
</html>
