---
import Layout from "../../layouts/Layout.astro";
import { BOOKS, BOOK_ORDER, bookKeyToLabel } from "../../data/books.js";
import ReadMenu from "../../components/ReadMenu.astro";
import SearchBar from "../../components/SearchBar.astro";
import PrintCredit from "../../components/PrintCredit.astro";
import SblgntNotice from "../../components/SblgntNotice.astro";
import "../../styles/scripture-tools.css";
import "../../styles/read-mode.css";
import readModeScript from "../../scripts/read-mode.js?url";
import { prepareReadParagraph } from "../../lib/chapter-html";

type ChapterData = {
  chapter?: number;
  paragraphs?: string[];
  indexed?: boolean;
};

type ChapterModule = { default: ChapterData };

const chapterModules = import.meta.glob<ChapterModule>(
  "../../data/chapters/*.json",
  {
    eager: true,
  },
);

const introModules = import.meta.glob("../../data/intros/*-intro.md", {
  eager: true,
});

function getChapter(bookKey: string, chapter: number): ChapterData | null {
  const key = `../../data/chapters/${bookKey}-${chapter}.json`;
  return chapterModules[key]?.default ?? null;
}

function getChapterNumbers(total: number): number[] {
  return Array.from({ length: total }, (_, i) => i + 1);
}

export function getStaticPaths() {
  return BOOK_ORDER.filter(
    (bookKey) => typeof (BOOKS as Record<string, number>)[bookKey] === "number",
  ).map((bookKey) => ({
    params: { book: bookKey },
    props: { bookKey },
  }));
}

const { bookKey } = Astro.props as { bookKey: string };

const chapterTotal = Number((BOOKS as Record<string, number>)[bookKey] || 0);
if (!chapterTotal) {
  throw new Error(`Unknown or empty book key for /read/[book]: ${bookKey}`);
}

const bookName = bookKeyToLabel(bookKey);
const hasIntro = Boolean(introModules[`../../data/intros/${bookKey}-intro.md`]);
const studyIntroHref = `/${bookKey}-intro`;

const chapters = getChapterNumbers(chapterTotal).map((chapter) => {
  const chapterData = getChapter(bookKey, chapter);
  const rawParagraphs = Array.isArray(chapterData?.paragraphs)
    ? chapterData!.paragraphs
    : [];

  const seenVerseIds = new Set<string>();
  const verseState = { currentVerse: null as number | null };
  return {
    chapter,
    draft: chapterData?.indexed === false || rawParagraphs.length === 0,
    paragraphs: rawParagraphs.map((html) =>
      prepareReadParagraph(html, bookKey, chapter, seenVerseIds, verseState),
    ),
  };
});

const chapterNumbers = getChapterNumbers(chapterTotal);

// A run of draft chapters reads as one short notice rather than repeating the
// placeholder for each (/read/acts used to print the same limerick 28 times).
// Every chapter keeps its own #ch-N anchor, so ReadMenu's in-page jumps and a
// saved resume position still land.
type Section =
  | { kind: "chapter"; chapter: number; paragraphs: string[] }
  | { kind: "drafts"; chapters: number[] };
const sections: Section[] = [];
for (const c of chapters) {
  const last = sections.at(-1);
  if (!c.draft) sections.push({ kind: "chapter", chapter: c.chapter, paragraphs: c.paragraphs });
  else if (last?.kind === "drafts") last.chapters.push(c.chapter);
  else sections.push({ kind: "drafts", chapters: [c.chapter] });
}

// De-index the read-view aggregate when every chapter of the book is a draft
// ("indexed": false). Mirrors the per-chapter noindex on Study View so a
// book's full draft text can't be indexed via its /read/<book> page. Books
// with even one published chapter (e.g. Luke) stay indexable.
const existingChapterData = chapterNumbers
  .map((chapter) => getChapter(bookKey, chapter))
  .filter((data): data is ChapterData => data !== null);
const allChaptersDraft =
  existingChapterData.length > 0 &&
  existingChapterData.every((data) => data.indexed === false);

const title = `${bookName} (Read View) | Liberation and Inclusion Translation`;
const description = `${bookName} on one page, read straight through, in the Liberation and Inclusion Translation (LIT).`;
const pageUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : "";
---

<Layout
  title={title}
  description={description}
  bg="cream"
  pagefindIndex={false}
  robotsNoindex={allChaptersDraft}
  scriptureControls="read"
  pageSearch
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://litbible.net/" },
        { "@type": "ListItem", "position": 2, "name": "Read", "item": "https://litbible.net/read/" },
        { "@type": "ListItem", "position": 3, "name": bookName, "item": `https://litbible.net/read/${bookKey}/` }
      ]
    })} />
  </Fragment>
  {/* The passage picker lives in the sticky toolbar below (always in
      reach), so the top bar carries only search. */}
  <section
    class="scripture-tools scripture-tools--search-only"
    data-pagefind-ignore
    aria-label="Scripture tools"
  >
    <div class="scripture-tools__inner">
      <div class="scripture-tools__center" aria-label="Search the LIT">
        <SearchBar fullSearchHref="/search" />
      </div>
    </div>
  </section>

  <section
    class="rm-page"
    data-rm-root
    data-pagefind-ignore
    data-rm-book={bookKey}
    data-rm-book-title={bookName}
    data-rm-has-intro={hasIntro ? "true" : "false"}
    data-rm-study-intro-href={studyIntroHref}
  >
    <div
      class="rm-toolbar"
      id="rm-toolbar"
      data-rm-toolbar
      data-pagefind-ignore
    >
      {/* The bottom sheet's dismiss (hidden while this is the sticky bar).
          First in the DOM because opening the sheet focuses it, so Tab
          then runs through the controls in the order they appear. */}
      <button
        type="button"
        class="rm-toolbar__close"
        data-rm-mobile-close
        aria-label="Close"
      >
        <svg
          class="rm-x"
          viewBox="0 0 24 24"
          aria-hidden="true"
          focusable="false"
        >
          <path d="M6 6l12 12M18 6L6 18"></path>
        </svg>
      </button>

      {/* Where the reader is, then the tools, then the ways out: the
          picker leads and the view switch closes the row, as in Study
          View's toolbar. The progress bar is drawn along the toolbar's
          edge (read-mode.css), so only the percentage takes room here. */}
      <div class="rm-toolbar__row">
        <div class="rm-toolbar__cluster rm-toolbar__cluster--where">
          <ReadMenu
            mode="read"
            currentBook={bookKey}
            currentChapter="1"
            label={`${bookName} 1`}
          />

          <div class="rm-toolbar__progress">
            <span class="rm-progress" data-rm-progress>0%</span>
            <div class="rm-progressbar" aria-hidden="true">
              <span data-rm-progress-bar></span>
            </div>
          </div>
        </div>

        <div class="rm-toolbar__cluster rm-toolbar__cluster--tools">
          {/* Opens the site's Display tray (SiteHeader.astro), which holds
              text size, line spacing and the Numbers setting for every page.
              The toolbar is sticky, so this is the one within reach. The bar
              shows "Aa", like the header's button; the bottom sheet, where
              the button is half a row wide, shows a faders icon and the word
              "Display", icon first like the sheet's other buttons. The bar
              keeps the word for screen readers alone. */}
          <button
            type="button"
            data-font-toggle
            aria-expanded="false"
            aria-controls="fontTray"
          >
            <span class="rm-aa-glyph" aria-hidden="true">Aa</span>
            <svg class="rm-tool-icon rm-aa-icon" viewBox="0 0 24 24" width="1.1em" height="1.1em" fill="none"
                 stroke="currentColor" stroke-width="2" stroke-linecap="round"
                 stroke-linejoin="round" aria-hidden="true" focusable="false">
              <path d="M4 21v-7M4 10V3M12 21v-9M12 8V3M20 21v-5M20 12V3M2 14h4M10 8h4M18 16h4"/>
            </svg>
            <span class="rm-aa-text">Display</span><span class="sr-only"> settings</span>
          </button>

          {/* The icon is Focus itself: one line of text lit, the lines
              around it dimmed. read-mode.js swaps only the label. */}
          <button type="button" data-rm-focus-toggle aria-pressed="false">
            <svg class="rm-tool-icon" viewBox="0 0 24 24" width="1.1em" height="1.1em" fill="none"
                 stroke="currentColor" stroke-width="2" stroke-linecap="round"
                 aria-hidden="true" focusable="false">
              <path d="M4 5h16" opacity=".5"/>
              <path d="M4 12h16"/>
              <path d="M4 19h11" opacity=".5"/>
            </svg>
            <span class="rm-focus-label">Focus: Off</span>
          </button>
        </div>

        <div class="rm-toolbar__cluster rm-toolbar__cluster--nav">
          {/* read-mode.js swaps the arrow and label to "My Location" once
              the reader has gone back to the top. */}
          <button type="button" data-rm-start-over>
            <span class="rm-btn-icon" aria-hidden="true">↑</span>
            <span class="rm-btn-label">Back to Top</span>
          </button>

          <a
            href={`/${bookKey}-1`}
            class="rm-switch"
            data-rm-study-switch
            aria-label={`Switch to Study View for ${bookName} chapter 1`}
          >
            <span
              class="reading-view-pill__icon rm-cycle-icon"
              aria-hidden="true"><svg viewBox="0 0 24 24" width="1em" height="1em" fill="none"
                   stroke="currentColor" stroke-width="2" stroke-linecap="round"
                   stroke-linejoin="round" aria-hidden="true" focusable="false">
                <path d="M14 2v4a2 2 0 0 0 2 2h4"/>
                <path d="M4.268 21a2 2 0 0 0 1.727 1H18a2 2 0 0 0 2-2V7l-5-5H6a2 2 0 0 0-2 2v3"/>
                <path d="m9 18-1.5-1.5"/>
                <circle cx="5" cy="14" r="3"/>
              </svg></span
            >
            <span>Study View</span>
          </a>
        </div>
      </div>
    </div>

    <button
      type="button"
      class="rm-fab"
      data-rm-fab
      aria-label="Open reading controls"
      aria-expanded="false"
      aria-controls="rm-toolbar"
    >
      <span class="rm-fab__icon" aria-hidden="true"></span>
    </button>

    <div class="rm-resume-chip" data-rm-resume-chip role="status" hidden>
      <button type="button" data-rm-resume-go>Continue reading ↓</button>
      <button type="button" data-rm-resume-dismiss aria-label="Dismiss">✕</button>
    </div>

    <article
      class="rm-reader"
      data-rm-reader
      data-rm-focus="off"
    >
      <h1 class="rm-title">{bookName}</h1>

      {/* Hidden description for Hebrew poetry blockquotes, referenced by
          aria-describedby. Mirrors the one in [slug].astro; both views run the
          same addHbqAria pass, so the reference must resolve on both. */}
      <div id="hbq-description" hidden>Formatted as Hebrew and Semitic poetry with indented parallel lines</div>

      <div class="rm-text" data-rm-text>
        {
          sections.map((section) =>
            section.kind === "chapter" ? (
              <>
                <div
                  class="rm-ch-anchor"
                  id={`ch-${section.chapter}`}
                  data-rm-chapter={section.chapter}
                  aria-hidden="true"
                />
                <h2 class="rm-chapter">Chapter {section.chapter}</h2>

                {/* data-chapter tells the selection bar (chapter-tools.js)
                    which chapter selected text belongs to, since a whole
                    book shares this page. */}
                {section.paragraphs.map((html) => (
                  <div class="rm-block" data-chapter={section.chapter} set:html={html} />
                ))}
              </>
            ) : (
              <>
                {section.chapters.map((chapter) => (
                  <div
                    class="rm-ch-anchor"
                    id={`ch-${chapter}`}
                    data-rm-chapter={chapter}
                    data-rm-draft
                    aria-hidden="true"
                  />
                ))}
                <h2 class="rm-chapter">
                  {section.chapters.length === 1
                    ? `Chapter ${section.chapters[0]}`
                    : `Chapters ${section.chapters[0]}–${section.chapters.at(-1)}`}
                </h2>
                <div class="rm-draft-stub">
                  {section.chapters.length === 1
                    ? "This chapter is still being translated."
                    : "These chapters are still being translated."}{" "}
                  <a href="#footer-newsletter-heading">Get updates by email</a>
                </div>
              </>
            ),
          )
        }
      </div>

      <PrintCredit url={pageUrl} />
    </article>
  </section>

  <SblgntNotice />

  <script type="module" src={readModeScript}></script>

  {/* Continue reading: record where the reader is each time Read View
      saves its own resume position. Draft chapters are never recorded. */}
  {/* The selection bar, as in Study View. Only the bar: verse numbers stay
      plain text here, since a verse menu's links and actions belong to the
      chapter's Study View page. */}
  <script>
    import "../../scripts/chapter-tools.js";
  </script>

  <script>
    import { saveLastRead, verseAtReadingLine } from "../../scripts/last-read.js";

    const page = document.querySelector(".rm-page[data-rm-root]");
    page?.addEventListener("rm:position", (event) => {
      const { book, chapter } = (event as CustomEvent<{ book: string; chapter: number }>).detail;
      if (!book || !chapter) return;
      if (document.getElementById(`ch-${chapter}`)?.hasAttribute("data-rm-draft")) return;
      const prefix = `${book}-${chapter}-v`;
      const markers = Array.from(document.querySelectorAll(`.rm-verse-anchor[id^="${prefix}"]`));
      const verse = verseAtReadingLine(markers, (id: string) => Number(id.slice(prefix.length)) || null);
      saveLastRead({ book, chapter, verse, view: "read" });
    });
  </script>
</Layout>
