---
import Layout from "../../layouts/Layout.astro";
import { BOOKS, BOOK_ORDER, bookKeyToLabel } from "../../data/books.js";
import ReadMenu from "../../components/ReadMenu.astro";
import SearchBar from "../../components/SearchBar.astro";
import "../../styles/scripture-tools.css";
import "../../styles/read-mode.css";
import readModeScript from "../../scripts/read-mode.js?url";
import { prepareReadParagraph } from "../../lib/chapter-html";

type ChapterData = {
  chapter?: number;
  paragraphs?: string[];
  indexed?: boolean;
};

type ChapterModule = { default: ChapterData };

const chapterModules = import.meta.glob<ChapterModule>(
  "../../data/chapters/*.json",
  {
    eager: true,
  },
);

const introModules = import.meta.glob("../../data/intros/*-intro.md", {
  eager: true,
});

function getChapter(bookKey: string, chapter: number): ChapterData | null {
  const key = `../../data/chapters/${bookKey}-${chapter}.json`;
  return chapterModules[key]?.default ?? null;
}

function getChapterNumbers(total: number): number[] {
  return Array.from({ length: total }, (_, i) => i + 1);
}

function getTocGroupSize(total: number): number {
  if (total <= 10) return 0;
  if (total <= 30) return 5;
  return 10;
}

function buildTocGroups(total: number, size: number) {
  if (!size) return [] as Array<{ label: string; chapters: number[] }>;

  const groups: Array<{ label: string; chapters: number[] }> = [];
  for (let start = 1; start <= total; start += size) {
    const end = Math.min(total, start + size - 1);
    groups.push({
      label: `${start}-${end}`,
      chapters: getChapterNumbers(end - start + 1).map((n) => n + start - 1),
    });
  }

  return groups;
}

export function getStaticPaths() {
  return BOOK_ORDER.filter(
    (bookKey) => typeof (BOOKS as Record<string, number>)[bookKey] === "number",
  ).map((bookKey) => ({
    params: { book: bookKey },
    props: { bookKey },
  }));
}

const { bookKey } = Astro.props as { bookKey: string };

const chapterTotal = Number((BOOKS as Record<string, number>)[bookKey] || 0);
if (!chapterTotal) {
  throw new Error(`Unknown or empty book key for /read/[book]: ${bookKey}`);
}

const bookName = bookKeyToLabel(bookKey);
const hasIntro = Boolean(introModules[`../../data/intros/${bookKey}-intro.md`]);
const studyIntroHref = `/${bookKey}-intro`;

const chapters = getChapterNumbers(chapterTotal).map((chapter) => {
  const chapterData = getChapter(bookKey, chapter);
  const rawParagraphs = Array.isArray(chapterData?.paragraphs)
    ? chapterData!.paragraphs
    : [];

  const seenVerseIds = new Set<string>();
  return {
    chapter,
    paragraphs: rawParagraphs.map((html) =>
      prepareReadParagraph(html, bookKey, chapter, seenVerseIds),
    ),
  };
});

const tocGroupSize = getTocGroupSize(chapterTotal);
const tocGroups = buildTocGroups(chapterTotal, tocGroupSize);
const chapterNumbers = getChapterNumbers(chapterTotal);

// De-index the read-view aggregate when every chapter of the book is a draft
// ("indexed": false). Mirrors the per-chapter noindex on Study View so a
// book's full draft text can't be indexed via its /read/<book> page. Books
// with even one published chapter (e.g. Luke) stay indexable.
const existingChapterData = chapterNumbers
  .map((chapter) => getChapter(bookKey, chapter))
  .filter((data): data is ChapterData => data !== null);
const allChaptersDraft =
  existingChapterData.length > 0 &&
  existingChapterData.every((data) => data.indexed === false);

const title = `${bookName} (Reading Mode) | Liberation and Inclusion Translation`;
const description = `Read ${bookName} in continuous scroll with Reading Mode.`;
---

<Layout
  title={title}
  description={description}
  bg="cream"
  index={false}
  noindex={allChaptersDraft}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://litbible.net/" },
        { "@type": "ListItem", "position": 2, "name": "Read", "item": "https://litbible.net/read/" },
        { "@type": "ListItem", "position": 3, "name": bookName, "item": `https://litbible.net/read/${bookKey}/` }
      ]
    })} />
  </Fragment>
  <section
    class="scripture-tools"
    data-pagefind-ignore
    aria-label="Scripture tools"
  >
    <div class="scripture-tools__inner">
      <div class="scripture-tools__left" aria-label="Jump to passage">
        <ReadMenu currentBook={bookKey} />
      </div>
      <div class="scripture-tools__center" aria-label="Search the LIT">
        <SearchBar fullSearchHref="/search" />
      </div>
      <div class="scripture-tools__right" aria-hidden="true"></div>
    </div>
  </section>

  <section
    class="rm-page"
    data-rm-root
    data-pagefind-ignore
    data-rm-book={bookKey}
    data-rm-book-title={bookName}
    data-rm-has-intro={hasIntro ? "true" : "false"}
    data-rm-study-intro-href={studyIntroHref}
  >
    <div
      class="rm-toolbar"
      id="rm-toolbar"
      data-rm-toolbar
      data-pagefind-ignore
    >
      <div class="rm-toolbar__row">
        <div class="rm-toolbar__cluster rm-toolbar__cluster--left">
          <button
            type="button"
            data-rm-toc-toggle
            aria-expanded="false"
            aria-controls="rm-toc-panel"
          >
            Go to chapter
          </button>

          <button
            type="button"
            data-rm-aa-toggle
            aria-expanded="false"
            aria-controls="rm-aa-panel"
            aria-label="Typography controls"
          >
            Aa
          </button>

          <button
            type="button"
            data-rm-markers-toggle
            aria-pressed="true"
            aria-label="Numbers: On"
          >
            Numbers: On
          </button>

          <button type="button" data-rm-focus-toggle aria-pressed="false">
            Focus: Off
          </button>
        </div>

        <div class="rm-toolbar__cluster rm-toolbar__cluster--center">
          <span class="rm-where" data-rm-where
            >{bookName} &middot; Chapter 1</span
          >

          <div class="rm-toolbar__progress">
            <span class="rm-progress" data-rm-progress>0%</span>
            <div class="rm-progressbar" aria-hidden="true">
              <span data-rm-progress-bar></span>
            </div>
          </div>
        </div>

        <div class="rm-toolbar__cluster rm-toolbar__cluster--right">
          <div class="rm-toolbar__z3-actions">
            <!-- UPDATED: arrow + swappable label -->
            <button type="button" data-rm-start-over>
              <span class="rm-arrow" aria-hidden="true"></span>
              <span class="rm-start-over-label">Return to Beginning</span>
            </button>

            <a
              href={`/${bookKey}-1`}
              class="rm-switch"
              data-rm-study-switch
              aria-label={`Switch to Study View for ${bookName} chapter 1`}
            >
              <span
                class="reading-view-pill__icon rm-cycle-icon"
                aria-hidden="true"><svg viewBox="0 0 24 24" width="1em" height="1em" fill="none"
                     stroke="currentColor" stroke-width="2" stroke-linecap="round"
                     stroke-linejoin="round" aria-hidden="true" focusable="false">
                  <path d="M1 4v6h6"/>
                  <path d="M3.51 15a9 9 0 1 0 .49-4.5"/>
                </svg></span
              >
              <span>Switch to Study View</span>
            </a>
          </div>

          <button
            type="button"
            class="rm-toolbar__close"
            data-rm-mobile-close
            aria-label="Close"
          >
            <svg
              class="rm-x"
              viewBox="0 0 24 24"
              aria-hidden="true"
              focusable="false"
            >
              <path d="M6 6l12 12M18 6L6 18"></path>
            </svg>
          </button>
        </div>
      </div>

      <div class="rm-toolbar__panels">
        <div id="rm-toc-panel" class="rm-toc" data-rm-toc-panel hidden>
          <div class="rm-toc__list">
            {
              !tocGroupSize ? (
                <>
                  <p class="rm-toc__chapters-label">Chapters</p>
                  <ol>
                    {chapterNumbers.map((chapter) => (
                      <li>
                        <button
                          type="button"
                          data-rm-target={`ch-${chapter}`}
                          data-rm-chapter-btn={chapter}
                        >
                          {chapter}
                        </button>
                      </li>
                    ))}
                  </ol>
                </>
              ) : (
                <>
                  <p class="rm-toc__chapters-label">Chapters</p>
                  <div
                    class="rm-toc__group-tabs"
                    role="tablist"
                    aria-label="Chapter groups"
                  >
                    {tocGroups.map((group, index) => (
                      <button
                        type="button"
                        role="tab"
                        data-rm-group-tab={index}
                        data-rm-group-start={group.chapters[0]}
                        data-rm-group-end={
                          group.chapters[group.chapters.length - 1]
                        }
                        aria-selected={index === 0 ? "true" : "false"}
                      >
                        {group.label}
                      </button>
                    ))}
                  </div>

                  {tocGroups.map((group, index) => (
                    <div
                      class="rm-toc__group-panel"
                      role="tabpanel"
                      data-rm-group-panel={index}
                      data-rm-group-start={group.chapters[0]}
                      data-rm-group-end={
                        group.chapters[group.chapters.length - 1]
                      }
                      hidden={index !== 0}
                    >
                      <ol>
                        {group.chapters.map((chapter) => (
                          <li>
                            <button
                              type="button"
                              data-rm-target={`ch-${chapter}`}
                              data-rm-chapter-btn={chapter}
                            >
                              {chapter}
                            </button>
                          </li>
                        ))}
                      </ol>
                    </div>
                  ))}
                </>
              )
            }
          </div>
        </div>

        <div id="rm-aa-panel" class="rm-aa" data-rm-aa-panel hidden>
          <div class="rm-aa__group">
            <p class="rm-aa__group-title">Font Size</p>
            <div class="rm-aa__options">
              <button type="button" data-rm-set="font:sm" aria-pressed="false"
                >S</button
              >
              <button type="button" data-rm-set="font:md" aria-pressed="false"
                >M</button
              >
              <button type="button" data-rm-set="font:lg" aria-pressed="false"
                >L</button
              >
            </div>
          </div>

          <div class="rm-aa__group">
            <p class="rm-aa__group-title">Line Height</p>
            <div class="rm-aa__options">
              <button
                type="button"
                data-rm-set="leading:normal"
                aria-pressed="false"
              >
                Normal
              </button>
              <button
                type="button"
                data-rm-set="leading:roomy"
                aria-pressed="false"
              >
                Roomy
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>

    <button
      type="button"
      class="rm-fab"
      data-rm-fab
      aria-label="Open reading controls"
      aria-expanded="false"
      aria-controls="rm-toolbar"
    >
      <span class="rm-fab__icon" aria-hidden="true"></span>
    </button>

    <div class="rm-resume-chip" data-rm-resume-chip role="status" hidden>
      <button type="button" data-rm-resume-go>Continue reading ↓</button>
      <button type="button" data-rm-resume-dismiss aria-label="Dismiss">✕</button>
    </div>

    <article
      class="rm-reader"
      data-rm-reader
      data-rm-markers="on"
      data-rm-focus="off"
    >
      <h1 class="rm-title">{bookName}</h1>

      <div class="rm-text" data-rm-text>
        {
          chapters.map(({ chapter, paragraphs }) => (
            <>
              <div
                class="rm-ch-anchor"
                id={`ch-${chapter}`}
                data-rm-chapter={chapter}
                aria-hidden="true"
              />
              <h2 class="rm-chapter">Chapter {chapter}</h2>

              {paragraphs.map((html) => (
                <div class="rm-block" set:html={html} />
              ))}
            </>
          ))
        }
      </div>
    </article>
  </section>

  <script type="module" src={readModeScript}></script>
</Layout>
