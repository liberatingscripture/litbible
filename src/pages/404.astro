---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Page not found | Liberation and Inclusion Translation"
  description="The page you’re looking for doesn’t exist."
  robotsNoindex={true}
>
  <section class="not-found">
    <div class="not-found__inner">
      <img
        class="not-found__logo"
        src="/images/lit-logo-2026-ring.svg"
        alt="Liberation and Inclusion Translation logo"
        width="140"
        height="140"
        loading="eager"
        decoding="async"
      />

      <h1 class="not-found__title">Page not found</h1>

      <p class="not-found__lead">
        The page you’re looking for doesn’t exist, may have moved, or the link
        may have a typo.
      </p>

      <p class="not-found__suggest" data-not-found-suggest hidden></p>

      <nav class="not-found__actions" aria-label="Quick links">
        <a class="not-found__cta kit-btn kit-btn--filled" href="/read">Read the LIT</a>
        <a class="not-found__cta not-found__cta--outline kit-btn kit-btn--tinted" href="/search"
          >Search</a
        >
        <a class="not-found__link" href="/">Go to the home page</a>
      </nav>
    </div>
  </section>
</Layout>

<script>
  // A guessable scripture address ("/John-3", "/john-3-16", "/jn-3",
  // "/read/1-corinthians") lands here because the real one is
  // "/john-3/#v16". Read it the way the search box reads a reference: a sure
  // match goes straight there, a known book with a chapter it doesn't have
  // gets a suggestion, and anything else leaves this page as it is.
  import { resolveMistypedPath } from "../scripts/search-core.js";

  const match = resolveMistypedPath(location.pathname);
  const target = match && new URL(match.href, location.origin);

  if (target && target.pathname !== location.pathname) {
    if (match.sure) {
      // A hash typed after a bare chapter ("/John-3#v16") still applies.
      if (!target.hash && location.hash) target.hash = location.hash;
      location.replace(target.href);
    } else {
      const suggest = document.querySelector<HTMLElement>(
        "[data-not-found-suggest]",
      );
      if (suggest) {
        const link = document.createElement("a");
        link.href = target.pathname + target.hash;
        link.textContent = match.label;
        suggest.append("Did you mean ", link, "?");
        suggest.hidden = false;
      }
    }
  }
</script>

<style>
  .not-found {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 60vh;
    padding: var(--space-9) var(--space-5);
    text-align: center;
  }

  .not-found__inner {
    max-width: 520px;
  }

  .not-found__logo {
    display: block;
    margin: 0 auto var(--space-6);
  }

  /* The page's one italic line: its own heading, in Fraunces's italic. */
  .not-found__title {
    font-style: italic;
    font-size: var(--size-title);
    line-height: var(--leading-title);
    margin: 0 0 var(--space-4);
  }

  .not-found__lead {
    font-size: var(--size-text);
    line-height: var(--leading-text);
    margin: 0 0 var(--space-4);
    color: var(--color-text-2);
  }

  .not-found__suggest {
    font-size: var(--size-text);
    line-height: var(--leading-text);
    margin: 0 0 var(--space-6);
  }

  .not-found__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3);
    margin: var(--space-5) 0;
  }

  .not-found__link {
    display: block;
    width: 100%;
    margin-top: var(--space-1);
    font-size: var(--size-margin);
    line-height: var(--leading-margin);
  }
</style>
