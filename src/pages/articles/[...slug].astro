---
import Layout from "../../layouts/Layout.astro";
import SearchBar from "../../components/SearchBar.astro";
import Icon from "../../components/Icon.astro";
import "../../styles/pages/article.css";

import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import { linkRefs } from "../../lib/scripture-refs-data.mjs";

type ArticleEntry = CollectionEntry<"articles">;

export async function getStaticPaths() {
  const entries = (await getCollection("articles")) as ArticleEntry[];
  return entries.map((entry) => ({
    params: { slug: entry.id },
  }));
}

const slug = Astro.params.slug as string;

const entries = (await getCollection("articles")) as ArticleEntry[];
const entry = entries.find((e) => e.id === slug);

if (!entry) throw new Error(`Article not found: ${slug}`);

const { Content } = await render(entry);
// The body goes out as a string so its scripture references can be linked
// (src/lib/scripture-refs.mjs). No article uses a Markdown image, which is the
// one thing render() does that the stored HTML doesn't; if one ever does, the
// component path below still renders it, just without links.
const bodyHtml =
  entry.rendered?.html != null && !entry.rendered.metadata?.imagePaths?.length
    ? linkRefs(entry.rendered.html)
    : null;
const { data } = entry;

/**
 * Pagefind-friendly hyphen normalization for INDEXED TEXT:
 * Replace hyphens that function as word-joiners with spaces so searches match
 * both "life breath" and "life-breath", etc.
 *
 * Conservative: only targets hyphen-minus BETWEEN word characters.
 */
function hyphensToSpacesForIndex(s: string) {
  return String(s ?? "").replace(/([0-9A-Za-z])\-([0-9A-Za-z])/g, "$1 $2");
}

const pageTitleRaw = `${data.title} | Liberation and Inclusion Translation`;
const pageDescriptionRaw = data.description ?? "";

const pageTitle = pageTitleRaw;
const pageDescription = pageDescriptionRaw;

const dateLabel = data.date.toLocaleDateString("en-US", {
  timeZone: "UTC",
  year: "numeric",
  month: "numeric",
  day: "numeric",
});

const heroImage = data.heroImage;
const siteOrigin = "https://litbible.net";
const tags: string[] = Array.isArray(data.tags) ? data.tags : [];
function tagKey(t: string) {
  return String(t)
    .toLowerCase()
    .replace(/[^0-9a-z]/g, "");
}

/**
 * Index-only strings (hyphens treated as spaces):
 * This is what Pagefind will use for matching.
 *
 * NOTE: We intentionally index ONLY:
 * - Title (keyword matches)
 * - Tags (topic matches)
 *
 * We do NOT index the description/dek.
 */
const indexTitle = hyphensToSpacesForIndex(data.title);
const indexTagsJoined = hyphensToSpacesForIndex(tags.join(", "));
---

<Layout
  title={pageTitle}
  description={pageDescription}
  bg="cream"
  pageSearch
  ogImage={heroImage ? `${siteOrigin}${heroImage}` : undefined}
  ogType="article"
  twitterCard={heroImage ? "summary_large_image" : "summary"}
  deskSurface="article"
>
  <Fragment slot="head">
    {heroImage && <link rel="preload" as="image" href={heroImage} />}
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://litbible.net/" },
        { "@type": "ListItem", "position": 2, "name": "Articles", "item": "https://litbible.net/articles/" },
        { "@type": "ListItem", "position": 3, "name": data.title, "item": `${siteOrigin}/articles/${slug}/` }
      ]
    })} />
    <meta property="article:published_time" content={data.date.toISOString()} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      "headline": data.title,
      "description": pageDescriptionRaw || undefined,
      "datePublished": data.date.toISOString(),
      "author": { "@type": "Person", "name": data.author ?? "Brandon C. Vélez Johnson" },
      "image": heroImage ? `${siteOrigin}${heroImage}` : undefined,
      "publisher": { "@type": "Organization", "name": "Liberating Scripture Collective" },
      "url": `${siteOrigin}/articles/${slug}/`
    })} />
  </Fragment>
  <div class="article-shell">
    <div class="article-top">
      <div class="article-top__inner">
        <div class="article-top__search">
          <SearchBar
            placeholder="Search…"
            fullSearchHref="/search"
            defaultMode="article"
          />
        </div>
      </div>
    </div>

    {/* The page is the reading column (Phase 7, "The glossary and articles"):
        no card, the title in Fraunces, the words in Source Sans 3 at the
        reading measure. .article__card stays the column's name because the
        Study Desk finds it (desk-frame.js, desk/page-kind.js). */}
    <article
      class="article__card"
      data-pagefind-body
      data-pagefind-filter="type:article"
    >
      {/* Index-only surface: title + tags (NOT description) */}
      <div class="sr-only" aria-hidden="true">
        {/* Make title real indexable text (keyword matches).
            A div, not h1 — the visible .article__title below is the page's
            only h1; data-pagefind-weight preserves title-ranking weight. */}
        <div data-pagefind-weight="7">{indexTitle}</div>

        {/* Optional meta mirror (handy for tooling/debug) */}
        <span data-pagefind-meta="title">{indexTitle}</span>

        {
          tags.length > 0 && (
            <>
              {/* Topic-only zone so tag hits do not count as keyword hits */}
              <span id="pf-topics-start" />

              {/* IMPORTANT:
                - use meta="topics" so both tray + search page treat these as "Subject matches"
                - keep it a clean comma-separated list
                - hyphens normalized for index matching */}
              <p data-pagefind-meta="topics">{indexTagsJoined}</p>

              <span id="pf-topics-end" />

              {/* Optional: enable tag filters later (normalized) */}
              {tags.map((t) => (
                <span data-pagefind-filter={`tag:${tagKey(t)}`} />
              ))}
            </>
          )
        }
      </div>

      {/* Everything below is ignored by Pagefind */}
      <header class="article__header" data-pagefind-ignore>
        <h1 class="article__title">{data.title}</h1>

        {/* Author and date, one small line under the title */}
        <p class="article__byline">
          {data.author && <span class="article__author">{data.author}</span>}
          {data.author && <span class="article__dot" aria-hidden="true">·</span>}
          <time class="article__date" datetime={data.date.toISOString()}>
            {dateLabel}
          </time>
        </p>

        {pageDescriptionRaw && <p class="article__dek">{pageDescriptionRaw}</p>}
      </header>

      {
        heroImage && (
          <div class="article__hero" aria-hidden="true" data-pagefind-ignore>
            <img
              class="article__hero-img"
              src={heroImage}
              alt=""
              loading="eager"
              fetchpriority="high"
              decoding="async"
            />
          </div>
        )
      }

      {/* Back-to-top target */}
      <div id="top" data-pagefind-ignore></div>

      <div class="article__body" data-pagefind-ignore>
        {bodyHtml != null ? <Fragment set:html={bodyHtml} /> : <Content />}
      </div>

      {
        tags.length > 0 && (
          <ul class="tags article__tags" aria-label="Tags" data-pagefind-ignore>
            {tags.map((t) => (
              <li class="tag">{t}</li>
            ))}
          </ul>
        )
      }

      {/* Bottom nav */}
      <div class="article__bottom-nav" data-pagefind-ignore>
        <a class="kit-btn kit-btn--plain article__back" href="/articles">
          <Icon name="back" />All Articles
        </a>
        <a class="kit-btn kit-btn--plain article__top" href="#top">
          <Icon name="up" />Back to top
        </a>
      </div>
    </article>
  </div>
  {/* Scripture reference previews (progressive enhancement) */}
  <script>
    import "../../scripts/ref-preview.js";
  </script>
</Layout>
