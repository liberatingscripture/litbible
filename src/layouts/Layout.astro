---
import "../styles/global.css";
import "../styles/print.css";
import SiteHeader from "../components/SiteHeader.astro";
import interLatin400Url from "@fontsource/inter/files/inter-latin-400-normal.woff2";
import crimsonLatin600Url from "@fontsource/crimson-text/files/crimson-text-latin-600-normal.woff2";
import SiteFooter from "../components/SiteFooter.astro";
import AppsLaunchPopover from "../components/AppsLaunchPopover.astro";
import AppInstallBanner from "../components/AppInstallBanner.astro";
import { APP_PLATFORM_UA } from "../lib/app-platform.mjs";
import { EDGE, FIRST_PAINT, GAP, MAX_MEASURE, MIN_MEASURE, MIN_WIDTH } from "../lib/desk-margin.mjs";
import { contentUpdated, contentVersion } from "../lib/content-version.mjs";

const {
  title = "Liberation and Inclusion Translation",
  description = "A trauma-informed, justice-oriented translation of the Bible from the original languages.",
  canonical,
  bg = "cream",
  headerClass = "",
  pagefindIndex = false, // ✅ default: do NOT Pagefind-index generic pages
  robotsNoindex = false, // when true → <meta name="robots" content="noindex,follow">
  ogImage,
  twitterCard = "summary", // "summary_large_image" for pages with wide ogImage art
  ogType = "website", // "article" for article pages (Open Graph og:type)
  hideFooterNewsletter = false, // pages with their own Brevo form (e.g. /unsubscribe)
  // Adds the Display tray's scripture settings: "study" (verse numbers and
  // footnote letters) on chapter pages, "read" (numbers only; Read View
  // prints no footnote letters) on /read/<book>.
  scriptureControls,
  // True on pages that carry their own search box (chapters, intros, /read,
  // Read View, /search, articles). Every other page gets the header's
  // search icon instead, so each page has exactly one way in (audit U6).
  pageSearch = false,
  // The Study Desk's own header (/desk): the page's title, centered, in
  // place of the nav, and no search (SiteHeader's deskTitle).
  deskTitle,
} = Astro.props;

// Auto-generate canonical URL from site config when not explicitly provided.
// Astro.site is set via `site:` in astro.config.mjs.
const canonicalUrl: string =
  canonical ?? (Astro.site ? new URL(Astro.url.pathname, Astro.site).href : "");
const siteOrigin = Astro.site ? Astro.site.origin : "https://litbible.net";
const ogImageUrl = ogImage ?? `${siteOrigin}/images/lit-logo-2026-ring.png`;

// Critical inline style values — prevent FOUC before external stylesheet loads.
// green pages stay green in dark mode (brand color); all others flip to dark bg.
const isGreen = bg === "green";
const isWhite = bg === "white";
const criticalBg        = isGreen ? "#209D50" : isWhite ? "#FAFAF8" : "#E1DFD9";
const criticalColor     = isGreen ? "#E1DFD9" : "#1d231c";
const criticalDarkBg    = isGreen ? "#209D50" : isWhite ? "#1d1d1f" : "#0E0E0F";
const criticalDarkColor = isGreen ? "#E1DFD9" : "#F0F0F0";
// scrollbar-gutter, header min-height, and main min-height are reserved here
// (not just in global.css) so the early paint shares the final layout geometry.
// .site-header covers the outer element; .site-header__inner covers the inner.
// main{min-height:50svh} keeps the early paint from starting at height:0
// before content arrives, avoiding a large layout shift on long pages.
// The dark block mirrors global.css's dual mechanism so the pre-paint data-theme
// attribute overrides it on first paint: the media rule is guarded with
// :not([data-theme="light"]) (so a forced-light user on a dark OS gets no dark
// frame), and an explicit :root[data-theme="dark"] rule forces dark on any OS.
const criticalCSS = `html,body{margin:0;padding:0}html{scrollbar-gutter:stable}body{background:${criticalBg};color:${criticalColor}}.site-header{min-height:80px}.site-header__inner{min-height:80px;box-sizing:border-box}main{min-height:50svh}@media(prefers-color-scheme:dark){:root:not([data-theme="light"]) body{background:${criticalDarkBg};color:${criticalDarkColor}}}:root[data-theme="dark"] body{background:${criticalDarkBg};color:${criticalDarkColor}}`;

// What the desk's pre-paint script needs to repeat src/lib/desk-margin.mjs's
// firstPaint (BA25, BA30).
const deskFit = { ...FIRST_PAINT, edge: EDGE, gap: GAP, minWidth: MIN_WIDTH, minMeasure: MIN_MEASURE, maxMeasure: MAX_MEASURE };
---

<!doctype html>
<html lang="en" data-content-version={contentVersion()} data-content-updated={contentUpdated()}>
  <head>
    <meta charset="utf-8" />
    <!-- Apply the saved reader font before first paint to avoid a flash of the default font.
         Absence of 'lit-font' = default fonts: no attribute, no accessibility font downloaded.
         The legacy boolean 'dyslexic-font' key is still read as a fallback so readers who
         turned OpenDyslexic on before the three-way control shipped aren't reset. -->
    <script is:inline>try{var f=localStorage.getItem('lit-font')||(localStorage.getItem('dyslexic-font')==='1'?'dyslexic':'');if(f==='dyslexic'||f==='atkinson')document.documentElement.setAttribute('data-font',f)}catch(_){}</script>
    <!-- Apply the saved theme (light/dark) before first paint to avoid a flash of the wrong scheme.
         Absence of 'lit-theme' = system: no attribute, CSS follows prefers-color-scheme. -->
    <script is:inline>try{var t=localStorage.getItem('lit-theme');if(t==='light'||t==='dark'){document.documentElement.setAttribute('data-theme',t);document.documentElement.style.colorScheme=t;}}catch(_){}</script>
    <!-- Apply the saved text size, line spacing, and verse-number / footnote-letter
         visibility before first paint, so nothing reflows after load. Each key's
         absence is the default (Medium, Normal, shown). The three Read View keys
         that came before the shared Display tray (lit_rm_fontSize, lit_rm_lineHeight,
         lit_rm_markers) are still read as fallbacks; the tray deletes each one when
         its setting changes, so it can't resurrect an older choice.
         Verse numbers are one setting per view. Study View reads lit-verse-numbers
         alone: a number there is the verse menu's button, so hiding it for Read
         View's sake took the menu away on a touch screen. Read View reads
         lit-read-numbers, then lit_rm_markers (its own key before the tray), then
         Study View's, so it follows Study View until the reader sets it. -->
    <script is:inline define:vars={{ readView: scriptureControls === "read" }}>try{var s=localStorage,d=document.documentElement,z=s.getItem('lit-size')||s.getItem('lit_rm_fontSize'),l=s.getItem('lit-leading')||s.getItem('lit_rm_lineHeight'),n=readView?(s.getItem('lit-read-numbers')||s.getItem('lit_rm_markers')||s.getItem('lit-verse-numbers')):s.getItem('lit-verse-numbers'),r=s.getItem('lit-fn-letters'),k=s.getItem('lit-terms');if(z==='sm'||z==='lg'||z==='xl')d.setAttribute('data-size',z);if(l==='roomy')d.setAttribute('data-leading',l);if(n==='off')d.setAttribute('data-vn',n);if(r==='off')d.setAttribute('data-fn',r);if(k==='off')d.setAttribute('data-terms',k)}catch(_){}</script>
    <!-- The Study Desk preview (STUDY-DESK.md, phase 1b). ?desk=on or ?desk=off sets or
         clears lit-desk-preview in this browser (off clears lit-desk-panel too) and is
         taken out of the address, so a copied link never carries it. With the flag on, and on a computer (the test in
         src/lib/app-platform.mjs, repeated here since this script can't import),
         data-desk="on" turns the desk on: desk-gate.js loads it, and global.css shows
         the Notebook button and narrows the reading measure to 52. Unless the reader
         closed the notebook (lit-desk-panel "closed"; it starts open and minimized,
         BVJ 2026-10-13) or chose on the notebook page that pages open with it
         closed (lit-desk-start; src/lib/desk-start.mjs is the rule),
         data-desk-panel="open" goes on too, and, when it starts expanded rather than
         minimized (lit-desk-min "0", or a start of "open"), data-desk-expanded: only the
         expanded notebook narrows Study View chapters to 48 and applies the dragged widths
         (BVJ, 2026-10-14), so stamped here a page opening that way never reflows.
         margin.js keeps data-desk-expanded in step from then on. The widths
         a reader dragged this visit (sessionStorage lit-desk-measure and lit-desk-width;
         src/scripts/desk/widths.js) go on with it as data-desk-widths, --desk-measure and
         --desk-width, so a Study View chapter opens with them and doesn't jump. Both are
         stamped only where the window holds them: the script repeats
         src/lib/desk-margin.mjs's firstPaint (handed its numbers as deskFit), which works
         out the column's width from the reader's font and text size. Too narrow for the
         margin, the notebook would float and fold by itself, reflowing every chapter
         (BA25); widths kept in a wider window are given way as widths.js gives them, or
         left off (BA30). The window's width is the width less the scrollbar, measured on
         a throwaway element: the page reserves a scrollbar's room (scrollbar-gutter, in
         the critical CSS), which the window doesn't show yet this early, and reading it
         without left a 16px band where the guess was wrong. The panel itself sits in the
         margin, so nothing else needs reserving for it here. -->
    <script is:inline define:vars={{ appUa: APP_PLATFORM_UA.source, appUaFlags: APP_PLATFORM_UA.flags, deskFit }}>try{var d=document.documentElement,s=localStorage,u=new URL(location.href),q=u.searchParams.get('desk'),n=navigator,a=n.userAgent||'',t=n.maxTouchPoints>1;if(q==='on'||q==='off'){if(q==='on')s.setItem('lit-desk-preview','on');else{s.removeItem('lit-desk-preview');s.removeItem('lit-desk-panel')}u.searchParams.delete('desk');history.replaceState(history.state,'',u.pathname+u.search+u.hash)}if(s.getItem('lit-desk-preview')==='on'&&!(new RegExp(appUa,appUaFlags).test(a)||(n.userAgentData&&n.userAgentData.mobile===true)||(t&&(/Macintosh/.test(a)||(/Linux/.test(a)&&!/CrOS/.test(a)))))){d.setAttribute('data-desk','on');var b=s.getItem('lit-desk-start');if(b==='closed'?false:b==='min'||b==='open'||s.getItem('lit-desk-panel')!=='closed'){d.setAttribute('data-desk-panel','open');if(b==='open'||(b!=='min'&&s.getItem('lit-desk-min')==='0')){var f=deskFit,w=sessionStorage,m=parseFloat(w.getItem('lit-desk-measure')),x=parseFloat(w.getItem('lit-desk-width')),e=document.createElement('div'),v,k=(f.ch[d.getAttribute('data-font')]||f.ch[''])*(f.scale[d.getAttribute('data-size')]||1)*f.body*parseFloat(getComputedStyle(d).fontSize),r,h=1,g;e.style.cssText='position:absolute;visibility:hidden;width:99px;height:9px;overflow:scroll';d.appendChild(e);v=innerWidth-(e.offsetWidth-e.clientWidth);d.removeChild(e);r=v-f.edge-f.gap;if(m>=f.minMeasure&&m<=f.maxMeasure&&x>=f.minWidth){h=m*k+f.pad+x-r;if(h>0){g=Math.min(h,x-f.minWidth);x-=g;h-=g}if(h>0){g=Math.min(h,(m-f.minMeasure)*k);m-=g/k;h-=g}}if(h<=.5){d.setAttribute('data-desk-expanded','');d.setAttribute('data-desk-widths','');d.style.setProperty('--desk-measure',String(Math.round(m*10)/10));d.style.setProperty('--desk-width',Math.round(x)+'px')}else if(r-f.measure*k-f.pad>=f.minWidth)d.setAttribute('data-desk-expanded','')}}}}catch(_){}</script>
    <title>{title}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content={robotsNoindex ? "noindex,follow" : "index,follow"} />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}

    {/* Apple Smart App Banner (iOS Safari). Unlike a plain link, this flips its
        button from GET to OPEN when the app is installed and hands it the page.
        app-argument is this page's canonical URL, so OPEN lands on the passage.
        Fragments (#v3) aren't known at render time, so it resolves at chapter
        level; verse precision comes from Universal Links (apple-app-site-association). */}
    {canonicalUrl && (
      <meta name="apple-itunes-app" content={`app-id=6772577879, app-argument=${canonicalUrl}`} />
    )}

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:site_name" content="LIT Bible" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImageUrl} />
    {/* Dimensions are only known for the default logo; pages passing their
        own ogImage omit them rather than misreport. */}
    {!ogImage && <meta property="og:image:width" content="1000" />}
    {!ogImage && <meta property="og:image:height" content="1000" />}

    <!-- Twitter Card -->
    <meta name="twitter:card" content={twitterCard} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Critical inline reset: applies before the external stylesheet is fetched,
         preventing the browser's 8px default body margin from causing CLS.
         Colors are bg-specific so no flash occurs on green or dark-mode pages. -->
    <Fragment set:html={`<style>${criticalCSS}</style>`} />

    <!-- Font preloads: start fetching before CSS is parsed -->
    <link rel="preload" href={interLatin400Url} as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href={crimsonLatin600Url} as="font" type="font/woff2" crossorigin="anonymous" />

    <!-- Favicons & manifest -->
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#209D50" />
    <meta name="theme-color" content="#0F6B33" media="(prefers-color-scheme: dark)" />
    <meta name="color-scheme" content="light dark" />

<!-- Articles RSS feed -->
    <link
      rel="alternate"
      type="application/rss+xml"
      title="LIT Bible Articles"
      href="/rss.xml"
    />

    <!-- Translation updates RSS feed (the release notes) -->
    <link
      rel="alternate"
      type="application/rss+xml"
      title="LIT Translation Updates"
      href="/translation-updates.xml"
    />

    <!-- Found in Translation podcast (RedCircle) -->
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Found in Translation Podcast"
      href="https://feeds.redcircle.com/59ffbfb2-f814-469a-8522-416bb67c15f6"
    />

<slot name="head" />
  </head>

  <body class={`bg-${bg}`} data-pagefind-ignore={pagefindIndex ? undefined : true}>
    <a href="#main-content" class="skip-link">Skip to content</a>
    <AppInstallBanner />
    <SiteHeader class={headerClass} scriptureControls={scriptureControls} headerSearch={!pageSearch && !deskTitle} deskTitle={deskTitle} />

    <main id="main-content" data-pagefind-body={pagefindIndex ? true : undefined}>
      <slot />
    </main>

    <SiteFooter hideNewsletter={hideFooterNewsletter} />
    <AppsLaunchPopover />
  </body>
</html>
