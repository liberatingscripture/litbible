---
import "../styles/global.css";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";

const {
  title = "Liberation and Inclusion Translation",
  description = "A trauma-informed, justice-oriented translation of the Bible from the original languages.",
  canonical,
  bg = "cream",
  headerClass = "",
  index = false, // ✅ default: do NOT index generic pages
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>{title}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="index,follow" />
    {canonical ? <link rel="canonical" href={canonical} /> : null}
    <slot name="head" />
  </head>

  <body class={`bg-${bg}`} data-pagefind-ignore={index ? undefined : true}>
    <SiteHeader class={headerClass} />

    <main data-pagefind-body={index ? true : undefined}>
      <slot />
    </main>

    <SiteFooter />
  </body>
</html>
