---
import "../styles/global.css";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";

const {
  title = "Liberation and Inclusion Translation",
  description = "A trauma-informed, justice-oriented translation of the Bible from the original languages.",
  canonical,
  bg = "cream",
  headerClass = "",
  index = false, // ✅ default: do NOT index generic pages
} = Astro.props;

// Auto-generate canonical URL from site config when not explicitly provided.
// Astro.site is set via `site:` in astro.config.mjs.
const canonicalUrl: string =
  canonical ?? (Astro.site ? new URL(Astro.url.pathname, Astro.site).href : "");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>{title}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="index,follow" />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:site_name" content="LIT Bible" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <!-- Favicons & manifest -->
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#209D50" />

<slot name="head" />
  </head>

  <body class={`bg-${bg}`} data-pagefind-ignore={index ? undefined : true}>
    <a href="#main-content" class="skip-link">Skip to content</a>
    <SiteHeader class={headerClass} />

    <main id="main-content" data-pagefind-body={index ? true : undefined}>
      <slot />
    </main>

    <SiteFooter />
  </body>
</html>
