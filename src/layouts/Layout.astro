---
import "../styles/global.css";
import SiteHeader from "../components/SiteHeader.astro";
import interLatin400Url from "@fontsource/inter/files/inter-latin-400-normal.woff2";
import crimsonLatin600Url from "@fontsource/crimson-text/files/crimson-text-latin-600-normal.woff2";
import SiteFooter from "../components/SiteFooter.astro";
import WelcomePopover from "../components/WelcomePopover.astro";

const {
  title = "Liberation and Inclusion Translation",
  description = "A trauma-informed, justice-oriented translation of the Bible from the original languages.",
  canonical,
  bg = "cream",
  headerClass = "",
  pagefindIndex = false, // ✅ default: do NOT Pagefind-index generic pages
  robotsNoindex = false, // when true → <meta name="robots" content="noindex,follow">
  ogImage,
  twitterCard = "summary", // "summary_large_image" for pages with wide ogImage art
  ogType = "website", // "article" for article pages (Open Graph og:type)
  hideFooterNewsletter = false, // pages with their own Brevo form (e.g. /unsubscribe)
} = Astro.props;

// Auto-generate canonical URL from site config when not explicitly provided.
// Astro.site is set via `site:` in astro.config.mjs.
const canonicalUrl: string =
  canonical ?? (Astro.site ? new URL(Astro.url.pathname, Astro.site).href : "");
const siteOrigin = Astro.site ? Astro.site.origin : "https://litbible.net";
const ogImageUrl = ogImage ?? `${siteOrigin}/images/lit-logo.png`;

// Critical inline style values — prevent FOUC before external stylesheet loads.
// green pages stay green in dark mode (brand color); all others flip to dark bg.
const isGreen = bg === "green";
const isWhite = bg === "white";
const criticalBg        = isGreen ? "#209D50" : isWhite ? "#FAFAF8" : "#E1DFD9";
const criticalColor     = isGreen ? "#E1DFD9" : "#1d231c";
const criticalDarkBg    = isGreen ? "#209D50" : isWhite ? "#1d1d1f" : "#0E0E0F";
const criticalDarkColor = isGreen ? "#E1DFD9" : "#F0F0F0";
// scrollbar-gutter, header min-height, and main min-height are reserved here
// (not just in global.css) so the early paint shares the final layout geometry.
// .site-header covers the outer element; .site-header__inner covers the inner.
// main{min-height:50svh} keeps the early paint from starting at height:0
// before content arrives, avoiding a large layout shift on long pages.
// The dark block mirrors global.css's dual mechanism so the pre-paint data-theme
// attribute overrides it on first paint: the media rule is guarded with
// :not([data-theme="light"]) (so a forced-light user on a dark OS gets no dark
// frame), and an explicit :root[data-theme="dark"] rule forces dark on any OS.
const criticalCSS = `html,body{margin:0;padding:0}html{scrollbar-gutter:stable}body{background:${criticalBg};color:${criticalColor}}.site-header{min-height:80px}.site-header__inner{min-height:80px;box-sizing:border-box}main{min-height:50svh}@media(prefers-color-scheme:dark){:root:not([data-theme="light"]) body{background:${criticalDarkBg};color:${criticalDarkColor}}}:root[data-theme="dark"] body{background:${criticalDarkBg};color:${criticalDarkColor}}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <!-- Apply dyslexic-font class before first paint to avoid flash of default font -->
    <script is:inline>try{if(localStorage.getItem('dyslexic-font')==='1')document.documentElement.classList.add('dyslexic-font')}catch(_){}</script>
    <!-- Apply the saved theme (light/dark) before first paint to avoid a flash of the wrong scheme.
         Absence of 'lit-theme' = system: no attribute, CSS follows prefers-color-scheme. -->
    <script is:inline>try{var t=localStorage.getItem('lit-theme');if(t==='light'||t==='dark'){document.documentElement.setAttribute('data-theme',t);document.documentElement.style.colorScheme=t;}}catch(_){}</script>
    <title>{title}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content={robotsNoindex ? "noindex,follow" : "index,follow"} />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:site_name" content="LIT Bible" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImageUrl} />
    {/* Dimensions are only known for the default logo; pages passing their
        own ogImage omit them rather than misreport. */}
    {!ogImage && <meta property="og:image:width" content="1000" />}
    {!ogImage && <meta property="og:image:height" content="1000" />}

    <!-- Twitter Card -->
    <meta name="twitter:card" content={twitterCard} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Critical inline reset: applies before the external stylesheet is fetched,
         preventing the browser's 8px default body margin from causing CLS.
         Colors are bg-specific so no flash occurs on green or dark-mode pages. -->
    <Fragment set:html={`<style>${criticalCSS}</style>`} />

    <!-- Font preloads: start fetching before CSS is parsed -->
    <link rel="preload" href={interLatin400Url} as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href={crimsonLatin600Url} as="font" type="font/woff2" crossorigin="anonymous" />

    <!-- Favicons & manifest -->
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#209D50" />
    <meta name="color-scheme" content="light dark" />

<!-- Articles RSS feed -->
    <link
      rel="alternate"
      type="application/rss+xml"
      title="LIT Bible Articles"
      href="/rss.xml"
    />

    <!-- Found in Translation podcast (RedCircle) -->
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Found in Translation Podcast"
      href="https://feeds.redcircle.com/59ffbfb2-f814-469a-8522-416bb67c15f6"
    />

<slot name="head" />
  </head>

  <body class={`bg-${bg}`} data-pagefind-ignore={pagefindIndex ? undefined : true}>
    <a href="#main-content" class="skip-link">Skip to content</a>
    <SiteHeader class={headerClass} />

    <main id="main-content" data-pagefind-body={pagefindIndex ? true : undefined}>
      <slot />
    </main>

    <SiteFooter hideNewsletter={hideFooterNewsletter} />
    <WelcomePopover />
  </body>
</html>
