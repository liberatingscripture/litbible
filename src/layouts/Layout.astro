---
import "../styles/tokens.css";
import "../styles/global.css";
import "../styles/kit.css";
import "../styles/header.css";
import "../styles/footer.css";
import "../styles/print.css";
import SiteHeader from "../components/SiteHeader.astro";
import PlaceLine from "../components/PlaceLine.astro";
import PassagePicker from "../components/PassagePicker.astro";
import { placeOf } from "../lib/places.mjs";
import sourceSansLatinUrl from "@fontsource-variable/source-sans-3/files/source-sans-3-latin-wght-normal.woff2";
import frauncesLatinUrl from "@fontsource-variable/fraunces/files/fraunces-latin-full-normal.woff2";
import SiteFooter from "../components/SiteFooter.astro";
import AppsLaunchPopover from "../components/AppsLaunchPopover.astro";
import AppInstallBanner from "../components/AppInstallBanner.astro";
import { APP_PLATFORM_UA } from "../lib/app-platform.mjs";
import { EDGE, FIRST_PAINT, GAP, MIN_WIDTH } from "../lib/desk-margin.mjs";
import { READING_SURFACES, hasPanel } from "../scripts/desk-frame.js";
import { contentUpdated, contentVersion } from "../lib/content-version.mjs";

const {
  title = "Liberation and Inclusion Translation",
  description = "A trauma-informed, justice-oriented translation of the Bible from the original languages.",
  canonical,
  bg = "cream",
  headerClass = "",
  pagefindIndex = false, // ✅ default: do NOT Pagefind-index generic pages
  robotsNoindex = false, // when true → <meta name="robots" content="noindex,follow">
  ogImage,
  twitterCard = "summary", // "summary_large_image" for pages with wide ogImage art
  ogType = "website", // "article" for article pages (Open Graph og:type)
  hideFooterNewsletter = false, // pages with their own Brevo form (e.g. /unsubscribe)
  // Adds the Display tray's scripture settings: "study" (verse numbers and
  // footnote letters) on chapter pages, "read" (numbers only; Read View
  // prints no footnote letters) on /read/<book>.
  scriptureControls,
  // True on pages that carry their own search box (chapters and intros, in
  // the place line; Read View, /search, articles). The header's magnifier
  // takes the reader to that box there, and opens its own strip everywhere
  // else, so a page never shows two (audit U6). The Read page (chapters,
  // intros, Read View) has no magnifier at all (HD-13).
  pageSearch = false,
  // Study's own header (/desk): the page's title, centered, in place of the
  // places, and no search (SiteHeader's deskTitle).
  deskTitle,
  // Where the header's Study menu sends "Scripture": a chapter or an
  // introduction passes the place line's "Study John 3" address
  // (ScriptureLayout), so the two never disagree.
  deskHref,
  // The passage on a chapter or an introduction ({ book, chapter,
  // studyHref }; ScriptureLayout), which makes the line under the header
  // the place line (PlaceLine.astro) and opens the passage picker at it.
  readingLine,
  // True on /read, where the passage picker is the page, so no other is
  // drawn: everywhere else but Study's own header, the picker waits in a
  // closed dialog for its ways in (PassagePicker.astro).
  pickerInPage = false,
  // The chapter's name on a chapter or an introduction ("John 3"), which
  // makes the header's row the phone's top bar under 700px (SiteHeader's
  // picker; ScriptureLayout passes it, with the bar at the thumb).
  picker,
  // Which reading surface this page is, for the Study Desk ("chapter",
  // "intro", "read", "article", "glossary"; the kinds in desk-frame.js's
  // ALL_SURFACES). The pre-paint script stamps the Notebook panel's state
  // only where that kind has the panel (hasPanel; E124).
  deskSurface,
} = Astro.props;

// Where this page is among the four places (src/lib/places.mjs): the
// header underlines its place, and the line under the header names it.
const where = placeOf(Astro.url.pathname);
const search = deskTitle || where.readPage ? "none" : pageSearch ? "page" : "strip";

// Auto-generate canonical URL from site config when not explicitly provided.
// Astro.site is set via `site:` in astro.config.mjs.
const canonicalUrl: string =
  canonical ?? (Astro.site ? new URL(Astro.url.pathname, Astro.site).href : "");
const siteOrigin = Astro.site ? Astro.site.origin : "https://litbible.net";
const ogImageUrl = ogImage ?? `${siteOrigin}/images/lit-logo-2026-ring.png`;

// Critical inline style values — prevent FOUC before external stylesheet loads.
// Green pages stay green in dark mode (brand color); every other page is the
// paper by day and the night page by night (tokens.css: --color-page and
// --color-text), whatever its bg, since the cream went ("Surfaces").
const isGreen = bg === "green";
const criticalBg        = isGreen ? "#209D50" : "#FAFAF8";
const criticalColor     = isGreen ? "#FAFAF8" : "#1D231C";
const criticalDarkBg    = isGreen ? "#209D50" : "#111411";
const criticalDarkColor = isGreen ? "#FAFAF8" : "#ECEEE8";
// scrollbar-gutter, header min-height, and main min-height are reserved here
// (not just in global.css) so the early paint shares the final layout geometry.
// .site-header covers the outer element; .site-header__inner covers the inner.
// main{min-height:50svh} keeps the early paint from starting at height:0
// before content arrives, avoiding a large layout shift on long pages.
// A phone's reading page reserves its top bar's height instead (header.css,
// "The phone's top bar").
// The dark block mirrors global.css's dual mechanism so the pre-paint data-theme
// attribute overrides it on first paint: the media rule is guarded with
// :not([data-theme="light"]) (so a forced-light user on a dark OS gets no dark
// frame), and an explicit :root[data-theme="dark"] rule forces dark on any OS.
const criticalCSS = `html,body{margin:0;padding:0}html{scrollbar-gutter:stable}body{background:${criticalBg};color:${criticalColor}}.site-header{min-height:80px}.site-header__inner{min-height:80px;box-sizing:border-box}@media(max-width:699px){.site-header--reading,.site-header--reading .site-header__inner{min-height:52px}}main{min-height:50svh}@media(prefers-color-scheme:dark){:root:not([data-theme="light"]) body{background:${criticalDarkBg};color:${criticalDarkColor}}}:root[data-theme="dark"] body{background:${criticalDarkBg};color:${criticalDarkColor}}`;

// What the desk's pre-paint script needs to repeat src/lib/desk-margin.mjs's
// firstPaint (BA25, BA30).
const deskFit = { ...FIRST_PAINT, edge: EDGE, gap: GAP, minWidth: MIN_WIDTH };
// Whether this page has the Notebook panel, for the same script (E124).
const deskPanel = hasPanel(deskSurface);
// Whether its column is the one firstPaint knows, a Chapter View chapter's
// (the first reading surface, as margin.js tells it): the only page whose
// move left the script can work out before anything is laid out (E137).
const deskChapter = deskPanel && deskSurface === READING_SURFACES[0].kind;
---

<!doctype html>
<html lang="en" data-content-version={contentVersion()} data-content-updated={contentUpdated()}>
  <head>
    <meta charset="utf-8" />
    {/* Apply the saved reader font before first paint to avoid a flash of the default font.
         Absence of 'lit-font' = default fonts: no attribute, no accessibility font downloaded.
         The legacy boolean 'dyslexic-font' key is still read as a fallback so readers who
         turned OpenDyslexic on before the three-way control shipped aren't reset. */}
    <script is:inline>try{var f=localStorage.getItem('lit-font')||(localStorage.getItem('dyslexic-font')==='1'?'dyslexic':'');if(f==='dyslexic'||f==='atkinson')document.documentElement.setAttribute('data-font',f)}catch(_){}</script>
    {/* Apply the saved theme (light/dark) before first paint to avoid a flash of the wrong scheme.
         Absence of 'lit-theme' = system: no attribute, CSS follows prefers-color-scheme. */}
    <script is:inline>try{var t=localStorage.getItem('lit-theme');if(t==='light'||t==='dark'){document.documentElement.setAttribute('data-theme',t);document.documentElement.style.colorScheme=t;}}catch(_){}</script>
    {/* Apply the saved text size, line spacing, Justify, and whether verse numbers,
         footnote letters, and key terms show before first paint, so nothing reflows
         after load. Each key's absence is the default (Medium, Normal, Justify off,
         shown); lit-justify is stored only when on. The three Read View keys
         that came before the shared Display tray (lit_rm_fontSize, lit_rm_lineHeight,
         lit_rm_markers) are still read as fallbacks; the tray deletes each one when
         its setting changes, so it can't resurrect an older choice.
         Verse numbers had one setting per view until Read View retired into the
         chapter's page, which reads on through the book (Featherboa, Phase 4). The
         page reads lit-verse-numbers, which is stored only when off, then Read
         View's own (lit-read-numbers, then lit_rm_markers), so a reader who hid
         them for reading a whole book keeps that until the switch is next set. */}
    <script is:inline>try{var s=localStorage,d=document.documentElement,z=s.getItem('lit-size')||s.getItem('lit_rm_fontSize'),l=s.getItem('lit-leading')||s.getItem('lit_rm_lineHeight'),n=s.getItem('lit-verse-numbers')||s.getItem('lit-read-numbers')||s.getItem('lit_rm_markers'),r=s.getItem('lit-fn-letters'),k=s.getItem('lit-terms'),j=s.getItem('lit-justify');if(z==='sm'||z==='lg'||z==='xl')d.setAttribute('data-size',z);if(l==='roomy')d.setAttribute('data-leading',l);if(n==='off')d.setAttribute('data-vn',n);if(r==='off')d.setAttribute('data-fn',r);if(k==='off')d.setAttribute('data-terms',k);if(j==='on')d.setAttribute('data-justify',j)}catch(_){}</script>
    {/* The Study Desk preview (STUDY-DESK.md, phase 1b). ?desk=on or ?desk=off sets or
         clears lit-desk-preview in this browser (off clears lit-desk-panel too) and is
         taken out of the address, so a copied link never carries it. With the flag on, and on a computer (the test in
         src/lib/app-platform.mjs, repeated here since this script can't import),
         data-desk="on" turns the desk on: desk-gate.js loads it, and global.css shows
         the Notebook button and narrows the reading measure to 52. The rest is the
         Notebook panel's, so it is stamped only on a page that has the panel
         (deskPanel, from the page's deskSurface: Chapter View and Read View while
         PROSE_NOTES in desk-frame.js is off; E124). There, unless the reader
         closed the notebook (lit-desk-panel "closed"; it starts open and minimized,
         BVJ 2026-10-13) or chose on /settings that pages open with it closed
         (lit-desk-start; src/lib/desk-start.mjs is the rule),
         data-desk-panel="open" goes on too, and with it data-desk-expanded: the open
         notebook, minimized or expanded, narrows Chapter View chapters to 48 and applies
         the dragged widths (Featherboa's Phase 5, BS-15: opening and closing the panel
         moves no scripture; until then only the expanded one did, BVJ 2026-10-14), so
         stamped here a page opening with it never reflows. margin.js keeps
         data-desk-expanded in step from then on. The widths
         a reader dragged this visit (sessionStorage lit-desk-measure and lit-desk-width;
         src/scripts/desk/widths.js) go on with it as data-desk-widths, --desk-measure and
         --desk-width, so a Chapter View chapter opens with them and doesn't jump, but only
         where the window holds them: the script repeats src/lib/desk-margin.mjs's
         firstPaint (handed its numbers as deskFit), which works out the column's width
         from the reader's font and text size. Widths kept in a wider window are given way
         as widths.js gives them, or left off (BA30), and a measure kept in another face is
         held to this face's range, 45 to 75 of its characters (FIRST_PAINT.range), as
         widths.js holds it. (Too narrow for the margin, the notebook floats and folds by
         itself; that once reflowed every chapter, BA25, as it was stamped expanded and
         then folded to 52. The open notebook now keeps the 48 folded too.) The
         window's width is the width less the scrollbar, measured on
         a throwaway element: the page reserves a scrollbar's room (scrollbar-gutter, in
         the critical CSS), which the window doesn't show yet this early, and reading it
         without left a 16px band where the guess was wrong. The panel itself sits in the
         margin, so nothing else needs reserving for it here.
         On a Chapter View chapter (deskChapter) the column's place goes on as well (E137).
         Where the margin is too narrow for the notebook, the first placement moves
         the column left (placeInMargin), and until the desk's code arrived the chapter
         painted centered and then moved, on every page turn. firstPaint works that move out
         from the same numbers, and it is stamped as --desk-move, a whole translate
         ("-104px 0") that global.css puts on the column; margin.js takes it over as its own
         when its rail is made. --desk-bar-center, the column's center, goes on with it, and
         with the dragged widths, which leave the column off center too. Nothing is stamped
         where the column stays centered, or on Read View, whose column this script doesn't
         know.
         Accounts (the plan's step 4h) are closed for everyone until one browser opens them
         with ?account=preview (lit-desk-account). The parameter is read here, on every
         page, as ?desk= is: ?account=preview or ?account=local stores the choice,
         ?account=off clears it, and it is taken out of the address (once, with ?desk=
         where both are there). It was read only on the account pages at first, so on
         any other page it stayed in the address and opened nothing (BVJ, 2026-11-25).
         src/scripts/account-gate.js reads the stored choice on the account pages, and
         test/desk-prepaint.test.js holds the two to the same key and values.
         Where accounts are open, data-account="open" goes on, on every device: the header's
         way in is then in the row from first paint (global.css shows it only beside
         data-desk), and /delete-account/ shows its box. It retires at launch with the switch.
         With it goes data-account-last="in" where this browser's header showed the account
         button last (lit-desk-account-last, a note desk/account/header-entry.js keeps): the
         button is narrower than "Sign in," so the row holds the right room from first paint
         and nothing in it moves when the entry is drawn (E231). That one stays at launch. */}
    <script is:inline define:vars={{ appUa: APP_PLATFORM_UA.source, appUaFlags: APP_PLATFORM_UA.flags, deskFit, deskPanel, deskChapter }}>try{var d=document.documentElement,s=localStorage,u=new URL(location.href),q=u.searchParams.get('desk'),y=u.searchParams.get('account'),o=0,n=navigator,a=n.userAgent||'',t=n.maxTouchPoints>1;if(q==='on'||q==='off'){if(q==='on')s.setItem('lit-desk-preview','on');else{s.removeItem('lit-desk-preview');s.removeItem('lit-desk-panel')}u.searchParams.delete('desk');o=1}if(y==='preview'||y==='local'||y==='off'){if(y==='off')s.removeItem('lit-desk-account');else s.setItem('lit-desk-account',y);u.searchParams.delete('account');o=1}if(o)history.replaceState(history.state,'',u.pathname+u.search+u.hash);var c=s.getItem('lit-desk-account');if(c==='preview'||c==='local'){d.setAttribute('data-account','open');if(s.getItem('lit-desk-account-last')==='in')d.setAttribute('data-account-last','in')}if(s.getItem('lit-desk-preview')==='on'&&!(new RegExp(appUa,appUaFlags).test(a)||(n.userAgentData&&n.userAgentData.mobile===true)||(t&&(/Macintosh/.test(a)||(/Linux/.test(a)&&!/CrOS/.test(a)))))){d.setAttribute('data-desk','on');if(deskPanel){var b=s.getItem('lit-desk-start');if(b==='closed'?false:b==='min'||b==='open'||s.getItem('lit-desk-panel')!=='closed'){d.setAttribute('data-desk-panel','open');var f=deskFit,w=sessionStorage,m=parseFloat(w.getItem('lit-desk-measure')),x=parseFloat(w.getItem('lit-desk-width')),e=document.createElement('div'),v,M=f.range[d.getAttribute('data-font')]||f.range[''],k=(f.ch[d.getAttribute('data-font')]||f.ch[''])*(f.scale[d.getAttribute('data-size')]||1)*f.body*parseFloat(getComputedStyle(d).fontSize),r,h=1,g;e.style.cssText='position:absolute;visibility:hidden;width:99px;height:9px;overflow:scroll';d.appendChild(e);v=innerWidth-(e.offsetWidth-e.clientWidth);d.removeChild(e);r=v-f.edge-f.gap-f.keepLeft;if(isFinite(m)&&isFinite(x)&&x>=f.minWidth){m=Math.min(M.max,Math.max(M.min,m));h=m*k+f.pad+x-r;if(h>0){g=Math.min(h,x-f.minWidth);x-=g;h-=g}if(h>0){g=Math.min(h,(m-M.min)*k);m-=g/k;h-=g}}if(h<=.5){m=Math.round(m*10)/10;x=Math.round(x);d.setAttribute('data-desk-expanded','');d.setAttribute('data-desk-widths','');d.style.setProperty('--desk-measure',String(m));d.style.setProperty('--desk-width',x+'px');if(deskChapter)d.style.setProperty('--desk-bar-center',v-f.edge-x-f.gap-(m*k+f.pad)/2+'px')}else{d.setAttribute('data-desk-expanded','');if(r-f.measure*k-f.pad>=f.minWidth){h=Math.round(Math.max(0,f.minWidth+f.edge+f.gap+(f.measure*k+f.pad-v)/2));if(deskChapter&&h){d.style.setProperty('--desk-move',-h+'px 0');d.style.setProperty('--desk-bar-center',v/2-h+'px')}}}}}}}catch(_){}</script>
    <title>{title}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content={robotsNoindex ? "noindex,follow" : "index,follow"} />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}

    {/* Apple Smart App Banner (iOS Safari). Unlike a plain link, this flips its
        button from GET to OPEN when the app is installed and hands it the page.
        app-argument is this page's canonical URL, so OPEN lands on the passage.
        Fragments (#v3) aren't known at render time, so it resolves at chapter
        level; verse precision comes from Universal Links (apple-app-site-association). */}
    {canonicalUrl && (
      <meta name="apple-itunes-app" content={`app-id=6772577879, app-argument=${canonicalUrl}`} />
    )}

    {/* Open Graph */}
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:site_name" content="LIT Bible" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImageUrl} />
    {/* Dimensions are only known for the default logo; pages passing their
        own ogImage omit them rather than misreport. */}
    {!ogImage && <meta property="og:image:width" content="1000" />}
    {!ogImage && <meta property="og:image:height" content="1000" />}

    {/* Twitter Card */}
    <meta name="twitter:card" content={twitterCard} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    {/* Critical inline reset: applies before the external stylesheet is fetched,
         preventing the browser's 8px default body margin from causing CLS.
         Colors are bg-specific so no flash occurs on green or dark-mode pages. */}
    <Fragment set:html={`<style>${criticalCSS}</style>`} />

    {/* Font preloads: start fetching before CSS is parsed. Source Sans 3 draws
         every page's text and Fraunces every page's title, each one variable
         file for all its weights (faces.css). */}
    <link rel="preload" href={sourceSansLatinUrl} as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href={frauncesLatinUrl} as="font" type="font/woff2" crossorigin="anonymous" />

    {/* Favicons & manifest */}
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#209D50" />
    <meta name="theme-color" content="#0F6B33" media="(prefers-color-scheme: dark)" />
    <meta name="color-scheme" content="light dark" />

{/* Articles RSS feed */}
    <link
      rel="alternate"
      type="application/rss+xml"
      title="LIT Bible Articles"
      href="/rss.xml"
    />

    {/* Translation updates RSS feed (the release notes) */}
    <link
      rel="alternate"
      type="application/rss+xml"
      title="LIT Translation Updates"
      href="/translation-updates.xml"
    />

    {/* Found in Translation podcast (RedCircle) */}
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Found in Translation Podcast"
      href="https://feeds.redcircle.com/59ffbfb2-f814-469a-8522-416bb67c15f6"
    />

<slot name="head" />
  </head>

  <body class={`bg-${bg}`} data-pagefind-ignore={pagefindIndex ? undefined : true}>
    <a href="#main-content" class="skip-link">Skip to content</a>
    <AppInstallBanner />
    <SiteHeader class={headerClass} scriptureControls={scriptureControls} search={search} deskTitle={deskTitle} picker={picker} deskHref={deskHref} />
    {/* A page puts its one or two main commands at the line's right with
        slot="place-line" (none does yet). A chapter or an introduction gets
        the place line instead (readingLine). */}
    {readingLine && !deskTitle ? (
      <PlaceLine where={where} reading={readingLine} />
    ) : where.line && !deskTitle && (
      Astro.slots.has("place-line") ? (
        <PlaceLine where={where}><slot name="place-line" slot="commands" /></PlaceLine>
      ) : (
        <PlaceLine where={where} />
      )
    )}
    {/* The passage picker's panel and sheet (FP-01 to FP-16): closed until
        a way in opens it, and kept in a <template> till then, so a page that
        never opens it carries none of its thousand-odd elements (a dialog
        never opens without JavaScript anyway). passage-picker.js puts it in
        place the first time; /read's own picker is the page. */}
    {!deskTitle && !pickerInPage && (
      <dialog class="picker-dialog" id="passagePicker" aria-label="Choose passage" data-picker-dialog data-pagefind-ignore>
        <template data-picker-template>
          <PassagePicker book={readingLine?.book} chapter={readingLine?.chapter} />
        </template>
      </dialog>
    )}
    {!deskTitle && (
      <script>
        import "../scripts/passage-picker.js";
      </script>
    )}

    <main id="main-content" data-pagefind-body={pagefindIndex ? true : undefined}>
      <slot />
    </main>

    <SiteFooter hideNewsletter={hideFooterNewsletter} />
    <AppsLaunchPopover />
  </body>
</html>
