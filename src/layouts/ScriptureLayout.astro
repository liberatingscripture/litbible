---
// ScriptureLayout.astro
import "../styles/scripture-tools.css";

import Layout from "./Layout.astro";
import ReadMenu from "../components/ReadMenu.astro";
import SearchBar from "../components/SearchBar.astro";
import ScriptureHeader from "../components/ScriptureHeader.astro";

const {
  title = "Liberation and Inclusion Translation",
  description = "A trauma-informed, justice-oriented translation of the Bible from the original languages.",
  canonical,
  bg = "cream",

  /**
   * Pagefind + scripture metadata
   * book: MUST match your ReadMenu slug keys (e.g., "luke", "1peter", "hebrews")
   * chapter: "intro" or a chapter number (e.g., "1")
   * type: "scripture" | "intro" | "search" | ...
   */
  book,
  chapter,
  type = "scripture",

  /**
   * scripture topics/tags (array or string)
   * These are indexed as Pagefind meta "topics"
   */
  topics,

  /**
   * Layout toggles
   */
  showToolsReadMenu = true,
  showToolsSearch = true,

  /**
   * Controls the robots meta (noindex/index) via Layout, and — for intro
   * pages — whether this page emits its own Pagefind meta/body indexing.
   * (Defaults to false for search pages, true otherwise)
   */
  robotsIndex: robotsIndexProp,

  /**
   * Social share image (absolute URL) + matching Twitter card type,
   * forwarded to Layout. Chapter/intro pages pass their generated
   * /og/<slug>.png card here.
   */
  ogImage,
  twitterCard,
} = Astro.props;

const pagefindBook = book ?? "";
const pagefindChapter = chapter ?? "";
const pagefindType = type ?? "scripture";

/**
 * Normalize topics into an array of exact tag strings.
 * Keep multi-word tags intact. No joining. No slugging.
 */
const topicsList: string[] = Array.isArray(topics)
  ? topics
      .map((t) =>
        String(t)
          .replace(/\u00A0/g, " ")
          .trim(),
      )
      .filter(Boolean)
  : typeof topics === "string"
    ? [topics.replace(/\u00A0/g, " ").trim()].filter(Boolean)
    : [];

const shouldIndex =
  typeof robotsIndexProp === "boolean" ? robotsIndexProp : pagefindType !== "search";

// Scripture CHAPTER pages are intentionally NOT Pagefind-indexed: their
// keyword search runs against the verse index (public/search/verses.json —
// see searchVerses in search-core.js) and their topics come from
// public/topics-index.json. Pagefind indexes intros (their prose — hits
// display under the "Book introductions" search group) and, elsewhere,
// glossary/articles. `shouldIndex` stays in charge of robots noindex.
const pagefindIndexable = shouldIndex && pagefindType !== "scripture";

const isSearchPage = pagefindType === "search";
const isScriptureLike =
  pagefindType === "scripture" || pagefindType === "intro";

/**
 * Default header props (only used if caller doesn't provide a pageHeader slot)
 */
const headerKind: "intro" | "chapter" =
  pagefindType === "intro" || String(pagefindChapter) === "intro"
    ? "intro"
    : "chapter";

let headerChapter: number | undefined = undefined;
if (headerKind === "chapter") {
  const n = Number.parseInt(String(pagefindChapter || "1"), 10);
  headerChapter = Number.isFinite(n) ? n : 1;
}
---

<Layout title={title} description={description} canonical={canonical} bg={bg} robotsNoindex={!shouldIndex} ogImage={ogImage} twitterCard={twitterCard}>
  <slot slot="head" name="head" />

  <div class={`scripture-layout scripture-layout--${pagefindType}`}>
    {
      (showToolsReadMenu || showToolsSearch) && (
        <section
          class="scripture-tools"
          data-pagefind-ignore
          aria-label="Scripture tools"
        >
          <div class="scripture-tools__inner">
            <div class="scripture-tools__left" aria-label="Jump to passage">
              {showToolsReadMenu ? <ReadMenu currentBook={pagefindBook} currentChapter={String(pagefindChapter)} /> : null}
            </div>

            <div class="scripture-tools__center" aria-label="Search the LIT">
              {showToolsSearch ? (
                <SearchBar />
              ) : null}
            </div>

            <div class="scripture-tools__right" aria-label="Reading View">
              {pagefindType === "scripture" && headerKind === "chapter" ? (
                <div class="reading-view-right" data-pagefind-ignore>
                  <a
                    class="reading-view-pill"
                    href={`/read/${pagefindBook}/#ch-${headerChapter ?? 1}`}
                    aria-label={`Switch to Reading View for ${pagefindBook} ${headerChapter ?? 1}`}
                  >
                    <span class="reading-view-pill__icon" aria-hidden="true">
                      <svg viewBox="0 0 24 24" width="1em" height="1em" fill="none"
                           stroke="currentColor" stroke-width="2" stroke-linecap="round"
                           stroke-linejoin="round" aria-hidden="true" focusable="false">
                        <path d="M8 21h12a2 2 0 0 0 2-2v-2H10v2a2 2 0 1 1-4 0V5a2 2 0 1 0-4 0v3h4"/>
                        <path d="M19 17V5a2 2 0 0 0-2-2H4"/>
                      </svg>
                    </span>
                    <span>Switch to Reading View</span>
                  </a>
                </div>
              ) : null}
            </div>
          </div>
        </section>
      )
    }

    {
      /* On /search we want the panel visible + in-flow (not dropdown).
         This runs after hydration and simply removes the "hidden" state. */
      isSearchPage && showToolsSearch ? (
        <script is:inline>
          {`
            (() => {
              const root = document.querySelector("[data-search-root]");
              if (!root) return;
              root.classList.add("is-open");
              const panel = root.querySelector("[data-search-panel]");
              if (panel) panel.hidden = false;
            })();
          `}
        </script>
      ) : null
    }

    <div
      class="scripture-main"
      aria-labelledby={isScriptureLike ? "chapter-title" : undefined}
      data-pagefind-body={pagefindIndexable ? true : undefined}
      data-pagefind-ignore={pagefindIndexable ? undefined : true}
      data-type={pagefindIndexable ? pagefindType : undefined}
      data-book={pagefindIndexable ? pagefindBook : undefined}
      data-chapter={pagefindIndexable ? pagefindChapter : undefined}
      data-pagefind-filter={pagefindIndexable
        ? "type[data-type], book[data-book], chapter[data-chapter]"
        : undefined}
    >
      {
        /* =========================================================
         Pagefind meta fields (TEXT-based, not <meta content="...">)
         NOTE: These MUST be ignored for body indexing.
         ========================================================= */
      }
      {
        pagefindIndexable ? (
          <>
            {/* Avoid duplicate title meta on scripture/intro pages.
                ScriptureHeader's <h1> already carries data-pagefind-meta="title". */}
            {!isScriptureLike ? (
              <span
                class="pf-meta"
                data-pagefind-meta="title"
                data-pagefind-ignore
              >
                {title}
              </span>
            ) : null}

            <span
              class="pf-meta"
              data-pagefind-meta="description"
              data-pagefind-ignore
            >
              {description}
            </span>
            <span
              class="pf-meta"
              data-pagefind-meta="type"
              data-pagefind-ignore
            >
              {pagefindType}
            </span>
            <span
              class="pf-meta"
              data-pagefind-meta="book"
              data-pagefind-ignore
            >
              {pagefindBook}
            </span>
            <span
              class="pf-meta"
              data-pagefind-meta="chapter"
              data-pagefind-ignore
            >
              {String(pagefindChapter)}
            </span>

            {topicsList.length
              ? topicsList.map((t) => (
                  <span
                    class="pf-meta"
                    data-pagefind-meta="topics"
                    data-pagefind-ignore
                  >
                    {t}
                  </span>
                ))
              : null}
          </>
        ) : null
      }

      {
        /* Default header (unless the page provides its own pageHeader slot)
         Wrapped in data-pagefind-ignore so the h1 text (e.g. "Mark 1") is NOT
         indexed as body content — it only contributes via data-pagefind-meta="title"
         on the <h1> inside ScriptureHeader. Without this, searching "Mark" returns
         every chapter in Mark as a keyword hit. */
      }
      <div data-pagefind-ignore>
        <slot name="pageHeader">
          {
            isScriptureLike ? (
              <ScriptureHeader
                kind={headerKind}
                bookKey={pagefindBook}
                chapter={headerChapter}
              />
            ) : null
          }
        </slot>
      </div>

      <slot />
    </div>

    <section
      class="scripture-disclaimer"
      aria-label="Source text and licensing notice"
      data-pagefind-ignore
    >
      <div class="scripture-disclaimer__inner">
        <p>
          The Liberation &amp; Inclusion Translation (LIT) is an original
          English translation prepared from{" "}
          <em>The Greek New Testament: SBL Edition</em> (ed. Michael W. Holmes; ©
          2010 Society of Biblical Literature &amp; Logos Bible Software).
        </p>
        <p>
          The SBLGNT is licensed under the Creative Commons Attribution 4.0,
          International Licence (CC BY 4.0):{" "}
          <a
            href="https://creativecommons.org/licenses/by/4.0/"
            rel="noopener noreferrer"
            target="_blank"
          >
            https://creativecommons.org/licenses/by/4.0/</a
          >. This translation constitutes an adaptation of that Greek text. Used
          with permission.
        </p>
        <p>
          Greek quotations are presented in transliterated form; accentuation
          and punctuation follow LIT house style, mostly removed for
          accessibility to readers without prior knowledge of Greek.
        </p>
        <p>
          Portions of the SBL Greek text quoted here remain available under CC
          BY 4.0; the NC-ND restrictions apply only to the original English
          translation and other LIT-specific content.
        </p>
        <p>
          The Society of Biblical Literature and Logos Bible Software do not
          endorse the LIT Bible.
        </p>
      </div>
    </section>

    <style>
      .scripture-main {
        margin: 0 auto;
        max-width: var(--content-width, 72ch);
        padding: 12px 16px 64px;
      }

      /* Hidden-but-indexed metadata for Pagefind */
      .pf-meta {
        position: absolute;
        left: -9999px;
        width: 1px;
        height: 1px;
        overflow: hidden;
        white-space: nowrap;
      }

      @media (min-width: 641px) {
        :global(.scripture-tools__right) {
          justify-self: end;
        }
      }

      /* Reading View pill: right column, on the shared toolbar row */
      .reading-view-right {
        display: flex;
        justify-content: flex-end;
      }

      /* Mirror the ReadMenu picker's trigger so the two ends of the tools bar
         read as one design family. --green-text flips to a LIGHT green in dark
         mode (it's a text token), so where we use it as the hover fill it needs
         a paired foreground that flips to dark ink. */
      .reading-view-pill {
        --rvp-accent-fg: #ffffff;

        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;

        /* Pinned to the same floor as the ReadMenu picker trigger so the
           toolbar's two ends are the same size. Keep in sync with ReadMenu. */
        min-width: 245px;
        padding: 10px 18px;
        border-radius: 999px;

        background: var(--surface-input);
        border: 1px solid rgba(var(--ink-rgb), 0.11);

        color: var(--text);
        text-decoration: none;
        user-select: none;

        font-weight: 500;
        font-size: 16px;
        line-height: 1;

        box-shadow: 0 2px 7px rgba(0, 0, 0, 0.08);
        transition:
          background-color 0.2s ease,
          color 0.2s ease;
      }

      @media (prefers-color-scheme: dark) {
        :global(:root:not([data-theme="light"])) .reading-view-pill {
          --rvp-accent-fg: #1d231c;
        }
      }

      :global(:root[data-theme="dark"]) .reading-view-pill {
        --rvp-accent-fg: #1d231c;
      }

      .reading-view-pill__icon {
        display: inline-flex;
        align-items: center;
        color: var(--green-text);
        font-size: 17px;
        line-height: 1;
      }

      .reading-view-pill:hover {
        background: var(--green-text);
        color: var(--rvp-accent-fg);
      }

      .reading-view-pill:hover .reading-view-pill__icon {
        color: var(--rvp-accent-fg);
      }

      .reading-view-pill:focus-visible {
        outline: 2px solid var(--green-text);
        outline-offset: 1px;
      }

      /* Mobile-only breathing room BETWEEN the two tool columns.
     (We do NOT style SearchBar internals here.) */
      @media (max-width: 640px) {
        :global(.scripture-tools__inner) {
          gap: 18px;
        }

        :global(.scripture-tools__center) {
          margin-top: 8px;
        }

        .reading-view-right {
          margin-top: 0.75rem;
          justify-content: center;
        }
      }

      .scripture-disclaimer {
        background: var(--surface-raised);
        padding: 30px 16px 56px;
      }

      .scripture-disclaimer__inner {
        margin: 0 auto;

        /* match the footer/tools “wide” container */
        width: min(1100px, calc(100% - 32px));
        max-width: none;

        font-size: 0.95rem;
        line-height: 1.65;
        color: rgba(var(--ink-rgb), 0.85);
      }

      .scripture-disclaimer__inner p {
        margin: 0 0 14px;
      }

      .scripture-disclaimer__inner a {
        word-break: break-word;
      }
    </style>
  </div>
</Layout>
