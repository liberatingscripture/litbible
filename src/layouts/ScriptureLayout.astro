---
// ScriptureLayout.astro
import "../styles/scripture-tools.css";

import Layout from "./Layout.astro";
import ReadMenu from "../components/ReadMenu.astro";
import SearchBar from "../components/SearchBar.astro";
import ScriptureHeader from "../components/ScriptureHeader.astro";
import PrintCredit from "../components/PrintCredit.astro";
import SblgntNotice from "../components/SblgntNotice.astro";
import { bookKeyToLabel } from "../data/books.js";

const {
  title = "Liberation and Inclusion Translation",
  description = "A trauma-informed, justice-oriented translation of the Bible from the original languages.",
  canonical,
  bg = "cream",

  /**
   * Pagefind + scripture metadata
   * book: MUST match your ReadMenu slug keys (e.g., "luke", "1peter", "hebrews")
   * chapter: "intro" or a chapter number (e.g., "1")
   * type: "scripture" | "intro" | "search" | ...
   */
  book,
  chapter,
  type = "scripture",

  /**
   * scripture topics/tags (array or string)
   * These are indexed as Pagefind meta "topics"
   */
  topics,

  /**
   * Layout toggles
   */
  showToolsReadMenu = true,
  showToolsSearch = true,

  /**
   * Controls the robots meta (noindex/index) via Layout, and — for intro
   * pages — whether this page emits its own Pagefind meta/body indexing.
   * (Defaults to false for search pages, true otherwise)
   */
  robotsIndex: robotsIndexProp,

  /**
   * Social share image (absolute URL) + matching Twitter card type,
   * forwarded to Layout. Chapter/intro pages pass their generated
   * /og/<slug>.png card here.
   */
  ogImage,
  twitterCard,

  /**
   * The Display tray's verse-number / footnote-letter settings, forwarded to
   * Layout. Chapter pages with text pass "study"; intros and drafts pass
   * nothing, since they have neither.
   */
  scriptureControls,

  /**
   * A published chapter with text: the Read aloud icon beside the title
   * (audit X9).
   */
  readAloud = false,
} = Astro.props;

const pagefindBook = book ?? "";
// The address a printed page carries (PrintCredit); Layout derives its
// canonical link the same way.
const pageUrl: string =
  canonical ?? (Astro.site ? new URL(Astro.url.pathname, Astro.site).href : "");
const pagefindChapter = chapter ?? "";
const pagefindType = type ?? "scripture";

/**
 * Normalize topics into an array of exact tag strings.
 * Keep multi-word tags intact. No slugging. (The Pagefind meta below joins
 * them into one comma-separated value.)
 */
const topicsList: string[] = Array.isArray(topics)
  ? topics
      .map((t) =>
        String(t)
          .replace(/\u00A0/g, " ")
          .trim(),
      )
      .filter(Boolean)
  : typeof topics === "string"
    ? [topics.replace(/\u00A0/g, " ").trim()].filter(Boolean)
    : [];

const shouldIndex =
  typeof robotsIndexProp === "boolean" ? robotsIndexProp : pagefindType !== "search";

// Scripture CHAPTER pages are intentionally NOT Pagefind-indexed: their
// keyword search runs against the verse index (public/search/verses.json —
// see searchVerses in search-core.js) and their topics come from
// public/topics-index.json. Pagefind indexes intros (their prose — hits
// display under the "Book introductions" search group) and, elsewhere,
// glossary/articles. `shouldIndex` stays in charge of robots noindex.
const pagefindIndexable = shouldIndex && pagefindType !== "scripture";

const isSearchPage = pagefindType === "search";
const isScriptureLike =
  pagefindType === "scripture" || pagefindType === "intro";

/**
 * Default header props (only used if caller doesn't provide a pageHeader slot)
 */
const headerKind: "intro" | "chapter" =
  pagefindType === "intro" || String(pagefindChapter) === "intro"
    ? "intro"
    : "chapter";

let headerChapter: number | undefined = undefined;
if (headerKind === "chapter") {
  const n = Number.parseInt(String(pagefindChapter || "1"), 10);
  headerChapter = Number.isFinite(n) ? n : 1;
}
---

<Layout title={title} description={description} canonical={canonical} bg={bg} robotsNoindex={!shouldIndex} ogImage={ogImage} twitterCard={twitterCard} scriptureControls={scriptureControls} pageSearch={showToolsSearch}>
  <slot slot="head" name="head" />

  {/* Fetch the previous or next chapter as soon as a reader shows intent
      (hover, or pointer-down on touch), so the page is already here when the
      click lands. Prefetch, never prerender: a prerendered page runs its
      scripts, which would count a pageview toward the app popover's lit_pv
      gate, could arm the popover itself, and might log an analytics visit
      for a chapter nobody opened. Browsers without speculation rules ignore
      this. */}
  <script is:inline type="speculationrules" slot="head">
    {
      "prefetch": [
        {
          "where": {
            "selector_matches": [
              ".chapter-nav a.nav-button",
              ".chapter-ctas a.chapter-cta"
            ]
          },
          "eagerness": "moderate"
        }
      ]
    }
  </script>

  <div class={`scripture-layout scripture-layout--${pagefindType}`}>
    {
      (showToolsReadMenu || showToolsSearch) && (
        <section
          class="scripture-tools"
          data-pagefind-ignore
          aria-label="Scripture tools"
        >
          <div class="scripture-tools__inner">
            <div class="scripture-tools__left" aria-label="Jump to passage">
              {showToolsReadMenu ? <ReadMenu currentBook={pagefindBook} currentChapter={String(pagefindChapter)} /> : null}
            </div>

            <div class="scripture-tools__center" aria-label="Search the LIT">
              {/* Phones, with JS: search starts as this button and opens in
                  place of the row (see the script after this section). */}
              {showToolsSearch ? (
                <button type="button" class="tools-search-toggle" aria-label="Search" aria-expanded="false" hidden>
                  <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor"
                       stroke-width="2" stroke-linecap="round" aria-hidden="true" focusable="false">
                    <circle cx="10.5" cy="10.5" r="6.5" />
                    <path d="M15.5 15.5 21 21" />
                  </svg>
                </button>
              ) : null}
              {showToolsSearch ? (
                <SearchBar />
              ) : null}
              {showToolsSearch ? (
                <button type="button" class="tools-search-close" aria-label="Close search" hidden>×</button>
              ) : null}
            </div>

            <div class="scripture-tools__right" aria-label="Reading View">
              {pagefindType === "scripture" && headerKind === "chapter" ? (
                <div class="reading-view-right" data-pagefind-ignore>
                  <a
                    class="reading-view-pill"
                    href={`/read/${pagefindBook}/#ch-${headerChapter ?? 1}`}
                    aria-label={`Switch to Reading View for ${bookKeyToLabel(pagefindBook)} ${headerChapter ?? 1}`}
                  >
                    <span class="reading-view-pill__icon" aria-hidden="true">
                      <svg viewBox="0 0 24 24" width="1em" height="1em" fill="none"
                           stroke="currentColor" stroke-width="2" stroke-linecap="round"
                           stroke-linejoin="round" aria-hidden="true" focusable="false">
                        <path d="M8 21h12a2 2 0 0 0 2-2v-2H10v2a2 2 0 1 1-4 0V5a2 2 0 1 0-4 0v3h4"/>
                        <path d="M19 17V5a2 2 0 0 0-2-2H4"/>
                      </svg>
                    </span>
                    <span class="rvp-full">Switch to Reading View</span>
                    <span class="rvp-short">Reading View</span>
                  </a>
                </div>
              ) : null}
            </div>
          </div>
        </section>
      )
    }

    {/* The compact phone toolbar (audit F3). Runs while the page is still
        parsing, right after the toolbar, so the one-row layout is in place
        before first paint and nothing shifts. Without JS phones keep the
        stacked toolbar, whose search field works on its own. */}
    {isScriptureLike && (showToolsReadMenu || showToolsSearch) && (
      <script is:inline>
          (() => {
            const tools = document.querySelector(".scripture-layout .scripture-tools");
            if (!tools) return;
            tools.setAttribute("data-compact", "");
            const toggle = tools.querySelector(".tools-search-toggle");
            const close = tools.querySelector(".tools-search-close");
            if (!toggle || !close) return;
            toggle.hidden = false;
            close.hidden = false;
            const input = tools.querySelector(".searchbar__input");
            const open = () => {
              tools.setAttribute("data-search-open", "");
              toggle.setAttribute("aria-expanded", "true");
              input && input.focus();
            };
            const shut = () => {
              if (!tools.hasAttribute("data-search-open")) return;
              tools.removeAttribute("data-search-open");
              toggle.setAttribute("aria-expanded", "false");
              const bar = tools.querySelector("[data-searchbar]");
              if (bar) bar.dataset.open = "false";
              toggle.focus();
            };
            toggle.addEventListener("click", open);
            close.addEventListener("click", shut);
            tools.addEventListener("keydown", (e) => {
              if (e.key === "Escape") shut();
            });
          })();
      </script>
    )}


    <div
      class="scripture-main"
      aria-labelledby={isScriptureLike ? "chapter-title" : undefined}
      data-pagefind-body={pagefindIndexable ? true : undefined}
      data-pagefind-ignore={pagefindIndexable ? undefined : true}
      data-type={pagefindIndexable ? pagefindType : undefined}
      data-book={pagefindIndexable ? pagefindBook : undefined}
      data-chapter={pagefindIndexable ? pagefindChapter : undefined}
      data-pagefind-filter={pagefindIndexable
        ? "type[data-type], book[data-book], chapter[data-chapter]"
        : undefined}
    >
      {
        /* =========================================================
         Pagefind meta fields (TEXT-based, not <meta content="...">)
         NOTE: These MUST be ignored for body indexing.
         They are index-only, not screen-reader text, so each one is
         aria-hidden too: Pagefind reads the HTML, not the accessibility
         tree, and without it a screen reader heard the type,
         book and topics ahead of the chapter heading.
         ========================================================= */
      }
      {
        pagefindIndexable ? (
          <>
            {/* Avoid duplicate title meta on scripture/intro pages.
                ScriptureHeader's <h1> already carries data-pagefind-meta="title". */}
            {!isScriptureLike ? (
              <span
                class="pf-meta"
                aria-hidden="true"
                data-pagefind-meta="title"
                data-pagefind-ignore
              >
                {title}
              </span>
            ) : null}

            {/* No description meta. Pagefind searches metadata, nothing
                shows it, and every intro's description names "the
                Liberation and Inclusion Translation (LIT)", which made all 27
                intros a hit for "liberation", "inclusion", "translation" and
                "lit". */}
            <span
              class="pf-meta"
              aria-hidden="true"
              data-pagefind-meta="type"
              data-pagefind-ignore
            >
              {pagefindType}
            </span>
            <span
              class="pf-meta"
              aria-hidden="true"
              data-pagefind-meta="book"
              data-pagefind-ignore
            >
              {pagefindBook}
            </span>
            <span
              class="pf-meta"
              aria-hidden="true"
              data-pagefind-meta="chapter"
              data-pagefind-ignore
            >
              {String(pagefindChapter)}
            </span>

            {/* One span, comma-separated (parseMetaList splits it). Pagefind
                keeps one value per key, so a span per topic kept only the
                last. */}
            {topicsList.length ? (
              <span
                class="pf-meta"
                aria-hidden="true"
                data-pagefind-meta="topics"
                data-pagefind-ignore
              >
                {topicsList.join(", ")}
              </span>
            ) : null}
          </>
        ) : null
      }

      {
        /* Default header (unless the page provides its own pageHeader slot)
         Wrapped in data-pagefind-ignore so the h1 text (e.g. "Mark 1") is NOT
         indexed as body content — it only contributes via data-pagefind-meta="title"
         on the <h1> inside ScriptureHeader. Without this, searching "Mark" returns
         every chapter in Mark as a keyword hit. */
      }
      <div data-pagefind-ignore>
        <slot name="pageHeader">
          {
            isScriptureLike ? (
              <ScriptureHeader
                kind={headerKind}
                bookKey={pagefindBook}
                chapter={headerChapter}
                readAloud={readAloud}
              />
            ) : null
          }
        </slot>
      </div>

      <slot />

      {isScriptureLike ? <PrintCredit url={pageUrl} /> : null}
    </div>

    <SblgntNotice />

    <style>
      /* The reader's text size (Display tray) is set here rather than on the
         paragraphs, so the column's em-based width grows with it and the
         line keeps its length in characters. The header and buttons inside
         are sized in px/rem and stay put. --reading-width is the text
         itself, so the side padding is added on top (border-box). */
      .scripture-main {
        margin: 0 auto;
        font-size: calc(1em * var(--reading-scale, 1));
        max-width: calc(var(--reading-width, 72ch) + 32px);
        padding: 12px 16px 64px;
      }

      /* Hidden-but-indexed metadata for Pagefind */
      .pf-meta {
        position: absolute;
        left: -9999px;
        width: 1px;
        height: 1px;
        overflow: hidden;
        white-space: nowrap;
      }

      @media (min-width: 641px) {
        :global(.scripture-tools__right) {
          justify-self: end;
        }
      }

      /* Reading View pill: right column, on the shared toolbar row */
      .reading-view-right {
        display: flex;
        justify-content: flex-end;
      }

      /* Mirror the ReadMenu picker's trigger so the two ends of the tools bar
         read as one design family. --green-text flips to a LIGHT green in dark
         mode (it's a text token), so where we use it as the hover fill it needs
         a paired foreground that flips to dark ink. */
      .reading-view-pill {
        --rvp-accent-fg: #ffffff;

        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;

        /* Pinned to the same floor as the ReadMenu picker trigger so the
           toolbar's two ends are the same size. Keep in sync with ReadMenu. */
        min-width: 245px;
        padding: 10px 18px;
        border-radius: 999px;

        background: var(--surface-input);
        border: 1px solid rgba(var(--ink-rgb), 0.11);

        color: var(--text);
        text-decoration: none;
        user-select: none;

        font-weight: 500;
        font-size: 16px;
        line-height: 1;

        box-shadow: 0 2px 7px rgba(0, 0, 0, 0.08);
        transition:
          background-color 0.2s ease,
          color 0.2s ease;
      }

      @media (prefers-color-scheme: dark) {
        :global(:root:not([data-theme="light"])) .reading-view-pill {
          --rvp-accent-fg: #1d231c;
        }
      }

      :global(:root[data-theme="dark"]) .reading-view-pill {
        --rvp-accent-fg: #1d231c;
      }

      .reading-view-pill__icon {
        display: inline-flex;
        align-items: center;
        color: var(--green-text);
        font-size: 17px;
        line-height: 1;
      }

      .reading-view-pill:hover {
        background: var(--green-text);
        color: var(--rvp-accent-fg);
      }

      .reading-view-pill:hover .reading-view-pill__icon {
        color: var(--rvp-accent-fg);
      }

      .reading-view-pill:focus-visible {
        outline: 2px solid var(--focus-ring);
        outline-offset: 1px;
      }

      /* Mobile-only breathing room BETWEEN the two tool columns.
     (We do NOT style SearchBar internals here.) */
      @media (max-width: 640px) {
        :global(.scripture-tools__inner) {
          gap: 18px;
        }

        :global(.scripture-tools__center) {
          margin-top: 8px;
        }

        .reading-view-right {
          margin-top: 0.75rem;
          justify-content: center;
        }
      }
    </style>
  </div>
</Layout>
