---
import Layout from "./Layout.astro";
import ReadMenu from "../components/ReadMenu.astro";
import SearchBar from "../components/SearchBar.astro";

type Props = {
  title: string;
  description?: string;
  bg?: "cream" | "white" | "ink";
  showTools?: boolean;

  /**
   * If false, keep this page OUT of Pagefind indexing.
   * Default: true for reading pages.
   */
  pagefindIndex?: boolean;
};

const {
  title,
  description = "",
  bg = "cream",
  showTools = true,
  pagefindIndex = true,
} = Astro.props as Props;
---

<Layout title={title} description={description} bg={bg} pagefindIndex={pagefindIndex}>
  <slot slot="head" name="head" />
  <div class="read-layout">
    <header class="read-layout__hero">
      <slot name="hero" />
    </header>

    {
      showTools && (
        <section class="read-layout__tools" aria-label="Reading tools">
          <div class="read-layout__menu">
            <ReadMenu />
          </div>

          <SearchBar placeholder="Search" fullSearchHref="/search" />
        </section>
      )
    }

    <section class="read-layout__content">
      <slot />
    </section>

    <slot name="bands" />
  </div>

</Layout>

<style>
  .read-layout {
    display: block;
  }

  .read-layout__hero {
    max-width: var(--content-width, 72ch);
    margin: 0 auto;
    padding: clamp(72px, 10vh, 108px) 16px 12px;
    text-align: center;
  }

  /* Tools: layout-only spacing (no SearchBar internals touched) */
  .read-layout__tools {
    max-width: var(--content-width, 72ch);
    margin: 0 auto;
    padding: 18px 16px 26px;

    display: grid;
    gap: 26px;
  }

  .read-layout__menu {
    display: flex;
    justify-content: center;
    min-width: 0;
  }

  @media (max-width: 640px) {
    .read-layout__tools {
      padding-top: 22px;
      padding-bottom: 30px;
      gap: 30px;
    }
  }

  .read-layout__content {
    max-width: var(--content-width, 72ch);
    margin: 0 auto;

    /* Keep horizontal gutters, but do NOT add bottom padding here.
       The page can include full-bleed sections that must sit flush to the footer. */
    padding: 0 16px;
  }
</style>