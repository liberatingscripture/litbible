---
// SearchLayout.astro
import "../styles/scripture-tools.css";

import Layout from "./Layout.astro";
import ReadMenu from "../components/ReadMenu.astro";
import SearchBar from "../components/SearchBar.astro";

const {
  title = "Liberation and Inclusion Translation",
  description = "A trauma-informed, justice-oriented translation of the Bible from the original languages.",
  canonical,
  bg = "cream",

  /**
   * Pagefind + scripture metadata
   * book: MUST match your ReadMenu slug keys (e.g., "luke", "1peter", "hebrews")
   * chapter: "intro" or a chapter number (e.g., "1")
   * type: "scripture" | "intro" | "search" | ...
   */
  book,
  chapter,
  type = "search",

  /**
   * Scripture topics/tags (array or string)
   * Emitted to Pagefind meta as "topics"
   */
  topics,

  /**
   * Layout toggles
   */
  showToolsReadMenu = true,
  showToolsSearch = true,

  /**
   * If false, keep this page OUT of Pagefind indexing
   * (Defaults to false for search pages, true otherwise)
   */
  pagefindIndex: pagefindIndexProp,
} = Astro.props;

const pagefindBook = book ?? "";
const pagefindChapter = chapter ?? "";
const pagefindType = type ?? "search";

/**
 * Normalize topics into a single string for Pagefind meta.
 * Prefer space-separated so your UI can split on /[,\s]+/
 */
const topicsString = Array.isArray(topics)
  ? topics.join(" ")
  : typeof topics === "string"
    ? topics.trim()
    : "";

const shouldIndex =
  typeof pagefindIndexProp === "boolean" ? pagefindIndexProp : pagefindType !== "search";

const isSearchPage = pagefindType === "search";

// Let SearchBar default its active chip from the current URL (on /search only).
const initialTypeFromUrl = isSearchPage
  ? (Astro.url?.searchParams?.get("type") || "").trim()
  : "";
const baseUrl = import.meta.env.BASE_URL || "/";
---

<Layout
  title={title}
  description={description}
  canonical={canonical}
  bg={bg}
  pagefindIndex={shouldIndex}
  robotsNoindex={isSearchPage}
  pageSearch={showToolsSearch}
>
  <slot slot="head" name="head" />

  <div class={`scripture-layout scripture-layout--${pagefindType}`}>
    {
      (showToolsReadMenu || showToolsSearch) && (
        <section
          class="scripture-tools"
          data-pagefind-ignore
          aria-label="Scripture tools"
        >
          <div class="scripture-tools__inner">
            {/* Content above the search bar (the search page's heading), in a
                grid row of its own so the picker can share the field's row. */}
            {Astro.slots.has("preSearch") && (
              <div class="scripture-tools__heading">
                <slot name="preSearch" />
              </div>
            )}

            <div class="scripture-tools__left" aria-label="Jump to passage">
              {showToolsReadMenu ? <ReadMenu /> : null}
            </div>

            <div class="scripture-tools__center" aria-label="Search the LIT">
              {showToolsSearch ? (
                <SearchBar
                  fullSearchHref={`${baseUrl}search`}
                  defaultMode={initialTypeFromUrl}
                  initialOpen={isSearchPage}
                />
              ) : null}
            </div>

            <div class="scripture-tools__right" aria-hidden="true" />
          </div>
        </section>
      )
    }

    {
      /* On /search the SearchBar panel is server-rendered open via
         initialOpen={true}, so no client-side toggle is needed. */
    }

    <div
      class="scripture-main"
      data-pagefind-body={shouldIndex ? true : undefined}
      data-pagefind-ignore={shouldIndex ? undefined : true}
      data-type={shouldIndex ? pagefindType : undefined}
      data-book={shouldIndex ? pagefindBook : undefined}
      data-chapter={shouldIndex ? pagefindChapter : undefined}
      data-pagefind-filter={shouldIndex
        ? "type[data-type], book[data-book], chapter[data-chapter]"
        : undefined}
    >
      {
        /* =========================================================
         Pagefind meta (TEXT, not <meta> tags) — more reliable
         NOTE: Must be ignored for body indexing, or topics leak into keyword hits.
         ========================================================= */
      }
      {
        shouldIndex ? (
          <>
            <span
              class="pf-meta"
              aria-hidden="true"
              data-pagefind-meta="title"
              data-pagefind-ignore
            >
              {title}
            </span>
            <span
              class="pf-meta"
              aria-hidden="true"
              data-pagefind-meta="description"
              data-pagefind-ignore
            >
              {description}
            </span>
            <span
              class="pf-meta"
              aria-hidden="true"
              data-pagefind-meta="type"
              data-pagefind-ignore
            >
              {pagefindType}
            </span>
            <span
              class="pf-meta"
              aria-hidden="true"
              data-pagefind-meta="book"
              data-pagefind-ignore
            >
              {pagefindBook}
            </span>
            <span
              class="pf-meta"
              aria-hidden="true"
              data-pagefind-meta="chapter"
              data-pagefind-ignore
            >
              {String(pagefindChapter)}
            </span>

            {topicsString ? (
              <span
                class="pf-meta"
                aria-hidden="true"
                data-pagefind-meta="topics"
                data-pagefind-ignore
              >
                {topicsString}
              </span>
            ) : null}
          </>
        ) : null
      }

      <slot name="pageHeader" />
      <slot />
    </div>

    <style>
      /* The results follow the Display tray's text size and line spacing
         through --reading-scale and --reading-leading-extra (see
         src/styles/CLAUDE.md); the size sits with the width so a line keeps its
         length in characters. */
      .scripture-main {
        margin: 0 auto;
        font-size: calc(1em * var(--reading-scale, 1));
        max-width: var(--content-width, 72ch);
        padding: 12px 16px 64px;
      }

      /* Hidden-but-indexed metadata for Pagefind */
      .pf-meta {
        position: absolute;
        left: -9999px;
        width: 1px;
        height: 1px;
        overflow: hidden;
        white-space: nowrap;
      }

      /* The heading sits over the search field in a row of its own, and the
         passage picker shares the next row with the field, its label on the
         same baseline as the field's text (BVJ, 2026-11-06). Centered on the
         whole middle column (heading, field and filters), the picker landed
         wherever the heading's wrapping and the filters' height put that
         column's middle, a different place at each width. A phone stacks
         them: heading, picker, field. */
      :global(.scripture-tools__heading) {
        grid-column: 2;
        grid-row: 1;
      }

      @media (min-width: 641px) {
        :global(.scripture-tools__inner) {
          align-items: first baseline;
        }

        :global(.scripture-tools__left),
        :global(.scripture-tools__center),
        :global(.scripture-tools__right) {
          grid-row: 2;
        }

        /* A flex box takes its baseline from its first item, which in the
           picker is the book icon; this hands it the label's. The label is
           the tallest item, so it doesn't move. */
        :global(.scripture-tools__left .read-menu__label) {
          align-self: baseline;
        }
      }

      /* Mobile-only breathing room BETWEEN the stacked tools.
         (We do NOT style SearchBar internals here.) */
      @media (max-width: 640px) {
        :global(.scripture-tools__inner) {
          gap: 18px;
        }

        :global(.scripture-tools__heading) {
          grid-column: auto;
          grid-row: auto;
        }
      }

    </style>

    <style is:global>
      /* /search: make SearchBar panel behave like an in-page controls tray */
      .scripture-layout--search [data-searchbar] .searchbar__panel {
        position: static !important;
        top: auto !important;
        left: auto !important;
        right: auto !important;
        margin-top: 12px;
        display: block !important; /* we force open via dataset; this is extra safety */
      }

      /* /search: we only want the controls (chips/book/mode), not the mini-results tray */
      .scripture-layout--search [data-searchbar] .searchbar__status,
      .scripture-layout--search [data-searchbar] .searchbar__jump,
      .scripture-layout--search [data-searchbar] .searchbar__groups,
      .scripture-layout--search [data-searchbar] .searchbar__footer {
        display: none !important;
      }

      /* /search: you're already on full search */
      .scripture-layout--search [data-searchbar] .searchbar__full {
        display: none !important;
      }
    </style>
  </div>
</Layout>
